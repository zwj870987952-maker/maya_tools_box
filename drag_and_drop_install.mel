// ==============================================================================
// Maya FBX Material Ingest & Asset Diff Tool - Viewport Drag & Drop Installer
// Usage: Drag this file into Maya viewport to install shelf button and launch UI.
// ==============================================================================

global proc fbxDiffToolExecuteInstall(string $filePath) {
    string $fullPath = $filePath;

    if ($fullPath == "") {
        string $whatIs = `whatIs "fbxDiffToolExecuteInstall"`;
        if (`gmatch $whatIs "Mel procedure found in: *"`) {
            $fullPath = `substring $whatIs 25 (size($whatIs))`;
        }
    }

    if ($fullPath == "") {
        warning "Cannot auto-detect installer path. Please run script manually from Script Editor.";
        return;
    }

    string $rootDir = `dirname $fullPath`;
    $rootDir = substituteAllString($rootDir, "\\", "/");

    // Pass rootDir safely to Python
    string $pyCmd = "import sys, os\n";
    $pyCmd += "root = r'" + $rootDir + "'\n";
    $pyCmd += "if root not in sys.path:\n";
    $pyCmd += "    sys.path.insert(0, root)\n";
    $pyCmd += "import compare_and_sync_fbx_assets as diff_tool\n";
    $pyCmd += "import importlib\n";
    $pyCmd += "importlib.reload(diff_tool)\n";
    $pyCmd += "diff_tool.install_shelf_button(root)\n";
    $pyCmd += "diff_tool.show_ui()\n";

    python($pyCmd);
}

// Maya viewport drag-and-drop callback hook
global proc onMayaDropped(string $draggedFile) {
    fbxDiffToolExecuteInstall($draggedFile);
}

// Fallback execution when sourced directly
fbxDiffToolExecuteInstall("");
