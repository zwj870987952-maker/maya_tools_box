+            mtbKF_checkAttr(($ikCtrl[0] + ".outerZ")); setAttr ($ikCtrl[0] + ".outerZ") 0;
+
+            mtbKF_checkAttr(($ikCtrl[0] + ".innerX")); setAttr ($ikCtrl[0] + ".innerX") 0;
+            mtbKF_checkAttr(($ikCtrl[0] + ".innerY")); setAttr ($ikCtrl[0] + ".innerY") 0;
+            mtbKF_checkAttr(($ikCtrl[0] + ".innerZ")); setAttr ($ikCtrl[0] + ".innerZ") 0;
+
+            mtbKF_checkAttr(($ikCtrl[0] + ".heelX")); setAttr ($ikCtrl[0] + ".heelX") 0;
+            mtbKF_checkAttr(($ikCtrl[0] + ".heelY")); setAttr ($ikCtrl[0] + ".heelY") 0;
+            mtbKF_checkAttr(($ikCtrl[0] + ".heelZ")); setAttr ($ikCtrl[0] + ".heelZ") 0;
+
+            mtbKF_checkAttr(($ikCtrl[0] + ".heelTipX")); setAttr ($ikCtrl[0] + ".heelTipX") 0;
+            mtbKF_checkAttr(($ikCtrl[0] + ".heelTipY")); setAttr ($ikCtrl[0] + ".heelTipY") 0;
+            mtbKF_checkAttr(($ikCtrl[0] + ".heelTipZ")); setAttr ($ikCtrl[0] + ".heelTipZ") 0;
