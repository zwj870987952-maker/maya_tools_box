global proc float BOver9_0_b970808d076db3299a05dc858ee1a1e0(float $frame1, float $frame2, string $curve_name)
{
    float $fr[]=`keyframe  -t($frame1 + ":" +  $frame2) -q $curve_name`;
    if($fr[0]!=$frame1)
        floatArrayInsertAtIndex(0, $fr, $frame1);
    if($fr[size($fr)-1]!=$frame2)
        floatArrayInsertAtIndex(size($fr), $fr, $frame2);
    float $promejutok[]=BOver9_0_7145e62c24cf62d609b928973d8456c7($fr, 0,1);
    int $index=$promejutok[0];
    float $half_len=$promejutok[1]/2;
    float $rand_delta =`rand 0 $half_len` - $half_len/2;
    float $fin_frame=$fr[$index] + $promejutok[1]/2 + $rand_delta;
    return  $fin_frame;
}
