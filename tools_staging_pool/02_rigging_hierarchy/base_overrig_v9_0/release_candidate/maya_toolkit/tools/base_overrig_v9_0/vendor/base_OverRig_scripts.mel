global proc BOver9_0_09f1edc0a69a4931b08e1bcc40e94a55()
{
	string $selected[]= `ls -sl`;
	if(size($selected)==0)
	{
		warning "select something!!!!";
		return;
	}
	string $crvs[] = `keyframe -q -n`;
	float $statTime[] = `keyframe -index 0 -q -tc $crvs`;
	$statTime=`sort $statTime`;
	float $null_frame = $statTime[0] - 10;
	catchQuiet(`setKeyframe -v 0 -t $null_frame -at rotateX -at rotateY -at rotateZ`) ;
	catchQuiet(`filterCurve $selected.rotateX $selected.rotateY $selected.rotateZ`);
	selectKey -clear;
	catchQuiet(`cutKey -t $null_frame  -at rotateX -at rotateY -at rotateZ `);
	selectKey -clear;
}
global proc string[] BOver9_0_194c7b09c27128a45486ac17560c7a25(string $objs[])
{
	string $new_selected[];
	$j=0;
	for($i=0;$i<size($objs);$i++)
	{
		if( `objExists $objs[$i]` )
		{
			$new_selected[$j] = $objs[$i];
			$j++;
		}
	}
	select -r $new_selected;
	return $new_selected;
}
global proc float BOver9_0_c7822f1f10b007a6803735c105e40799(string $obj1, string $obj2)
{
	float $temp[]=BOver9_0_8598296823aa3af15686cb0d78f1615d($obj1);
	vector $point1 = <<$temp[0], $temp[1], $temp[2]>>;
	$temp=BOver9_0_8598296823aa3af15686cb0d78f1615d($obj2);
	vector $point2 = <<$temp[0], $temp[1], $temp[2]>>;
	float $lenght=`mag($point1-$point2)`;
	return  $lenght;
}
global proc float[] BOver9_0_9bcfe87821f81f923d9a4d502efb9945()
{
    float $time_pref[],$ast,$min,$max,$aet;
    $ast=`playbackOptions -q -ast`;
    $min=`playbackOptions -q -min`;
    $max=`playbackOptions -q -max`;
    $aet=`playbackOptions -q -aet`;
    $time_pref={$ast,$min,$max,$aet};
    return $time_pref;
}
global proc BOver9_0_d9f7ba947826f7f00ce2215bc1417109(float $time_pref[])
{
    playbackOptions  -ast $time_pref[0] -min $time_pref[1] -max $time_pref[2] -aet $time_pref[3];
