global proc BOver9_0_9b29b86e5de4ada4b19840df4e8973d5()
{
	$Names = `ls -sl`;
	$mt=`ls "motionTrail*"`;
	if(size($mt))
	{
		catchQuiet (`select $mt`);
		updateMotionTrail;
		select $Names;
	}
	else
		warning "No motion trails in scene";
}
global proc string[] BOver9_0_d1e3370b8e860ec07368697d9ae6b53b(string $objects[])
{
    string $connected_MT[]=`listHistory -f 1 -lf 0 -pdo 1 $objects`;
    $connected_MT=`ls -type motionTrail $connected_MT`;
    $connected_MT= stringArrayRemoveDuplicates(`listConnections -s 0 -d 1 $connected_MT`);
    return $connected_MT;
}
global proc BOver9_0_216cd5229394f893f58516bc1517892a(int $knots, int $bake_anim, int $create_MT, int $besier_mode)
{
	undoInfo -ock -cn "curve_motion_path";
	$maya_unit=`currentUnit -q -l`;
	if ($maya_unit!="cm")
	{
		currentUnit  -l cm;
	}
	optionVar -intValue animBlendingOpt 1;
	optionVar -intValue animBlendBrokenInputOpt 1;
	$mayaVersion = `getApplicationVersionAsFloat` ;
    string $eval_mode[];
    if ($mayaVersion>=2019)
    {
		python("from maya.plugin.evaluator.cache_preferences import CachePreferenceEnabled");
		python("CachePreferenceEnabled().set_value( False )");
    }
	global string $eval_mode[];
	if ($mayaVersion>=2016)
	{
		$eval_mode=`evaluationManager -q -mode`;
		evaluationManager -mode "off";
	}
	$knots-=1;
	int $degrees=3;
    if($knots<=1)
        $knots=1;
	float $frame_range[]=BOver9_0_dfc2513778a513e560ec81c8f3df6563();
	if( ($frame_range[1]- $frame_range[0])==1)
	{
		warning "need select framerange!!!!";
		currentUnit  -l $maya_unit;
		evaluationManager -mode $eval_mode;
		undoInfo -cck;
		return;
	}
	string $selection[]=`ls-sl`;
	if( size($selection)==0)
	{
		warning "need select object!!!!";
		currentUnit  -l $maya_unit;
		evaluationManager -mode $eval_mode;
		undoInfo -cck;
		return;
	}
	global string $BARN_curve_motion_path_remember1[];
	global string $BARN_curve_motion_path_remember2[];
	global string $BARN_curve_motion_path_remember3[];
	BOver9_0_ac692345fba3e827ad5d6e26de39ba07;
	$BARN_curve_motion_path_remember1=$selection;
	BOver9_0_4b209c5c00abddc3e3509a14326e2488({$selection[0]},"OverRig_rig_objects");
	int $mt_error=catchQuiet($mot_tra=`snapshot  -motionTrail 1  -increment 1 -startTime $frame_range[0] -endTime ($frame_range[1]-1) $selection[0]`);
	if( $mt_error)
	{
		warning "something wrong, may be you select vertex???";
		currentUnit  -l $maya_unit;
		evaluationManager -mode $eval_mode;
		undoInfo -cck;
		return;
	}
	string $motion_trails[]=`ls -type motionTrail`;
	if(size($motion_trails)!=0)
    	for($obj in $motion_trails)
            catchQuiet (`setAttr ($obj + ".nodeState") 2`);
	vector $coords[]=BOver9_0_4ad38bb85176eb981038083a281c91d6($selection[0], {$frame_range[0],$frame_range[1]-1});
	string $curve_name=BOver9_0_83a9015d514ecd1326a1648b28396ba2($coords,1);
	string $cuve_dubli[];
	if($bake_anim)
	{
		$cuve_dubli=`duplicate -rr $curve_name`;
		$dup_cuve_shapes=BOver9_0_5e702211108f11813c411c94f8b1b380($cuve_dubli[0]);
		setAttr ($dup_cuve_shapes[0] +".dispCV") 1;
		select $cuve_dubli;
		BOver9_0_cc20e95399a3b6da44eb78e45451d764(13);
	}
	string $curves[]=`rebuildCurve -ch 1 -rpo 1 -rt 0 -end 1 -kr 0 -kcp 0 -kep 1 -kt 0 -s $knots -d $degrees -tol 0.01 $curve_name`;
    string $cuv_shape[];
    int $colo[];
    int $numCVs;
    if($besier_mode)
    {
        select $curves;
        nurbsCurveToBezier;
        $numCVs = `getAttr -size ($curves[0] + ".controlPoints")`;
        $cuv_shape=BOver9_0_5e702211108f11813c411c94f8b1b380($curves[0]);
        setAttr ($cuv_shape[0] + ".dispCV") 1;
        $colo=BOver9_0_3de1f2433d756c53274925f7253b3c51({$curves[0]});
		BOver9_0_cc20e95399a3b6da44eb78e45451d764($colo[0]);
        setAttr -lock true ($cuv_shape[0] + ".cp[0].xv");
        setAttr -lock true ($cuv_shape[0] + ".cp[0].yv");
        setAttr -lock true ($cuv_shape[0] + ".cp[0].zv");
        setAttr -lock true ($cuv_shape[0] + ".cp[" + ($numCVs -1) + "].xv");
        setAttr -lock true ($cuv_shape[0] + ".cp[" + ($numCVs -1) + "].yv");
        setAttr -lock true ($cuv_shape[0] + ".cp[" + ($numCVs -1) + "].zv");
    }
    string $clusters[],$cluster_lock[];
    if(!$besier_mode)
    {
		for($i=1;$i<($knots+2);$i++)
		{
			$tmpp=`cluster ($curve_name + ".cv[" + $i + "]")`;
			$clusters[$i-1]=$tmpp[1];
		}
		select -cl;
		select $clusters;
		BOver9_0_4c2952dd9f486573856c8eb6a0dc46ac(0);
		$cluster_lock=BOver9_0_54d92f8424c4459e6d996d9fd93902f0();
		BOver9_0_c89bf830cdb2b9cc874e6c8604e8b257;
		BOver9_0_b6a5017ee305f5ba0bbf3116243cc3af;
		BOver9_0_34cdd1e4469c2d3c695448db824d2ecb(1);
		$colo=BOver9_0_3de1f2433d756c53274925f7253b3c51({$cluster_lock[0]});
		BOver9_0_cc20e95399a3b6da44eb78e45451d764($colo[0]);
		BOver9_0_6de8028af587b467034457b4d6349f89(0.1);
		BOver9_0_4a0278149f801323f33f7bb9e4ee597d($cluster_lock,$clusters);
	}
	$lock_on_curve=`spaceLocator`;
	BOver9_0_3323b46f97bc12510f86536ae21ff525;
	$BARN_curve_motion_path_remember2=$lock_on_curve;
	BOver9_0_34cdd1e4469c2d3c695448db824d2ecb(1);
	BOver9_0_cc20e95399a3b6da44eb78e45451d764(13);
	BOver9_0_6de8028af587b467034457b4d6349f89(0);
	if(!$besier_mode)
		catchQuiet(`select $clusters $cluster_lock $curve_name $cuve_dubli`);
	else
		catchQuiet(`select $curve_name $cuve_dubli`);
	catchQuiet($gr_name=`group -w -n "curve_path"`);
	xform -piv 0 0 0;
	BOver9_0_4b209c5c00abddc3e3509a14326e2488(`ls-sl`,"OverRig_knots");
	BOver9_0_5fce4865a9fd47748e6796c1be9d64b2;
	$BARN_curve_motion_path_remember3=`ls-sl`;
	undoInfo -cck;
	$motion_path=BOver9_0_7b95c992be7b036735f7298f89ab9556($selection[0],$curve_name,$frame_range, $lock_on_curve[0],1);
	undoInfo -ock -cn "curve_motion_path";
	string $markers[]=BOver9_0_cfc20aa23531f881688ec3a171beaae5($motion_path);
	string $mark;
	$j=0;
	$i=0;
	string $colored_markers[];
	for ($mark in $markers)
	{
	    setAttr ($mark  +  ".lodVisibility") 0;
		setAttr ($mark  +  ".visibility") 0;
		setAttr ($mark  +  ".hideOnPlayback") 1;
		setAttr ($mark  +  ".hiddenInOutliner") 1;
		$marker_shape=BOver9_0_5e702211108f11813c411c94f8b1b380($mark);
		setAttr ($marker_shape[0]  +  ".lodVisibility") 0;
		setAttr ($marker_shape[0]  +  ".visibility") 0;
		setAttr ($marker_shape[0]  +  ".hideOnPlayback") 1;
		setAttr ($marker_shape[0]  +  ".hiddenInOutliner") 1;
	    if($j==4)
	    {
	        $j=0;
	        $colored_markers[$i]=$mark;
	        $i++;
	    }
	    $j++;
	}
	select $markers;
	BOver9_0_cc20e95399a3b6da44eb78e45451d764(8);
	select $colored_markers;
	print $colored_markers;
	BOver9_0_cc20e95399a3b6da44eb78e45451d764(22);
    parent    $lock_on_curve $mot_tra $gr_name;
	string $p_constr[]=`parentConstraint -skipRotate x -skipRotate y -skipRotate z -weight 1 $lock_on_curve $selection[0]`;
	catch(BOver9_0_f0549514de82c9ee2236723b537462e7($lock_on_curve, {$p_constr[0]},"Curve_trajectory", $frame_range, 1));
	select $lock_on_curve;
	currentUnit  -l $maya_unit;
	evaluationManager -mode $eval_mode;
	 if(!$create_MT)
        delete $mot_tra[0];
	undoInfo -cck;
}
global proc string[] BOver9_0_d87329da3638ba6d8abbdc21284da5b0(string $path_to_JGLBN)
{
    string $namespase_prefix=BOver9_0_d9b32ab6c0497dc9f017f8056df67928("dyn");
    file -import  -iv -type "mayaBinary" -ra true -namespace $namespase_prefix -options "v=0"  -pr -loadReferenceDepth "all" -importTimeRange "keep" ($path_to_JGLBN + "Jiggle_Bone_New.mb");
    string $jiggle_group_name=($namespase_prefix + ":jiggle_gr");
	BOver9_0_4b209c5c00abddc3e3509a14326e2488({$jiggle_group_name,($namespase_prefix + ":jiggle_plane")},"OverRig_knots");
    string $jiggle_dynamic_bone=($namespase_prefix + ":jiggle_bone_to_connect");
    string $jiggle_bone_name=($namespase_prefix + ":jiggle_bone");
    select $jiggle_group_name  $jiggle_bone_name $jiggle_dynamic_bone;
    namespace -f -mnr -removeNamespace  $namespase_prefix;
    string $new_name[]=BOver9_0_10b1c67feba7e9570357d44ba9306692 ("", `ls-sl`,"");
    return $new_name;
}
global proc string BOver9_0_7f3473239f5affa2a0790f0c6db6aaf9(string $clth_j[], float $len, float $sdvig,   float $sdvig_side, float $smooth_end, int $cycle,   int $abs_mode, int $save_edge, float $min_fr, float $max_fr, int $zero_percent, int $partial_mode)
{
    if(size($clth_j)<=1)
	{
		warning "select something!!";
		return "";
	}
	string $sv_edge_lock[],$layer,$edge_layer_name;
	string $hvost;
	float $scene_range[];
	float $min=`playbackOptions -q -ast`;
	float $max=`playbackOptions -q -aet`;
	$scene_range={$min,$max};
    if($save_edge)
    {
        select $clth_j;
        currentTime $min_fr;
        $sv_edge_lock=BOver9_0_24abb2efaf063b9b16a2b2c78969a384();
        setKeyframe -breakdown 0   -hierarchy none -controlPoints 0 -shape 1 $sv_edge_lock;
        currentTime $max_fr;
        BOver9_0_5e8af8371c687e5c50d7ded5040ffe13($clth_j, $sv_edge_lock);
        setKeyframe -breakdown 0   -hierarchy none -controlPoints 0 -shape 1 $sv_edge_lock;
    }
    $hvost =BOver9_0_ddf3e35ed988fd159dd82159edfce03a($clth_j, $len, $sdvig,   $sdvig_side,   $smooth_end,$cycle,   $abs_mode ) ;
    if ($hvost!="break")
    {
    	select $clth_j;
    	$layer=BOver9_0_c830bbb3bb6041f72a5fb76403fcabe8();
    	setAttr ($layer + ".rotationAccumulationMode") 1;
    	BOver9_0_09f1edc0a69a4931b08e1bcc40e94a55;
        if($partial_mode)
            BOver9_0_402263cc1b8de1e793411a0a2dc0e8ec({$layer}, $scene_range, 1.0, "flat", 0);
    	delete_constraint_attributes_on_objects($clth_j);
    	delete $hvost ;
        if($save_edge)
        {
            $edge_layer_name=BOver9_0_bdd2d2262c150fe16a261bb2e2e76046(1);
            currentTime $min_fr;
            BOver9_0_7f958423a7cfe1774157efdcb79ac0be($sv_edge_lock, $clth_j);
            setKeyframe -breakdown 0   -hierarchy none -controlPoints 0 -shape 1 $clth_j;
            currentTime ($min_fr + $zero_percent);
            setKeyframe -breakdown 0   -id -itt flat  -ott flat -dd true -hierarchy none -controlPoints 0 -shape 1 $clth_j;
            currentTime ($max_fr - $zero_percent);
            setKeyframe -breakdown 0   -id -itt flat  -ott flat -dd true -hierarchy none -controlPoints 0 -shape 1 $clth_j;
            currentTime $max_fr;
            BOver9_0_7f958423a7cfe1774157efdcb79ac0be($sv_edge_lock, $clth_j);
            setKeyframe -breakdown 0   -hierarchy none -controlPoints 0 -shape 1 $clth_j;
            delete $sv_edge_lock;
            animLayer -edit -parent $layer $edge_layer_name;
        }
    	select -cl;
    	if($save_edge)
    	{
    	    BOver9_0_92974e563427b6856d49efc764f12d33($edge_layer_name);
    	    rename $edge_layer_name "edge_additive";
    	}
    	else
    	    BOver9_0_92974e563427b6856d49efc764f12d33($layer);
    }
    return $layer;
}
global proc string BOver9_0_a54e109972caf8ac808da7205e765e57(string $name_expression, int $size_inputs)
{
    $expression_name=`expression  -ae 0 -s "" -n  $name_expression `;
    string $cmd="string $p[];\n";
    for($i=0;$i<$size_inputs;$i++)
    {
        $cmd= $cmd + "  \n $p[" + $i + "]=.I[" + $i + "];";
    }
     $cmd= $cmd + " \n $h=`sort $p`; \n .O[0]=$h[size($p)-1];";
    expression  -e  -s $cmd $expression_name ;
    for($i=0; $i<$size_inputs;$i++)
    {
        addAttr -ln ("null" + $i) -nn ("null" + $i)  -dv 0   -dcb 1 $expression_name;
        connectAttr -f ( $expression_name + ".null" + $i) ( $expression_name + ".input[" + $i + "]");
    }
    return $expression_name;
}
global proc string BOver9_0_44f98143a051a179f7a8f034b026e69b(string $compon, string $object)
{
    string $v[]=`filterExpand -sm 31 $compon`;
    select $v;
    string $geo[]=BOver9_0_9145a4487029b640fc70278199ce684f();
    string $shp[]= `listRelatives  -shapes $geo[0]`;
    string $uv[];
    string $buffer[];
    float $uv_coords[];
    if(size($v)>0)
    {
        $uv = `polyListComponentConversion -fromVertex -toUV  $v[0]`;
        tokenize $uv[0] "[]" $buffer;
        $uv_coords=getAttr ($shp[0] + ".uvpt[" + $buffer[1] + "]");
    }
    string $constr[]=`pointOnPolyConstraint $geo $object` ;
    string $attr_nameU[]=`listAttr -string ("*U*" ) $constr`;
    string $attr_nameV[]=`listAttr -string ("*V*" ) $constr`;
    setAttr ($constr[0] + "." + $attr_nameU[size($attr_nameU)-1]) $uv_coords[0];
    setAttr ($constr[0] + "." + $attr_nameV[size($attr_nameV)-1]) $uv_coords[1];
    return $constr[0];
}
global proc string[] BOver9_0_b9fa1d9928478b91ad38716608825bd6()
{
    $min=`playbackOptions -query -min`;
    $max=`playbackOptions -query -max`;
    string $sel[] = `ls -sl`;
    $lock=`spaceLocator`;
    string $shps_l[]= `listRelatives  -shapes $lock[0]`;
    string $sn_sh[]=`snapshot -n($sel[0] + "_motionTrail") -motionTrail 1  -increment 1 -startTime $min -endTime $max`;
    string $s = $sn_sh[1];
    string $t = $sn_sh[0];
    string $shps[]= `listRelatives  -shapes $t`;
    string $sp= $shps[0];
    disconnectAttr ($s + ".points") ($sp + ".points");
    disconnectAttr ($lock[0] + ".message") ($sp + ".transformToMove");
    disconnectAttr ($lock[0] + ".worldMatrix[0]") ($s +".inputMatrix");
    disconnectAttr ($lock[0] + ".message") ($s +".snapshotObject");
    disconnectAttr ($shps_l[1] + ".localPosition") ($s +".localPosition");
delete $lock;
int $end=`optionVar -q  "bar_mt_END_val"`;
int $start=`optionVar -q  "bar_mt_START_val"`;
if($end==0)
    $end=10;
if($end>($max-$min)/2)
    $end=($max-$min)/2;
if($start==0)
    $start=10;
if($start>($max-$min)/2)
    $start=($max-$min)/2;
setAttr -lock false ($t + ".translate");
setAttr -lock false ($t + ".translateX");
setAttr -lock false ($t + ".translateY");
setAttr -lock false ($t + ".translateZ");
addAttr -ln "end"  -at long  -min 0 -dv $end $t;
addAttr -ln "start"  -at long  -min 0 -dv $start $t;
setAttr -e-keyable true ($t + ".start");
setAttr -e-keyable true ($t + ".end");
catchQuiet(`setAttr  ($t + ".useOutlinerColor") true`);
catchQuiet(`setAttr  ($t + ".outlinerColor") 1 1 0`);
setAttr -keyable false -channelBox false ($sp + ".frameMarkerSize");
setAttr -keyable false -channelBox false ($sp + ".preFrame");
setAttr -keyable false -channelBox false ($sp + ".postFrame");
setAttr -keyable false -channelBox false ($sp + ".sf");
setAttr -keyable false -channelBox false ($sp + ".fi");
setAttr -keyable false -channelBox false ($sp + ".ks");
setAttr -keyable false -channelBox false ($sp + ".s");
setAttr -keyable false -channelBox false ($sp + ".b");
setAttr -keyable false -channelBox false ($sp + ".sit");
setAttr -keyable false -channelBox false ($sp + ".sot");
setAttr -keyable false -channelBox false ($sp + ".sib");
setAttr -keyable false -channelBox false ($sp + ".sob");
setAttr -keyable false -channelBox false ($sp + ".mok");
setAttr -keyable false -channelBox false ($sp + ".pd");
setAttr -keyable true -channelBox false ($sp + ".keyframeSize");
int $num=size(`ls "*EGR*_motionTrailHandleShape" "*:*EGR*_motionTrailHandleShape"`);
float $trailColors[];
float $extraTrailColor[];
if($num>9)
    $num=0;
switch($num)
{
    case 0:
    $trailColors={0.2064,0.4945,0.6193};
    $extraTrailColor={0.009462,0.1766,0.249};
    break;
    case 1:
    $trailColors={0.0,0.0,1.0};
    $extraTrailColor={1.0,0.0,0.0};
    break;
    case 2:
    $trailColors={1.0,0.3694,0.0};
    $extraTrailColor={0.0,0.6431,1.0};
    break;
    case 3:
    $trailColors={1.0,0.0,1.0};
    $extraTrailColor={0.0,1.0,0.8644};
    break;
    case 4:
    $trailColors={0.8866,1.0,1.0};
    $extraTrailColor={0.5529,0.0,1.0};
    break;
    case 5:
    $trailColors={0.0, 0.9164,1.0};
    $extraTrailColor={0.8822,0.0,1.0};
    break;
    case 6:
    $trailColors={1.0,0.0,0.8658};
    $extraTrailColor={1.0,0.602,0.212025};
    break;
    case 7:
    $trailColors={0.682628,0.687,0.153888};
    $extraTrailColor={0.0541,0.4364,0.602};
    break;
    case 8:
    $trailColors={1.0,1.0,1.0};
    $extraTrailColor={0.0,0.0,0.0};
    break;
    case 9:
    $trailColors={0.55,0.55,0.55};
    $extraTrailColor={0.25,0.25,0.25};
    break;
}
float $dot_color[];
string $buffer[];
string $res;
if(`optionVar -ex  "bar_mt_DOT_colors"`)
{
	$res= `optionVar -q  "bar_mt_DOT_colors"`;
	tokenize $res " " $buffer;
    $dot_color[0]=$buffer[0];
	$dot_color[1]=$buffer[1];
	$dot_color[2]=$buffer[2];
}
else
    $dot_color={1.0,1.0,1.0};
int $trailThickness;
if(`optionVar -ex  "bar_trailThickness"`)
    $trailThickness=`optionVar -q  "bar_trailThickness"`;
else
    $trailThickness=2;
float $trailDotsize;
if(`optionVar -ex  "bar_trailDotsize"`)
    $trailDotsize=`optionVar -q  "bar_trailDotsize"`;
else
    $trailDotsize=1;
    setAttr ($sp + ".trailColor") -type double3 $trailColors[0]  $trailColors[1]  $trailColors[2] ;
    setAttr ($sp + ".extraTrailColor") -type double3 $extraTrailColor[0] $extraTrailColor[1] $extraTrailColor[2] ;
    setAttr ($sp + ".keyframeColor") -type double3 $dot_color[0] $dot_color[1] $dot_color[2];
    setAttr ($sp + ".keyframeSize") 0.1;
    setAttr  ($sp + ".showFrames") 0;
    setAttr  ($sp + ".keyframeSize") $trailDotsize;
    setAttr -e($sp + ".trailThickness") $trailThickness;
    setAttr ($sp + ".pinned") 1;
    setAttr ($sp + ".frameMarkerSize") 0.1;
    setAttr  ($sp + ".frameMarkerColor") -type double3 1 1 1;
	setAttr ($t + ".overrideEnabled") 1;
	setAttr ($t + ".overrideDisplayType") 2;
setAttr -lock true ($sp + ".showInTangent");
setAttr -lock true ($sp + ".showInBead");
setAttr -lock true ($sp + ".showOutTangent");
setAttr -lock true ($sp + ".modifyKeys");
setAttr -lock true ($sp + ".showOutTangent");
setAttr -lock true ($sp + ".showOutBead");
setAttr -lock true ($sp + ".ak");
setAttr -lock true ($sp + ".ec");
setAttr -lock true ($sp + ".bc");
setAttr -lock true ($sp + ".sek");
setAttr -lock true ($sp + ".preFrame");
setAttr -lock true ($sp + ".postFrame");
setAttr -lock true ($sp + ".fadeInoutFrames");
setAttr -lock true ($sp + ".frameMarkerSize");
setAttr -lock true ($sp + ".showFrameMarkers");
setAttr -lock true ($sp + ".frameMarkerColor");
setAttr -lock true ($sp + ".showFrameMarkerFrames");
setAttr -lock true ($sp + ".showFrames");
    select $sel;
    return {$t,$sp,$s};
}
global proc string BOver9_0_5a83676d63b5330872e526b5f6930549( string $object)
{
    undoInfo -stateWithoutFlush 0;
    global string $global_mt_name;
    catchQuiet($global_mt_name=BOver9_0_8358654186ce68fce780ef66a4260a01($object));
    undoInfo -stateWithoutFlush 1;
    return $global_mt_name;
}
global proc string BOver9_0_bdd2d2262c150fe16a261bb2e2e76046(int $rotation_mod)
{
	string $selected[]=`ls-sl`;
	string $animLayer=`animLayer -addSelectedObjects`;
	for($obj in `ls-sl`)
    {
        select $obj;
        animLayer -e -addSelectedObjects $animLayer;
    }
	$cmd="setAttr " + $animLayer + ".rotationAccumulationMode " + $rotation_mod;
	eval ($cmd);
	select -cl;
	select $selected;
	BOver9_0_92974e563427b6856d49efc764f12d33($animLayer);
	return $animLayer;
}
global proc BOver9_0_92974e563427b6856d49efc764f12d33(string $layer)
{
	string $layers[]=`ls -type "animLayer"`;
	int $i;
	for($i=0; $i<size($layers); $i++)
		animLayer -e -selected 0 $layers[$i];
	animLayer -e -selected 1 $layer;
	animLayerEditorOnSelect $layer 1;
}
global proc BOver9_0_402263cc1b8de1e793411a0a2dc0e8ec(string $layers[], float $range[], float $side_fr, string $tangent, int $reverse)
{
    float $v0=0;
    float $v1=1;
    if($reverse)
    {
        $v0=1;
        $v1=0;
    }
    for($l in $layers)
    {
        setKeyframe -t ($range[0] - $side_fr) -v $v0  -itt $tangent -ott $tangent -at ($l + ".weight") ($l + ".weight") ;
        setKeyframe -t ($range[0])            -v $v1  -itt $tangent -ott $tangent -at ($l + ".weight") ($l + ".weight") ;
        setKeyframe -t ($range[1])            -v $v1  -itt $tangent -ott $tangent -at ($l + ".weight") ($l + ".weight") ;
        setKeyframe -t ($range[1] + $side_fr) -v $v0  -itt $tangent -ott $tangent -at ($l + ".weight") ($l + ".weight") ;
    }
}
global proc string[] BOver9_0_719a69b0631e3563f3cad27518625416(float $keys_for_delete[])
{
	string $promejutki[];
	$k = 0;
	$i = 0;
	clear $promejutki;
	while ($i<size($keys_for_delete))
	{
		$start_frame=$keys_for_delete[$i];
		$j = $i;
		$pos = 0;
		do
		{
			$pos = $pos + 1;
			$j = $j + 1;
		} while ($j < size($keys_for_delete) && $keys_for_delete[$j] == $start_frame + $pos);
		$promejutki[$k]=($start_frame + ":" + $keys_for_delete[$j - 1]);
		$k++;
		$i = $j;
	}
    return $promejutki;
}
global proc BOver9_0_419ebd630d5f306b0e072ae65d2736e8(float $side, float $poseBias)
{
    float $farme_rng[];
	global string $gMainWindow;
    catchQuiet($farme_rng=BOver9_0_cba6da1b519f7600c71b7de0d52d2c3e());
    if($farme_rng[0]>=$farme_rng[1])
	{
		BOver9_0_bbc6100deeaad590128e235d81b77ee3( $poseBias, `ls-fl-sl`);
	}
    else
        BOver9_0_c53bf77b0f2a5276b2dd47d6531b8351($side);
}
global proc BOver9_0_18ecfb9c58f1a9c19cff7819d9a88813(string $objects[], float $color[])
{
	string $obj;
	if(!size($objects))
		return;
	for($obj in $objects)
	{
		catchQuiet(`setAttr  ($obj + ".useOutlinerColor") true`);
		catchQuiet(`setAttr  ($obj +" .outlinerColor") $color[0] $color[1] $color[2]`);
	}
}
global proc string[] BOver9_0_d68451d42d330e385dd0c090bd6877a0(string $prefix)
{
    string $uuids[]=`ls -uuid-sl`;
    string $curr_obj[], $short_name, $fin_obj[];
	for($uid in $uuids)
	{
	     $curr_obj=`ls  -l -uuid $uid`;
	     $short_name= `match "[^|\\]*$"$curr_obj[0]`;
	     rename $curr_obj[0] ($prefix +  $short_name);
	 }
	 $fin_obj= `ls  -uuid $uuids`;
	 select -cl;
	 select -r $fin_obj;
	 return $fin_obj;
}
global proc string[] BOver9_0_24abb2efaf063b9b16a2b2c78969a384()
{
    string $selection[]=`ls-fl-os`;
    string $lock[]=BOver9_0_54d92f8424c4459e6d996d9fd93902f0();
    catchQuiet ( BOver9_0_d1b73d0512bac8d20998bdbab9b3aed7($selection, $lock) );
    for($i=0;$i<size($selection);$i++)
        if(!((`objectType -isType "mesh" $selection[$i]`)+(`objectType -isType "nurbsSurface" $selection[$i]`)+(`objectType -isType "nurbsCurve" $selection[$i]`)+(`objectType -isType "lattice" $selection[$i]`)))
            delete `orientConstraint $selection[$i] $lock[$i]`;
    return $lock;
}
global proc BOver9_0_113374ba19bc1f4dc9b1cc9706816f86(string $objects[])
{
	if(!size($objects))
		return;
	string $obj;
	for($obj in $objects)
	{
		setAttr -lock true ($obj + ".translateX");
		setAttr -lock true ($obj + ".translateY");
		setAttr -lock true ($obj + ".translateZ");
	}
}
global proc BOver9_0_b76d22f29f0df28efe8f00a67d5635f7(int $style)
{
	string $objs[] = `ls-sl`;
	if(!size($objs))
		return;
	string $obj;
	for($obj in $objs)
		setAttr ($obj + ".drawStyle") $style;
}
global proc int[] BOver9_0_3de1f2433d756c53274925f7253b3c51(string $objects[])
{
    if(!size($objects))
        return {};
    string $obj;
    int $colors[];
    int $color;
    $i=0;
    for($obj in $objects)
    {
        catchQuiet(`setAttr ($obj + ".overrideEnabled") 1`);
        $colors[$i]=`rand 3 31`;
		catchQuiet(`setAttr -lock false ($obj + ".overrideColor") $colors[$i]`);
		$i++;
    }
    return $colors;
}
global proc float[] BOver9_0_d47b8e8b02e1593b7af35176139fac48(string $array[])
{
	float $output[];
	int $count = size($array);
	if (!$count)
        return $output={};
	for ($i = 0; $i < $count; $i++)
		$output[$i]= $array[$i];
	return $output;
}
global proc vector[] BOver9_0_4ad38bb85176eb981038083a281c91d6(string $selection, float $framerange[])
{
    float $objPosition[];
    vector $getPvPos_range[];
    float $getPvPos[];
    float $Rot[];
    int $j=0;
    for($i=$framerange[0];$i<=($framerange[1]);$i++)
	{
		currentTime $i;
		$getPvPos=BOver9_0_8598296823aa3af15686cb0d78f1615d($selection);
		$getPvPos_range[$j]=<<$getPvPos[0],$getPvPos[1],$getPvPos[2]>>;
		$j++;
	}
	return $getPvPos_range;
}
global proc string BOver9_0_29a2189faa1ce9571a1184989dc7f462()
{
	string $tmp[];
	string $locs[]=`ls -sl`;
	select -r $locs[0];
	select -add $locs[2];
	$tmp=`aimConstraint -mo -weight 1 -aimVector 0 1 0 -upVector 0 0 1 -worldUpType "object" -worldUpObject $locs[1]`;
	return $tmp[0];
}
global proc string BOver9_0_399e6ca23a24d0e48ed5cb872f4729dd( string $shape )
{
    string $transform;
	if ( "transform" != `nodeType $shape` )
	{
		string $parents[] = `listRelatives  -parent $shape`;
		$transform = $parents[0];
	}
   return $transform;
}
global proc string[] BOver9_0_9145a4487029b640fc70278199ce684f()
{
	string $facesShapes[] = `ls -l -sl -o`;
	string $str1=stringArrayToString($facesShapes, " ");
	string $selected[]=`ls -l -sl`;
	string $str2=stringArrayToString($selected, " ");
	string $obj_selected[];
	if( $str1!=$str2 )
	     $obj_selected = `listRelatives -f -p $facesShapes`;
	    else
	        $obj_selected=$selected;
	if (size ($obj_selected)==0)
	    $obj_selected=$facesShapes;
	return $obj_selected;
}
global proc string BOver9_0_d9b32ab6c0497dc9f017f8056df67928(string $NMSPC)
{
    $g=1;
    string $namespase_prefix;
    for ($i=1;$g;$i++)
    {
        $namespase_prefix = $NMSPC + $i;
        $g= `namespace -ex ($NMSPC + $i)`;
    }
    return $namespase_prefix;
}
global proc string[] BOver9_0_4874f5c758343518c484dc3cb8ee48b0(int $dergee, int $num_CV_on_drawn_curve, int $proportional, int $connect)
{
	$selected_base=`ls-sl`;
	$selected=BOver9_0_54d92f8424c4459e6d996d9fd93902f0();
	BOver9_0_5cb0441daec59a79a525bdb749d48438("x");
	if ($connect)
	    BOver9_0_4a0278149f801323f33f7bb9e4ee597d($selected,$selected_base);
	$num=size($selected);
	$curve_name=BOver9_0_a8d1933a966541e62d79a2fcbf6e4ea4($dergee);
	if($num_CV_on_drawn_curve!=0)
		rebuildCurve -ch 0 -rpo 1 -rt 0 -end 1 -kr 0 -kcp 0 -kep 0 -kt 0 -s $num_CV_on_drawn_curve -d $dergee -tol 0.01  $curve_name;
	if($proportional)
		$curves_base=`rebuildCurve -ch 1 -rpo 0 -rt 0 -end 1 -kr 0 -kcp 0 -kep 0 -kt 0 -s ($num) -d  3 -tol 0.01 $curve_name`;
	else
		$curves_base[0]=$curve_name;
	$point_on_curve_node=`createNode nearestPointOnCurve`;
	$rebild_curve_shape_base=BOver9_0_5e702211108f11813c411c94f8b1b380($curves_base[0]);
	connectAttr -f ($rebild_curve_shape_base[0] + ".worldSpace[0]") ($point_on_curve_node + ".inputCurve");
	$i=0;
	for($obj in $selected)
	{
		$pos=BOver9_0_8598296823aa3af15686cb0d78f1615d($obj);
		setAttr ($point_on_curve_node + ".inPositionX") $pos[0];
		setAttr ($point_on_curve_node + ".inPositionY") $pos[1];
		setAttr ($point_on_curve_node + ".inPositionZ") $pos[2];
		$start_pos=`getAttr  ($point_on_curve_node + ".parameter ")`;
		$point_on_curve_info_node=`createNode pointOnCurveInfo`;
		connectAttr -f ($rebild_curve_shape_base[0] + ".worldSpace[0]") ($point_on_curve_info_node + ".inputCurve");
		connectAttr -f ($point_on_curve_info_node + ".position") ($obj + ".translate");
		setAttr ($point_on_curve_info_node + ".parameter") $start_pos;
	}
	delete $point_on_curve_node;
	select $selected $curve_name $curves_base[0];
	return` ls-sl` ;
}
global proc string[] BOver9_0_ef7d5e5d22a49212f1df955c4a101f3a(float $radius)
{
	$selection = `ls -fl -sl `;
	string $curve_sphere[];
	if(size($selection)>0)
	{
		for($i=0;$i<size($selection);$i++)
		{
			$curve_sphere[$i]=BOver9_0_1325d6f8979e36be5cd12865010fabb9($radius);
		}
		BOver9_0_847308ac6f1debf8edcc8d63e128d64c( $selection, $curve_sphere);
		BOver9_0_7f958423a7cfe1774157efdcb79ac0be( $selection,$curve_sphere);
	}
	else
	{
		$curve_sphere[0]=BOver9_0_1325d6f8979e36be5cd12865010fabb9($radius);
	}
   select $curve_sphere ;
   return $curve_sphere;
}
global proc int BOver9_0_c3face5af2eaef8e548ce10d50587275(string $curve)
{
    int $numCVs = `getAttr -size ($curve + ".controlPoints")`;
    select -replace ($curve + ".cv[0:" + ($numCVs -1) + "]") ;
    return $numCVs;
}
global proc BOver9_0_74b3586ec5f33152020ca1d5764043c3()
{
    $selected_loc=`ls-sl`;
	float $rx=1;
	float $ry=1;
	float $local_pos[];
	float $local_rot[];
	float $local_rotTmp[];
	float $joint_radius=0.5;
	string $shapes[];
	float $curr_unit=BOver9_0_f71c299bf7b53f7243b078a9990e581c(1);
	for($loc in $selected_loc)
	{
	   	$shapes1=`listRelatives  -type "shape"  -f  $loc`;
		$color=`getAttr  ($loc + ".overrideColor") `;
		catchQuiet($joint_radius = (`getAttr  ($loc + ".radius")`));
        catchQuiet($local_pos = (`getAttr  ($loc + ".localPosition")`));
		catchQuiet($local_rot = (`getAttr ($shapes1[0] + ".localScale")`)  );
		$cirle=`circle  -c 0 0 0  -nr 0 0 1 -sw 360 -r ($joint_radius*2*$curr_unit) -d 3 -ut 0 -tol 1e-06 -s 8 -ch 1  `;
		move -a $local_pos[0]  $local_pos[1] $local_pos[2] $cirle;
		$local_rotTmp=`sort $local_rot`;
		delete -ch;
	    if($local_rotTmp[2]!=0)
		    scale -r -p  ($local_pos[0] + "cm") ($local_pos[1] + "cm") ($local_pos[2] + "cm") ($local_rotTmp[2]/$curr_unit/$curr_unit) ($local_rotTmp[2]/$curr_unit/$curr_unit) ($local_rotTmp[2]/$curr_unit/$curr_unit) ($cirle[0] + ".cv[0:7]");
		if(($local_rot[0]+$local_rot[1]+$local_rot[0])/3!=$local_rot[0])
		{
		if ($local_rotTmp[0]==$local_rot[0])
		    rotate -r -p  ($local_pos[0] + "cm") ($local_pos[1] + "cm") ($local_pos[2] + "cm") -ws -fo 0 90 0 ($cirle[0] + ".cv[0:7]");
		else if ($local_rotTmp[0]==$local_rot[1])
		    rotate -r -p  ($local_pos[0] + "cm") ($local_pos[1] + "cm") ($local_pos[2] + "cm") -ws -fo 90 0 0 ($cirle[0] + ".cv[0:7]");
		}
		select $loc $cirle[0];
		$objects=`ls-sl`;
		$shapes=`listRelatives  -type "shape"  -f  $objects[0]`;
		catchQuiet(`setAttr ($shapes[0] + ".visibility") 1`);
		for($i=1;$i<size($objects);$i++)
		{
			$shapes=`listRelatives -shapes  $objects[$i]`;
			delete (`parentConstraint $objects[0] $objects[$i] `);
			parent $objects[$i] $objects[0];
			makeIdentity -apply 1 $objects[$i];
			$j=0;
			for($sh in $shapes)
			{
			    $ren=`rename $sh  ($loc+ "Shape" + $j)`;
			    parent -add  -s $ren $objects[0];
			}
		}
		catchQuiet(`delete $shapes1`);
		delete $objects[1];
		select $objects[0];
		$shapes=`listRelatives  -type "shape"  -f  $objects[0]`;
		catchQuiet(`setAttr -keyable false -channelBox true ($shapes[1] + ".rcurve")`);
		catchQuiet(`setAttr -keyable false -channelBox true  ($shapes[1] + ".cwdth")`);
		catchQuiet(`setAttr -keyable false -channelBox true  ($shapes[1] + ".srate")`);
		catchQuiet(`setAttr -keyable false -channelBox true  ($shapes[1] + ".ai_curve_shaderr")`);
		catchQuiet(`setAttr -keyable false -channelBox true  ($shapes[1] + ".ai_curve_shaderg")`);
		catchQuiet(`setAttr -keyable false -channelBox true  ($shapes[1] + ".ai_curve_shaderb")`);
        catchQuiet(`setAttr ($shapes[1] + ".overrideEnabled")  1`);
		catchQuiet(`setAttr -lock false ($shapes[1] + ".overrideColor") $color`);
		select $shapes[0];
		catchQuiet(`select $shapes[1]`);
	}
	select $selected_loc;
}
global proc float BOver9_0_9cf10c253bb06da91bcfe3836a7e5f36(float $pos1[], float $pos2[])
{
    vector $p1_p2=<<$pos1[0],$pos1[1],$pos1[2]>> -<<$pos2[0],$pos2[1],$pos2[2]>>;
    $lenght=(`mag $p1_p2`);
    return $lenght;
}
global proc float[] BOver9_0_6f6ae5b84133776f167ce9bbf3409540(float $point1[],float $point2[],float $point3[])
{
	float $vector1[]={$point2[0]-$point1[0],$point2[1]-$point1[1],$point2[2]-$point1[2]};
	float $vector2[]={$point3[0]-$point1[0],$point3[1]-$point1[1],$point3[2]-$point1[2]};
	float $orto[]=crossProduct($vector2, $vector1, 1, 1);
	float $result[]=crossProduct($vector1, $orto, 1, 1);
	return $result;
}
global proc string BOver9_0_7b95c992be7b036735f7298f89ab9556(string $object,string $curve_name, float $framerange[], string $curve_movement_loc, int $bake_anim)
{
    undoInfo  -ock -cn "curve_motion_path";
	if( ($framerange[1]- $framerange[0])==1)
	{
		$framerange[0]=`playbackOptions -q -ast`;
		$framerange[1]=(`playbackOptions -q -aet`) + 1;
	}
	string $m_path=`pathAnimation -fractionMode 0 -follow true -followAxis x -upAxis z -worldUpType "scene" -inverseUp false -inverseFront false -bank false -startTimeU $framerange[0] -endTimeU ($framerange[1]-1) $curve_name $curve_movement_loc`;
	if($bake_anim)
	{
		string $near_point_on_crve_node=`createNode nearestPointOnCurve`;
		string $decompose_matrix_node=`createNode decomposeMatrix`;
		connectAttr -f ($object + ".worldMatrix[0]") ($decompose_matrix_node + ".inputMatrix");
		connectAttr -f ($decompose_matrix_node + ".outputTranslate") ($near_point_on_crve_node + ".inPosition");
		string $crve_shape[]=BOver9_0_5e702211108f11813c411c94f8b1b380($curve_name);
		connectAttr -f ($crve_shape[0] + ".worldSpace[0]")  ($near_point_on_crve_node + ".inputCurve");
		select $m_path;
		int $j=0;
		float $U_V_param[];
		for($i=$framerange[0]; $i<$framerange[1];$i++)
		{
			currentTime $i;
			$U_V_param[$j]=getAttr ($near_point_on_crve_node + ".parameter");
			setKeyframe  -v $U_V_param[$j] -t $i ($m_path + ".uValue");
			keyframe -e -vc $U_V_param[$j]  -t $i ($m_path + "_uValue");
			$j++;
		}
		keyTangent -itt spline -ott spline $m_path;
		delete $near_point_on_crve_node $decompose_matrix_node;
	}
    string $find_double_linear[]=`listConnections  -d 1 -s 0 -scn 1 -type "addDoubleLinear"  $curve_movement_loc `;
    connectAttr -f ($m_path + ".allCoordinates") ($curve_movement_loc + ".translate");
    delete $find_double_linear;
	return $m_path;
}
global proc string BOver9_0_ddf3e35ed988fd159dd82159edfce03a(string $selection[], float $hardness, float $sdvig_lenght, float $sdvig_side, float $smooth_end, int $cycled, int $abs_mode )
{
    float $curren_time =`currentTime -q`;
    string $gr_name;
	if(size($selection)<=1)
	{
	    warning "one chain member, skipped";
	    select -cl;
	    $gr_name="break";
	    return $gr_name;
	}
	select $selection;
	BOver9_0_9bad7ec683c4a9fc4b3098a039f34d33(8, 1);
	string $joints[]=`ls-sl`;
	select $joints;
	BOver9_0_09f1edc0a69a4931b08e1bcc40e94a55;
    string 	$top_locks[], $cycle_layer_name;
    string $side_locks[];
    float $lenght_aim_move;
    string $top_locks_fin[];
    if($abs_mode==1)
    {
        $sdvig_lenght=$sdvig_lenght/size($selection);
        $sdvig_side=0;
    }
    $size=size($joints);
    for ($i=0; $i<size($joints);$i++)
	{
    	select $joints[$i];
    	$top_locks=BOver9_0_54d92f8424c4459e6d996d9fd93902f0();
        if ($i!=`size($joints)`-1)
            $lenght_aim_move=BOver9_0_c7822f1f10b007a6803735c105e40799($joints[$i], $joints[$i+1]);
        else
    	    $lenght_aim_move=BOver9_0_c7822f1f10b007a6803735c105e40799($joints[$i], $joints[$i-1]);
    	move -r -os -wd ($lenght_aim_move*$hardness) 0 0 ;
    	BOver9_0_17431451b1be026fdeee93b86579c6b6({$joints[$i]}, $top_locks);
        BOver9_0_c89bf830cdb2b9cc874e6c8604e8b257;
        BOver9_0_de88efca2929f0080ae1d45ff5db42d4;
        BOver9_0_09f1edc0a69a4931b08e1bcc40e94a55;
    	$top_locks_fin[$i]=$top_locks[0];
        aimConstraint -mo -weight 1 -aimVector 1 0 0 -upVector 0 0 1 -worldUpType "objectrotation" -worldUpVector 0 0 1 -worldUpObject $top_locks_fin[$i]  $top_locks_fin[$i] $joints[$i];
    	if($i==0&&$smooth_end!=0)
    	{
    	    select $top_locks  ;
    	    BOver9_0_01964c63a0f5c1bf0eb159d94bb787cc(($hardness*$smooth_end*2),0);
			keyTangent -itt spline -ott spline;
    	}
    	if ($cycled)
    	{
    		select $top_locks;
		    $cycle_layer_name=BOver9_0_bdd2d2262c150fe16a261bb2e2e76046(1);
	        copy_start_frame_to_end();
	        BOver9_0_37aa5a96585e35a67af0d77c7cbea21c();
	        animCurveEditor -edit -displayInfinities 1 graphEditor1GraphEd;
    		setInfinity -pri cycle -poi cycle;
    	}
    	keyframe -e -iub true -r -o over -tc ($sdvig_lenght  ) $top_locks[0];
    	keyframe -e -at rx  -at ry  -at rz  -iub true -r -o over -tc ( $sdvig_side) $top_locks[0];
		rotationInterpolation -convert quaternionSlerp $top_locks.rotateX;
	}
	select $top_locks_fin  $joints[0];
	$gr_name=`group -n "hvost_over"`;  xform -os -piv 0 0 0;
	currentTime  $curren_time;
	return $gr_name;
}
global proc BOver9_0_01964c63a0f5c1bf0eb159d94bb787cc(float $period, int $pre_bake)
{
 float $min,$max;
    float $range[]= BOver9_0_dfc2513778a513e560ec81c8f3df6563();
    if($range[1]-$range[0]==1)
    {
        $min=`playbackOptions -q -min`;
        $max=`playbackOptions -q -max`;
        $range={$min,$max};
    }
	float $rng=$range[1]-$range[0];
	if($period>$rng)
		$period=$rng;
    if($pre_bake)
        bakeResults -sampleBy 1 -oversamplingRate 1 -preserveOutsideKeys 1 -sparseAnimCurveBake 0;
	float $frame=floor($rng/$period);
	$frame=$rng/$frame;
    filterCurve -f resample  -kernel gaussian2 -period $frame -s $range[0] -e $range[1];
}
global proc string BOver9_0_a0b1ccb530c89eb90e4a1b647be4ed19(float $hardness, float $sdvig_lenght, float $sdvig_side, float $smooth_end, int $cycled, int $abs_mode )
{
	undoInfo -ock -cn "BOver9_0_a0b1ccb530c89eb90e4a1b647be4ed19";
    $curren_time=`currentTime -q`;
	BOver9_0_90caf8375dffdf325df3be666537a016;
	$selection=`ls-sl`;
	BOver9_0_9bad7ec683c4a9fc4b3098a039f34d33(8,1);
	$joints=`ls-sl`;
    string 	$top_locks[];
    string $side_locks[];
    float $lenght_aim_move;
    if($abs_mode==1)
    {
        $sdvig_lenght=$sdvig_lenght/size($selection);
        $sdvig_side=0;
        $smooth_end=0;
    }
    $size=size($joints);
    for ($i=0; $i<size($joints);$i++)
	{
    	select $joints[$i];
    	BOver9_0_c642429ed9a3aabf65a66eefcd97bfbb;
        if ($i!=`size($joints)`-1)
        {
            $lenght_aim_move=BOver9_0_c7822f1f10b007a6803735c105e40799($joints[$i], $joints[$i+1]);
        }
        else
    	{
    	    $lenght_aim_move=BOver9_0_c7822f1f10b007a6803735c105e40799($joints[$i], $joints[$i-1]);
    	}
    	move -r -os -wd ($lenght_aim_move*$hardness) 0 0 ;
    	pickWalk -d right;
    	move -r -os -wd 0 (-1*$lenght_aim_move*$hardness) 0 ;
    	BOver9_0_10df34add5a583f84d24608e860c1b4b;
    	$tops=`ls-sl`;
    	$top_locks[$i]=$tops[0];
    	keyframe -e -iub true -r -o over -tc ($sdvig_lenght + $i*$smooth_end);
    	pickWalk -d right;
    	$sides=`ls-sl`;
    	$side_locks[$i]=$sides[0];
    	keyframe -e -iub true -r -o over -tc ($sdvig_side +$i*$smooth_end);
    	if ($cycled)
    	{
    		select $tops $sides;
    		animCurveEditor -edit -displayInfinities 1 graphEditor1GraphEd;
    		setInfinity -pri cycle -poi cycle;
    	}
	}
	select $top_locks $side_locks $joints[0];
	string $gr_name=`group -n "hvost"`;  xform -os -piv 0 0 0;
	select $top_locks $side_locks;
	select $selection;
	select $top_locks;
	currentTime  $curren_time;
	undoInfo -cck;
	return $gr_name;
}
global proc string BOver9_0_8358654186ce68fce780ef66a4260a01(string $object)
{
    string $selection[]=`ls-sl`;
    global string $global_mt_name;
    $global_mt_name=$object + "_motionTrailHandleShape";
    $global_mt_name_bsw=$object + "_motionTrailHandle";
	$c_time=`currentTime-q`;
	int $startFrame;
	int $endFrame;
	int $fr_before=getAttr ($global_mt_name_bsw + ".start");
	int $fr_after=getAttr ($global_mt_name_bsw + ".end");
	if($fr_before!=0)
        $startFrame = $c_time-$fr_before;
    else
        $startFrame=`playbackOptions -q -min`;
    if($fr_after!=0)
        $endFrame = $c_time+$fr_after;
    else
        $endFrame=`playbackOptions -q -max`;
    float $pos[];
    float $wpos[];
    string $m_trail[];
    string $positio="";
    for ($frame = $startFrame; $frame <=$endFrame; $frame++)
    {
        $pos = `getAttr -time $frame ( $object + ".worldMatrix[0]")`;
        $wpos[0] = BOver9_0_f71c299bf7b53f7243b078a9990e581c($pos[12]);
        $wpos[1] = BOver9_0_f71c299bf7b53f7243b078a9990e581c($pos[13]);
        $wpos[2] = BOver9_0_f71c299bf7b53f7243b078a9990e581c($pos[14]);
        $positio=$positio + floatArrayToString( $wpos, " " ) + " 1 ";
    }
    $cmd="setAttr " + $global_mt_name + ".points -type pointArray " + ($endFrame-$startFrame+1) + " " + $positio + ";";
    $cmd=$cmd + "\nsetAttr " + $object + "_motionTrail.startTime " + $startFrame + ";";
    $cmd=$cmd + "\nsetAttr " + $object + "_motionTrail.endTime " + $endFrame+ ";";
    eval ($cmd);
    return $global_mt_name;
}
global proc int BOver9_0_37aa5a96585e35a67af0d77c7cbea21c()
{
    $selection=`ls -sl`;
    string $obj_in_layers[];
    string  $aff[];
    $i=0;
    string $obj;
    for ($obj in $selection)
    {
        select $obj;
        $aff=getAffectedLayers({$obj});
        if(size($aff)>=1)
        {
            $obj_in_layers[$i]=$obj;
            $i++;
        }
    }
    select $obj_in_layers;
    string  $affected_layers[], $lay, $locked_a_layers[], $unlocked_a_layers[], $locked_muted_a_layers[],$locked_un_muted_a_layers[];
    $size=size($obj_in_layers);
    if ($size>=1)
    {
        $affected_layers=getAffectedLayers($obj_in_layers);
        for($lay in $affected_layers)
            {
                if(`animLayer -q -lock  $lay`==1)
                    appendStringArray($locked_a_layers, {$lay},1);
                else
                    appendStringArray($unlocked_a_layers, {$lay},1);
            }
        for($lay in $locked_a_layers)
            {
                if(`animLayer -q -mute  $lay`==1)
                    appendStringArray($locked_muted_a_layers, {$lay},1);
                else
                    appendStringArray($locked_un_muted_a_layers, {$lay},1);
            }
        for($lay in $locked_a_layers)
            animLayer -edit -mute 1 $lay;
        BOver9_0_de88efca2929f0080ae1d45ff5db42d4;
        BOver9_0_e503fab70a8f9fdcc7cdd1520fc26701($selection,  $unlocked_a_layers);
        deleteEmptyAnimLayers();
        for($lay in $locked_un_muted_a_layers)
            animLayer -edit -mute 0 $lay;
    }
    select -cl;
    int $have_locked=0;
    select  $selection;
	if ($size>=1)
		BOver9_0_09f1edc0a69a4931b08e1bcc40e94a55;
	if (size($locked_a_layers)>0)
	    $have_locked=1;
	return $have_locked;
}
global proc BOver9_0_e503fab70a8f9fdcc7cdd1520fc26701(string $objects[], string $layers[])
{
	for($layer in $layers)
	{
		if (`objectType $layer` == "animLayer")
		{
			string $attributes[] = `animLayer -query -attribute $layer`;
			for($attribute in $attributes)
			{
				$attribute_full_name = `ls -l $attribute`;
				$node_full_name = `plugNode $attribute_full_name[0]`;
				for($object in $objects)
				{
					$object_full_name = `ls -l $object`;
					if( $node_full_name == $object_full_name[0] )
					{
						evalEcho( "animLayer -edit -removeAttribute " + $attribute +" "+ $layer );
					}
				}
			}
		}
	}
}
global proc BOver9_0_c53bf77b0f2a5276b2dd47d6531b8351(float $scale_size)
{
	float $value[];
	float $fr[];
	float $fr_end,$fr_start;
	float $v_range,$r;
	float $straight_value_pos;
	string $curve[] = `keyframe -q -n -sl`;
	for($i=0;$i<size($curve);$i++)
	{
		$fr  = `keyframe -q -tc -sl $curve[$i]`;
		if(size($fr)>2)
		{
			$value  = `keyframe -q -vc -sl $curve[$i]`;
			$v_start = $value[0];
			$v_end = $value[size($value)-1];
			$fr_start=$fr [0];
			$fr_end=$fr [(size($fr))-1];
			$r =$fr_end - $fr_start;
			$v_range=$v_end - $v_start;
			for($k=1;$k<size($fr)-1;$k++)
			{
				$frame_proportion_pose=($fr [$k]-$fr_start)/$r;
				$straight_value_pos = $v_range*$frame_proportion_pose + $v_start;
				scaleKey  -iub false -ts 1  -fs 1 -fp 0  -valueScale $scale_size -valuePivot $straight_value_pos -tp ($fr [$k]) -t ($fr [$k])  $curve[$i];
			}
		}
	}
	currentTime -e `currentTime -q`;
}
global proc BOver9_0_bbc6100deeaad590128e235d81b77ee3(float $poseBias, string $objects[])
{
	string $curves[], $attribs[], $tmp[], $crv, $full;
	float $cur_time;
	float $timeL,$timeR;
	string $tanL[],$tanR[],$tanFin[];
	float $x;
	float $pk=3;
	if($poseBias>1.5)
	{
		$x=$poseBias;
		$x=pow (2,$pk*$x -$pk);
		$poseBias=$x- 1.37;
	}
	if($poseBias<-0.5)
	{
		$x=1-$poseBias;
		$x=pow (2,$pk*$x -$pk);
		$poseBias= 1-$x + 1.37;
	}
	float $val_curr[],$diffToUse,$v_new;
	$cur_time = `currentTime -q`;
	$attribs = `channelBox -q -selectedMainAttributes mainChannelBox`;
	if (size($attribs)>=1)
	{
		for ($obj in $objects)
		{
			for ($attrib in $attribs)
			{
				$full = $obj + "." + $attrib;
				if (!objExists($full))
					continue;
				$tmp = `keyframe -q -name $full`;
				if (!size($tmp))
					continue;
				$curves[size($curves)] = $tmp[0];
			}
		}
	}
	else
		$curves = `keyframe -q -name $objects` ;
	for ($crv in $curves)
	{
		$timeL = `findKeyframe -which previous $crv`;
		$timeR = `findKeyframe -which next $crv`;
		$tanL = `keyTangent -time $timeL -q -itt -ott $crv`;
		$tanR = `keyTangent -time $timeR -q -itt -ott $crv`;
		$tanFin={$tanL[0],$tanR[0]};
		if (($tanL[0] == "fixed")||($tanL[1] == "fixed") ||($tanR[0] == "fixed")||($tanR[1] == "fixed"))
			  $tanFin = `keyTangent -q -g -itt -ott`;
		else
			if ($tanR[1] == "step")
				$tanFin[1] = $tanR[1];
		$val_curr  = `keyframe -time $timeL -time $timeR -q -valueChange $crv` ;
		$diffToUse = ($val_curr[1] - $val_curr[0]) * $poseBias;
		$v_new = $val_curr[0] + $diffToUse;
		setKeyframe -t $cur_time -v $v_new -ott $tanFin[1] $crv;
		if ($tanFin[0] != "step")
			keyTangent -t $cur_time -itt $tanFin[0] $crv;
	}
	currentTime -e $cur_time;
}
global proc string BOver9_0_1325d6f8979e36be5cd12865010fabb9(float $radius)
{
	string $curves[];
	clear $curves;
	$crv=`circle -c 0 0 0 -nr 0 0 1 -sw 360 -r  $radius -d 3 -ut 0 -tol 0.01 -s 8 -ch 0`;
	catchQuiet (`setAttr -lock true ($crv[0] + ".rcurve")`);
	catchQuiet (`setAttr -lock true ($crv[0] + ".cwdth")`);
	catchQuiet (`setAttr -lock true ($crv[0] + ".srate")`);
	catchQuiet (`setAttr -lock true ($crv[0] + ".ai_curve_shaderr")`);
	catchQuiet (`setAttr -lock true ($crv[0] + ".ai_curve_shaderg")`);
	catchQuiet (`setAttr -lock true ($crv[0] + ".ai_curve_shaderb")`);
	appendStringArray( $curves, $crv, 1);
	$crv=`duplicate -rr -rc`;
	rotate -a -ws -fo 0 90 0 ;
	appendStringArray( $curves, $crv, 1);
	$crv=`duplicate -rr -rc`;
	rotate -r -ws -fo 0 0 90 ;
	appendStringArray( $curves, $crv, 1);
	select $curves;
	makeIdentity -apply true -t 1 -r 1 -s 1 -n 0 -pn 1;
	for($i=1;$i<size($curves);$i++)
	{
		$shapes=`listRelatives -shapes  $curves[$i]`;
		parent -add  -s  $shapes $curves[0];
	}
	select $curves;
	select -d $curves[0];
	delete;
	select $curves[0];
	makeIdentity -apply true -t 1 -r 1 -s 1 -n 0 -pn 1;
	return $curves[0];
}