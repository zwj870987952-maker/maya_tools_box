global proc string[] BOver9_0_f0209cb5b5931bdfa7ae6801db19a0f8 ()
{
	string $uid_objs[]=`ls -uuid -sl`;
    string $curr_objs[];
    string $fin_objs[];
	string $group[];
	string $transform_grpp[];
	string $tmpp[]=BOver9_0_a2b81a3977941c0eac1cda769570172c();;
	for ($i=0; $i<(size($uid_objs)-1);$i++)
	{
	    $curr_objs=`ls -uuid {$uid_objs[$i+1],$uid_objs[$i]}`;
        if(objectType($curr_objs[0])=="joint" && objectType($curr_objs[1])=="joint")
        {
			select $curr_objs[0];
			$group=BOver9_0_e34225338b41391d68d09634ca599397(1);
			$transform_grpp=stringArrayRemove($tmpp,$group);
			$curr_objs=`ls -uuid {$uid_objs[$i+1],$uid_objs[$i]}`;
			connectJoint -pm $curr_objs[0] $curr_objs[1];
			catchQuiet(`delete $transform_grpp`);
        }
        else
             catchQuiet (`parent $curr_objs[0] $curr_objs[1]`);
	}
    $fin_objs=`ls -uuid $uid_objs`;
	select -cl;
	select $fin_objs;
	return $fin_objs;
}
