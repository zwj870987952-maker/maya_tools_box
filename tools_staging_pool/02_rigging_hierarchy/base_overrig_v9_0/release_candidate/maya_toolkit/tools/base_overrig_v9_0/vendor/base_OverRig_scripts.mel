	$rz_lock=`getAttr -lock ($obj[$num_obj-1] + ".rz")`;
	$tx_lock=`getAttr -lock ($obj[$num_obj-1] + ".tx")`;
	$ty_lock=`getAttr -lock ($obj[$num_obj-1] + ".ty")`;
	$tz_lock=`getAttr -lock ($obj[$num_obj-1] + ".tz")`;
	$h=$rx_lock+$ry_lock+$rz_lock+$tx_lock+$ty_lock+$tz_lock;
	if ($h<6)
	{
		$skipTX= "";
		$skipTY= "";
		$skipTZ= "";
		$skipRX= "";
		$skipRY= "";
		$skipRZ= "";
		if($tx_lock)
			$skipTX= " -st x";
		if($ty_lock)
			$skipTY= " -st y";
		if($tz_lock)
			$skipTZ= " -st z";
		if($rx_lock)
			$skipRX= " -sr x";
		if($ry_lock)
			$skipRY= " -sr y";
		if($rz_lock)
			$skipRZ= " -sr z";
		$skipped = $skipTX + $skipTY + $skipTZ + $skipRX + $skipRY + $skipRZ;
		string $objects = "";
		for($i=0;$i<$num_obj;$i++)
		{
			$objects = $objects + $obj[$i] + " ";
		}
		$name_of_constrain=`eval ("parentConstraint -mo " + $skipped + " " + $objects)`;
		for($i=0;$i<($num_obj-1);$i++)
		{
			$attr_name=`listAttr -string ("*W" + $i) $name_of_constrain[0]`;
			catch (`setAttr ($name_of_constrain[0] + "." +  $attr_name[0]) $weight_all[$i]`);
		}
	}
		$ret_name=$name_of_constrain[0];
		return $ret_name;
}
