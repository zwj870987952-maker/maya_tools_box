		if(!`getAttr -lock ($obj + ".tx") `)
			setAttr ($obj + ".tx") 0;
		if(!`getAttr  -lock ($obj + ".ty") `)
			setAttr ($obj + ".ty") 0;
		if(!`getAttr  -lock ($obj + ".tz")`)
			setAttr ($obj + ".tz") 0;
	}
}
global proc string[] BOver9_0_1ed150b12535ee196bee8b74a6bf5f5c(string $objects[], string $obj_type)
{
    string $fin_listing[];
    string $fin_listing_prev[];
    string $shape_type_listing[];
    string $tmp_shapes[];
    string $shapes[];
    for($obj in $objects)
    {
       $tmp_shapes=BOver9_0_5e702211108f11813c411c94f8b1b380($obj);
       appendStringArray($shapes,  $tmp_shapes, `size($tmp_shapes)`);
    }
    $j=0;
    for($obj in $shapes)
    {
        if(`objectType $obj`==$obj_type)
        {
          $shape_type_listing[$j] = $obj;
          $j++;
        }
    }
    $j=0;
    if($obj_type!="joint")
    {
        for($obj in $shape_type_listing)
        {
             $fin_listing_prev[$j]=BOver9_0_399e6ca23a24d0e48ed5cb872f4729dd($obj);
             $j++;
             $fin_listing=stringArrayRemoveDuplicates ($fin_listing_prev);
        }
    }
	else
       $fin_listing=$shape_type_listing;
    return $fin_listing;
}
global proc string[] BOver9_0_3f4f73dada507559923dd025fcbc3bdf(string $inputt[], int $start_pos, int $end_pos)
{
    string $outputt[];
    $sizee=size($inputt);
    if(($start_pos<0)&&($end_pos>0))
    {
        error "wrong range. start position can >=0";
        $outputt[0]="";
        return $outputt;
    }
    if(($start_pos>=0)&&($start_pos>=$sizee))
    {
        error "start position more than string[] size";
        $outputt[0]="";
        return $outputt;
    }
    if(($end_pos<0)&&($end_pos*-1>$sizee))
    {
        error "end position more than string[] size";
        $outputt[0]="";
        return $outputt;
    }
    if(($start_pos<0)&&($start_pos*-1>$sizee))
    {
        error "start position more than string[] size";
        $outputt[0]="";
        return $outputt;
    }
    if(($end_pos>=0)&&($end_pos>=$sizee))
    {
        error "end position over more than string[] size";
        $outputt[0]="";
        return $outputt;
    }
    if(($end_pos<0)&&($start_pos>($sizee+$end_pos)))
    {
        error "start position over more than end position";
        $outputt[0]="";
        return $outputt;
    }
    if(($end_pos>=0)&&($start_pos>$end_pos))
    {
        error "start position over more than end position";
        $outputt[0]="";
        return $outputt;
    }
    if(($start_pos<0)&&(($end_pos<0))&&($start_pos>$end_pos))
    {
        error "wrong range. start position over more than end position";
        $outputt[0]="";
        return $outputt;
    }
    if($start_pos==$end_pos)
    {
        $outputt[0]=$inputt[$start_pos];
        return $outputt;
    }
    if($end_pos>0)
    {
       for($i=0;$i<=($end_pos-$start_pos);$i++)
       {
          $outputt[$i] =$inputt[$start_pos+$i];
       }
        return $outputt;
    }
    if($end_pos<0&&$start_pos>=0)
    {
       for($i=0;$i<($sizee+$end_pos);$i++)
       {
          $outputt[$i] =$inputt[$start_pos+$i];
       }
       return $outputt;
    }
    if(($end_pos<0)&&($start_pos<0))
    {
       for($i=0;$i<(-1*$start_pos+$end_pos);$i++)
       {
          $outputt[$i] =$inputt[($sizee+$start_pos)+$i];
       }
       return $outputt;
    }
}
global proc string[] BOver9_0_2edf2909df70a7e657b4b646868a0b9c()
{
	$selection=`ls-l-sl`;
	string  $childrens[];
	string  $childrens_last_hierarhy[];
	string  $childrens_all[];
	string  $childrens_all1[];
	for($obj in $selection)
	{
		$childrens=`listRelatives -f -c -typ "joint" $obj`;
		appendStringArray ($childrens_all,$childrens,size($childrens));
	}
	$childrens_all1=stringArrayRemove ( $selection,$childrens_all);
	return $childrens_all1;
}
global proc BOver9_0_c6ebe74a412a2810e00a55e90c1354fb(string $name_of_plugin)
{
    $maya_path=`getenv MAYA_LOCATION`;
    $path_to_plugin=$maya_path + "/bin/plug-ins/" + $name_of_plugin;
    catch(`loadPlugin -qt $path_to_plugin`);
