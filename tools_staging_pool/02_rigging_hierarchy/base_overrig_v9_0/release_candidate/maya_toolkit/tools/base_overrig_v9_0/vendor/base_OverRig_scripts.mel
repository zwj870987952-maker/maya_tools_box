global proc string[] BOver9_0_5e702211108f11813c411c94f8b1b380( string $transfrm )
{
   string $shapes[];
   $shapes[0] = $transfrm;
   if ( "transform" == `nodeType $transfrm` )
		$shapes = `listRelatives -f -shapes $transfrm`;
   return $shapes;
}
global proc string BOver9_0_c954f3ebe8232ef721ae19221935b64e(string $take_name)
{
    $i=0;
    while (`objExists $take_name`)
        $take_name=( $take_name + $i);
   return $take_name;
