	int $index_values[]={ 1, 13, 18, 22 ,14 , 1, 16, 3, 6, 12, 15, 19, 29, 30};
	string $index_val_string="{" + $index_values[0];
	for($i=1; $i<size( $index_values); $i++)
	    $index_val_string =$index_val_string + "," + $index_values[$i];
   $index_val_string =$index_val_string + "}";
	$maxOverrideColors =size ($index_values);
    $formOffset = 0;
    $mainWindow = "coloring";
    $mainLayout = `formLayout -parent $mainWindow`;
    $columns = $maxOverrideColors / 2;
    $rows = 2;
    $cellWidth = 17;
    $cellHeight = 16;
    $colorPalette = `palettePort -dimensions $columns $rows
                                 -transparent 0
                                 -width ($columns * $cellWidth)
                                 -height ($rows * $cellHeight)
                                 -topDown 1
                                 -colorEditable 0`;
    print $colorPalette;
    int $index;
    for ($index = 1; $index < $maxOverrideColors-1;  $index++)
    {
        $colorComponent = `colorIndex -q $index_values[$index]`;
        palettePort -e -rgbValue $index $colorComponent[0] $colorComponent[1] $colorComponent[2] $colorPalette;
    }
    palettePort -e -rgbValue 0 0.6 0.6 0.6 -cc ("BOver9_0_feece4078c8aeb0c08bb278bcaf1bd05(`palettePort -q -setCurCell " + $colorPalette + "`, " + $index_val_string + ")") $colorPalette;
    formLayout -e -attachForm $colorPalette "top" $formOffset $mainLayout;
    formLayout -e -attachForm $colorPalette "left" $formOffset $mainLayout;
    formLayout -e -attachForm $colorPalette "right" $formOffset $mainLayout;
}
