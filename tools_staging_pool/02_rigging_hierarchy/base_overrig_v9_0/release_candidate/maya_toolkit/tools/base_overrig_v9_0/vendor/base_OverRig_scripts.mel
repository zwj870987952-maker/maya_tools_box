}
global proc BOver9_0_9a8d2e62249cad27916aacc736478655()
{
	$obj=`ls-sl`;
	if (size($obj) == 2)
	{
		$Rot = `xform -q -ro -ws $obj[0]`;
		rotate -ws $Rot[0] $Rot[1] $Rot[2] $obj[1];
		rotate -ws $Rot[0] $Rot[1] $Rot[2] $obj[1];
		rotate -ws $Rot[0] $Rot[1] $Rot[2] $obj[1];
	}
	else
	{
		warning "Select 2 object!";
	}
}
global proc BOver9_0_b64d97d04ad365ea1605018f7b2a9dae()
{
	selectPref  -trackSelectionOrder 1;
	optionVar -intValue animBlendingOpt 1;
	optionVar -intValue animBlendBrokenInputOpt 1;
	$mayaVersion = `getApplicationVersionAsFloat` ;
    global string $BARN_eval_mode[];
    if ($mayaVersion>=2019)
    {
		python("from maya.plugin.evaluator.cache_preferences import CachePreferenceEnabled");
		python("CachePreferenceEnabled().set_value( False )");
    }
}
global proc string[] BOver9_0_54d92f8424c4459e6d996d9fd93902f0()
{
	string $selection[];
	$selection = `ls -fl -os`;
