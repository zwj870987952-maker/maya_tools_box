global proc BOver9_0_7b3fcad445e0b73cf535b7be3635a572()
{
    $selected_loc=`ls-sl`;
	float $rx=1;
	float $ry=1;
	float $local_pos[];
	float $local_rot[];
	float $local_rotTmp[];
	float $joint_radius=0.5;
	string $shapes[];
	float $curr_unit=BOver9_0_f71c299bf7b53f7243b078a9990e581c(1);
	for($loc in $selected_loc)
	{
		select-cl;
	   	$shapes1=`listRelatives  -type "shape"  -f  $loc`;
		$color=`getAttr  ($loc + ".overrideColor") `;
		catchQuiet($joint_radius = (`getAttr  ($loc + ".radius")`));
        catchQuiet($local_pos = (`getAttr  ($loc + ".localPosition")`));
		catchQuiet($local_rot = (`getAttr ($shapes1[0] + ".localScale")`)  );
		$local_rotTmp=`sort $local_rot`;
		$cirle=`BOver9_0_ef7d5e5d22a49212f1df955c4a101f3a(($joint_radius + $local_rotTmp[2]) *$curr_unit)`;
		move -a $local_pos[0]  $local_pos[1] $local_pos[2] $cirle;
		delete -ch;
		select $loc $cirle[0];
		$objects=`ls-sl`;
		$shapes=`listRelatives  -type "shape"  -f  $objects[0]`;
		catchQuiet(`setAttr ($shapes[0] + ".visibility") 1`);
		for($i=1;$i<size($objects);$i++)
		{
			$shapes=`listRelatives -shapes  $objects[$i]`;
			delete (`parentConstraint $objects[0] $objects[$i] `);
			parent $objects[$i] $objects[0];
			makeIdentity -apply 1 $objects[$i];
			$j=0;
			for($sh in $shapes)
			{
			    $ren=`rename $sh  ($loc+ "Shape" + $j)`;
			    parent -add  -s $ren $objects[0];
			}
		}
		catchQuiet(`delete $shapes1`);
		delete $objects[1];
		select $objects[0];
		$shapes=`listRelatives  -type "shape"  -f  $objects[0]`;
		catchQuiet(`setAttr -keyable false -channelBox true ($shapes[1] + ".rcurve")`);
		catchQuiet(`setAttr -keyable false -channelBox true  ($shapes[1] + ".cwdth")`);
		catchQuiet(`setAttr -keyable false -channelBox true  ($shapes[1] + ".srate")`);
		catchQuiet(`setAttr -keyable false -channelBox true  ($shapes[1] + ".ai_curve_shaderr")`);
		catchQuiet(`setAttr -keyable false -channelBox true  ($shapes[1] + ".ai_curve_shaderg")`);
		catchQuiet(`setAttr -keyable false -channelBox true  ($shapes[1] + ".ai_curve_shaderb")`);
		catchQuiet(`setAttr -lock false ($shapes[1] + ".overrideColor") $color`);
		select $shapes[0];
		catchQuiet(`select $shapes[1]`);
	}
	select $selected_loc;
}
global proc vector BOver9_0_b2bb441f7665fb6e6f9e58a22cb5e462(string $curve)
{
    BOver9_0_c3face5af2eaef8e548ce10d50587275($curve);
    string $J[]=BOver9_0_54d92f8424c4459e6d996d9fd93902f0();
    BOver9_0_a9acebc46d5277d92e6d954501ac53c7( "x","up", "");
    vector $j_pos[]=BOver9_0_72356eaf232b169651a82383ba9e7e57($J);
    string $L[]=BOver9_0_54d92f8424c4459e6d996d9fd93902f0();
    move -r -os -wd 0 20 0 $L;
    vector $l_pos[]=BOver9_0_72356eaf232b169651a82383ba9e7e57($L);
    float $vec_summ[]={0,0,0};
    vector $vect_summ=<<0,0,0>>;
    float $fl_j_pos[],$fl_l_pos[],$vec[];
    vector $all_y_vectors[];
    for($i=0;$i<size($J);$i++)
    {
        $fl_j_pos=$j_pos[$i];
        $fl_l_pos=$l_pos[$i];
        $vec=BOver9_0_b785f6145105d03029da5b3e19367cbd($fl_j_pos, $fl_l_pos, 1);
        $all_y_vectors[$i]=<<$vec[0],$vec[1],$vec[2]>>;
        $vect_summ= $vect_summ+$all_y_vectors[$i];
    }
    delete $J $L;
    return $vect_summ;
}
global proc float[] BOver9_0_b785f6145105d03029da5b3e19367cbd(float $p1[], float $p2[], int $normalize)
{
  float $v2_1[]={$p2[0]-$p1[0],$p2[1]-$p1[1],$p2[2]-$p1[2]};
  if($normalize)
      normalize ($v2_1);
  return $v2_1;
}
global proc float[] BOver9_0_8aba008b6f6ae60b66a902e6ab3eed1c(string $objects[], float $lenght_coeff, float $distribution_coeff)
{
	if(size($objects)!=3)
    {
        warning "need 3 objects!";
        return {};
    }
	float $fin_coords[];
	float $p1[];
	float $p2[];
	float $p3[];
	$p1 =BOver9_0_8598296823aa3af15686cb0d78f1615d($objects[0]);
	$p2 =BOver9_0_8598296823aa3af15686cb0d78f1615d($objects[1]);
	$p3 =BOver9_0_8598296823aa3af15686cb0d78f1615d($objects[2]);
	$vector=BOver9_0_6f6ae5b84133776f167ce9bbf3409540($p1,$p2,$p3);
	vector $p1_p2=<<$p1[0],$p1[1],$p1[2]>> -<<$p2[0],$p2[1],$p2[2]>>;
	$lenght=(`mag $p1_p2`)*$lenght_coeff;
	float $x=$vector[0]*$lenght + $p2[0]*$distribution_coeff + $p1[0]*(1-$distribution_coeff);
	float $y=$vector[1]*$lenght + $p2[1]*$distribution_coeff + $p1[1]*(1-$distribution_coeff);
	float $z=$vector[2]*$lenght + $p2[2]*$distribution_coeff + $p1[2]*(1-$distribution_coeff);
	$fin_coords={$x,$y,$z};
	return $fin_coords;
}
global proc float BOver9_0_476390711655739e4d4919b7f7336b00(float $pos_A[], float $pos_B[], float $pos_C[])
{
	float $c=BOver9_0_9cf10c253bb06da91bcfe3836a7e5f36($pos_A, $pos_B);
    float $b=BOver9_0_9cf10c253bb06da91bcfe3836a7e5f36($pos_A, $pos_C);
    float $a=BOver9_0_9cf10c253bb06da91bcfe3836a7e5f36($pos_C, $pos_B);
    float $p=($a+$b+$c)/2;
    float  $arg=($p*($p-$a)*($p-$b)*($p-$c));
    if($arg<=0)
        $arg=0;
	float $sqr=sqrt($arg);
    float $H_c=(2*$sqr)/$c;
    return $H_c;
}
global proc float[] BOver9_0_7145e62c24cf62d609b928973d8456c7(float $points[], int $need_sort, int $longest)
{
    float $curr_interval;
    float $found_interval=0;
    float $curr_ind;
    if($need_sort)
        $points=sort($points);
    if(!$longest)
       $found_interval=`maxfloat`;
    for($i=0;$i<(size($points)-1);$i++)
    {
        $curr_interval=abs($points[$i+1] - $points[$i]);
        if($longest)
        {
            if($curr_interval>$found_interval)
            {
                $found_interval= $curr_interval;
                $curr_ind=$i;
            }
        }
        else
        {
            if($curr_interval<$found_interval)
            {
                $found_interval= $curr_interval;
                $curr_ind=$i;
            }
        }
    }
	return  {$curr_ind,$found_interval};
}
global proc string BOver9_0_65107bc37ea4a0d842be293fd78287a9(string $attribname, string $object)
{
    addAttr -ln $attribname -nn $attribname -at long  -dv 0 $object;
    setAttr -e-channelBox true ($object + "." + $attribname);
    return   ($object + "." + $attribname);
}
global proc string BOver9_0_5be180667c9ec255cdbc3827fe30f0f2(string $object, string $node_name_mask)
{
	$connected_nodes=`listConnections -t node $object`;
	string $nodename;
	int $has_connect_to_recalculate=0;
	string $obj;
	for($obj in $connected_nodes)
		{
		   if(`gmatch $obj $node_name_mask`)
		   {
		   $nodename=$obj;
		   $has_connect_to_recalculate=1;
		   }
		}
		return  $nodename;
}
