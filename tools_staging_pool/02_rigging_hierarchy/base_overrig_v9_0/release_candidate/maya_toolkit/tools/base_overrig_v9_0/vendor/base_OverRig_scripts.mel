global proc string BOver9_0_e0b44e5f427a869b704a743cf1d3614c()
{
	$obj=`ls-sl`;
	string $name_of_constrain[];
	$tx_lock=`getAttr -lock ($obj[1] + ".tx")`;
	$ty_lock=`getAttr -lock ($obj[1] + ".ty")`;
	$tz_lock=`getAttr -lock ($obj[1] + ".tz")`;
	$h=$tx_lock+$ty_lock+$tz_lock;
	if ($h<3)
	{
		$skipX= "";
		$skipY= "";
		$skipZ= "";
		if($tx_lock)
			$skipX= " -skip x";
		if($ty_lock)
			$skipY= " -skip y";
		if($tz_lock)
			$skipZ= " -skip z";
		$skipped = $skipX + $skipY + $skipZ;
		string $objects = "";
		for($i=0;$i<size($obj);$i++)
			$objects = $objects + $obj[$i] + " ";
		$name_of_constrain=`eval ("pointConstraint  " + $skipped + " " + $objects)`;
	}
	return  $name_of_constrain[0];
}
global proc string BOver9_0_b142decaa1526dfbc704c277d5c70c28()
{
	string $obj[]=`ls-sl`;
	string $name_of_constrain[];
	float $no_ofset_position[];
	float $base_position[]=BOver9_0_8598296823aa3af15686cb0d78f1615d($obj[size($obj)-1]);
	float $weight_all[]=BOver9_0_9de233870ac6b9c5087a491c3b4ca38a($obj);
	$tx_lock=`getAttr -lock ($obj[size($obj)-1] + ".tx")`;
	$ty_lock=`getAttr -lock ($obj[size($obj)-1] + ".ty")`;
	$tz_lock=`getAttr -lock ($obj[size($obj)-1] + ".tz")`;
	$h=$tx_lock+$ty_lock+$tz_lock;
	if ($h<3)
	{
		$skipX= "";
		$skipY= "";
		$skipZ= "";
		if($tx_lock)
			$skipX= " -skip x";
		if($ty_lock)
			$skipY= " -skip y";
		if($tz_lock)
			$skipZ= " -skip z";
		$skipped = $skipX + $skipY + $skipZ;
		string $objects = "";
		for($i=0;$i<size($obj);$i++)
			$objects = $objects + $obj[$i] + " ";
		$name_of_constrain=`eval ("pointConstraint  " + $skipped + " " + $objects)`;
		for($i=0;$i<(size($obj)-1);$i++)
		{
			$attr_name=`listAttr -string ("*W" + $i) $name_of_constrain[0]`;
			catch (`setAttr ($name_of_constrain[0] + "." +  $attr_name[0]) $weight_all[$i]`);
		}
		$no_ofset_position=BOver9_0_8598296823aa3af15686cb0d78f1615d($obj[size($obj)-1]);
		float $ofset[]={$base_position[0]-$no_ofset_position[0],$base_position[1]-$no_ofset_position[1],$base_position[2]-$no_ofset_position[2]};
		setAttr ($name_of_constrain[0] + ".offsetX") $ofset[0];
		setAttr ($name_of_constrain[0] + ".offsetY") $ofset[1];
		setAttr ($name_of_constrain[0] + ".offsetZ") $ofset[2];
	}
	return $name_of_constrain[0];
}
global proc float[] BOver9_0_9713c7abe7f317a1eaefb22b30d9ce1c()
{
	string $obj[]=`ls-sl`;
	float $distance[];
	float $pos1[];
	float $pos2[];
	if(size($obj)<2)
	{
		warning "Select 2 object!";
		return $pos1;
	}
	else
	{
		$pos1=`xform -q  -ws -piv $obj[0]`;
		$pos2=`xform -q  -ws -piv $obj[1]`;
		for($i=0;$i<3;$i++)
			$distance[$i]=$pos1[$i]-$pos2[$i];
	}
	if (size($obj) == 2)
	{
		move -rpr $pos1[0] $pos1[1] $pos1[2] $obj[1];
		move -rpr $pos1[0] $pos1[1] $pos1[2] $obj[1];
		move -rpr $pos1[0] $pos1[1] $pos1[2] $obj[1];
		return $pos1;
	}
	if (size($obj) > 2)
	{
		$range=size($obj)-1;
		$x=$distance[0]/$range;
		$y=$distance[1]/$range;
		$z=$distance[2]/$range;
		for($i=2;$i<size($obj);$i++)
		{
		   move -rpr ($pos1[0] - $x*($i-1)) ($pos1[1] - $y*($i-1)) ($pos1[2] - $z*($i-1)) $obj[$i];
		   move -rpr ($pos1[0] - $x*($i-1)) ($pos1[1] - $y*($i-1)) ($pos1[2] - $z*($i-1)) $obj[$i];
		   move -rpr ($pos1[0] - $x*($i-1)) ($pos1[1] - $y*($i-1)) ($pos1[2] - $z*($i-1)) $obj[$i];
		}
		return $pos1;
	}
}
global proc BOver9_0_41b4e3b470ec48427b6ebd4f09a607e7()
{
	string $objs[] = `ls-sl`;
	for($obj in $objs)
