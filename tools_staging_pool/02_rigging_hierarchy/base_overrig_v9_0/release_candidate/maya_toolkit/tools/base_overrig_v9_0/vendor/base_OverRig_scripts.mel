global proc string BOver9_0_3ed0416e2547f09f133c132ecd5ccd97()
{
	string $obj[]=`ls-sl`;
	int $num_obj=size($obj);
	string $ret_name;
	string $name_of_constrain[];
	$weight_all=BOver9_0_9de233870ac6b9c5087a491c3b4ca38a($obj);
