	if(`window -q -ex "anim_to_easy_spine_system_rig"`)deleteUI("anim_to_easy_spine_system_rig");
	window -minimizeButton false -sizeable 1 -title "anim to Easy Spine system rig" -maximizeButton false -height 45 -width 310 -toolbox true -titleBar true -menuBar true "anim_to_easy_spine_system_rig";
        frameLayout
