global proc move_and_rotate_total_pivot(int $avg_point)
{
	undoInfo -ock -cn "move_and_rotate_total_pivot";
	global float $m_AIM_selectedTime[];
	global string $m_Piv_selection[];
	global string $m_Piv_locks[];
	global string $m_Piv_name_constraints[];
	global string $m_Piv_temp_gr_name;
	global string $m_Piv_groups[];
	global int $m_Piv_mode;
	string $axis;
	$m_Piv_mode=0;
	$m_AIM_selectedTime=BOver9_0_dfc2513778a513e560ec81c8f3df6563();
	if(($m_AIM_selectedTime[0]!=$m_AIM_selectedTime[1]-1)||(size($m_Piv_selection)>1))
		$m_Piv_mode=1;
	$m_Piv_selection=`ls-sl`;
	vector $average_point=BOver9_0_e3bea614176fbceebe7c7aae67e953b0(BOver9_0_72356eaf232b169651a82383ba9e7e57($m_Piv_selection));
	if ($avg_point==0)
		select $m_Piv_selection[size($m_Piv_selection)-1];
	if ($avg_point!=0)
		select $m_Piv_selection[0];
	$m_Piv_locks = BOver9_0_54d92f8424c4459e6d996d9fd93902f0();
	if ($avg_point==1)
	{
		move -a -ws ($average_point.x) ($average_point.y) ($average_point.z) $m_Piv_locks[0];
		rotate -ws 0 0 0 $m_Piv_locks[0];
	}
	if ($avg_point==3)
	{
		$axis=`upAxis -q -ax`;
		if ($axis=="z")
			move -a -ws ($average_point.x) ($average_point.y) 0 $m_Piv_locks[0];
		else
			move -a -ws ($average_point.x) 0 ($average_point.z) $m_Piv_locks[0];
		rotate -ws 0 0 0 $m_Piv_locks[0];
	}
	if ($avg_point==4)
	{
		move -a -ws 0 0 0 $m_Piv_locks[0];
		rotate -ws 0 0 0 $m_Piv_locks[0];
	}
	scriptJob -ro 1 -cf "SomethingSelected" "BOver9_0_2082990dda026469945596942b8ed225";
	inViewMessage -smg "move pivot in place and deselect" -pos topRight -bkc 0x00000000 -fade  -dk  ;
	manipMoveContext -edit -mode 0 Move;
	setToolTo moveSuperContext;
}
