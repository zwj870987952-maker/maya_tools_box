global proc string[] BOver9_0_32a3829df17c3736d9757e423eeaf0e3 (string $target[], string $object[])
{
    if(size($target)!=size($object))
		warning "size parent massives is DIFFERENT!!! Only relevant objects will be processed! This can lead to unexpected consequences!!!!";
	if(size($target)> size($object))
		$target=`ls -head (size($object)) $target`;
    string $curr_objs[];
    string $fin_objs[];
	string $uid_objs[]=`ls -uuid $object`;
	string $uid_targts[]=`ls -uuid $target`;
    for($i=0;$i<size($target);$i++)
    {
        $curr_objs=`ls -uuid {$uid_objs[$i],$uid_targts[$i]}`;
        catchQuiet (`parent $curr_objs[0] $curr_objs[1]`);
    }
    $fin_objs=`ls -uuid $uid_objs`;
	select -cl;
	select $fin_objs;
	return $fin_objs;
}
global proc BOver9_0_70e1c4b7692160ed48aa4962be320af3 (string $joints[], int $lock_status)
{
    string $obj;
    for($obj in $joints)
    {
        catchQuiet (`setAttr -l $lock_status ($obj + ".jointOrientX")`);
        catchQuiet (`setAttr -l $lock_status ($obj + ".jointOrientY")`);
        catchQuiet (`setAttr -l $lock_status ($obj + ".jointOrientZ")`);
    }
}
global proc string[] BOver9_0_e706e982298fe9e8f94ae04b06b5d6b2(string $prefix)
{
    string $uuids[],$uid;
    string $curr_obj[], $fin_obj[];
    $uuids=`ls  -uuid-sl`;
    for($uid in $uuids)
    {
        $curr_obj=`ls -uuid $uid`;
        rename $curr_obj[0] ($prefix  + "#");
    }
    select -cl;
    $fin_obj=`ls -uuid $uuids`;
    select $fin_obj;
    return $fin_obj;
}
global proc string [] BOver9_0_c9088e941b7677113499bb19ad80f9bf (string $prefix, string $name_massive[])
{
    string $uuids[];
    string $curr_obj[],$short_name_curr,$short_name,$namesps,$new_names[];
    $uuids=`ls  -uuid-sl`;
	for($i=0;$i<size($uuids);$i++)
	{
	    $namesps = `match "^.*:"  $name_massive[$i]`;
	    $short_name = `match "[^/\:]*$" $name_massive[$i]`;
		$fin_name=BOver9_0_c954f3ebe8232ef721ae19221935b64e( $namesps   + $prefix + $short_name);
		$curr_obj=`ls  -l -uuid $uuids[$i]`;
		$short_name_curr= `match "[^|\\]*$"$curr_obj[0]`;
		rename $curr_obj[0] $fin_name;
	}
	select -cl;
    $new_names=`ls -uuid $uuids`;
    select $new_names;
	return $new_names;
}
global proc string [] BOver9_0_10b1c67feba7e9570357d44ba9306692 (string $prefix, string $name_massive[],string $postfix)
{
    string $uuids[];
    string $curr_obj[], $fin_obj[],$short_name_curr;
    $uuids=`ls  -uuid-sl`;
	for($i=0;$i<size($uuids);$i++)
	{
	    $namesps = `match "^.*:"  $name_massive[$i]`;
	    $short_name = `match "[^/\:]*$" $name_massive[$i]`;
		$fin_name=BOver9_0_c954f3ebe8232ef721ae19221935b64e( $namesps   + $prefix + $short_name + $postfix + "#");
		$curr_obj=`ls  -l -uuid $uuids[$i]`;
		$short_name_curr= `match "[^|\\]*$"$curr_obj[0]`;
		rename $curr_obj[0] $fin_name;
	}
	select -cl;
    $new_names=`ls -uuid $uuids`;
    select $new_names;
	return $new_names;
}
