global proc bar_create_multiply_fast_motion_trail(int $start, int $end, int $static)
{
    string $selected[]=`ls-sl`;
	if($start + $end !=0)
		if (!$static)
		{
			optionVar -intValue "bar_mt_START_val" $start;
			optionVar -intValue "bar_mt_END_val" $end;
		}
	global string $global_mt_name_last_created[];
	$global_mt_name_last_created={};
	global string $global_mt_name;
    for($obj in $selected)
    {
        select $obj;
        if( objExists($obj + "*_motionTrailHandle")==0)
			BOver9_0_5af02f105b3c73a5596102329399dcb1($static);
		else
			if($start + $end !=0)
			{
				delete ($obj + "*_motionTrailHandle");
				BOver9_0_5af02f105b3c73a5596102329399dcb1($static);
			}
		appendStringArray($global_mt_name_last_created, {$global_mt_name},1);
    }
    select $selected;
}
global proc BOver9_0_cab45c22668192720cf5bc40a90b9717()
{
    global string $global_mt_name_last_created[];
	$global_mt_name_last_created={};
	string $mTrails[]= `ls "*EGR*_motionTrailHandle" "*:*EGR*_motionTrailHandle"`;
    delete $mTrails;
}
global proc BOver9_0_8acbdd90e1a397ed24eb3b1674ab9209(int $thikness, float $dot, float $dotColor[])
{
        if(!$dot)
            $dot=0.1;
        global string $global_mt_name_last_created[];
        if($thikness>=1)
        {
            optionVar -intValue   "bar_trailThickness" $thikness;
            for($obj in $global_mt_name_last_created)
                setAttr ($obj + ".trailThickness") $thikness;
        }
        if($dot>=0)
        {
            optionVar -floatValue   "bar_trailDotsize" $dot;
            for($obj in $global_mt_name_last_created)
                setAttr ($obj + ".keyframeSize") $dot;
        }
        if($dotColor[0]>=0)
        {
            optionVar -stringValue   "bar_mt_DOT_colors" ($dotColor[0] + " " + $dotColor[1] + " " + $dotColor[2]);
            for($obj in $global_mt_name_last_created)
                setAttr ($obj + ".keyframeColor") -type double3 $dotColor[0] $dotColor[1] $dotColor[2];
        }
}
global proc BOver9_0_90caf8375dffdf325df3be666537a016()
{
	string $selection[]=`ls-sl`;
	if(size($selection))
	{
		if(`objExists ANIMATION`)
		{
				if((`objectType ANIMATION`== "objectSet"))
				{
					rename "ANIMATION" "ANIMATION1";
					sets -name ANIMATION;
				}
				else
				{
					sets -name CAUTION_WRONG_NAME_SET;
					warning "In scene exists obj with name ANIMATION!!!!!!!";
				}
		}
		else
			sets -name ANIMATION;
	}
	else
		warning "select somebody";
}
global proc double_inv_oscillate_or_mirror(float $period, string $t_axis, string $r_axis)
{
	float $t=`currentTime -q`;
	if(size(`ls-sl`)==0)
	{
	    print "nothing selected!";
	    return;
	}
	float $keysel[] = `keyframe -q -sl`;
    if(size($keysel)>0)
        BOver9_0_09bdb78af23637cc0a3c8a88a1e6ab24($t_axis,  $r_axis);
    else
        BOver9_0_a37a85a658eebae4bd5ae354ec083baa($period,  $t_axis,  $r_axis);
}
global proc Lag_Key(float $sdvig)
{
	$selection=`ls-sl`;
	string $crvs[];
	$crvs = `keyframe -q -n -sl`;
	$select_keys_or_now=!($crvs[0]=="");
	if ($select_keys_or_now)
	{
		$all_curves_and_frames = BOver9_0_a01af7626635f090f4162490a6d9507d($crvs);
		int $curr_obj_number;
		string $all_curves_and_frames_new[];
		clear $all_curves_and_frames_new;
		float $tmp[];
		string $tmp_string [];
		float $temp_name_fr[];
		for($i=0; $i<size($crvs); $i++)
		{
			int $number = BOver9_0_2d92805242e50041994bf7f653f4e114($selection,$crvs[$i]);
			eval("selectKey -k " + $all_curves_and_frames[$i] + " " + $crvs[$i]);
			keyframe -e -iub true -r -o over -tc (($sdvig*$number));
			clear $temp_name_fr;
			$temp_name_fr = `keyframe -q`;
			$temp_param = "";
			for($j=0; $j<size($temp_name_fr); $j++)
			{
				$temp_param = $temp_param + "-t " + $temp_name_fr[$j] + " ";
			}
			$all_curves_and_frames_new[$i] = $temp_param;
		}
		for($i=0; $i<size($crvs); $i++)
		{
			eval ("selectKey -add -k" + $all_curves_and_frames_new[$i] + " " + $crvs[$i]);
		}
		clear $all_curves_and_frames;
		clear $all_curves_and_frames_new;
	}
	else
	{
		for($i=0;$i<size($selection);$i++)
		{
			keyframe -e -iub true -r -o over -tc (($sdvig*$i)) $selection[$i];
		}
	}
}
global proc BOver9_0_3676fd34198e455bb82f6106192bc927(int $frame_count, int $uniform)
{
    string $curves[]=`keyframe -q -n -sl`;int $deln;
    if(size($curves)==0)
        return;
    if(!$uniform)
        for($cu in $curves)
        {
            $cu_time=`keyframe -q -sl $cu`;
            floatArrayRemoveAtIndex(0, $cu_time);
            floatArrayRemoveAtIndex(size($cu_time)-1, $cu_time);
            for($i=0;$i<$frame_count;$i++)
            {
                if(size($cu_time)>0)
                {
                    $deln=floor (  rand (size($cu_time) ));
                    if($deln>=0)
                    {
                        $framedd=$cu_time[$deln];
                        cutKey  -t $framedd $cu;
                        floatArrayRemoveAtIndex($deln, $cu_time);
                    }
                }
            }
        }
    else
        {
           $cu_time=`keyframe -q -sl $curves[0]`;
            floatArrayRemoveAtIndex(0, $cu_time);
            floatArrayRemoveAtIndex(size($cu_time)-1, $cu_time);
            for($i=0;$i<$frame_count;$i++)
            {
                if(size($cu_time)>0)
                {
                    $deln=floor (  rand (size($cu_time) ));
                    if($deln>=0)
                    {
                        $framedd=$cu_time[$deln];
                        cutKey  -t $framedd $curves;
                        floatArrayRemoveAtIndex($deln, $cu_time);
                    }
                }
            }
        }
}
global proc float[] BOver9_0_cba6da1b519f7600c71b7de0d52d2c3e()
{
	float $num_frame[] = `keyframe -q  -sl`;
	$num_frame=`sort  $num_frame`;
	if(size($num_frame)==0)
	{
		warning "no interval selected" ;
		return {0,-1};
	}
	return {$num_frame[0], $num_frame[size($num_frame)-1]};
}
global proc BOver9_0_7bd26c8b37f4670d39bdb4c4c27816c3(float $scale_size, int $num_frames, int $uniform)
{
	$curve=`keyframe -q -sl -n`;
	float $range[]=BOver9_0_cba6da1b519f7600c71b7de0d52d2c3e();
	float $min_time=$range[0];
	float $max_time=$range[1];
	float $rand_frame[],$rand_base;
	float $rand_value[];
	float $selected_range=$max_time - $min_time;
	float $step_for_random=$selected_range/$num_frames;
	int $i=1;
	if ($min_time<$max_time)
	{
		if(!$uniform)
    		for ($f=0;$f<size($curve);$f++)
    		{
    			$rand_base= $min_time;
    			$prev_rand_base=$min_time;
    			for($i=0;$i<$num_frames;$i++)
    				{
    					$rand_frame[$i]=BOver9_0_b970808d076db3299a05dc858ee1a1e0(($rand_base), ($rand_base+$step_for_random), $curve[$f]);
    					$rand_base=$rand_base+$step_for_random;
    					$rand_value[$i]=(`rand -1 1`)*$scale_size;
    					$prev_rand_base=$rand_base;
    				}
    				for($i=0;$i<$num_frames;$i++)
    					    setKeyframe -id -dd true -t $rand_frame[$i]  $curve[$f];
    				for($i=0;$i<$num_frames;$i++)
    					    keyframe -e -iub true -r -t $rand_frame[$i] -o over -vc $rand_value[$i] $curve[$f];
    		}
    	else
    	    {
    	        $rand_base= $min_time;
    			$prev_rand_base=$min_time;
    			for($i=0;$i<$num_frames;$i++)
    				{
    					$rand_frame[$i]=BOver9_0_b970808d076db3299a05dc858ee1a1e0(($rand_base), ($rand_base+$step_for_random), $curve[0]);
    					$rand_base=$rand_base+$step_for_random;
    					$rand_value[$i]=(`rand -1 1`)*$scale_size;
    					$prev_rand_base=$rand_base;
    				}
    				for($i=0;$i<$num_frames;$i++)
    					    setKeyframe -id -dd true -t $rand_frame[$i]  $curve;
    				for($i=0;$i<$num_frames;$i++)
    					    keyframe -e -iub true -r -t $rand_frame[$i] -o over -vc $rand_value[$i] $curve;
    	    }
		selectKey -r -t ($min_time + ":" + $max_time)  $curve;
		keyTangent -itt spline -ott spline;
	}
}
global proc set_key_time_range(string $mode)
{
	if((size(`ls-sl`))==0)
	{
		warning "nothing selected";
		return;
	}
	int $mayaver24=0;
    float $mayaVersion = `getApplicationVersionAsFloat` ;
	string $patch_ver;
	float $patch_ver_fl;
    if ($mayaVersion==2024)
	{
		$patch_ver=`about  -minorVersion`;
		$patch_ver_fl=$patch_ver;
		if($patch_ver_fl<2)
			$mayaver24=1;
	}
	$cur_time = `currentTime -q`;
	global string $gPlayBackSlider;
	float $selectedTime[]=`timeControl -q -ra $gPlayBackSlider`;
	float $end_of_range=$selectedTime[1]-1;
	float $start_of_range=$selectedTime[0];
	float $range=$end_of_range - $start_of_range;
	if($range==0)
		{
		currentTime -update false (`currentTime -q`);
	    if($mode=="all")
            setKeyframe -breakdown 0 -hierarchy none -controlPoints 0 -shape 0;
        if($mode=="translate")
            setKeyframe -at translate;
        if($mode=="rotate")
            setKeyframe -at rotate;
        if($mode=="scale")
            setKeyframe -at scale;
        if($mode=="channelbox")
            channelBoxCommand -key;
        }
        else
        {
        	if($mayaver24==0)
        		if($cur_time>=$end_of_range)
        			currentTime  $start_of_range;
        		else
        			currentTime $end_of_range;
        	refresh -su 1;
            for($i=0; $i<=$range; $i++)
            {
                currentTime -update false ($start_of_range + $i);
                if($mode=="all")
                    setKeyframe -breakdown 0 -hierarchy none -controlPoints 0 -shape 0;
                if($mode=="translate")
                    setKeyframe -at translate;
                if($mode=="rotate")
                    setKeyframe -at rotate;
                if($mode=="scale")
                    setKeyframe -at scale;
                if($mode=="channelbox")
                    channelBoxCommand -key;
            }
        	currentTime $cur_time;
        	refresh -su 0;
	}
}
global proc float[] BOver9_0_8658db3767d3086054bf3959e3ff6b41()
{
    global string $gPlayBackSlider;
    float $selectedTime[]=`timeControl -q -ra $gPlayBackSlider`;
    $selectedTime[1]= $selectedTime[1] - 1;
    if($selectedTime[1]-$selectedTime[0]==0)
    {
        $selectedTime[0]=`playbackOptions -q -ast`;
        $selectedTime[1]=`playbackOptions -q -aet`;
    }
    return $selectedTime;
}
global proc float[] BOver9_0_dfc2513778a513e560ec81c8f3df6563()
{
	global string $gPlayBackSlider;
	float $selectedTime[]=`timeControl -q -ra $gPlayBackSlider`;
	string $curve[] = `keyframe -q -n -sl`;
	if((($selectedTime[1]-$selectedTime[0])<=1)&&($curve[0]==""))
	{
	}
	else if((($selectedTime[1]-$selectedTime[0])<=1)&&($curve[0]!=""))
	{
		$selectedTime=BOver9_0_cba6da1b519f7600c71b7de0d52d2c3e();
		$selectedTime[1]=ceil($selectedTime[1]+1);
	}
	return $selectedTime;
}
global proc offset_keys_by_period(float $period)
{
    float $f_min=`playbackOptions -q -min`;
    float $f_max=`playbackOptions -q -max`;
    float $f_av=($f_max-$f_min)*(1/$period);
    keyframe -e -iub true -r -o over -tc $f_av;
}
global proc double_oscillate_keys(float $period)
{
	float $t=`currentTime -q`;
	if(size(`ls-sl`)==0)
	{
	    warning "nothing selected!";
	    return;
	}
	refresh -su 1;
	float $f_min=`playbackOptions -q -min`;
	float $f_max=`playbackOptions -q -max`;
	float $f_av=($f_max-$f_min)*(1/$period);
	setKeyframe -breakdown 0 -t $t -hierarchy none -controlPoints 0 -shape 0 -itt flat -ott flat;
	float $second_keyTime=$t+$f_av;
	if($second_keyTime>$f_max)
	    $second_keyTime=$t-$f_av;
	currentTime($second_keyTime);
	setKeyframe -breakdown 0  -t  $second_keyTime -hierarchy none -controlPoints 0 -shape 0 -itt flat -ott flat;
	currentTime $t;
	refresh -su 0;
	animCurveEditor -edit -displayInfinities 1 graphEditor1GraphEd;
	setInfinity -pri oscillate -poi oscillate;
}
global proc BOver9_0_a37a85a658eebae4bd5ae354ec083baa(float $period, string $t_axis, string $r_axis)
{
	float $t=`currentTime -q`;
	$t_axis=capitalizeString($t_axis);
	$r_axis=capitalizeString($r_axis);
	refresh -su 1;
	float $f_min=`playbackOptions -q -min`;
	float $f_max=`playbackOptions -q -max`;
	float $f_av=($f_max-$f_min)*(1/$period);
	setKeyframe -breakdown 0 -t $t -hierarchy none -controlPoints 0 -shape 0 -itt flat -ott flat;
	selectKey -clear;
    copyKey -time $t;
	float $second_keyTime=$t+$f_av;
	if($second_keyTime>$f_max)
	    $second_keyTime=$t-$f_av;
	currentTime($second_keyTime);
	pasteKey -t $second_keyTime;
	setKeyframe -breakdown 0  -t  $second_keyTime -hierarchy none -controlPoints 0 -shape 0 -itt flat -ott flat;
	currentTime $t;
	refresh -su 0;
	animCurveEditor -edit -displayInfinities 1 graphEditor1GraphEd;
	string $cmd="scaleKey  -vs -1 -vp 0 ";
    if($t_axis=="X")
        $cmd=$cmd  + "-at \"tx\" ";
    if($t_axis=="Y")
        $cmd=$cmd  + "-at \"ty\" ";
    if($t_axis=="Z")
        $cmd=$cmd  + "-at \"tz\" ";
    if($r_axis=="X")
        $cmd=$cmd  + "-at \"rz\" -at \"ry\"";
    if($r_axis=="Y")
        $cmd=$cmd  + "-at \"rx\" -at \"rz\"";
    if($r_axis=="Z")
        $cmd=$cmd  + "-at \"rx\" -at \"ry\"";
    $cmd=$cmd  + " -t " + $second_keyTime;
    eval($cmd);
	setInfinity -pri oscillate -poi oscillate;
}
global proc float[] selKeys_by_timerange()
{
    float $selectedTime[]=BOver9_0_dfc2513778a513e560ec81c8f3df6563();
	selectKey -clear;
    selectKey  -t ($selectedTime[0]+":"+ ($selectedTime[1]-1));
    return $selectedTime;
}
global proc set_currenttime_to_mid_selection()
{
    float $tim_rng[]=BOver9_0_dfc2513778a513e560ec81c8f3df6563();
    int $frame=($tim_rng[1]-$tim_rng[0])/2 + $tim_rng[0];
    currentTime $frame;
}
global proc time_slider_range(float $defoult_range)
{
	float $g_selectedTimeSliderRange[];
	$g_selectedTimeSliderRange=BOver9_0_dfc2513778a513e560ec81c8f3df6563();
	$cur_time = `currentTime -q`;
	$min_anim_range= `playbackOptions -q -ast`;
	$max_anim_range= `playbackOptions -q -aet`;
	global float $g_prev_range_TimeSlider;
	global float $g_first_time_TimeSlider;
	global int $g_pereshelk_TimeSlider;
	if($g_first_time_TimeSlider == 0)
	{
		$g_prev_range_TimeSlider = $defoult_range;
		$g_first_time_TimeSlider=1;
	}
	if($g_first_time_TimeSlider == 1)
	{
		if ($g_pereshelk_TimeSlider == 0)
		{
			$k = $g_selectedTimeSliderRange[1] - $g_selectedTimeSliderRange[0];
			if ($k == 1)
			{
				$popolam = floor ($g_prev_range_TimeSlider/2);
				$num_L_kray = $cur_time-$popolam;
				$num_R_kray = $cur_time+$popolam;
				if ($num_L_kray < $min_anim_range)
				{
					$set_min_range=$min_anim_range;
					$set_max_range=$min_anim_range+$g_prev_range_TimeSlider;
					playbackOptions -min $set_min_range -max $set_max_range;
					animView -st  ($set_min_range - $g_prev_range_TimeSlider/10.0)  -et ($set_max_range +  $g_prev_range_TimeSlider/10.0) graphEditor1GraphEd;
				}else
					if ($num_R_kray > $max_anim_range)
					{
						$set_min_range=$max_anim_range-$g_prev_range_TimeSlider;
						$set_max_range=$max_anim_range;
						playbackOptions -min $set_min_range -max $set_max_range;
						animView -st  ($set_min_range - $g_prev_range_TimeSlider/10.0)  -et ($set_max_range +  $g_prev_range_TimeSlider/10.0) graphEditor1GraphEd;
					}
				else
				{
					$set_min_range=$cur_time-$popolam;
					$set_max_range=$cur_time+$popolam;
					playbackOptions -min $set_min_range -max $set_max_range;
					animView -st  ($set_min_range - $g_prev_range_TimeSlider/10.0)  -et ($set_max_range +  $g_prev_range_TimeSlider/10.0) graphEditor1GraphEd;
				}
			}
			if ($k > 1)
			{
				$g_prev_range_TimeSlider = $k;
				$set_min_range=$g_selectedTimeSliderRange[0];
				$set_max_range=$g_selectedTimeSliderRange[1]-1;
				playbackOptions -min $set_min_range -max $set_max_range;
				animView -st  ($set_min_range - $g_prev_range_TimeSlider/10.0)  -et ($set_max_range +  $g_prev_range_TimeSlider/10.0) graphEditor1GraphEd;
			}
			$g_pereshelk_TimeSlider=1;
		}
	else
		if ($g_pereshelk_TimeSlider == 1)
		{
			playbackOptions -min $min_anim_range -max $max_anim_range;
			animView -st  ($min_anim_range - $g_prev_range_TimeSlider/10.0)  -et ($max_anim_range +  $g_prev_range_TimeSlider/10.0) graphEditor1GraphEd;
			$g_pereshelk_TimeSlider=0;
		}
	}
}
global proc string[] delete_keys_from_selected_or_timeslider()
{
    float $keys_for_delete[] = `keyframe -q -sl`;
    string $fr_deleted[];
    global string $gPlayBackSlider;
    float $selectedTime[]=`timeControl -q -ra $gPlayBackSlider`;
    $fr_deleted[0]=$selectedTime[0] + ":" + ($selectedTime[1]-1);
    if( $selectedTime[1]- $selectedTime[0]>1)
    	timeSliderClearKey;
    else if ($selectedTime[1]-$selectedTime[0]==1 && size($keys_for_delete)==0)
        timeSliderClearKey;
	else
		$fr_deleted=BOver9_0_dc0d813b43709134eff71f1ddbf39eae();
	return $fr_deleted;
}
global proc set_start_end_key()
{
    refresh -su 1;
	float $t=`currentTime -q`;
	float $f_min=`playbackOptions -q -min`;
	float $f_max=`playbackOptions -q -max`;
	currentTime($f_min);
	setKeyframe -breakdown 0 -hierarchy none -controlPoints 0 -shape 0;
	currentTime($f_max);
	setKeyframe -breakdown 0 -hierarchy none -controlPoints 0 -shape 0;
	currentTime $t;
	refresh -su 0;
}
global proc copy_start_frame_to_end()
{
    float $t=`currentTime -q`;
    float $f_min=`playbackOptions -q -min`;
    float $f_max=`playbackOptions -q -max`;
    currentTime($f_min);
    setKeyframe -breakdown 0 -hierarchy none -controlPoints 0 -shape 0;
    currentTime -update false ($f_max);
    setKeyframe -breakdown 0 -hierarchy none -controlPoints 0 -shape 0;
    currentTime $t;
}
global proc float[] barn_copy_keys()
{
    string $crvs[] = `keyframe -q -n`;
    global float $barn_copied_curve_range[];
    $barn_copied_curve_range = `keyframe -q  -sl $crvs`;
    if (size($crvs)!=1)
    {
        warning "select keyframes on single animCurve!";
        return {};
    }
    copyKey -option curve;
    return  $barn_copied_curve_range;
}
global proc barn_past_scaled_keys()
{
    global float $barn_copied_curve_range[];
    string $crvs[] = `keyframe -q -n`;
    float $num_frame[];
    int $num;
    for($crv in $crvs)
    {
        $num_frame = `keyframe -q -sl $crv`;
        $num=size($num_frame)-1;
        if($num!=0)
            pasteKey -time ($num_frame[0] + ":" + $num_frame[$num]) -option scaleReplace -copies 1 -connect 1 -timeOffset 0 -floatOffset 0  $crv;
        else
            pasteKey -time ($num_frame[0] + ":" + ($num_frame[0]- $barn_copied_curve_range[0] + $barn_copied_curve_range[size($barn_copied_curve_range)-1] )) -option scaleReplace -connect 1 -copies 1 -timeOffset 0  -floatOffset 0 $crv;
    }
}
global proc BOver9_0_fc9a5a809318602860f6fb1135723ed7(string $rOrder_str)
{
	string $selection[]=`ls-sl`;
	int $rOrder;
	switch ($rOrder_str)
	{
	    case "xyz" :
	        $rOrder = 0;
	        break;
	    case "yzx" :
	        $rOrder = 1;
	        break;
	    case "zxy" :
	        $rOrder = 2;
	        break;
	    case "xzy" :
	        $rOrder = 3;
	        break;
	    case "yxz" :
	        $rOrder = 4;
	        break;
	    case "zyx" :
	        $rOrder = 5;
	        break;
	}
	float $all_keytime[]=`keyframe -at rotate  -query $selection`;
	int $no_key;
	float $time_pref[],$curr_time;
	$curr_time=`currentTime -q`;
	if(`size($all_keytime)`==0)
	{
		setKeyframe -attribute rotate $selection;
		$no_key=1;
		$all_keytime={$curr_time};
	}
	$all_keytime=sort($all_keytime);
	$time_pref=BOver9_0_9bcfe87821f81f923d9a4d502efb9945();
	playbackOptions -ast  $all_keytime[0];
	playbackOptions -aet  $all_keytime[size( $all_keytime)-1];
	string $lock[]=BOver9_0_43aae6ab29019a62e5f1055f1a9e5d1f();
	float $is_frame[];
	BOver9_0_d04a25c84de52f4787d68215d32315e0($rOrder, $selection);
	for($fr in $all_keytime)
	{
		currentTime $fr;
		for($obj in $selection)
		{
			$is_frame=`keyframe -at rotate -t $fr -query  $obj`;
			if(`size($is_frame)`!=0)
				setKeyframe -attribute rotate -t $fr $obj;
		}
	}
	delete $lock;
	BOver9_0_d9f7ba947826f7f00ce2215bc1417109($time_pref);
	currentTime $curr_time;
	select $selection;
}
global proc overRig_tween_window()
{
    if(`window -q -ex "tween_window"`)deleteUI("tween_window");
    window
		-title " key tween, key overshoot or curve push"
		-tb true
		-h 45
		-w 600
		-s 0
		-mnb false -mxb false -mb false -tlb true
		-bgc 0.8 0.9 1.0
		-tbm true "tween_window";
    global int $bar_tween_val_UI_posiiton;
	columnLayout  -adjustableColumn true  -ann "use for aniomation objects" base_column;
			rowLayout -p "base_column" -cw 1 190  -cw 2 204  -adj 2 -nc 4 arrange_item;
			    text -en 0 -w 90
					-ann "owershoot to left frame"
					-p "arrange_item" -l "overshoot<<<";
			    rowLayout -p "arrange_item"
					-ann "tween range"
					-cw 1 98  -cw 2 70  -cw 3 90 -w 200   -nc 3 ;
    			    button -w 20
    			        -bgc 0.8 1 0.8
						-ann "tween to left frame, or hard push curve"
    			        -l "<"
    			        -c "intSlider -e -v 0 slidder_tween_my; floatField -e -v 0  tween_slider_field; BOver9_0_d18150d077ed5b67c6812087cb8711c2((`intSlider -q -v slidder_tween_my`)/100.0, 0.2);";
                    floatField    -nbg 1 -ed 0 -ebg 0  -v 50 -w 46  -precision 0
    				    -cc "intSlider -e  -v (`floatField -q -v tween_slider_field`) slidder_tween_my"
    				    tween_slider_field;
    				button -w 20
						-ann "tween to right frame, or hard push curve"
    			        -bgc 0.8 1 0.8
    			        -l ">"
				        -c "intSlider -e -v 100 slidder_tween_my; floatField -e -v 100  tween_slider_field; BOver9_0_d18150d077ed5b67c6812087cb8711c2((`intSlider -q -v slidder_tween_my`)/100.0, -0.4);";
            text -en 0
				-ann "owershoot to right frame"
				-w 90 -p "arrange_item" -l ">>>overshoot";
            rowLayout -p "base_column" -cw 1 65 -nc 2 -adj 1;
				intSlider
					-ann "drag to tween, overshoot (for frame) or push (for selected curves)"
					-p "base_column"
					-h 16 -min -100 -max 200 -value 50
				    -dc "$bar_tween_val_UI_posiiton=`intSlider -q -v slidder_tween_my`; BOver9_0_d18150d077ed5b67c6812087cb8711c2((`intSlider -q -v slidder_tween_my`)/100.0, 0.01);  floatField -e -v (`intSlider -q -v slidder_tween_my`)  tween_slider_field; "
					-step 1
					slidder_tween_my;
	showWindow "tween_window";
}
global proc BOver9_0_692e2fda85cadfdf0f28e93323f58c08()
{
	global float $startTime;
