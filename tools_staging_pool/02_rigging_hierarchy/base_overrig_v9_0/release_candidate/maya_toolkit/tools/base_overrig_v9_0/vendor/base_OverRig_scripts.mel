global proc string[] BOver9_0_92f8bb791ca3a38da50df3bfa5733ff5()
{
	$selected=`ls-fl-sl`;
	if(size($selected)<=0)
	{
		warning "Nothing selected!";
		return {""};
	}
	$locators=`BOver9_0_54d92f8424c4459e6d996d9fd93902f0`;
	setKeyframe  $locators;
	$locators=BOver9_0_e706e982298fe9e8f94ae04b06b5d6b2("LOH");
    $minTR=`playbackOptions -q -ast`;
    $maxTR=`playbackOptions -q -aet`;
    $time=`currentTime -q`;
    autoKeyframe -st 0;
    for($i=$minTR;$i<=$maxTR;$i++)
    {
        currentTime $i;
        BOver9_0_5e8af8371c687e5c50d7ded5040ffe13($selected, $locators);
        setKeyframe  $locators;
    }
    autoKeyframe -st 1;
	currentTime $time;
	return $locators;
}
global proc BOver9_0_2e50fb684e35f7dc58ab390d98530944(float $color[])
{
	string $obj;
