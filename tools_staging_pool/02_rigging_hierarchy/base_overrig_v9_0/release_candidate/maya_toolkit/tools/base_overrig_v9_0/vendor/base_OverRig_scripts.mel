    currentTime $minTR;
	for($i=0;$i<size($selected);$i++)
	{
	    $tmpp=`spaceLocator`;
	    $locators[$i]=$tmpp[0];
	}
	select $locators;
	BOver9_0_9a3ce25cfdbc96f0053e2e03715d7f2b;
