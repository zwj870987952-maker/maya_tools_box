global proc string BOver9_0_c830bbb3bb6041f72a5fb76403fcabe8()
{
    $selection=`ls-sl`;
    $mayaVersion = `getApplicationVersionAsFloat` ;
    string $eval_mode[];
    if ($mayaVersion>=2016)
    {
        $eval_mode=`evaluationManager -q -mode`;
		if($eval_mode[0]!="off")
			evaluationManager -mode "off";
    }
    $min=`playbackOptions -q -ast`;
    $max=`playbackOptions -q -aet`;
    string $lay=`animLayer -override 1  "BakedAnim"`;
    string $pblnds[];
    $its_baked=catch (`bakeResults -sm 1 -s false -t ($min+":"+$max) -dl $lay  -minimizeRotation true  $selection`) ;
    if ($mayaVersion>=2016)
    {
		if($eval_mode[0]!="off")
			evaluationManager -mode $eval_mode[0];
    }
    if($its_baked)
        warning "select something!";
	else
	{
		$pblnds=BOver9_0_d9af2e6919b9d27514f3d6668ca41211($selection);
		delete $pblnds;
		delete_constraint_attributes_on_objects($selection);
	}
    select  $selection;
    return  $lay;
}
global proc BOver9_0_296ca14a4925cd18efa144cbe7274292(string $objects[], int $across)
{
	string $selected[],$obj;
	string $connected_obj[];
	string $tmpp[];
	if($across)
	{
		for($obj in $objects)
		{
			select   $obj;
			$tmpp=return_constrained_object($obj);
			appendStringArray($connected_obj, $tmpp, size($tmpp));
		}
		$selected=$connected_obj;
	}
	else
		$selected= $objects;
	$min_range=`playbackOptions -q -ast`;
	$max_range=`playbackOptions -q -aet`;
	$timedd=`currentTime -q`;
	float $keys_times[];
	string $cmd_t;
	string $all_obj_eval[];
	for($i=0;$i<size($selected);$i++)
	{
		if($across)
			$keys_times=BOver9_0_78b3badf5e21d9d0f6a0516171924096 ({$objects[$i]}, "all");
		else
			$keys_times=BOver9_0_78b3badf5e21d9d0f6a0516171924096 ({$selected[$i]}, "all");
		if(size( $keys_times)>1)
		{
			$cmd_t="";
			for($k in $keys_times)
			$cmd_t=$cmd_t + " -t " + $k;
			$cmd_t = "selectKey -tgl -k  " + $cmd_t + " " + $selected[$i] + ";";
			$all_obj_eval[$i]= $cmd_t;
		}
	}
	select $selected;
	BOver9_0_de88efca2929f0080ae1d45ff5db42d4;
	selectKey -add -time ($min_range + ":" + $max_range) $selected;
	for($cmd in $all_obj_eval)
		eval($cmd);
	cutKey -animation keys -clear;
}
global proc BOver9_0_07761c6364123ec92b7691e8fd34a814(string $selected[])
{  
    $pair_blends=`listConnections  -type pairBlend $selected`;
    if(size($pair_blends)==0)
    {
        warning "no matching objects were found";
        return;
    }
    $pair_blends=stringArrayRemoveDuplicates($pair_blends);
    string $barn_logic[], $curr_barn;
    for($blen in $pair_blends)
    {
        select $blen;
        $curr_barn=BOver9_0_e8f0c3b3e6300189aca31ae83320ec92("barn_logic_or_for_constr_blending*");
        if($curr_barn!="")
            appendStringArray($barn_logic,{$curr_barn},1);
    }
    string $constraints[]={"parentConstraint","orientConstraint","pointConstraint","aimConstraint"};
    string $p_nodes[], $connection[], $tmpeps[], $obj,$const,$connect;
    for($obj in  $barn_logic)
            for($const in $constraints)
                appendStringArray($connection, ($tmpeps = `listConnections  -type  $const  $obj`),size( $tmpeps));
    $connection= stringArrayRemoveDuplicates($connection);
    for ($connect in $connection)
    {
            $tmpeps=`listConnections -d 0 -s 1 $connect `;
            appendStringArray($p_nodes,$tmpeps,size($tmpeps));
    }
    $p_nodes = stringArrayRemoveDuplicates($p_nodes);
    $p_nodes = stringArrayRemoveExact($connection, $p_nodes);
    $p_nodes = stringArrayRemoveExact($selected, $p_nodes);
    select $p_nodes;
    BOver9_0_296ca14a4925cd18efa144cbe7274292(`ls-sl`, 1);
}
global proc BOver9_0_de88efca2929f0080ae1d45ff5db42d4()
{
	$selection=`ls-sl`;
    $mayaVersion = `getApplicationVersionAsFloat` ;
    string $eval_mode[];
    if ($mayaVersion>=2016)
    {
        $eval_mode=`evaluationManager -q -mode`;
		if($eval_mode[0]!="off")
			evaluationManager -mode "off";
    }
    $min=`playbackOptions -q -ast`;
    $max=`playbackOptions -q -aet`;
    $its_baked=catchQuiet (`bakeResults -sm 1 -s false -t ($min+":"+$max) $selection`);
	if ($mayaVersion>=2016)
    {
		if($eval_mode[0]!="off")
			evaluationManager -mode $eval_mode[0];
    }
    if($its_baked)
    {
        warning "select something!";
    }
}
global proc BOver9_0_42bfa468078681895875c773853d2cda(float $frame_range[])
{
    string $selected[]=`ls-sl`;
	float $mayaVersion = `getApplicationVersionAsFloat` ;
    string $eval_mode[];
    if ($mayaVersion>=2016)
    {
        $eval_mode=`evaluationManager -q -mode`;
		if($eval_mode[0]!="off")
			evaluationManager -mode "off";
    }
    global string $gPlayBackSlider;
    if($frame_range[0]==0 && $frame_range[1]==0)
         $frame_range =`timeControl -q -ra $gPlayBackSlider`;
    if( ($frame_range[1]-$frame_range[0])<=1)
    {
        $frame_range[0]=`playbackOptions -q -min`;
        $frame_range[1]=`playbackOptions -q -max` + 1;
    }
    string $pblnds[];
	$its_baked=catchQuiet (`bakeResults -sm 1 -s false -t ($frame_range[0]+":"+($frame_range[1]-1))  -preserveOutsideKeys 1 $selected`);
	if ($mayaVersion>=2016)
    {
		if($eval_mode[0]!="off")
			evaluationManager -mode $eval_mode[0];
    }
    if($its_baked)
        warning "select something!";
	else
	{
		$pblnds=BOver9_0_d9af2e6919b9d27514f3d6668ca41211($selected);
		delete $pblnds;
		delete_constraint_attributes_on_objects($selected);
	}
}
global proc string[] BOver9_0_d9af2e6919b9d27514f3d6668ca41211(string $objects[])
{
    string $list_non_locked_and_vis_channels[]={};
    string $curr_attr[];
    for($obj in $objects)
    {
        $curr_attr = `listAttr -k -u $obj`;
        $curr_attr=stringArrayAddPrefix($curr_attr, ($obj + ".") );
        appendStringArray($list_non_locked_and_vis_channels, $curr_attr, size($curr_attr));
    }
    string $list_pair_blend_obj[]={};
    for($ch in $list_non_locked_and_vis_channels)
    {
        $curr_attr =`listConnections -d off -s on -type "pairBlend" $ch`;
        appendStringArray($list_pair_blend_obj, $curr_attr, size($curr_attr));
    }
    $list_pair_blend_obj=stringArrayRemoveDuplicates($list_pair_blend_obj);
    return $list_pair_blend_obj;
}
global proc BOver9_0_e02b9af8de573969d2834f5d4e4228fd(float $min, float $max, string $objects[])
{
	$mayaVersion = `getApplicationVersionAsFloat` ;
