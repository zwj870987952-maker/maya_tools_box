global proc barn_fast_bake_source_obj_and_delete_knots()
{
    barn_sel_set_member("OverRig_rig_objects");
    apply_Fast_Bake;
    delete_constraint_attributes_on_objects(`ls-sl`);
    string $set_member[]=barn_sel_set_member("OverRig_knots");
    if(size($set_member)>0)
        delete;
}
global proc barn_fast_bake_min_max_or_range_source_obj_and_delete_knots()
{
    barn_sel_set_member("OverRig_rig_objects");
    apply_range_Fast_Bake();
    delete_constraint_attributes_on_objects(`ls-sl`);
    string $set_member[]=barn_sel_set_member("OverRig_knots");
    if(size($set_member)>0)
        delete;
}
global proc  string[] barn_sel_set_member(string $name_of_set)
{
    string $set_member[];
    if( `objExists($name_of_set)`)
    {
        select `sets -q $name_of_set`;
        $set_member=`ls -fl -sl`;
    }
	return $set_member;
}
