	$dup_lock=`duplicate $locators`;
    for($j=0;$j<size($locators);$j++)
    {
    	addAttr -ln "speed" -nn "speed" -at double -dv 0 $locators[$j];
        setAttr -e -k 1 -channelBox true ($locators[$j] + ".speed");
        setKeyframe ($locators[$j] + ".speed");
    }
    playbackOptions   -ps 0;
    float $trans_prev[]={0,0,0};
    autoKeyframe -st 0;
    for($i=$minTR;$i<=$maxTR;$i++)
    {
        currentTime $i;
        BOver9_0_847308ac6f1debf8edcc8d63e128d64c($locators, $dup_lock);
        for($j=0;$j<size($locators);$j++)
        {
            $Trans=BOver9_0_e70d36ea08e9b8ec1fa4786146236d25($selected[$j]);
            move -rpr $Trans[0] $Trans[1] $Trans[2] $locators[$j];
            setAttr ($locators[$j] + ".speed") (BOver9_0_c7822f1f10b007a6803735c105e40799($locators[$j] , $dup_lock[$j]));
            setKeyframe ($locators[$j] + ".speed");
        }
        setKeyframe  $locators $dup_lock;
    }
    autoKeyframe -st 1;
    playbackOptions   -ps $playback_speed;
    select $locators $dup_lock;
    BOver9_0_b0a1523d18ddbfe3c562938d09574284;
    for($j=0;$j<size($locators);$j++)
        aimConstraint -offset 0 0 0 -weight 1 -aimVector 1 0 0 -upVector 0 1 0 -worldUpType "scene"   $dup_lock[$j] $locators[$j];
    select $locators;
	BOver9_0_692e2fda85cadfdf0f28e93323f58c08;
	BOver9_0_de88efca2929f0080ae1d45ff5db42d4;
	BOver9_0_09f1edc0a69a4931b08e1bcc40e94a55;
	BOver9_0_f4b1a2b52ab1771321003f86cde63160;
	delete $dup_lock;
	for($j=0;$j<size($locators);$j++)
	    {
	        setAttr -lock 0 ($locators[$j] + ".sx");
	        connectAttr -f ($locators[$j] + ".speed") ($locators[$j] + ".scaleX");
	    }
	currentTime $time;
	select $locators;
	return $locators;
}
