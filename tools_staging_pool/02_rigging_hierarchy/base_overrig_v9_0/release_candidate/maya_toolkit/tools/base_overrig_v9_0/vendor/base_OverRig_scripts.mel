    for($i=0;$i<size($fl_array);$i++)
       $output_int[$i] =$fl_array[$i];
    if($sorting)
        $output_int=sort($output_int);
    string $tmp_str[];
    if($remove_duplicates)
    {
       for($i=0;$i<size($output_int);$i++)
           $tmp_str[$i]=$output_int[$i];
       $tmp_str=stringArrayRemoveDuplicates($tmp_str);
       $output_int={};
       for($i=0;$i<size($tmp_str);$i++)
           $output_int[$i]=$tmp_str[$i];
    }
    return $output_int;
}
