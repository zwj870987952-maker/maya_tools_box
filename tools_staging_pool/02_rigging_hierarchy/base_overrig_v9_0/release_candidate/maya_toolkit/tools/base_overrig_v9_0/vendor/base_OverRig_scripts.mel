	$BARN_curve_sword_remember_SOURCE=`ls-sl`;
	BOver9_0_4b209c5c00abddc3e3509a14326e2488($BARN_curve_sword_remember_SOURCE,"OverRig_rig_objects");
	BOver9_0_692e2fda85cadfdf0f28e93323f58c08;
	if(size(`ls-sl`)==3)
		catch (BOver9_0_f3eeb22d0b2ca4debf42ff3b4d15f5b7());
	else
	if(size(`ls-sl`)>3)
		catch (BOver9_0_542fcb78713b77e1be59b8629b811638());
	else
		warning "need select 3 or more object!";
	$BARN_curve_sword_remember_AIM_TOP=`ls-sl`;
