            -mh 5
            -mw 3
            -cc " window -e -h 42 anim_to_easy_spine_system_rig"
            -p "anim_to_easy_spine_system_rig" -cl 1 -cll true -l "help" "fral_bdy";
            columnLayout -bgc 1 0.8 0.5  -p "fral_bdy";
            text -al "left" " for BODY rig";
            text -al "left" "   1. select pelvis, spine jnts and chest";
            text -al "left" "   2. and press CREATE button";
            text -al "left" "   3. rotate pelvis and chest locators close to the orientation axes of the original skeleton ";
            text -al "left" "   4. press APPLY button";
