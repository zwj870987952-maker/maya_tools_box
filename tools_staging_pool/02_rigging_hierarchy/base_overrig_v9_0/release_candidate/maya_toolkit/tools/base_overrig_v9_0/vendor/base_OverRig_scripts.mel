	if (size ($selection)>0)
	{
		$j=0;
		for($obj in $selection)
		{
			$getPvPos=BOver9_0_8598296823aa3af15686cb0d78f1615d($obj);
			$b=`spaceLocator -p 0 0 0`;
			$locators[$j]=$b[0];
			xform -ws -t $getPvPos[0] $getPvPos[1] $getPvPos[2] $b[0];
			rotate -ws $getPvPos[3] $getPvPos[4] $getPvPos[5]  $b[0];
			$j++;
		}
		select -cl;
		for($obj in $locators)
		{
			select -add $obj;
		}
	}
	else
	{
		$locators = `spaceLocator -p 0 0 0`;
	}
	return $locators;
}
global proc string[] BOver9_0_6b3d22f4c951fb49c197d50c1803f0cb(string $objects[])
