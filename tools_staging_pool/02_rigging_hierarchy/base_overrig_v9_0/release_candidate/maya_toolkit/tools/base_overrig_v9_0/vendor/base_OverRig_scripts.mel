global proc BOver9_0_feece4078c8aeb0c08bb278bcaf1bd05(int $num , int $indexses[])
{
	string $objs[] = `ls-sl`;
	if(!size($objs))
		return;
	if ($num <= 0)
        for ($obj in $objs)
            setAttr ($obj + ".overrideEnabled") 0;
    else
    	for($i=0;$i<size($objs);$i++)
    	{
    		setAttr ($objs[$i] + ".overrideEnabled") 1;
    		setAttr -lock false ($objs[$i] + ".overrideColor") $indexses[$num];
    	}
}
