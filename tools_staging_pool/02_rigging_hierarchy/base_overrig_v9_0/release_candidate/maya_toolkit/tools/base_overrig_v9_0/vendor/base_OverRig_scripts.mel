	$poly_names = `filterExpand  -sm 34 $selected`;
	if(size($vertex_edges_names)==0&&size($poly_names)==0)
	{
	    warning "no component selected !!!!";
	    return {};
	}
	if(size($vertex_edges_names)>0)
	{
        select $vertex_edges_names;
        BOver9_0_ac692345fba3e827ad5d6e26de39ba07;
        $loh_lock=BOver9_0_07739a1aa5203222338cc34f38597dfb();
