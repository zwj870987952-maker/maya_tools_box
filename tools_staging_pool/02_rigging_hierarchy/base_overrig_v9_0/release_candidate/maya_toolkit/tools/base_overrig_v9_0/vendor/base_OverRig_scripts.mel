global proc string[] BOver9_0_89ca12a1050c943f0c5eb395eaa18d85(string $path_to_JGLBN, float $size_j)
{
    string $bake_grupp[],$option_dynamic_bone[],$inside_jnts[],$tempp[];
    string $selection[]=`ls-sl`;
    int $i=0;
    for($obj in $selection)
    {
        $tempp=BOver9_0_d87329da3638ba6d8abbdc21284da5b0($path_to_JGLBN);
        $bake_grupp[$i]= $tempp[0];
        $option_dynamic_bone[$i]=$tempp[1];
        $inside_jnts[$i]= $tempp[2];
        $i++;
    }
    select $inside_jnts;
    BOver9_0_15760bd5ac6225f582185bab24346a67($size_j*0.2);
    select $option_dynamic_bone;
    BOver9_0_15760bd5ac6225f582185bab24346a67($size_j);
    for($b in $option_dynamic_bone)
    		setAttr ($b + ".Enable") 0;
    BOver9_0_847308ac6f1debf8edcc8d63e128d64c($selection, $bake_grupp);
	BOver9_0_7f958423a7cfe1774157efdcb79ac0be($selection, $bake_grupp);
	BOver9_0_17431451b1be026fdeee93b86579c6b6($selection, $bake_grupp);
	select $bake_grupp;
	BOver9_0_de88efca2929f0080ae1d45ff5db42d4;
	BOver9_0_09f1edc0a69a4931b08e1bcc40e94a55;
	BOver9_0_17431451b1be026fdeee93b86579c6b6($inside_jnts, $selection);
	for($b in $option_dynamic_bone)
		setAttr ($b + ".Enable") 1;
	select $option_dynamic_bone;
    return $bake_grupp;
}
global proc execute_overlap_command(int $chain, string $base_clth_j[], float $len, float $sdvig,  float $sdvig_side,float $smooth_end, int $cycle,int $abs_mode, int $save_edge)
{
	if (size ($base_clth_j)==0)
	{
		print "\n\n\n\nnothing selected!!! select something!\n";
		undoInfo -cck;
		return;
	}
	BOver9_0_692e2fda85cadfdf0f28e93323f58c08;
	undoInfo -ock -cn "execute_overlap_command";
    global string $gPlayBackSlider;
	float $selectedTime[]=`timeControl -q -ra $gPlayBackSlider`;
    int $partial_mode=0;
	float $min_frOld=`playbackOptions -q -ast`;
	float $max_frOld=`playbackOptions -q -aet`;
	float $min_in_frOld=`playbackOptions -q -min`;
	float $max_in_frOld=`playbackOptions -q -max`;
	float $min_fr=$min_frOld;
	float $max_fr=$max_frOld;
	if($selectedTime[1]-$selectedTime[0]>1)
	{
	    $partial_mode=1;
	    $min_fr=$selectedTime[0];
	    $max_fr=$selectedTime[1]-1;
	    playbackOptions -ast $min_fr -aet $max_fr;
	}
	int $zero_percent=($max_fr-$min_fr)/5;
	global string $BARN_curve_sword_remember_SOURCE[];
	clear $BARN_curve_sword_remember_SOURCE;
	$BARN_curve_sword_remember_SOURCE=`ls-fl-sl`;
	float $time=`currentTime -q`;
