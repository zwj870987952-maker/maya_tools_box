global proc BOver9_0_f0549514de82c9ee2236723b537462e7(string $objects[], string $constr_names[], string $channel_name, float $frame_range[], int $rotate_quaternion)
{
	string $all_constr_nodes[]=`ls  "barn_logic_or_for_constr_blending*"`;
	for($node in $all_constr_nodes)
		if(!`connectionInfo -ies ($node + ".output[0]")`)
			delete $node;
	string $nodename;
	string $all_expression_names[];
	string $parent_constr_WL[];
	string $attr_name;
	string $p_blend_name[];
	for($i=0;$i<size($objects);$i++)
	{
		$attr_name=($objects[$i] + "." + $channel_name);
		addAttr -ln  $channel_name -nn $channel_name -at double -dv 1 $objects[$i];
		setAttr -e -keyable true  $attr_name;
		if($frame_range[1]-$frame_range[0]>1)
		{
			setKeyframe -itt flat -ott flat -t ($frame_range[0]-1)  -t ($frame_range[0])   -t ($frame_range[1]-1) -t ($frame_range[1]) -v 0 $attr_name;
			keyframe -e    -vc 1 -t ($frame_range[0])   -t ($frame_range[1]-1) $attr_name ;
		}
		setAttr -lock 1 $attr_name;
		$nodename=BOver9_0_5be180667c9ec255cdbc3827fe30f0f2($constr_names[$i], "barn_logic_or_for_constr_blending*");
		$p_blend_name=`listConnections  -d 1 -s 0 -scn 1 -type "pairBlend" $constr_names[$i]`;
		if($nodename!="")
			delete $nodename;
		$parent_constr_WL=`parentConstraint -q -wal $constr_names[$i]`;
		$all_expression_names[$i]=BOver9_0_a54e109972caf8ac808da7205e765e57("barn_logic_or_for_constr_blending", `size($parent_constr_WL)`);
		connectAttr -f ( $all_expression_names[$i] + ".output[0]") ($p_blend_name[0] + ".weight");
		for($j=0;$j<size($parent_constr_WL);$j++)
			connectAttr -f ($constr_names[$i] + "." + $parent_constr_WL[$j]) ( $all_expression_names[$i] + ".null" + $j);
		connectAttr -f $attr_name ($constr_names[$i] + "." + $parent_constr_WL[`size($parent_constr_WL)` -1]);
		setAttr($p_blend_name[0] + ".rotInterpolation")  $rotate_quaternion;
	}
}
