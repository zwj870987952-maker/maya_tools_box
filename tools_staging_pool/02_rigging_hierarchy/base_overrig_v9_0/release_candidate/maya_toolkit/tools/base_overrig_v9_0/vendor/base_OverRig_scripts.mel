global proc BOver9_0_32e5cf028e8fb27af956fe4209ca4c1c()
{
	$select = `ls -fl -sl`;
	global string $gPlayBackSlider;
	float $frame_range[]=`timeControl -q -ra $gPlayBackSlider`;
	select -d $select[size($select)-1];
	$childs = `ls -head (size($select)-1) $select`;
	$createSetResult = `sets -name "temp_set_parent_in"`;
	catchQuiet(`BOver9_0_37979d5db724aeac3ec6046edc570bbd`);
	catchQuiet(`BOver9_0_25dd166f9ad7839b589ab3bd870d76db`);
	catchQuiet(`BOver9_0_c89bf830cdb2b9cc874e6c8604e8b257`);
	catchQuiet(BOver9_0_7bb1bcd646c2647ac3ab09dc70126b5c($childs,".tx"));
	catchQuiet(BOver9_0_7bb1bcd646c2647ac3ab09dc70126b5c($childs,".ty"));
	catchQuiet(BOver9_0_7bb1bcd646c2647ac3ab09dc70126b5c($childs,".tz"));
	$temp_locators= `BOver9_0_54d92f8424c4459e6d996d9fd93902f0`;
	BOver9_0_17431451b1be026fdeee93b86579c6b6($childs, $temp_locators);
	select -r $temp_locators;
	if($frame_range[1]-$frame_range[0]>1)
	    BOver9_0_e02b9af8de573969d2834f5d4e4228fd(($frame_range[0]), $frame_range[1]-1, $temp_locators);
	else
	    BOver9_0_de88efca2929f0080ae1d45ff5db42d4;
	BOver9_0_17431451b1be026fdeee93b86579c6b6($temp_locators, $childs);
	select -r $select;
	catch(`parent`);
	$childs=`listConnections -t node $createSetResult`;
	select -r $childs;
	if($frame_range[1]-$frame_range[0]>1)
	    BOver9_0_e02b9af8de573969d2834f5d4e4228fd(($frame_range[0]), $frame_range[1]-1, $childs);
	else
	    BOver9_0_de88efca2929f0080ae1d45ff5db42d4;
	delete $temp_locators $createSetResult;
	filterCurve $childs.rotateX $childs.rotateY $childs.rotateZ;
}
global proc BOver9_0_d6efb621a5741bab0e75433a679ae12d()
{
