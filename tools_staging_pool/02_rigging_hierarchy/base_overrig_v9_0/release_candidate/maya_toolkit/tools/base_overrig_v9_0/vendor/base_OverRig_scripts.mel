	BOver9_0_74b3586ec5f33152020ca1d5764043c3();
	BOver9_0_cc20e95399a3b6da44eb78e45451d764(13);
	select -r $sword  $hand_SWST_jnts[1];
	BOver9_0_e0b44e5f427a869b704a743cf1d3614c;
	if($num_sel==5)
	{
		select -r $whrist  $hand_SWST_jnts[0];
		BOver9_0_dfb2ed0c2c53945ca7515c674763faa0();
	}
	else
	{
		select -r $hand_lock $hand_SWST_jnts[0];
		BOver9_0_dfb2ed0c2c53945ca7515c674763faa0();
	}
	select -r $hand_SWST_jnts $hand_SWST_lock;
	BOver9_0_c89bf830cdb2b9cc874e6c8604e8b257;
	select -tgl $hand_SWST_jnts[0];
	BOver9_0_b6a5017ee305f5ba0bbf3116243cc3af;
	select -r $hand_SWST_jnts[0];
