            text -al "left" "   4. press APPLY button";
	columnLayout -adj 1 -p "anim_to_easy_spine_system_rig" "columnLayout15";
		rowLayout -parent"columnLayout15" -adj 3   -numberOfColumns 6;
			checkBox -annotation "continuation of chain - first selected- end locator of previous chain " -label  "continuation mode" "continuation_of_chain_mode";
			button -h 40 -w 150 -command "BOver9_0_7895ec20650f9411ffd9ffcca61a04fb(`checkBox -q -v continuation_of_chain_mode`)" -label "1.create and rotate" ;
			button -h 40 -w 150 -command "BOver9_0_56198b33b19d3947083feaf628154297(`checkBox -q -v continuation_of_chain_mode`)" -annotation "apply system" -label "2. apply and bake"  ;
	showWindow "anim_to_easy_spine_system_rig";
}
global proc string BOver9_0_7895ec20650f9411ffd9ffcca61a04fb(int $continuation_of_chain)
{
