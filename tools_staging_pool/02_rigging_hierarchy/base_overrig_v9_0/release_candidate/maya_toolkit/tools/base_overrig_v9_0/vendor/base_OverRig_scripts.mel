global proc bar_tail_overlap_window()
{
    if(`window -q -ex "BOver9_0_38abc2ad8d0df7edc05b9cbbc4053b86"`)deleteUI("BOver9_0_38abc2ad8d0df7edc05b9cbbc4053b86");
    window -mnb false   -mxb false -t "tail overlap" -bgc 1.0 0.9  0.8   -tb true -s 1 -tlb true -mb true "BOver9_0_38abc2ad8d0df7edc05b9cbbc4053b86";
		columnLayout -w 560  -p "BOver9_0_38abc2ad8d0df7edc05b9cbbc4053b86";
			int $col_size=70;
			rowLayout   -cw 1 $col_size  -cw 2 $col_size -cw 3 $col_size -cw 4 $col_size -cw 5 $col_size -cw 6 $col_size -nc 9;
				text -l "";
				text "softness";
				text "lag";
				text -l "";
				text "easing";
			rowLayout -cw 1 $col_size  -cw 2 $col_size -cw 3 $col_size -cw 4 $col_size -cw 5 $col_size -adj 8  -nc 8 -p "BOver9_0_38abc2ad8d0df7edc05b9cbbc4053b86";
				checkBox -ann "every selection - root of chain" -v 1 -l "hierarchy" "root_mode";
				floatField -v 2.0 -s 0.1 -pre 1 -ann "softness" "softness_overlap";
				floatField -v 1.0 -pre 1 -ann "lag every control" "lag_overlap";
				checkBox -ann "absolute mode - total lag" -l "abs offset" "abs_mode_overlap";
				floatField -v 0 -pre 1 -min 0 -ann "smooth movement - remove noise" "smooth_end_overlap";
				checkBox -ann "cycled or no" -l "cycled" "cycled_overlap";
				checkBox -ann "save edge poses in separate additive layer" -l "save poses" "save_pose_overlap";
				button -bgc 0.6 0.9 0.6
					-c "execute_overlap_command(`checkBox -q -v root_mode`,`ls-fl-sl`,`floatField -q -v softness_overlap`,`floatField -q -v lag_overlap`,0,`floatField -q -v smooth_end_overlap`,`checkBox -q -v cycled_overlap`,`checkBox -q -v abs_mode_overlap`,`checkBox -q -v save_pose_overlap`); "
					-l "execute" "execute";
		frameLayout
				-p "BOver9_0_38abc2ad8d0df7edc05b9cbbc4053b86"
				-bgc 0.2 0.555 0.580
				-ebg true
				-bv false
				-cl 1
				-cll true
				-l "help"
				-la "top"
				-lw 5
				-mw 5
				-mh 2
				-ec "catchQuiet(`window -e -h 225 BOver9_0_38abc2ad8d0df7edc05b9cbbc4053b86`)"
				-cc "catchQuiet(`window -e -h 80 BOver9_0_38abc2ad8d0df7edc05b9cbbc4053b86`)"
				tail_overlap_help;
			columnLayout  -w 550 -adj 1;
				textScrollList -allowMultiSelection 0  -ebg 1 -h 140 -bgc 1.0 0.9  0.8 -en 1 -highlightColor 0.2 0.555 0.580
					-append "    select a chain of bones from top to bottom, or the first objects in several chains "
					-append "     "
					-append "    hierarchy - selected objects are the first control of chains "
					-append "    softness - The smaller it is, the more overlapp there is"
					-append "    lag - lag of each link relative to the previous one - the greater the lag, the more flexible the chain"
					-append "    abs offset - lag of the whole chain in frames relative to the whole animation, recorded in the lag forw"
					-append "    easing - removes the shaking from the animation"
					-append "    cycled - loop or no"
					-append "    save poses - save edge poses in separate additive layer"
			myControlObj;
			separator -h 3 -style "none";
    showWindow "BOver9_0_38abc2ad8d0df7edc05b9cbbc4053b86";
    window -e   -h  80 BOver9_0_38abc2ad8d0df7edc05b9cbbc4053b86;
}
global proc overRig_noise_window()
{
    if(`window -q -ex "noise_window"`)deleteUI("noise_window");
    window -title "noise (work with selection animation curves)" -h 50 -tb true -mnb false -mxb false -mb false -tlb true -bgc 0.6 0.9 0.9
        -tbm true "noise_window";
    global int $bar_noise_UI_posiiton;
    global int $bar_sssssssssss;
    global int $bar_val_UI_posiiton;
			columnLayout -w 400 -adjustableColumn true  -ann "select animation curves" base_column;
			rowLayout -p "base_column" -nc 4 -adj 3 ;
			    text "noise value strenght  ";
				floatField -min 0.1 -v 5 -max 100 -precision 2
				    -cc "floatSlider -e  -v (`floatField -q -v flfild_sl`) strenght_slider; "
				    flfild_sl;
				floatSlider -h 30 -min 0.1 -step 0.1 -max 100 -value 5
				    -dc " floatField -e  -v (`floatSlider -q -v strenght_slider`) flfild_sl;"
				    strenght_slider;
				checkBox -v 0
					-ann "the same random for all curves"
					-l "uniform" uniform_ch_bx;
			rowLayout -p "base_column" -cw 1 65 -nc 2 -adj 2;
			    text "add noise";
				intSlider -h 30 -min -10 -max 10 -value 0
				    -dc "$bar_noise_UI_posiiton=`intSlider -q -v slidder`;$bar_sssssssssss=`intSlider -q -v slidder`;BOver9_0_15a4ea50cf1974ac5aa20a845bd17e2c( `floatField-q -v flfild_sl`, abs ($bar_sssssssssss), `checkBox -q -v uniform_ch_bx`)"
				    -step 1 slidder;
	window -e -h 65	"noise_window";
	showWindow "noise_window";
}
global proc BOver9_0_15a4ea50cf1974ac5aa20a845bd17e2c(float $value, int $frame, int $uniform)
{
    global int $bar_noise_UI_posiiton;
    global int $bar_noise_UI_posiiton_prev;
    if($bar_noise_UI_posiiton>$bar_noise_UI_posiiton_prev)
    {
        if( $frame!=0)
            BOver9_0_7bd26c8b37f4670d39bdb4c4c27816c3($value, $frame, $uniform);
    }
    else
    {
        if( $frame!=0)
            BOver9_0_3676fd34198e455bb82f6106192bc927($frame+1,$uniform);
    }
    $bar_noise_UI_posiiton_prev=$bar_noise_UI_posiiton;
}
