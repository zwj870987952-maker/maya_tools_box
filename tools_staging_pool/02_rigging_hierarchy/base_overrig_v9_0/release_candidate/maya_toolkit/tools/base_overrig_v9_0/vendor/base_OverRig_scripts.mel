global proc string BOver9_0_886bd92917571731156a7a071d0dbe98 (string $two_edges_names[])
{
	string $nameObject;
	string $namePOSI;
	string $tmp;
	$two_edges_names = `filterExpand -sm 32 $two_edges_names`;
	int $size = size($two_edges_names);
	if ($size == 0)
	{
		error("No edges selected");
		return "";
	}
	if ($size != 2)
	{
		error("No two edges selected");
		return "";
	}
    $nameObject = `match "^[^\.]*" $two_edges_names[0]`;
	$tmp=`substitute "^[^.]*\\.e\\[*" $two_edges_names[0] ""`;
	float $e1=`substitute "]" $tmp ""`;
	$tmp=`substitute "^[^.]*\\.e\\[*" $two_edges_names[1] ""`;
	float $e2 =`substitute "]" $tmp ""`;
	string $nameCFME1 = `createNode curveFromMeshEdge -n "CurveFromMeshEdge1"`;
	setAttr ($nameCFME1 + ".ihi") 1;
	setAttr ($nameCFME1 + ".ei[0]")  $e1;
	string $nameCFME2 = `createNode curveFromMeshEdge -n "CurveFromMeshEdge2"`;
	setAttr ($nameCFME2 + ".ihi") 1;
	setAttr ($nameCFME2 + ".ei[0]" ) $e2;
	string $nameLoft = `createNode loft -n "Loft1"`;
	setAttr -s 2 ($nameLoft + ".ic");
	setAttr ($nameLoft + ".u") yes;
	setAttr ($nameLoft + ".rsn") yes;
	$namePOSI = `createNode pointOnSurfaceInfo -n "PointOnSurfaceInfo1"`;
	setAttr ($namePOSI + ".turnOnPercentage") 1;
	setAttr ($namePOSI + ".parameterU") 0.5;
	setAttr ($namePOSI + ".parameterV") 0.5;
	connectAttr -f ($nameLoft + ".os") ($namePOSI + ".is");
	connectAttr ($nameCFME1 + ".oc") ($nameLoft + ".ic[0]");
	connectAttr ($nameCFME2 + ".oc") ($nameLoft + ".ic[1]");
	connectAttr ($nameObject + ".w") ($nameCFME1 + ".im");
	connectAttr ($nameObject + ".w") ($nameCFME2 + ".im");
	string $nameLocator = `createNode transform -n "lock_on_poly"`;
	createNode locator -n ($nameLocator + "Shape") -p $nameLocator;
	string $nameAC = `createNode aimConstraint -p $nameLocator -n ($nameLocator + "_AimConstraint1")`;
	setAttr ($nameAC + ".tg[0].tw") 1;
	setAttr ($nameAC + ".a") -type "double3" 0 1 0;
	setAttr ($nameAC + ".u") -type "double3" 0 0 1;
	setAttr -k off ($nameAC + ".v");
	setAttr -k off ($nameAC + ".tx");
	setAttr -k off ($nameAC + ".ty");
	setAttr -k off ($nameAC + ".tz");
	setAttr -k off ($nameAC + ".rx");
	setAttr -k off ($nameAC + ".ry");
	setAttr -k off ($nameAC + ".rz");
	setAttr -k off ($nameAC + ".sx");
	setAttr -k off ($nameAC + ".sy");
	setAttr -k off ($nameAC + ".sz");
	connectAttr ($namePOSI + ".position") ($nameLocator + ".translate");
	connectAttr ($namePOSI + ".n") ($nameAC + ".tg[0].tt");
	connectAttr ($namePOSI + ".tv") ($nameAC + ".wu");
	connectAttr ($nameAC + ".crx") ($nameLocator + ".rx");
	connectAttr ($nameAC + ".cry") ($nameLocator + ".ry");
	connectAttr ($nameAC + ".crz") ($nameLocator + ".rz");
	return $nameLocator;
}
