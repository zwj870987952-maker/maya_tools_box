	BOver9_0_e9a3d5ffe283044f2485219b12ac5f73( $hand_SWST_jnts,1);
	if($num_sel==5)
	{
		select -r  $gr_name[0] $whrist ;
		BOver9_0_dfb2ed0c2c53945ca7515c674763faa0;
	}
	else
	{
		select -r  $gr_name[0] $hand_lock;
		BOver9_0_dfb2ed0c2c53945ca7515c674763faa0;
