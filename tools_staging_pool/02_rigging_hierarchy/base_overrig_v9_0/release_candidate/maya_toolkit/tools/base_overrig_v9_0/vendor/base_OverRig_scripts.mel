}
global proc string[] BOver9_0_95aedc626a621231a66a091788483a9e(string $curveName, int $sequent_parent)
{
	string $curve_Shape[] = `listRelatives -shapes -f -type "nurbsCurve" $curveName`;
	int $numCVs = `getAttr -size ($curve_Shape[0] + ".controlPoints")`;
	catchQuiet(`setAttr ($curve_Shape[0] + ".lockLength") 0`);
	string $loks[];
	string $clusters[], $tmppo[];
	for($i=0;$i< $numCVs;$i++)
	{
		$tmppo=`cluster ($curveName + ".cv[" + $i + "]")`;
		$clusters[$i]=$tmppo[1];
	}
	$loks=BOver9_0_526c020cd7c9a859fd08d49719a4fddf($clusters);
	BOver9_0_32a3829df17c3736d9757e423eeaf0e3($loks,$clusters);
	BOver9_0_4c2952dd9f486573856c8eb6a0dc46ac(0);
	BOver9_0_113374ba19bc1f4dc9b1cc9706816f86($clusters);
	BOver9_0_b6a5017ee305f5ba0bbf3116243cc3af;
	BOver9_0_ade4e354383a28fcefcaf5ce40e6639d;
	BOver9_0_aa074854107180f09880ea0e8edd43f8;
	BOver9_0_8071326ac26a590fcb224ddba406d389();
	BOver9_0_1b3bfd1d62d966ea966f5caca72bac5d($clusters, 1);
	if($sequent_parent)
	{
		select  $loks;
		BOver9_0_f0209cb5b5931bdfa7ae6801db19a0f8;
	}
	return $loks;
}
global proc string[] BOver9_0_465f2c70f8e4bf417e93834f61ee4f6e(string $stroka, string $poisk)
{
	string $buffer[]={};
	string $fin_str=$stroka;
	int $siz_stroka=sizeBytes($stroka);
	int $siz_poisk=sizeBytes($poisk);
	for($i=0;$i<($siz_stroka/ $siz_poisk)+1;$i++)
	    $fin_str=`substitute $poisk $fin_str "###^@@@"`;
	tokenize $fin_str "^" $buffer;
	for($i=0;$i<size($buffer);$i++)
	{
	    $buffer[$i]=`substitute "###" $buffer[$i] ""`;
	    $buffer[$i]=`substitute "@@@" $buffer[$i] ""`;
	}
	return $buffer;
}
global proc string BOver9_0_c884f4200431a153fb44b960cecbef34(string $object)
{
    string $shapes_object[];
    string $object_type;
    $shapes_object=BOver9_0_5e702211108f11813c411c94f8b1b380($object);
    if($shapes_object[0]!=$object)
        $object_type=`objectType $shapes_object[0]`;
    else
        $object_type=`objectType $object`;
    return $object_type;
}
global proc BOver9_0_b8c78ceb987ce7e962297e68eebc8c12(string $base_obj, string $oriented_obj)
{
   $vec_lock=BOver9_0_526c020cd7c9a859fd08d49719a4fddf({ $base_obj, $base_obj, $base_obj, $base_obj, $base_obj, $base_obj});
    move -r-os 100 0 0 $vec_lock[0];
    move -r-os -100 0 0 $vec_lock[1];
    move -r-os 0 100 0 $vec_lock[2];
    move -r-os 0 -100 0 $vec_lock[3];
    move -r-os 0 0 100 $vec_lock[4];
    move -r-os 0 0 -100 $vec_lock[5];
   $axis_lock=BOver9_0_526c020cd7c9a859fd08d49719a4fddf({ $oriented_obj, $oriented_obj});
    move -r-os 100 0 0 $axis_lock[0];
    move -r-os   0 0  100 $axis_lock[1];
    float $min_distX=500;
    float $min_distZ=500;
    float $distX, $distZ;
    int $numX, $numZ;
    for($i=0;$i<6;$i++)
    {
        $distX=BOver9_0_c7822f1f10b007a6803735c105e40799($axis_lock[0] , $vec_lock[$i]);
        if($distX<$min_distX)
        {
            $min_distX=$distX;
            $numX=$i;
        }
        $distZ=BOver9_0_c7822f1f10b007a6803735c105e40799($axis_lock[1] , $vec_lock[$i]);
        if($distZ<$min_distZ)
        {
            $min_distZ=$distZ;
            $numZ=$i;
        }
    }
    delete (`aimConstraint -offset 0 0 0 -weight 1 -aimVector 0 0 1 -upVector 1 0 0 -worldUpType "object" -worldUpObject $vec_lock[$numX] $vec_lock[$numZ] $oriented_obj`);
    delete  $vec_lock $axis_lock;
}
global proc string BOver9_0_c94e889a43233139ecf15566d05e5a78(string $controls[], string $selected_jnts[])
{
 	catchQuiet(`loadPlugin lookdevKit`);
	select $selected_jnts;
	int $num_control=size($controls);
	int $num=size($selected_jnts);
	string $base_curves_obj[]=BOver9_0_4874f5c758343518c484dc3cb8ee48b0(2, $num_control, 1, 1);
	string $base_curve_loc[]=`ls -head (size($base_curves_obj)-2)$base_curves_obj`;
	select $base_curve_loc;
	BOver9_0_a9acebc46d5277d92e6d954501ac53c7("x",  "up", "");
	string $curve_name[]=`ls  -tail 2 $base_curves_obj`;
	for($i=1;$i<$num-1;$i++)
		aimConstraint -offset 0 0 0 -weight 1 -aimVector 1 0 0 -upVector 0 0 1 -worldUpType "objectrotation" -worldUpVector 0 0 1 -worldUpObject $base_curve_loc[$i+1] $base_curve_loc[$i+1] $base_curve_loc[$i];
	select $base_curve_loc;
	string $lock_bottom_aim[]=BOver9_0_54d92f8424c4459e6d996d9fd93902f0();
	BOver9_0_32a3829df17c3736d9757e423eeaf0e3($base_curve_loc,$lock_bottom_aim);
	for($i=0;$i<$num-1;$i++)
		aimConstraint -offset 0 0 0 -weight 1 -aimVector -1 0 0 -upVector 0 0 1 -worldUpType "objectrotation" -worldUpVector 0 0 1 -worldUpObject $lock_bottom_aim[$i] $lock_bottom_aim[$i] $lock_bottom_aim[$i+1];
	select $base_curve_loc;
	string $rotator[]=BOver9_0_54d92f8424c4459e6d996d9fd93902f0();
	BOver9_0_32a3829df17c3736d9757e423eeaf0e3($base_curve_loc,$rotator);
	global string $ribbon_curve_rig_aimers_FloatMath_nodes[];
	$ribbon_curve_rig_aimers_FloatMath_nodes={};
	for($i=1;$i<$num-1;$i++)
	{
		string $float_math_node=`createNode floatMath`;
		appendStringArray($ribbon_curve_rig_aimers_FloatMath_nodes,{$float_math_node},1);
		connectAttr -f ($lock_bottom_aim[$i] + ".rotateX") ($float_math_node + ".floatA");
		setAttr ($float_math_node + ".operation") 2;
		float $distr=1-$i/($num*1.0);
		setAttr ($float_math_node + ".floatB") $distr;
		connectAttr -f  ($float_math_node + ".outFloat") ($rotator[$i] + ".rotateX");
	}
	BOver9_0_c99bdb5a898efbfb1d4fa2221eba881b($rotator,$selected_jnts);
	string $clusters[];
	string $tmpp[]=`cluster ($curve_name[0] + ".cv[0]") ($curve_name[0]  + ".cv[1]")`;
	float $pos[]=BOver9_0_174b5e03acbe9a8ba7bf83b031094a2e($controls[0]);
	move -a $pos[0] $pos[1] $pos[2] ($tmpp[1] + ".scalePivot") ($tmpp[1] + ".rotatePivot") ;
	$clusters[0]=$tmpp[1];
	$j=1;
	for($i=2;$i<$num_control;$i++)
	{
		$tmpp=`cluster ($curve_name[0] + ".cv[" + $i + "]") `;
		$pos=BOver9_0_174b5e03acbe9a8ba7bf83b031094a2e($controls[$j]);
		move -a $pos[0] $pos[1] $pos[2] ($tmpp[1] + ".scalePivot") ($tmpp[1] + ".rotatePivot") ;
		$clusters[$j]=$tmpp[1];
		$j++;
	}
	$tmpp=`cluster ($curve_name[0] + ".cv[" + $num_control + "]")  ($curve_name[0]  + ".cv[" + ($num_control + 1) + "]") `;
	$pos=BOver9_0_174b5e03acbe9a8ba7bf83b031094a2e($controls[$num_control -1]);
	move -a $pos[0] $pos[1] $pos[2] ($tmpp[1] + ".scalePivot") ($tmpp[1] + ".rotatePivot") ;
	$clusters[$num_control -1]=$tmpp[1];
	BOver9_0_17431451b1be026fdeee93b86579c6b6($controls, $clusters);
	select $controls[$num_control -1] $base_curve_loc[$num-1];
	BOver9_0_dfb2ed0c2c53945ca7515c674763faa0;
	select $controls[0] $base_curve_loc[0];
	BOver9_0_dfb2ed0c2c53945ca7515c674763faa0;
	string $fin_groupp=`group  $base_curve_loc $curve_name  $clusters`;
	xform -piv 0 0 0;
	BOver9_0_4c2952dd9f486573856c8eb6a0dc46ac(0);
	return $fin_groupp;
}
global proc string[] BOver9_0_d646a70340f6ca544557c45c16b7a914(int $second_obj_is_side, float $screen_size)
{
    string $selection[]=`ls-fl-sl`;
    string $objects[];
    string $side_obj;
    string $inner_obj[];
    $curve_name=$selection[0];
	vector $WUV_perp;
    if(size(`filterExpand -sm 9 $selection[0]`)==0)
    {
        warning "select curve first!!!\n ******************************************************";
        return {};
    }
    if($second_obj_is_side==1&&size($selection)<3)
    {
        warning "select 3 and more objects!!! Curve, side object and connect objects!!!!\n ******************************************************";
        return {};
    }
    if($second_obj_is_side==0&&size($selection)<2)
    {
        warning "select 2 and more objects!!! Curve and connect objects!!!!\n ******************************************************";
        return {};
    }
    if($second_obj_is_side==1)
    {
        $side_obj=$selection[1];
        $objects=`ls -tail (size($selection)-2) $selection`;
    }
    else if($second_obj_is_side==2)
	{
		$side_obj=$curve_name;
		$WUV_perp=BOver9_0_b2bb441f7665fb6e6f9e58a22cb5e462($curve_name);
        $objects=`ls -tail (size($selection)-1) $selection`;
	}
	else
    {
        $side_obj="";
        $objects=`ls -tail (size($selection)-1) $selection`;
    }
    for($object in $objects)
    {
        BOver9_0_97bb4fedbc7cf5833843579d493a26a3($curve_name, $side_obj, $object, $WUV_perp);
        appendStringArray($inner_obj,`ls-sl`,1);
    }
    select $inner_obj;
    BOver9_0_6de8028af587b467034457b4d6349f89($screen_size);
    return $inner_obj;
}
global proc string BOver9_0_97bb4fedbc7cf5833843579d493a26a3(string $curve_name, string $top_object, string $object, vector $WUV_perp)
{
	float $time=`currentTime-q`;
	select -cl;
	string $curve_movement_loc[]=BOver9_0_e6d1cc62e700198ddfd8906d663761ba();
	string $inside[]=`ls-sl`;
	$inside=BOver9_0_e706e982298fe9e8f94ae04b06b5d6b2($object + "_CRV");
	addAttr -ln "u"  -at double  -dv 0 $inside[0];
    setAttr -e-keyable true ($inside[0] + ".u");
    BOver9_0_90a059e9200ad500213586e0ecabdd0d($inside,0,0, 1,1) ;
	rotate 0 0 0 $inside;
	$curve_movement_loc[0]=`rename $curve_movement_loc "b_cuv_move"`;
	string $m_path;
	if ($top_object=="")
	    $m_path=`pathAnimation -fractionMode 0 -follow true -followAxis x -upAxis z -worldUpType "scene" -inverseUp false -inverseFront false -bank false -startTimeU $time -endTimeU $time $curve_name $curve_movement_loc[0]`;
	else if($curve_name==$top_object)
        $m_path=`pathAnimation -fractionMode 0 -follow true -followAxis x -upAxis z -worldUpType "objectrotation" -worldUpObject $curve_name  -worldUpVector ($WUV_perp.x) ($WUV_perp.y) ($WUV_perp.z) -inverseUp false -inverseFront false -bank false -startTimeU $time -endTimeU $time $curve_name $curve_movement_loc[0]`;
	else
	    $m_path=`pathAnimation -fractionMode 0 -follow true -followAxis x -upAxis z -worldUpType "object" -worldUpObject $top_object -inverseUp false -inverseFront false -bank false -startTimeU $time -endTimeU $time $curve_name $curve_movement_loc[0]`;
	delete `listConnections  -d 1  -t addDoubleLinear $m_path`;
	connectAttr -f ($m_path + ".allCoordinates") ($curve_movement_loc[0] + ".translate");
	string $near_point_on_crve_node=`createNode nearestPointOnCurve`;
	string $decompose_matrix_node=`createNode decomposeMatrix`;
	connectAttr -f ($object + ".worldMatrix[0]") ($decompose_matrix_node + ".inputMatrix");
	connectAttr -f ($decompose_matrix_node + ".outputTranslate") ($near_point_on_crve_node + ".inPosition");
	string $crve_shape[]=BOver9_0_5e702211108f11813c411c94f8b1b380($curve_name);
	connectAttr -f ($crve_shape[0] + ".worldSpace[0]")  ($near_point_on_crve_node + ".inputCurve");
	float  $tmp_coords[];
	string $marker_names[];
	string $curr_marker;
	$j=0;
	select $m_path;
		$U_V_param=getAttr ($near_point_on_crve_node + ".parameter");
		setAttr ($inside[0] + ".u")$U_V_param;
		connectAttr -f ($inside[0] + ".u") ($m_path + ".uValue");
	select (BOver9_0_cfc20aa23531f881688ec3a171beaae5($m_path));
	BOver9_0_4c2952dd9f486573856c8eb6a0dc46ac(0);
	keyTangent -itt linear -ott linear $m_path;
	delete $near_point_on_crve_node $decompose_matrix_node;
    BOver9_0_847308ac6f1debf8edcc8d63e128d64c({$object}, $inside);
    BOver9_0_17431451b1be026fdeee93b86579c6b6($inside,{$object});
    select $inside;
	return $m_path;
}
global proc string[] BOver9_0_cfc20aa23531f881688ec3a171beaae5(string $m_path)
{
    string $connected_items_by_group[] =`listConnections  -d 1 $m_path`;
    string $buffer[];
    string $markers[];
    $j=0;
    for( $k = 0; $k <size($connected_items_by_group);$k++)
    {
        if(`gmatch $connected_items_by_group[$k] "*positionMarker*"`)
        {
            $markers[$j]=$connected_items_by_group[$k];
            $j++;
        }
    }
    string $obj;
    string $markers_all[];
    $j=0;
    for ($obj in $markers)
    {
        tokenize $obj "->" $buffer;
        $markers_all[$j]=$buffer[1];
        $j++;
    }
    return $markers_all;
}
