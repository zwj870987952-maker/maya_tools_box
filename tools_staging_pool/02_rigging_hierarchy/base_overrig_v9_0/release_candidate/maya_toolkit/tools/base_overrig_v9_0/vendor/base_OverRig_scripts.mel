global proc BOver9_0_95d47209f5832c068ce7614b82201089()
{
	$selection=`ls-sl`;
	$lock_name =` spaceLocator `;
	setKeyframe -at rx -at ry -at rz $lock_name[0];
	$currTime=(`currentTime -q`) -1;
    setKeyframe  -at rx -at ry -at rz -t $currTime;
	string $obj;
	int $rotOrder;
	float $rx,$ry,$rz;
	for($obj in $selection)
	{ 
	    $rotOrder=getAttr($obj + ".rotateOrder");
		$rx=getAttr($obj + ".rx");
		$ry=getAttr($obj + ".ry");
		$rz=getAttr($obj + ".rz");
		setAttr ($lock_name[0] + ".rotateOrder") $rotOrder;
		rotate -a $rx $ry $rz $lock_name[0];
		setKeyframe -at rx -at ry -at rz $lock_name[0];
		filterCurve $lock_name.rotateX $lock_name.rotateY $lock_name.rotateZ;
	    $rx=getAttr($lock_name[0] + ".rx");
		$ry=getAttr($lock_name[0] + ".ry");
		$rz=getAttr($lock_name[0] + ".rz");
		rotate -a $rx $ry $rz $obj;
	}
	delete $lock_name;
	select $selection;
}
global proc BOver9_0_5cb0441daec59a79a525bdb749d48438(string $axis)
{
    $axis=`tolower $axis`;
    string $aim_name[];
	string  $jnt[];
	$selection=`ls -l -sl`;
	if(size($selection)<2)
	{
	    warning "select 2 or more joits";
	    return;
	}
	BOver9_0_8c16c9163e07a819fc2186f2d338a280(1);
	$childrens=BOver9_0_2edf2909df70a7e657b4b646868a0b9c();
	$childrens=`ls -l $childrens`;
	int $have_childrens=0;
	string $ch_locks[];
	string  $par_ch_constrain[];
	if(size($childrens)>0&&($childrens[0]!=$selection[size($selection)-1]))
	{
	    select $childrens;
	    BOver9_0_8c16c9163e07a819fc2186f2d338a280(1);
	    $ch_locks=BOver9_0_54d92f8424c4459e6d996d9fd93902f0();
	    $par_ch_constrain=BOver9_0_17431451b1be026fdeee93b86579c6b6($ch_locks, $childrens);
	    $have_childrens=1;
	}
	select $selection;
	$full_dist=0.0;
	$disst=0.0;
	select -cl;
	$jnt[0]=`joint -p 0 0 0`;
	select -cl;
	for($i=1;$i<size($selection);$i++)
	{
		select -cl;
		$disst = BOver9_0_c7822f1f10b007a6803735c105e40799($selection[$i-1],$selection[$i]);
		$full_dist = $full_dist + $disst;
        if($axis=="x")
            $jnt[$i]=`joint -p $full_dist 0 0`;
        if($axis=="y")
            $jnt[$i]=`joint -p 0 $full_dist 0`;
        if($axis=="z")
            $jnt[$i]=`joint -p 0 0 $full_dist`;
        if($axis=="-x")
            $jnt[$i]=`joint -p (-1*$full_dist) 0 0`;
        if($axis=="-y")
            $jnt[$i]=`joint -p 0 (-1*$full_dist) 0`;
        if($axis=="-z")
            $jnt[$i]=`joint -p 0 0 (-1*$full_dist)`;
	}
	select $jnt;
	BOver9_0_f0209cb5b5931bdfa7ae6801db19a0f8;
	 select $jnt;
	BOver9_0_8c16c9163e07a819fc2186f2d338a280(1);
	select  $selection[0] $jnt[0];
	BOver9_0_9713c7abe7f317a1eaefb22b30d9ce1c;
	int $axis_aim[];
	int $axis_up_vector[];
	int $axis_w_up_vector[];
	if($axis=="x")
	{
	   $axis_aim={1,0,0} ;
	   $axis_up_vector={0,0,-1};
	   $axis_w_up_vector={0,1,0};
	}
	if($axis=="y")
    {
	   $axis_aim={0,1,0} ;
	   $axis_up_vector={-1,0,0};
	   $axis_w_up_vector={0,0,1};
	}
	if($axis=="z")
	{
	   $axis_aim={0,0,1} ;
	   $axis_up_vector={0,-1,0};
	   $axis_w_up_vector={1,0,0};
	}
	if($axis=="-x")
	{
	   $axis_aim={-1,0,0} ;
	   $axis_up_vector={0,0,1};
	   $axis_w_up_vector={0,-1,0};
	}
	if($axis=="-y")
	{
	   $axis_aim={0,-1,0} ;
	   $axis_up_vector={1,0,0};
	   $axis_w_up_vector={0,0,-1};
	}
	if($axis=="-z")
	{
	   $axis_aim={0,0,-1} ;
	   $axis_up_vector={0,1,0};
	   $axis_w_up_vector={-1,0,0};
	}
	$cmd="aimConstraint -offset 0 0 0 -weight 1 -aimVector " + $axis_aim[0] + " " + $axis_aim[1] + " " + $axis_aim[2] + " -upVector " + " " + $axis_up_vector[0] + " " + $axis_up_vector[1] + " " + $axis_up_vector[2] + " -worldUpType \"object\" -worldUpVector  " + " " + $axis_w_up_vector[0] + " " + $axis_w_up_vector[1] + " " + $axis_w_up_vector[2] + " -worldUpObject ";
    if(size($selection)>2)
	{
    	for($i=0;$i<size($jnt)-2;$i++)
    	{
            $aim_name=eval ($cmd + $selection[$i+2] + " " +  $selection[$i+1] + " " + $jnt[$i]);
            delete $aim_name;
    	}
        $aim_name=eval ($cmd +  $selection[$i+1]  + " " +   $selection[$i+1] + " " +   $jnt[$i]);
        delete $aim_name;
    }
    if(size($selection)==2)
	{
         $aim_name=eval ($cmd +  $selection[1]   + " " +   $selection[1]  + " " +   $jnt[0]);
    	delete $aim_name;
	}
	select $selection;
	BOver9_0_3a25eaad774c71ebdcb06ee4d2b25ce3;
	BOver9_0_9a3ce25cfdbc96f0053e2e03715d7f2b;
	catch(`BOver9_0_41b4e3b470ec48427b6ebd4f09a607e7`);
	BOver9_0_5e8af8371c687e5c50d7ded5040ffe13($jnt, $selection);
	BOver9_0_95d47209f5832c068ce7614b82201089();
	delete $jnt;
	if($have_childrens)
	{
	    delete  $par_ch_constrain;
	    delete $ch_locks;
	}
}
global proc BOver9_0_5cca387e40527d14dd0862d275b6a5fc(string $j_chain[], string $axis, string $sao_napr, string $ch_up)
{
    float $sao_napr_angle=0;
    if($sao_napr=="down")
    {
         $sao_napr_angle=180;
    }
    float $ch_angle=0;
    if($ch_up=="change")
    {
         $ch_angle=180;
    }
    $selected=$j_chain;
    select $selected[0];
	    string $or;
        string $up;
        string $aim_V;
        string $up_v;
    if($axis=="x"||$axis=="-x")
    {
	    $or="xyz";
        $up="x" +  $sao_napr;
        $aim_V=" 0 -1 0 ";
        $up_v=" 0 0 1 ";
    }
    if($axis=="y"||$axis=="-y")
    {
        $or="yzx";
        $up="y" +  $sao_napr;
        $aim_V=" 0 0 -1 ";
        $up_v=" 1 0 0 ";
    }
    if($axis=="z"||$axis=="-z")
    {
        $or="zxy";
        $up="z" +  $sao_napr;
        $aim_V=" -1 0 0 ";
        $up_v=" 0 1 0 ";
    }
	$locks_for_aim=BOver9_0_54d92f8424c4459e6d996d9fd93902f0();
	select $selected;
	$max_dist=BOver9_0_18a895830f3c7ec611ca2fbd58e5730f(1);
	float $diist=$max_dist[2];
	vector $coords[]=BOver9_0_72356eaf232b169651a82383ba9e7e57($selected);
	int $ind=BOver9_0_b370e1f695c58fe83552587a1fd52907($coords);
    string $aim_name[];
    string $cmd;
    if ($sao_napr=="up")
        $cmd="aimConstraint -offset 0 0 0 -weight 1 -aimVector " + $aim_V + " -upVector " + $up_v + "-worldUpType \"object\" -worldUpObject " +  $selected[$ind] + " "  + $selected[size($selected)-1] + " "  + $locks_for_aim[0];
    else
        $cmd="aimConstraint -offset 0 0 0 -weight 1 -aimVector " + $up_v  + " -upVector " + $aim_V + "-worldUpType \"object\" -worldUpObject " +  $selected[$ind] + " "  + $selected[size($selected)-1] + " "  + $locks_for_aim[0];
	$aim_name =eval($cmd);
	delete $aim_name;
    $locks_true_position=`duplicate $locks_for_aim`;
	$ori_cstr=`orientConstraint -mo -weight 1 $locks_for_aim $selected[0]`;
	if($sao_napr=="up")
	    rotate -a 0 0 0  $locks_for_aim;
	    else
	    rotate -a 90 90 0  $locks_for_aim;
	delete 	$ori_cstr;
	select $selected;
	makeIdentity -apply true -t 0 -r 1 -s 0 -n 0 -pn 1;
    joint -e  -oj $or -secondaryAxisOrient $up;
    $childrens=`listRelatives -f -c -typ "joint" $selected[size($selected)-1]`;
    if (size($childrens)==0)
    {
    	setAttr ($selected[size($selected)-1] + ".jointOrientX") 0;
        setAttr ($selected[size($selected)-1] + ".jointOrientY") 0;
        setAttr ($selected[size($selected)-1] + ".jointOrientZ") 0;
    }
    $ori_cstr=`orientConstraint -mo -weight 1   $locks_for_aim $selected[0]`;
    select $locks_true_position $locks_for_aim;
    BOver9_0_9a8d2e62249cad27916aacc736478655();
    delete 	$ori_cstr;
    delete $locks_for_aim  $locks_true_position;
    select $selected;
    BOver9_0_a2b81a3977941c0eac1cda769570172c();
    if($axis=="x")
    {
        rotate -r -os -fo ($ch_angle) 0 0 ;
    }
    if($axis=="y")
    {
        rotate -r -os -fo 0 ($ch_angle) 0 ;
    }
    if($axis=="z")
    {
        rotate -r -os -fo 0 0 ($ch_angle) ;
    }
    if($axis=="-x")
    {
        rotate -r -os -fo ($ch_angle-$sao_napr_angle) 0 180 ;
    }
    if($axis=="-y")
    {
        rotate -r -os -fo 180 ($ch_angle-$sao_napr_angle) 0 ;
    }
    if($axis=="-z")
    {
        rotate -r -os -fo 0 180 ($ch_angle-$sao_napr_angle) ;
    }
    BOver9_0_f0209cb5b5931bdfa7ae6801db19a0f8();
    select -cl;
    select $selected;
}
global proc BOver9_0_a9acebc46d5277d92e6d954501ac53c7(string $axis,  string $sao_napr, string $ch_up)
{
    $axis=`tolower $axis`;
    $selection=`ls-sl`;
    BOver9_0_8c16c9163e07a819fc2186f2d338a280(1);
    $kk=size($selection);
    if($kk<2)
    {
        warning "select 2 or more joint";
        return;
    }
    $childrens=BOver9_0_2edf2909df70a7e657b4b646868a0b9c();
    int $have_childrens=0;
	string $ch_locks[];
	string  $par_ch_constrain[];
    if(size($childrens)>0)
    {
        select $childrens;
	    BOver9_0_8c16c9163e07a819fc2186f2d338a280(1);
	    $ch_locks=BOver9_0_54d92f8424c4459e6d996d9fd93902f0();
	    $par_ch_constrain=BOver9_0_17431451b1be026fdeee93b86579c6b6($ch_locks, $childrens);
	    $have_childrens=1;
	    select $selection;
    }
    if(size($childrens)==1)
    {
	    select $selection $childrens;
    }
    $sec_joints=BOver9_0_f2d5a2798ed7cfee36eb77ee8a281ed8();
    $sec_joints2=`ls-head (size($sec_joints)-1) $sec_joints`;
    if(size($childrens)==1)
    {
	    select   $sec_joints2;
    }
	BOver9_0_5cca387e40527d14dd0862d275b6a5fc(`ls-sl`, $axis, $sao_napr, $ch_up);
    select  $sec_joints;
    $lock=BOver9_0_54d92f8424c4459e6d996d9fd93902f0();
    $constr=BOver9_0_c99bdb5a898efbfb1d4fa2221eba881b($lock,$sec_joints);
    select -cl;
    select $sec_joints;
    BOver9_0_3a25eaad774c71ebdcb06ee4d2b25ce3;
    delete $constr;
    delete $lock;
    BOver9_0_95d47209f5832c068ce7614b82201089();
    if(size($childrens)==1)
    {
	    $sec_joints=`ls -head ($kk)  $sec_joints`;
    }
    BOver9_0_5e8af8371c687e5c50d7ded5040ffe13($sec_joints, $selection);
    delete $sec_joints;
    select $selection;
    if($have_childrens)
	{
	    delete  $par_ch_constrain;
	    delete $ch_locks;
	}
}
global proc string[] BOver9_0_18a895830f3c7ec611ca2fbd58e5730f(int $min_max)
{
	$selection=`ls-fl-sl`;
	$TotSize = `size $selection`;
	string $return_pair[];
	float $pi[] = `xform -ws -q -t $selection[0]`;
	float $pj[] = `xform -ws -q -t $selection[1]`;
	float $maxdist = `mag(<<$pi[0],$pi[1],$pi[2]>> - <<$pj[0],$pj[1],$pj[2]>>)`;
	float $distance=$maxdist;
	int $found=0;
	for ($i=0;$i<$TotSize-1;$i++)
	{
		for ($j=$i+1; $j<$TotSize; $j++)
		{
			$pi = `xform -ws -q -t $selection[$i]`;
			$pj = `xform -ws -q -t $selection[$j]`;
			$distance = `mag(<<$pi[0],$pi[1],$pi[2]>>-<<$pj[0],$pj[1],$pj[2]>>)`;
			if($min_max==1)
			{
				if ($distance > $maxdist || $found==0)
				{
				    $found=1;
					$maxdist = $distance;
					$return_pair[0]=$selection[$i];
					$return_pair[1]=$selection[$j];
					$return_pair[2]=$maxdist;
				}
			}
			if($min_max==0)
			{
				if ($distance <= $maxdist || $found==0)
				{
					$found=1;
					$maxdist = $distance;
					$return_pair[0]=$selection[$i];
					$return_pair[1]=$selection[$j];
					$return_pair[2]=$maxdist;
				}
			}
		}
	}
return $return_pair;
}
global proc BOver9_0_d1f6eb5ab8caa780647f498704025cf1()
{
    $selection=`ls-l-sl`;
    $b_lock=BOver9_0_54d92f8424c4459e6d996d9fd93902f0();
    string  $locks[];
    string  $constr[];
    $constr_point=BOver9_0_4a0278149f801323f33f7bb9e4ee597d($b_lock, $selection);
    select $selection;
    $children=BOver9_0_2edf2909df70a7e657b4b646868a0b9c();
    if(size($children)>0)
    {
        select $children;
        $locks=BOver9_0_54d92f8424c4459e6d996d9fd93902f0();
        $constr=BOver9_0_17431451b1be026fdeee93b86579c6b6($locks, $children);
    }
    select $selection;
    catchQuiet (`BOver9_0_3a25eaad774c71ebdcb06ee4d2b25ce3`);
    BOver9_0_9a3ce25cfdbc96f0053e2e03715d7f2b;
    catchQuiet (`delete $constr_point $constr`);
    catchQuiet (`delete $locks $b_lock`);
}
global proc string[] BOver9_0_e34225338b41391d68d09634ca599397(int $return_scene_like_first)
{
    $selection=`ls-l-sl`;
    string $parents[];
    string $tmp[];
    $i=0;
    string $s_selection[];
    for($obj in  $selection)
    {
        $s_selection[$i]=$selection[$i];
        $tmp=`listRelatives -f  -p $obj`;
        $parents[$i]= $tmp[0];
        if (size($tmp)==0&&$return_scene_like_first==0)
        {
            $parents[$i]="";
        }
        if (size($tmp)==0&&$return_scene_like_first==1)
        {
            $parents[$i]=$obj;
            $s_selection[$i]="";
        }
        $i++;
    }
    $diff = stringArrayRemove($s_selection, $parents);
    $diff =`ls-fl $diff`;
    return $diff;
}
global proc string[] BOver9_0_a2b81a3977941c0eac1cda769570172c()
{
    string $uuid_selection[] = `ls -uuid -sl`;
    string $selection[]=`ls-sl`;
    string $fin_names[];
    string $joint_uid[]={};
    string $rootj,$uuid_root[];
    string $in_place_tmp_j;
    for($uid in $uuid_selection)
    {
        $tmppp=`ls -uuid $uid `;
        if(objectType($tmppp[0])=="joint")
            appendStringArray($joint_uid,{$uid},1);
        else
            catchQuiet( `parent -w $tmppp[0]`);
    }
    for($uid in $joint_uid)
    {
        $tmppp=`ls -uuid $uid `;
        select $tmppp;
        $rootj=BOver9_0_933d4aecbe9d9d0ce9a6591c5b2e3770($tmppp[0]);
        $uuid_root=`ls -uuid $rootj`;
        if($uuid_root[0]!= $uid)
        {
            $tmp_j=`joint`;
            $in_place_tmp_j=`disconnectJoint  $tmppp[0]`;
            delete $tmp_j  $in_place_tmp_j;
        }
        else
            catchQuiet( `parent -w $tmppp[0]`);
    }
    $fin_names=`ls -uuid $uuid_selection`;
    select -cl;
    select $fin_names;
    return $fin_names ;
}
global proc string BOver9_0_20a28b95c1b8b4dd29397ab332dbc667()
{
    $currentPanel = `getPanel -withFocus`;
    $error=catch($cam_name=`modelEditor -q -camera  $currentPanel`);
    if($error)
    {
        $cam_name="no model panel viewport";
    }
    return $cam_name;
}
global proc string[] BOver9_0_e52ed91bd5c84901d59d7d8a0117fc7e(float $radius)
{
	$selection = `ls -fl -sl `;
	string $curve_sphere[];
	if(size($selection)>0)
	{
		for($i=0;$i<size($selection);$i++)
		{
			$curve_sphere[$i]=BOver9_0_7d16a2aa6cdd056e3f3dfb7d19faef75($radius);
		}
		BOver9_0_847308ac6f1debf8edcc8d63e128d64c( $selection, $curve_sphere);
		BOver9_0_7f958423a7cfe1774157efdcb79ac0be( $selection,$curve_sphere);
	}
	else
	{
		$curve_sphere[0]=BOver9_0_7d16a2aa6cdd056e3f3dfb7d19faef75($radius);
	}
   select $curve_sphere ;
   return $curve_sphere;
}
global proc string BOver9_0_7d16a2aa6cdd056e3f3dfb7d19faef75(float $radius)
{
	string $curves[];
	clear $curves;
	$crv=`curve -d 1 -p 0 0 0  -p 1 0 0 -p 0.69 0 -0.08 -p 1 0 0 -p  0.69 0 0.08 -p  1 0 0`;
	scale  $radius $radius $radius $crv;
	makeIdentity -apply true -t 1 -r 1 -s 1 -n 0 -pn 1;
	catchQuiet(`setAttr -lock true ($crv + ".rcurve")`);
	catchQuiet(`setAttr -lock true ($crv + ".cwdth")`);
	catchQuiet(`setAttr -lock true ($crv + ".srate")`);
	catchQuiet(`setAttr -lock true ($crv + ".ai_curve_shaderr")`);
	catchQuiet(`setAttr -lock true ($crv + ".ai_curve_shaderg")`);
	catchQuiet(`setAttr -lock true ($crv + ".ai_curve_shaderb")`);
	return $crv;
}
global proc string[] BOver9_0_46e3c16f7c510db12bc5343ac1a842b6(int $color, int $template, int $show_outliner)
{
	$selection=`ls-sl`;
	$curv=BOver9_0_a8d1933a966541e62d79a2fcbf6e4ea4(1);
	if($color)
		BOver9_0_cc20e95399a3b6da44eb78e45451d764($color);
	if( $template)
		BOver9_0_8071326ac26a590fcb224ddba406d389();
	string $tmpp[];
	string $curves[] = `listRelatives -f -shapes -type "nurbsCurve" $curv`;
	int $numCVs = `getAttr -size ($curves[0] + ".controlPoints")`;
	string $cluster_names[];
	clear $cluster_names;
	for($i=0;$i<$numCVs;$i++)
	{
		$tmpp=`cluster -envelope 1 ($curv + ".cv[" + $i + "]")` ;
		$cluster_names[$i]=$tmpp[1];
	}
	BOver9_0_32a3829df17c3736d9757e423eeaf0e3($selection,$cluster_names);
	select  $cluster_names;
	BOver9_0_4c2952dd9f486573856c8eb6a0dc46ac(0);
	select $curv;
	select -add  $cluster_names;
	BOver9_0_1b3bfd1d62d966ea966f5caca72bac5d(`ls-sl`, $show_outliner);
	BOver9_0_aa074854107180f09880ea0e8edd43f8;
	BOver9_0_b6a5017ee305f5ba0bbf3116243cc3af;
	BOver9_0_1f3f21e017b74355329202016bf1b177;
	BOver9_0_ade4e354383a28fcefcaf5ce40e6639d;
	string $ret[]=`ls-sl`;
	select $selection;
	return $ret;
}
global proc BOver9_0_1b3bfd1d62d966ea966f5caca72bac5d(string $objects[], int $hidden)
{
    string $shapes[];
    for ($obj in $objects)
    {
        setAttr ($obj  +  ".hiddenInOutliner") $hidden;
        $shapes=BOver9_0_5e702211108f11813c411c94f8b1b380($obj);
        for($shape in $shapes)
        {
             setAttr ($shape  +  ".hiddenInOutliner") $hidden;
        }
    }
}
global proc string[] return_constrained_object(int $select)
{
    string $p_nodes[], $connection[], $tmpeps[], $obj,$const,$connect;
    string $constraints[]={"parentConstraint","orientConstraint","pointConstraint","aimConstraint"};
    string $selected[]=`ls-l-sl`;
	if(size($selected)==0)
	{
		warning "select KNOT or AIM locator";
		return {};
	}
	for($obj in  $selected)
        for($const in $constraints)
            appendStringArray($connection, ($tmpeps=`listConnections  -type $const $obj`),size( $tmpeps));
    $connection= stringArrayRemoveDuplicates($connection);
    for ($connect in $connection)
        appendStringArray($p_nodes,`listRelatives -f -p $connect `,1);
    $p_nodes= stringArrayRemoveDuplicates($p_nodes);
    if($select)
        select $p_nodes;
    return $p_nodes;
}
global proc string find(string $procedure)
{
	string $path= `whatIs($procedure)`;
	string $fullPath=`substring $path 25 999`;
	system("load " + $fullPath);
	return $fullPath;
}
global proc string BOver9_0_4b209c5c00abddc3e3509a14326e2488(string $objects[], string $name_set)
{
    string $selected[]=`ls-sl`;
	string $createSetResult;
	select $objects;
    if( (`objExists($name_set)`) && (`objectType($name_set)` == "objectSet"))
        sets -edit -forceElement $name_set;
    else
        $createSetResult = `sets -name $name_set`;
	select $selected;
    return $createSetResult;
}
global proc BOver9_0_76e4594d663c1d36640d38425e50d327(string $objects[], string $name_set)
{
    if( (`objExists($name_set)`) && (`objectType($name_set)` == "objectSet"))
        {
          sets -rm $name_set;
         if(`sets -q -s $name_set`==0)
             delete $name_set;
        }
}
global proc BOver9_0_d04a25c84de52f4787d68215d32315e0(int $type, string $objcts[])
{
    for($obj in $objcts)
        catchQuiet(`setAttr ($obj + ".rotateOrder") $type`);
}
global proc delete_constraint_attributes_on_objects(string $objects[])
{
    string $attr[],$obj,$att;
    for($obj in $objects)
    {
        $attr=`listAttr -r -st "blendParent*" -st "blendOrient*" -st "blendPoint*" -st "blendAim*" -st "MaxHandle*" $obj `;
        for($att in $attr)
        {
            cutKey -cl -t ":" -f ":" -at $att $obj;
            catch (`deleteAttr -attribute $att $obj`);
        }
    }
}
global proc BOver9_0_7f958423a7cfe1774157efdcb79ac0be(string $target_position[], string $object_to_move[])
{
	if(size($target_position)!=size($object_to_move))
		warning "size objects to rotate is DIFFERENT!!! Only relevant objects will be processed! This can lead to unexpected consequences!!!!";
	if(size($target_position)> size($object_to_move))
		$target_position=`ls -head (size($object_to_move)) $target_position`;
	float $Rot[];
	for($i=0;$i<size($target_position);$i++)
	{
		$Rot = `xform -q -ro -ws $target_position[$i]`;
		rotate -ws $Rot[0] $Rot[1] $Rot[2] $object_to_move[$i];
		rotate -ws $Rot[0] $Rot[1] $Rot[2] $object_to_move[$i];
		rotate -ws $Rot[0] $Rot[1] $Rot[2] $object_to_move[$i];
	}
}
global proc string  BOver9_0_933d4aecbe9d9d0ce9a6591c5b2e3770(string $jnt)
{
    string $selected[]=`ls -l $jnt`;
    string $buffer[];
    string $root;
    $buffer=BOver9_0_465f2c70f8e4bf417e93834f61ee4f6e($selected[0], "|");
    string $var[]={};
    for($i=1;$i<size($buffer);$i++)
        $var[$i]=$var[$i-1]+"|"+$buffer[$i];
    for($i=1;$i<size($var);$i++)
    {
        if(`objectType $var[$i]`=="joint")
        {
            $root=$var[$i];
            break;
        }
    }
    return $root;
}
global proc vector[] BOver9_0_72356eaf232b169651a82383ba9e7e57(string $objects[])
{
    vector $vec_pos[];
    $i=0;
	float $pos[];
   for($obj in $objects)
   {
       $pos=BOver9_0_8598296823aa3af15686cb0d78f1615d($obj);
       $vec_pos[$i]=<<$pos[0],$pos[1],$pos[2]>>;
       $i++;
   }
   return $vec_pos;
}
global proc float BOver9_0_a358a7c27f7a7b80712d695138ed032e(string $objects[], int $average)
{
    float $distance;
    for($i=0;$i<size($objects)-1;$i++)
        $distance=$distance + BOver9_0_c7822f1f10b007a6803735c105e40799($objects[$i] , $objects[$i+1]);
    if($average)
         $distance=$distance/(size($objects)-1);
    return $distance;
}
global proc int BOver9_0_b370e1f695c58fe83552587a1fd52907(vector $coords[])
{
	$num=size($coords);
	$posA= $coords[0];
	$posB=$coords[$num-1];
	float $dists[];
	for($i=1;$i<$num-1;$i++)
	{
		$dists[$i]=BOver9_0_476390711655739e4d4919b7f7336b00($posA,$posB,$coords[$i]);
	}
	$index=BOver9_0_d0a0b515ba819d3c77adb0bbe48cfd1d( $dists,1);
	return $index;
}
global proc vector BOver9_0_e3bea614176fbceebe7c7aae67e953b0(vector $coords[])
{
	int $num = `size $coords`;
	vector $ff;
	for ($each in $coords)
	    $ff+=$each;
	$ff=($ff/$num);
	return $ff;
}
global proc int BOver9_0_d0a0b515ba819d3c77adb0bbe48cfd1d(float $massive[],int $min_max)
{
    $num=`size $massive`;
    int $number;
    string $str_ind_massive[];
    string $buffer[];
    for($i=0;$i<$num;$i++)
    {
        $str_ind_massive[$i]=$massive[$i] + ";" + $i;
    }
     $massive=`sort  $massive`;
     float $znach=$massive[0];
     if($min_max==1)
     {
	     if($num>0)
            $znach=$massive[$num-1];
         else
            $znach=$massive[$num];
     }
     string $obj;
     for($obj in $str_ind_massive)
     {
         tokenize $obj ";" $buffer;
         if($buffer[0]==$znach)
         {
             $number=$buffer[1];
             break;
         }
     }
     return $number;
}
global proc float BOver9_0_f71c299bf7b53f7243b078a9990e581c(float $input)
{
   string $un=`currentUnit -query -linear`;
   float $output;
   float $coeff;
   if($un=="mm")
       $coeff=0.1;
   if($un=="cm")
       $coeff=1;
   if($un=="m")
       $coeff=100;
   if($un=="km")
       $coeff=100000;
   if($un=="in")
       $coeff=2.54;
   if($un=="ft")
       $coeff=30.48;
   if($un=="yd")
       $coeff=91.44;
   if($un=="mi")
       $coeff=160934.4;
    $output =  $input/$coeff;
    return $output;
}
global proc string BOver9_0_e8f0c3b3e6300189aca31ae83320ec92(string $node_name_mask)
{
	$connected_nodes=`listConnections -t node`;
	string $nodename;
	int $has_connect_to_recalculate=0;
	string $obj;
	for($obj in $connected_nodes)
		{
		   if(`gmatch $obj $node_name_mask`)
		   {
		   $nodename=$obj;
		   $has_connect_to_recalculate=1;
		   }
		}
		return  $nodename;
}
