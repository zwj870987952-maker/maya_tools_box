global proc BOver9_0_90a059e9200ad500213586e0ecabdd0d(string $objects[], int $t_lock, int $r_lock, int $s_lock, int $v_lock)
{
    if(!size($objects))
        return;
    string $obj;
    for($obj in $objects)
    {
        if($t_lock==1)
        {
            setAttr ($obj + ".tx") -lock 1;
            setAttr ($obj + ".ty") -lock 1;
            setAttr ($obj + ".tz") -lock 1;
        }
        if($t_lock==0)
        {
            setAttr -lock false ($obj + ".translate");
            setAttr ($obj + ".tx") -lock 0;
            setAttr ($obj + ".ty") -lock 0;
            setAttr ($obj + ".tz") -lock 0;
        }
        if($t_lock==2)
        {
            setAttr ($obj + ".tx") -lock (!`getAttr -lock ($obj + ".tx")`);
            setAttr ($obj + ".ty") -lock (!`getAttr -lock ($obj + ".ty")`);
            setAttr ($obj + ".tz") -lock (!`getAttr -lock ($obj + ".tz")`);
        }
        if($r_lock==1)
        {
            setAttr ($obj + ".rx") -lock 1;
            setAttr ($obj + ".ry") -lock 1;
            setAttr ($obj + ".rz") -lock 1;
        }
        if($r_lock==0)
        {
            setAttr -lock false ($obj + ".rotate");
            setAttr ($obj + ".rx") -lock 0;
            setAttr ($obj + ".ry") -lock 0;
            setAttr ($obj + ".rz") -lock 0;
        }
        if($r_lock==2)
        {
            setAttr ($obj + ".rx") -lock (!`getAttr -lock ($obj + ".rx")`);
            setAttr ($obj + ".ry") -lock (!`getAttr -lock ($obj + ".ry")`);
            setAttr ($obj + ".rz") -lock (!`getAttr -lock ($obj + ".rz")`);
        }
        if($s_lock==1)
        {
            setAttr ($obj + ".sx") -lock 1;
            setAttr ($obj + ".sy") -lock 1;
            setAttr ($obj + ".sz") -lock 1;
        }
        if($s_lock==0)
        {
            setAttr -lock 0 ($obj + ".scale");
            setAttr ($obj + ".sx") -lock 0;
            setAttr ($obj + ".sy") -lock 0;
            setAttr ($obj + ".sz") -lock 0;
        }
        if($s_lock==2)
        {
            setAttr ($obj + ".sx") -lock (!`getAttr -lock ($obj + ".sx")`);
            setAttr ($obj + ".sy") -lock (!`getAttr -lock ($obj + ".sy")`);
            setAttr ($obj + ".sz") -lock (!`getAttr -lock ($obj + ".sz")`);
        }
        if($v_lock==1)
            setAttr ($obj + ".v") -lock 1;
        if($v_lock==0)
            setAttr ($obj + ".v") -lock 0;
        if($v_lock==2)
            setAttr ($obj + ".v") -lock (!`getAttr -lock ($obj + ".v")`);
    }
}
global proc BOver9_0_7bb1bcd646c2647ac3ab09dc70126b5c(string $objs[], string $attrib)
{
	string $ff;
	int $gg;
	for ($i=0; $i<size($objs);$i++)
	{
		$ff = `connectionInfo -sfd ($objs[$i] + $attrib)`;
		$gg = `gmatch $ff "*Constraint*"`;
		if (!$gg)
			setAttr -lock false ($objs[$i] + $attrib);
	}
}
global proc BOver9_0_cc20e95399a3b6da44eb78e45451d764(int $color)
{
	string $objs[] = `ls-sl`;
	if(!size($objs))
		return;
	for($i=0;$i<size($objs);$i++)
	{
		catchQuiet(`setAttr ($objs[$i] + ".overrideEnabled") 1`);
		catchQuiet(`setAttr -lock false ($objs[$i] + ".overrideColor") $color`);
	}
}
global proc BOver9_0_ea29f12459b08b7b0796eaa3f3cb0ac6(int $d_type)
{
	string $objs[] = `ls-sl`;
	if(!size($objs))
		return;
	string $shapes[];
	string $obj;
	for($obj in $objs)
	{
	    $shapes=`listRelatives -shapes  $obj`;
	    for($shape in $shapes)
	    {
	     catchQuiet(`setAttr ($shape + ".overrideEnabled") 1`);
		 catchQuiet(`setAttr -lock false ($shape + ".overrideDisplayType") $d_type`);
		}
	}
}
global proc BOver9_0_c7778d9b5fb99a9fe750d3c73c32b9d9(string $objects[], float $local_scale, int $colore)
{
    if(!size($objects))
        return;
    string $obj;
	float $local_scale_lock=BOver9_0_f71c299bf7b53f7243b078a9990e581c($local_scale)*BOver9_0_f71c299bf7b53f7243b078a9990e581c(1);
    for($obj in $objects)
    {
        catchQuiet(`setAttr ($obj + ".overrideEnabled") 1`);
		catchQuiet(`setAttr -lock false ($obj + ".overrideColor") $colore`);
	    catchQuiet (`setAttr ($obj + ".localScaleX") $local_scale_lock`);
		catchQuiet (`setAttr ($obj + ".localScaleY") $local_scale_lock`);
		catchQuiet (`setAttr ($obj + ".localScaleZ") $local_scale_lock`);
		catchQuiet (`setAttr ($obj + ".radius") $local_scale`);
    }
}
