global proc string[] BOver9_0_b25c8b5dbe1b800e5676f04de22544c6(string $face_name)
{
	string $quad_poly_edges[], $edges[];
	float $max_len=-1, $curr_len=-1;
	int $max_i,$max_j,$i,$j;
	$quad_poly_edges=`polyListComponentConversion -ff -te $face_name` ;
	$quad_poly_edges=`ls -fl $quad_poly_edges`;
	vector $edge_center[];
	float $tmp_coord[];
	for($i=0;$i<size($quad_poly_edges);$i++)
	{
		$tmp_coord=BOver9_0_8598296823aa3af15686cb0d78f1615d($quad_poly_edges[$i]);
		$edge_center[$i]=<<$tmp_coord[0],$tmp_coord[1],$tmp_coord[2]>>;
	}
	for($i=0;$i<size($quad_poly_edges)-1;$i++)
		for($j=$i+1;$j<size($quad_poly_edges);$j++)
		{
		  $curr_len=mag($edge_center[$i]-$edge_center[$j])  ;
		  if($curr_len>$max_len)
		  {
			  $max_len=$curr_len;
			  $max_i=$i;
			  $max_j=$j;
		  }
		}
	$edges={$quad_poly_edges[$max_i],$quad_poly_edges[$max_j]};
	return $edges;
}
global proc float[] BOver9_0_9de233870ac6b9c5087a491c3b4ca38a(string $objects[])
{
	float $distanse_all[];
	float $distanse_all_normalized[];
	float $weight_all[];
	float $getPvPos[];
    $getPvPos=BOver9_0_174b5e03acbe9a8ba7bf83b031094a2e( $objects[size($objects)-1]);
	vector $end_point = <<$getPvPos[0], $getPvPos[1], $getPvPos[2]>>;
	for($i=0;$i<(size($objects)-1);$i++)
	{
        $getPvPos=BOver9_0_174b5e03acbe9a8ba7bf83b031094a2e($objects[$i]);
		vector $start_point = <<$getPvPos[0], $getPvPos[1], $getPvPos[2]>>;
		$distanse_all[$i]=mag($start_point - $end_point);
	}
	$sort_dist=`sort $distanse_all`;
	float $max_dist = $sort_dist[size($sort_dist)-1];
	float $min_dist = $sort_dist[0];
	if($min_dist>0)
	{
		for($i=0;$i<size($distanse_all);$i++)
		{
			$distanse_all_normalized[$i]=$distanse_all[$i]/$max_dist;
			$weight_all[$i]=1/$distanse_all_normalized[$i] ;
		}
	}
	else
	{
		for($i=0;$i<size($distanse_all);$i++)
		{
			if($distanse_all[$i])
				$weight_all[$i]=0;
			else
				$weight_all[$i]=1;
		}
	}
	float $summ=0;
	for($obj in $weight_all)
	    $summ+=$obj;
	float $weight_all_normi[];
	for($i=0;$i<size($weight_all);$i++)
	    $weight_all_normi[$i]=$weight_all[$i]/$summ;
	return $weight_all_normi;
}
global proc BOver9_0_15760bd5ac6225f582185bab24346a67(float $subScale)
{
	float $dist=50;
	$subScale=BOver9_0_f71c299bf7b53f7243b078a9990e581c($subScale);
	string $sel[]=`ls-head 1 -sl`;
	string $camera_name="";
	float $camera_scale=1;
	catchQuiet( $camera_name= BOver9_0_20a28b95c1b8b4dd29397ab332dbc667());
	if( $camera_name =="no model panel viewport")
	    $camera_name="persp";
	catchQuiet( $camera_scale=`getAttr ($camera_name + ".cameraScale")`);
	catchQuiet( $dist=BOver9_0_c7822f1f10b007a6803735c105e40799($sel[0], $camera_name));
	catchQuiet( $camera_ortograf=`getAttr ($camera_name + ".orthographic")`);
	catchQuiet( $camera_orthographicWidth=`getAttr ($camera_name + ".orthographicWidth")`);
	if(!$camera_ortograf)
	    catchQuiet(BOver9_0_92de112c5c170c44ad9daf4d48b1acdd (($dist/25)*$subScale* (1/`jointDisplayScale -q`)*$camera_scale));
	else
	    catchQuiet(BOver9_0_92de112c5c170c44ad9daf4d48b1acdd (($camera_orthographicWidth/25)*$subScale* (1/`jointDisplayScale -q`)*$camera_scale));
}
