{
	string $objs[] = `ls-sl`;
	for($obj in $objs)
	{
		if(!`getAttr -lock ($obj + ".rx") `)
			setAttr ($obj + ".rx") 0;
		if(!`getAttr  -lock ($obj + ".ry") `)
			setAttr ($obj + ".ry") 0;
		if(!`getAttr  -lock ($obj + ".rz")`)
			setAttr ($obj + ".rz") 0;
