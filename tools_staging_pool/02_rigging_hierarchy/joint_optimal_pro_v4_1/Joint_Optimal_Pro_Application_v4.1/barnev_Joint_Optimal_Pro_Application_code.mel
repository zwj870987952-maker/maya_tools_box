            -p "skeleton_scripts" -cl 0 -cll true -l "MIRRORING"`;
	columnLayout -adj 1-p   $fral "mirr";
	rowLayout -parent "mirr"  -adj 3 -numberOfColumns 5 ;
	    button  -h $mid_button_h -w $btnn_w  -command "JOPA_4_1_911ce829ffadd631db0afd6c10b8a9c1()" -annotation "multiply mirror tool" "MultiMirror";
	    button  -h $mid_button_h -w ($btnn_w/4) -command "MirrorJointOptions;" -annotation "maya mirror tool options"  "o";
	    text -label " - maya mirror tool" -annotation "maya mirror tool";
	    button
			-h $mid_button_h -w ($btnn_w)
			-bgc 0.8 0.9 0.9
			-command "JOPA_4_1_9e849622a64e61725d0526208e8aee88"
			-annotation "myrror of extra bones on the other side. Option from mirror joints optionbox"  "mirror extra";
columnLayout -p $fral -adj 1  "coloring";
 	int $index_values[]={ 1, 13, 18, 22 ,14 , 4, 16, 3, 6, 12, 15, 19, 29, 30, 27, 17,2,15,20};
	string $index_val_string="{" + $index_values[0];
	for($i=1; $i<size( $index_values); $i++)
	{
	    $index_val_string =$index_val_string + "," + $index_values[$i];
	}
   $index_val_string =$index_val_string + "}";
	$maxOverrideColors =size ($index_values);
    $formOffset = 2;
    $mainWindow = "coloring";
    $mainLayout = `formLayout -parent $mainWindow`;
    $columns = $maxOverrideColors / 2;
    $rows = 2;
    $cellWidth = 17;
    $cellHeight = 17;
    $colorPalette = `palettePort -dimensions $columns $rows
                                 -transparent 0
                                 -width ($columns * $cellWidth)
                                 -height ($rows * $cellHeight)
                                 -topDown 1
                                 -colorEditable 0`;
    print $colorPalette;
    int $index;
    for ($index = 1; $index < $maxOverrideColors-1;  $index++)
    {
        $colorComponent = `colorIndex -q $index_values[$index]`;
        palettePort -e -rgbValue $index $colorComponent[0] $colorComponent[1] $colorComponent[2] $colorPalette;
    }
    palettePort -e -rgbValue 0 0.6 0.6 0.6 -cc ("JOPA_4_1_feece4078c8aeb0c08bb278bcaf1bd05(`palettePort -q -setCurCell " + $colorPalette + "`, " + $index_val_string + ")") $colorPalette;
    formLayout -e -attachForm $colorPalette "top" $formOffset $mainLayout;
    formLayout -e -attachForm $colorPalette "left" $formOffset $mainLayout;
    formLayout -e -attachForm $colorPalette "right" $formOffset $mainLayout;
 		columnLayout -adj 1  -ann $jopa_version -parent "skeleton_scripts" "podpis";
    	text  -h ($base_text_height+5)  -p  "podpis" -al "center" -ww false  -l "autor  Pavel Barnev       pavel_barnev2000@mail.ru";
 }
