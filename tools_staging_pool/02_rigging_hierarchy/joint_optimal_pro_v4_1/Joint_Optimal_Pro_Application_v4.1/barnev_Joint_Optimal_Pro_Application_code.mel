global proc JOPA_4_1_de88efca2929f0080ae1d45ff5db42d4()
{
	$selection=`ls-sl`;
    $mayaVersion = `getApplicationVersionAsFloat` ;
    string $eval_mode[];
    if ($mayaVersion>=2016)
    {
        $eval_mode=`evaluationManager -q -mode`;
		if($eval_mode[0]!="off")
			evaluationManager -mode "off";
    }
    $min=`playbackOptions -q -ast`;
    $max=`playbackOptions -q -aet`;
    $its_baked=catchQuiet (`bakeResults -sm 1 -s false -t ($min+":"+$max) $selection`);
	if ($mayaVersion>=2016)
    {
		if($eval_mode[0]!="off")
			evaluationManager -mode $eval_mode[0];
    }
    if($its_baked)
    {
        warning "select something!";
    }
}
global proc JOPA_4_1_d1b73d0512bac8d20998bdbab9b3aed7(string $target[], string $object[])
{
	int $ro;
	for($i=0;$i<size($target);$i++)
	{
		$ro=`getAttr($target[$i] + ".rotateOrder")`;
		setAttr ($object[$i] + ".rotateOrder")$ro;
	}
}
global proc JOPA_4_1_3a25eaad774c71ebdcb06ee4d2b25ce3()
{
	string $objs[] = `ls-sl`;
	for($obj in $objs)
	{
	    if(`objectType -i "joint" $obj`)
	    {
    		if(!`getAttr -lock ($obj + ".jointOrientX")`)
    			setAttr ($obj + ".jointOrientX") 0;
    		if(!`getAttr  -lock ($obj + ".jointOrientY") `)
    			setAttr ($obj + ".jointOrientY") 0;
    		if(!`getAttr  -lock ($obj + ".jointOrientZ")`)
    			setAttr ($obj + ".jointOrientZ") 0;
    	}
	}
}
global proc JOPA_4_1_9a3ce25cfdbc96f0053e2e03715d7f2b()
{
	string $objs[] = `ls-sl`;
	for($obj in $objs)
	{
		if(!`getAttr -lock ($obj + ".rx") `)
			setAttr ($obj + ".rx") 0;
		if(!`getAttr  -lock ($obj + ".ry") `)
			setAttr ($obj + ".ry") 0;
		if(!`getAttr  -lock ($obj + ".rz")`)
			setAttr ($obj + ".rz") 0;
