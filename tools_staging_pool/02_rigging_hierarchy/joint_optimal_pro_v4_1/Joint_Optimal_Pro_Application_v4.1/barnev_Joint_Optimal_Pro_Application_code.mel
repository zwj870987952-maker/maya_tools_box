barnev_Joint_Optimal_Pro_Application
Author: Pavel Barnev pavel_barnev2000@mail.ru
This tool is intended for:
    Full  toolset for creating and orienting skeletons
	most of these tools work not only with bones, but in general with any objects
     Include:
	 - several ways to create bones
	 - including a unique method of adding bones to a nonlinear chain
	 - tools for quickly parenting
	 - a set of tools for alignment, smoothing and bone distribution
	 - a set of tools for selection bones, including a unique tool for selection the shortest path between two bones
	 - a set of tools for orienting bones - automatic and manual
	 - tool for painting bones in various colors
	 - a set of tools for quick naming, searching for matching names for removing namespaces, etc.
Installation:
    Unpack the .zip file to any place on the disk where you are comfortable
    Open Maya.
    Drag and drop file:
    drag_and_drop_THIS_FILE_on_maya_window_for_install_Joint_Optimal_Pro_Application.mel
    To an open MAYA window. An icon will appear in the Custom tab of the Shelf Editor.
	JOPA_skeleton_tools_menue()
*/
global proc JOPA_skeleton_tools_menue()
{
	if(`window -q -ex "create_skeleton_tools"`)deleteUI("create_skeleton_tools");
		if(`dockControl -q -ex "JointOPtimalAalign"`)deleteUI("JointOPtimalAalign");
	string $jopa_version="version J.O.P.A.   4.1";
	window  -w 250 -minimizeButton false -resizeToFitChildren true -maximizeButton false -title $jopa_version -titleBar true -menuBar true "create_skeleton_tools";
	selectPref  -trackSelectionOrder 1;
	string $final_name;
	$separator_len=300;
	float $red[]={0.7,0.4,0.5};
	float $blue[]={ 0.3, 0.3,0.5};
	float $green[]={0.4,0.6,0.4};
	$small_button_h=16;
	$mid_button_h=19;
	$sep_h=2;
	$base_text_height=12;
	tabLayout -ann $jopa_version -tv 1 "tabLayout2";
{
	columnLayout
			-p "tabLayout2"
			-adj  true
			"skeleton_scripts";
string $fral=`frameLayout
            -bgc $red[0] $red[1] $red[2]
            -mh 0
            -mw 1
			-ann $jopa_version
            -cc " window -e -h 500 create_skeleton_tools"
            -p "skeleton_scripts" -cl 0 -cll true -l "CREATING JOINTS"`;
	columnLayout  -adj 1 -p $fral   "jnts_create";
        rowLayout -parent "jnts_create"  -numberOfColumns 3 ;
		int $btnn_w=100;
        	button -h $mid_button_h  -w $btnn_w -command "setToolTo jointContext;" -annotation "standard maya joint creation tool"  "Create Joints tool";
        	button -h $mid_button_h -w ($btnn_w/4 )-command "setToolTo jointContext; toolPropertyWindow" -annotation "standard maya joint creation tool options"  "o";
        	text -label " - create joint tool" -annotation "create joint standart maya tool";
         rowLayout -parent "jnts_create"  -numberOfColumns 3 ;
        	button -h $mid_button_h -w $btnn_w -command "repeatLast -ac \"JOPA_4_1_6d2bbf47e863c2f0037cf0467b97cef6\" -acl \"create joints \";JOPA_4_1_6d2bbf47e863c2f0037cf0467b97cef6;" -annotation "create a joint in the center of the selected vertices" "joint on center";
        	text -label " - joint vtx center" -annotation "create a joint in the center of the selected vertices";
         rowLayout -parent "jnts_create"  -numberOfColumns 3 ;
        	button -h $mid_button_h -w $btnn_w -command " repeatLast -ac \" JOPA_4_1_a724b4b2abdd9e942758573c2c47afe6(100) \" -acl \"create joints \"; JOPA_4_1_a724b4b2abdd9e942758573c2c47afe6(100);" -annotation "create joints on selected  - not more than 100" "joint";
        	text -label " - joints on selected" -annotation "create joints on selected";
 		rowLayout -p "jnts_create" -numberOfColumns 2 ;
			button   -h $mid_button_h -w $btnn_w -command "repeatLast -ac \"select (`JOPA_4_1_d3cdf2488e5fc40a8060f5da3e93637a`)\" -acl \"create joints and parent \"; select (`JOPA_4_1_d3cdf2488e5fc40a8060f5da3e93637a`)"  -ann "create joints inside selected " "inside joints";
			text " - create joints inside";
 		rowLayout -cw 1 35 -cw 2 35 -parent "jnts_create"   -numberOfColumns 4 ;
				button   -w ($btnn_w/3) -h $mid_button_h -command "repeatLast -ac \" JOPA_4_1_5ca4dc00d401eb19d3b3eaf8ceb68c51(0);\" -acl \" add joint in chain \";JOPA_4_1_5ca4dc00d401eb19d3b3eaf8ceb68c51(1);" -annotation " add 1 joint " " + ";
				button   -w ($btnn_w/3) -h $mid_button_h -command "repeatLast -ac \" JOPA_4_1_9d2772351e5b1bd29134402e8ccbbda0();\" -acl \" remove joint from chain \";JOPA_4_1_9d2772351e5b1bd29134402e8ccbbda0();" -annotation " remove 1 joint " " - ";
				  text " - add/remove 1 joint between";
		rowLayout -cw 1 35 -cw 2 35 -parent "jnts_create"  -adj 4 -numberOfColumns 5 ;
				button   -w ($btnn_w/3) -h $mid_button_h
				-command "repeatLast -ac \" JOPA_4_1_ad3e5fee1a27e33794ab15e8350f4b53(1);\" -acl \" add joint on selected curve \";JOPA_4_1_ad3e5fee1a27e33794ab15e8350f4b53(1);"
				-bgc 0.7 0.7 0.8
				-annotation "add joint on selected curve chain" " + ";
				button   -w ($btnn_w/3) -h $mid_button_h
				-command "repeatLast -ac \" JOPA_4_1_ad3e5fee1a27e33794ab15e8350f4b53(0);\" -acl \" remove joint from selected curve chain \";JOPA_4_1_ad3e5fee1a27e33794ab15e8350f4b53(0);"
				-bgc 0.7 0.7 0.8
				-annotation "remove joint from selected curve chain " " - ";
				text " - add/remove 1 joint on selected curve";
 $fral=`frameLayout
            -bgc $red[0] $red[1] $red[2]
            -mh 0
            -mw 1
			-ann $jopa_version
            -cc " window -e -h 500 create_skeleton_tools"
            -p "skeleton_scripts" -cl 0 -cll true -l "PRECISION CREATE"`;
		 rowLayout -cw 1 35 -cw 2 35  -cw 3 35 -cw 4 35 -p $fral  -numberOfColumns 6 ;
					global string $SM_create_joint_by_3_selected_mod;
					button   -w ($btnn_w/3) -h ($mid_button_h-2)
							-command "$SM_JOPA_4_1_f911544bbc1f8bd26197ce3206a3d51e_mod=\"T\"; repeatLast -ac \" JOPA_4_1_f911544bbc1f8bd26197ce3206a3d51e($SM_JOPA_4_1_f911544bbc1f8bd26197ce3206a3d51e_mod);\" -acl \" create by 3 T form \" ; JOPA_4_1_f911544bbc1f8bd26197ce3206a3d51e($SM_JOPA_4_1_f911544bbc1f8bd26197ce3206a3d51e_mod);"
							-annotation " create joint by 3 selection by  T-form (between 1 2 oriented to 3)" " T ";
					button   -w ($btnn_w/3) -h ($mid_button_h-2)
							-command "$SM_JOPA_4_1_f911544bbc1f8bd26197ce3206a3d51e_mod=\"-T\"; repeatLast -ac \" JOPA_4_1_f911544bbc1f8bd26197ce3206a3d51e($SM_JOPA_4_1_f911544bbc1f8bd26197ce3206a3d51e_mod);\" -acl \" create by 3 -T form \" ; JOPA_4_1_f911544bbc1f8bd26197ce3206a3d51e($SM_JOPA_4_1_f911544bbc1f8bd26197ce3206a3d51e_mod);"
							-annotation " create joint by 3 selection by  -T-form (between 1 2 oriented between 1 2 secondary axis 3)" " -T ";
					button   -w ($btnn_w/3) -h ($mid_button_h-2)
							-command "$SM_JOPA_4_1_f911544bbc1f8bd26197ce3206a3d51e_mod=\"L\"; repeatLast -ac \" JOPA_4_1_f911544bbc1f8bd26197ce3206a3d51e($SM_JOPA_4_1_f911544bbc1f8bd26197ce3206a3d51e_mod);\" -acl \" create by 3 L form \" ; JOPA_4_1_f911544bbc1f8bd26197ce3206a3d51e($SM_JOPA_4_1_f911544bbc1f8bd26197ce3206a3d51e_mod);"
							-annotation " create joint by 3 selection by  L-form    (position on 3 oriented 1 2)" " L ";
					button   -w ($btnn_w/3) -h ($mid_button_h-2)
							-command "$SM_JOPA_4_1_f911544bbc1f8bd26197ce3206a3d51e_mod=\"V\"; repeatLast -ac \" JOPA_4_1_f911544bbc1f8bd26197ce3206a3d51e($SM_JOPA_4_1_f911544bbc1f8bd26197ce3206a3d51e_mod);\" -acl \" create by 3 V form \" ; JOPA_4_1_f911544bbc1f8bd26197ce3206a3d51e($SM_JOPA_4_1_f911544bbc1f8bd26197ce3206a3d51e_mod);"
							-annotation " create joint by 3 selection by  V-form    (position close to 3, on equal distance to 1-2,  oriented 1 2)" " V ";
					button   -w ($btnn_w/3) -h ($mid_button_h-2)
							-command " repeatLast -ac \"  JOPA_4_1_ede435b7fff94dfd41b52ef93374d3ee();\" -acl \" place center by 3 \" ;  JOPA_4_1_ede435b7fff94dfd41b52ef93374d3ee()"
							-annotation " place joint center of circle  by 3 selection " " C ";
					  text " - create joint by 3 selection";
 $fral=`frameLayout
            -bgc 0.6 0.42 0.6
            -mh 0
            -mw 1
			-ann $jopa_version
            -cc " window -e -h 500 create_skeleton_tools"
            -p "skeleton_scripts" -cl 0 -cll true -l "FREEZE ORIENTS"`;
 	columnLayout  -adj 1 -p $fral  "freezer";
 			rowLayout -parent "freezer"  -numberOfColumns 4 ;
    	        button  -h $mid_button_h  -w ($btnn_w*1.4) -command "repeatLast -ac \"JOPA_4_1_d1f6eb5ab8caa780647f498704025cf1();\" -acl \"freeze transform joints();\"; JOPA_4_1_d1f6eb5ab8caa780647f498704025cf1();"  -annotation "freeze ROTATE AND JOINT ORIENT. On complex bifurcated chains it is better not to use" "Freeze rotate and orient";
    	        text -label " - freeze rotate/j. orient selected" -annotation "freeze ROTATE AND JOINT ORIENT. On complex bifurcated chains it is better not to use";
             rowLayout -parent "freezer"  -numberOfColumns 4 ;
                button  -h $mid_button_h  -w ($btnn_w*1.4) -command " makeIdentity -apply true -t 0 -r 1 -s 0 -n 0 -pn 1;"  -annotation "freeze rotate of bones throughout the hierarchy" "Freeze rotate ALL hierarhy";
                text -label " - freeze rotate hierarchy" -annotation "freeze rotate of bones throughout the hierarchy";
             rowLayout -parent "freezer"  -numberOfColumns 4 ;
                button  -h $mid_button_h -w ($btnn_w*1.4) -command "repeatLast -ac \" JOPA_4_1_0f1ac522d0b034408fd36bd87fb46cb3\" -acl \" joint orient \"; JOPA_4_1_0f1ac522d0b034408fd36bd87fb46cb3()"  -annotation "Zero joint orient only for selected bones. With their transfer to rotate" "Orient->Rotate";
                text -label " - orient transfer to rotate  " -annotation "Zero joint orient only for selected bones. With their transfer to rotate";
            rowLayout -parent "freezer"  -numberOfColumns 4 ;
				button  -h $mid_button_h -w ($btnn_w*1.4) -command "repeatLast -ac \"JOPA_4_1_0bec9b327a3b7f3839a0d58cf92ce02c\" -acl \"freeze rotate \"; JOPA_4_1_0bec9b327a3b7f3839a0d58cf92ce02c()"  -annotation "- zero Rotate on selected joints and transfer to Joint Orient" "Rotate>Orient";
                text -label " - rotate transfer to orient  " -annotation "Zero joint orient only for selected bones. With their transfer to rotate";
$fral=`frameLayout
            -bgc $red[0] $red[1] $red[2]
            -mh 0
            -mw 1
			-ann $jopa_version
            -cc " window -e -h 500 create_skeleton_tools"
            -p "skeleton_scripts" -cl 0 -cll true -l "PARENTING JOINTS"`;
    columnLayout  -adj 1 -p $fral  "parenting";
    	rowLayout -adj 2 -parent "parenting" -numberOfColumns 4;
        	button  -h $mid_button_h -w ($btnn_w ) -command "repeatLast -ac \"$objects=JOPA_4_1_f0209cb5b5931bdfa7ae6801db19a0f8();select -cl;select ($objects);\" -acl \"parent sequent \"; $objects=JOPA_4_1_f0209cb5b5931bdfa7ae6801db19a0f8();select -cl;select ($objects);" -annotation "sequentially parent selected objects from first to last" "parent sequent";
        	text -label "" -annotation "sequentially parent selected objects from first to last";
        	button
				-h $mid_button_h  -w ($btnn_w )
				-command  "undoInfo -ock -cn \"true_parent\";JOPA_4_1_95a1a70cbaa809195c99a215410318c8(1);undoInfo -cck;"
				-bgc 0.8 0.9 0.9
				-annotation "true parent joints without transform groupp" "true parent";
        	button  -h $mid_button_h  -w ($btnn_w ) -command  "undoInfo -ock -cn \"JOPA_4_1_a2b81a3977941c0eac1cda769570172c\";JOPA_4_1_a2b81a3977941c0eac1cda769570172c();undoInfo -cck;" -annotation "true unparent while maintaining selection" "true unparent";
  $fral=`frameLayout
            -bgc $red[0] $red[1] $red[2]
            -mh 0
			-ann $jopa_version
            -mw 1
            -cc " window -e -h 500 create_skeleton_tools"
            -p "skeleton_scripts" -cl 0 -cll true -l "POSITIONING AND DISTRIBUTION"`;
    columnLayout  -adj 1 -p $fral "align";
    	rowLayout -adj 2 -parent "align"  -numberOfColumns 5 ;
                button  -h $mid_button_h  -w ($btnn_w) -command "repeatLast -ac \" JOPA_4_1_b9629ebf4695f6ad1940993b73361ead(10)\" -acl \"Smooth position \"; JOPA_4_1_b9629ebf4695f6ad1940993b73361ead(10)" -annotation "smooth positions selected " "Smooth position";
                text " - smooth/straight - ";
                 button   -h $mid_button_h  -w ($btnn_w+1)  -command "repeatLast -ac \" JOPA_4_1_b9629ebf4695f6ad1940993b73361ead(100)\" -acl \" Straight position \"; JOPA_4_1_b9629ebf4695f6ad1940993b73361ead(100)" -annotation "arrange in a straight line selected" "Straight position";
     	rowLayout  -parent "align"  -numberOfColumns 8 -adj 4 ;
                button  -h $mid_button_h -w ($btnn_w/2) -command "repeatLast -ac \" JOPA_4_1_0cb8b5d4e384a1ba8b59ac35529bc7eb(-0.2)\" -acl \" align object position \"; JOPA_4_1_0cb8b5d4e384a1ba8b59ac35529bc7eb(-0.2)" -annotation "move to the first selected object" "<<<<";
                button -h $small_button_h -w ($btnn_w)-command "repeatLast -ac \" JOPA_4_1_a8aee5f7819058e898a22052bd3773a1\" -acl \"align distribution \"; JOPA_4_1_a8aee5f7819058e898a22052bd3773a1 " -annotation "align distance distribution" "align distribution";
                button   -h $mid_button_h -w ($btnn_w/2) -command "repeatLast -ac \" JOPA_4_1_0cb8b5d4e384a1ba8b59ac35529bc7eb(0.2)\" -acl \" align object position \";JOPA_4_1_0cb8b5d4e384a1ba8b59ac35529bc7eb(0.2)" -annotation "move to the last selected object " ">>>>";
				text "";
				rowLayout   -numberOfColumns 3 ;
					                button  -h $small_button_h
											-bgc 0.7 0.8 0.7
											-w ($btnn_w/3 -1) -command "JOPA_4_1_266cf15f213f144bd5577f55c93329d0(0)" "<";
									button  -h $small_button_h
											-bgc 0.7 0.8 0.7
											-w ($btnn_w/3 -1) -command "JOPA_4_1_266cf15f213f144bd5577f55c93329d0(1)" "0";
									button  -h $small_button_h
											-bgc 0.7 0.8 0.7
											-w ($btnn_w/3 -1) -command "JOPA_4_1_266cf15f213f144bd5577f55c93329d0(2)" ">";
         rowLayout -cw 1 70 -parent "align" -adj 2 -numberOfColumns 8 ;
                button  -h $mid_button_h  -w ($btnn_w)-command "repeatLast -ac \" JOPA_4_1_3ee4702003ee8d11faa99588f53763ed\" -acl \" align on plane \";JOPA_4_1_3ee4702003ee8d11faa99588f53763ed()" -annotation "align the plane selected joints" "align plane";
                text "  - align the plane - ";
                button  -h $mid_button_h
						-bgc 0.7 0.8 0.7
						-w ($btnn_w*0.7+1)
						-command "repeatLast -ac \" JOPA_4_1_d6b9c21beb7156b6229e41d3d9f7ef3c\" -acl \" align on plane \";JOPA_4_1_d6b9c21beb7156b6229e41d3d9f7ef3c()" -annotation "align the plane selected joints manually "
						"manually";
				button   -h $mid_button_h
						-bgc 0.7 0.8 0.7
						-w ($btnn_w*0.28) -command " pickWalk -d up; pickWalk -d up; select -hi; DeleteConstraints; delete;" -annotation "delete plane manipulator"  "del";
         rowLayout -parent "align"  -numberOfColumns 8 ;
                button  -h ($mid_button_h-2)  -w ($btnn_w/2) -command " JOPA_4_1_ee610d2367958b592a8726aa94ff0ff1(\"x\",`checkBox -q -v abs_mode`);" -annotation "align the world plane X projection" "align X";
                button  -h ($mid_button_h-2)  -w ($btnn_w/2) -command " JOPA_4_1_ee610d2367958b592a8726aa94ff0ff1(\"y\",`checkBox -q -v abs_mode`);" -annotation "align the world plane Y projection" "align Y";
                button  -h ($mid_button_h-2)  -w ($btnn_w/2) -command " JOPA_4_1_ee610d2367958b592a8726aa94ff0ff1(\"z\",`checkBox -q -v abs_mode`);" -annotation "align the world plane Z projection" "align Z";
                text "  - align the world   ";
				checkBox -v false -l " - abs" abs_mode;
        rowLayout -parent "align"  -numberOfColumns 8 ;
				button   -w ($btnn_w ) -h $mid_button_h
				-command "JOPA_4_1_972cbf131f510c941b6fca958a7d0c69()"
				-bgc 0.7 0.7 0.8
				-annotation "snap selected joints to selected curve " "snap to curve";
                text "  - snap selected joints to selected curve";
 $fral=`frameLayout
            -bgc $green[0] $green[1] $green[2]
            -mh 0
            -mw 1
			-ann $jopa_version
            -cc " window -e -h 500 create_skeleton_tools"
            -p "skeleton_scripts" -cl 0 -cll true -l "SELECTION"`;
		columnLayout -adj 1 -p $fral "selection";
			rowLayout -p "selection"  -numberOfColumns 3;
				button  -h ($mid_button_h-2) -w ($btnn_w*1.5) -command "JOPA_4_1_cf07169f94f84aada068ef575331b875(\"forward\")" -annotation "hierarchically selects a piece of chain between selected joints" "select between";
				text -label " - selects a piece of chain" -annotation "select chain between 2 selected joints";
 			 rowLayout -p "selection"  -numberOfColumns 3;
				button  -h ($mid_button_h-2) -w ($btnn_w*1.5)-command "SelectHierarchy; $sel_joints=JOPA_4_1_1ed150b12535ee196bee8b74a6bf5f5c(`ls-sl`, \"joint\");select $sel_joints;" -annotation "hierarchically selects joints only" "select joints hierarchy";
				text -label " - selects joints only" -annotation "hierarchically selects joints only";
 			 rowLayout -p "selection"  -numberOfColumns 3;
				button  -h ($mid_button_h-2) -w ($btnn_w*1.5)
					-command "repeatLast -ac \" JOPA_4_1_f4a01868ca61fbc2847abcd1b618cc24();\" -acl \" swap selection order \";JOPA_4_1_f4a01868ca61fbc2847abcd1b618cc24()"
					-annotation "swapping selection order"
					-l "swap";
				text -label " - swap selection order" -annotation "swap selection order";
 $fral=`frameLayout
            -bgc $green[0] $green[1] $green[2]
            -mh 0
            -mw 1
			-ann $jopa_version
            -cc " window -e -h 500 create_skeleton_tools"
            -p "skeleton_scripts" -cl 0 -cll true -l "TOOLS"`;
	columnLayout -adj 1 -p $fral "tools";
	rowLayout -parent "tools"  -adj 3 -numberOfColumns 4;
		button -w ($btnn_w/2) -h $small_button_h
		-bgc 0.7 0.7 0.8
		-command " JOPA_4_1_f16154a48b6bb7af40bdec525973aa99(1)"
		-annotation "disable all skincluster" -l "ENTER";
		button -w ($btnn_w/2) -h $small_button_h
		-bgc 0.7 0.7 0.8
		-command " JOPA_4_1_f16154a48b6bb7af40bdec525973aa99(0)"
		-annotation "enable all skincluster" -l "EXIT";
		text " - move skinned joint mode";
		button -w ($btnn_w ) -h $small_button_h
		-bgc 0.7 0.7 0.8
		-command " JOPA_4_1_e79dd31d96c9498499196fdfdddd4698()"
		-annotation "mirror connection menue" -l "mirror connection";
	rowLayout -p "tools" -numberOfColumns 2 ;
	    button -w ($btnn_w)  -h $mid_button_h  -command " JOPA_4_1_95d47209f5832c068ce7614b82201089;" -annotation "make rotations selected joint like after an euler filter"  "Rotate like Euler";
	     text " - make rotations like after an euler filter";
     	rowLayout -parent "tools"   -numberOfColumns 4;
        	button -w ($btnn_w/2) -h $small_button_h -command "repeatLast -ac \" JOPA_4_1_975573a52a98abc101c2b805675f922b(0)\" -acl \" segment scale compensate OFF\"; JOPA_4_1_975573a52a98abc101c2b805675f922b(0)" -annotation " off segment scale compensate " "OFF";
        	button -w ($btnn_w/2) -h $small_button_h -command "repeatLast -ac \" JOPA_4_1_975573a52a98abc101c2b805675f922b(1)\" -acl \" segment scale compensate ON\"; JOPA_4_1_975573a52a98abc101c2b805675f922b(1)" -annotation "  on segment scale compensate " "ON";
        	text " - segment scale compensate";
     	rowLayout  -parent "tools" -numberOfColumns 3;
        	button -w ($btnn_w) -h $mid_button_h  -command "repeatLast -ac \" JOPA_4_1_3a25eaad774c71ebdcb06ee4d2b25ce3\" -acl \" null joint orient \"; JOPA_4_1_3a25eaad774c71ebdcb06ee4d2b25ce3"  -annotation "zero joint orient selected" "null joint orient";
        	button -w ($btnn_w) -h $mid_button_h  -command "repeatLast -ac \" JOPA_4_1_9a3ce25cfdbc96f0053e2e03715d7f2b\" -acl \" null joint rotate\"; JOPA_4_1_9a3ce25cfdbc96f0053e2e03715d7f2b;" -annotation "zero rotates selected" "null joint rotate";
     	rowLayout -parent "tools" -numberOfColumns 4;
        	button  -w ($btnn_w/2) -h $small_button_h -command "repeatLast -ac \"JOPA_4_1_8c16c9163e07a819fc2186f2d338a280(1) \" -acl \" show local axis\"; JOPA_4_1_8c16c9163e07a819fc2186f2d338a280(1)" -annotation "show local axis" "show";
        	button -w ($btnn_w/2) -h $small_button_h -command " repeatLast -ac \" JOPA_4_1_8c16c9163e07a819fc2186f2d338a280(0)\" -acl \" hide local axis\"; JOPA_4_1_8c16c9163e07a819fc2186f2d338a280(0)"  -annotation "hide local axis" "hide";
        	text " - local axis              ";
		rowLayout -p "tools" -numberOfColumns 3 ;
				button -w ($btnn_w/2) -h $small_button_h -command " selectPref -sch 1;" -annotation "highlited all childs"  "Ch_OFF";
				button -w ($btnn_w/2) -h $small_button_h -command " selectPref -sch 0;" -annotation "highlited selected objects only  "  "Ch_ON";
