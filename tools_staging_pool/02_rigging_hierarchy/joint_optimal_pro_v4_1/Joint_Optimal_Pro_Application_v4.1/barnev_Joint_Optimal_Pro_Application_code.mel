global proc JOPA_4_1_15760bd5ac6225f582185bab24346a67(float $subScale)
{
	float $dist=50;
	$subScale=JOPA_4_1_f71c299bf7b53f7243b078a9990e581c($subScale);
	string $sel[]=`ls-head 1 -sl`;
	string $camera_name="";
	float $camera_scale=1;
	catchQuiet( $camera_name= JOPA_4_1_20a28b95c1b8b4dd29397ab332dbc667());
	if( $camera_name =="no model panel viewport")
	    $camera_name="persp";
	catchQuiet( $camera_scale=`getAttr ($camera_name + ".cameraScale")`);
	catchQuiet( $dist=JOPA_4_1_c7822f1f10b007a6803735c105e40799($sel[0], $camera_name));
	catchQuiet( $camera_ortograf=`getAttr ($camera_name + ".orthographic")`);
	catchQuiet( $camera_orthographicWidth=`getAttr ($camera_name + ".orthographicWidth")`);
	if(!$camera_ortograf)
	    catchQuiet(JOPA_4_1_92de112c5c170c44ad9daf4d48b1acdd (($dist/25)*$subScale* (1/`jointDisplayScale -q`)*$camera_scale));
	else
	    catchQuiet(JOPA_4_1_92de112c5c170c44ad9daf4d48b1acdd (($camera_orthographicWidth/25)*$subScale* (1/`jointDisplayScale -q`)*$camera_scale));
}
