global proc float[] JOPA_4_1_3f2307b9993ee7d97577d190465f37c9(string $objects[],int $normalised)
{
	float $part_dist_real[]={0};
	float $part_dist[]={0};
	float $part_dist_normalized[]={0};
	float $total_dist;
	for($i=1;$i<size($objects);$i++)
	{
		$part_dist[$i]=JOPA_4_1_c7822f1f10b007a6803735c105e40799($objects[$i-1] , $objects[$i]);
		$total_dist+=$part_dist[$i];
		$part_dist_real[$i]=$total_dist;
	}
	for($i=1;$i<size($objects);$i++)
		$part_dist_normalized[$i]=$part_dist_real[$i]/$total_dist;
	if($normalised)
		return $part_dist_normalized;
	else
		return $part_dist_real;
}
global proc string [] JOPA_4_1_4a0278149f801323f33f7bb9e4ee597d(string $target_massiv[], string $object_massiv[])
{
	string $name_of_constrain[];
	string $tmp[];
	int $tx_lock;
	int $ty_lock;
	int $tz_lock;
	int $h;
	string $skipX;
	string $skipY;
	string $skipZ;
	string $skipped;
	if(size($target_massiv)!=size($object_massiv))
		warning "size smart_point constraints massives is DIFFERENT!!! Only relevant objects will be processed! This can lead to unexpected consequences!!!!";
	if(size($target_massiv)> size($object_massiv))
		$target_massiv=`ls -head (size($object_massiv)) $target_massiv`;
	for($i=0;$i<size($target_massiv);$i++)
	{
		$tx_lock=`getAttr -lock ($object_massiv[$i] + ".tx")`;
		$ty_lock=`getAttr -lock ($object_massiv[$i] + ".ty")`;
		$tz_lock=`getAttr -lock ($object_massiv[$i] + ".tz")`;
		$h=$tx_lock+$ty_lock+$tz_lock;
		if ($h<3)
		{
			$skipX= "";
			$skipY= "";
			$skipZ= "";
			if($tx_lock)
				$skipX= " -skip x";
			if($ty_lock)
				$skipY= " -skip y";
			if($tz_lock)
				$skipZ= " -skip z";
			$skipped = $skipX + $skipY + $skipZ;
			$tmp=`eval ("pointConstraint " + $skipped + " " + $target_massiv[$i] + " " + $object_massiv[$i])`;
			$name_of_constrain[$i]=$tmp[0];
		}
	}
	return $name_of_constrain;
}
global proc string [] JOPA_4_1_ac2021d0d7ff3ecfad4dbca9f9f88248(string $target_massiv[], string $object_massiv[])
{
	string $name_of_constrain[];
	string $tmp[];
	for($i=0;$i<size($target_massiv);$i++)
		{
			$rx_lock=`getAttr -lock ($object_massiv[$i] + ".rx")`;
			$ry_lock=`getAttr -lock ($object_massiv[$i] + ".ry")`;
			$rz_lock=`getAttr -lock ($object_massiv[$i] + ".rz")`;
			$h=$rx_lock+$ry_lock+$rz_lock;
			if ($h<3)
			{
				$skipX= "";
				$skipY= "";
				$skipZ= "";
				if($rx_lock)
					$skipX= " -skip x";
				if($ry_lock)
					$skipY= " -skip y";
				if($rz_lock)
					$skipZ= " -skip z";
				$skipped = $skipX + $skipY + $skipZ;
				$tmp=`eval ("orientConstraint  " + $skipped + " " + $target_massiv[$i] + " " + $object_massiv[$i])`;
				$name_of_constrain[$i]=$tmp[0];
			}
	}
	return $name_of_constrain;
}
global proc float[] JOPA_4_1_8598296823aa3af15686cb0d78f1615d(string $selection)
{
    float $objPosition[];
    float $getPvPos[];
    float $Rot[];
    string $buffer[];
    string $e_f_result[];
    vector $coords[];
    vector $coo;
    int $num;
    string $points[]=`filterExpand -sm 28  -sm 30 -sm 31 -sm 35  -sm 36-sm 39-sm 40-sm 41-sm 42 -sm 46-sm 47-sm 70 -sm 73 $selection`;
	string $edges[]=`filterExpand -sm 32 -sm 37 $selection`;
	string $poly[]=`filterExpand -sm 34 -sm 38 -sm 72 $selection`;
	string $objname=`match "^[^\.]*" $selection`;
	if(size ($points)>0)
	{
		$getPvPos=`pointPosition -world $selection`;
		$objPosition={$getPvPos[0],$getPvPos[1],$getPvPos[2],0,0,0};
	}
	else if(size ($edges)>0)
	{
		$e_f_result=`polyInfo -ev $selection`;
		$num=`tokenize  $e_f_result[0] " " $buffer`;
		$j=0;
		for($i=2;$i<$num-1;$i++)
		{
			$getPvPos=`pointPosition -world ($objname + ".vtx[" + $buffer[$i] + "]")`;
			$coords[$j]=<<$getPvPos[0],$getPvPos[1],$getPvPos[2]>>;
			$j++;
		}
		$coo=JOPA_4_1_e3bea614176fbceebe7c7aae67e953b0($coords);
		$objPosition={$coo.x,$coo.y,$coo.z,0,0,0};
	}
	else if(size ($poly)>0)
    {
        $e_f_result=`polyInfo -fv $selection`;
        tokenize  $e_f_result[0] " " $buffer;
        $j=0;
        for($i=2;$i<size($buffer)-1;$i++)
        {
            $getPvPos=`pointPosition -world ($objname + ".vtx[" + $buffer[$i] + "]")`;
            $coords[$j]=<<$getPvPos[0],$getPvPos[1],$getPvPos[2]>>;
            $j++;
        }
        $coo=JOPA_4_1_e3bea614176fbceebe7c7aae67e953b0($coords);
        $objPosition={$coo.x,$coo.y,$coo.z,0,0,0};
    }
	else
	{
		$getPvPos = `xform -q -ws -piv $selection `;
		$Rot= `xform -q -ro -ws $selection`;
		$objPosition={$getPvPos[0],$getPvPos[1],$getPvPos[2],$Rot[0],$Rot[1],$Rot[2]};
	}
	return $objPosition;
}
global proc string[] JOPA_4_1_17431451b1be026fdeee93b86579c6b6(string $target_massiv[], string $object_massiv[])
{
	string $name_constrain[],$tmp_constrain[];
	string $skipTX,$skipTY,$skipTZ,$skipRX,$skipRY,$skipRZ;
	string $delChannelTX,$delChannelTY,$delChannelTZ,$delChannelRX,$delChannelRY,$delChannelRZ;
	int $rx_lock,$ry_lock,$rz_lock,$tx_lock,$ty_lock,$tz_lock;
	if(size($target_massiv)!=size($object_massiv))
		warning "size smart_parent constraints massives is DIFFERENT!!! Only relevant objects will be processed! This can lead to unexpected consequences!!!!";
	if(size($target_massiv)> size($object_massiv))
		$target_massiv=`ls -head (size($object_massiv)) $target_massiv`;
	for($i=0;$i<size($target_massiv);$i++)
	{
		$rx_lock=`getAttr -lock ($object_massiv[$i] + ".rx")`;
		$ry_lock=`getAttr -lock ($object_massiv[$i] + ".ry")`;
		$rz_lock=`getAttr -lock ($object_massiv[$i] + ".rz")`;
		$tx_lock=`getAttr -lock ($object_massiv[$i] + ".tx")`;
		$ty_lock=`getAttr -lock ($object_massiv[$i] + ".ty")`;
		$tz_lock=`getAttr -lock ($object_massiv[$i] + ".tz")`;
		$h=$rx_lock+$ry_lock+$rz_lock+$tx_lock+$ty_lock+$tz_lock;
		if ($h<6)
		{
			$skipTX= "";
			$skipTY= "";
			$skipTZ= "";
			$skipRX= "";
			$skipRY= "";
			$skipRZ= "";
			$delChannelTX = "";
			$delChannelTY = "";
			$delChannelTZ = "";
			$delChannelRX = "";
			$delChannelRY = "";
			$delChannelRZ = "";
			if($tx_lock)
				$skipTX= " -st x";
			else
				$delChannelTX =" -at \"tx\"";
			if($ty_lock)
				$skipTY= " -st y";
			else
				$delChannelTY =" -at \"ty\"";
			if($tz_lock)
				$skipTZ= " -st z";
			else
				$delChannelTZ =" -at \"tz\"";
			if($rx_lock)
				$skipRX= " -sr x";
			else
				$delChannelRX =" -at \"rx\"";
			if($ry_lock)
				$skipRY= " -sr y";
			else
				$delChannelRY =" -at \"ry\"";
			if($rz_lock)
				$skipRZ= " -sr z";
			else
				$delChannelRZ =" -at \"rz\"";
			$skipped = $skipTX + $skipTY + $skipTZ + $skipRX + $skipRY + $skipRZ;
			if($target_massiv[$i]!="")
				$tmp_constrain=`eval ("parentConstraint -mo " + $skipped + " " + $target_massiv[$i] + " " + $object_massiv[$i])`;
			$name_constrain[$i]=$tmp_constrain[0];
		}
	}
	return $name_constrain;
}
