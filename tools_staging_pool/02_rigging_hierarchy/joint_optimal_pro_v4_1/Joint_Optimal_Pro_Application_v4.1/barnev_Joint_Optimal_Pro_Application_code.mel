		setAttr ($obj + ".displayHandle") $on;
}
global proc JOPA_4_1_cc20e95399a3b6da44eb78e45451d764(int $color)
{
	string $objs[] = `ls-sl`;
	if(!size($objs))
		return;
	for($i=0;$i<size($objs);$i++)
	{
		catchQuiet(`setAttr ($objs[$i] + ".overrideEnabled") 1`);
		catchQuiet(`setAttr -lock false ($objs[$i] + ".overrideColor") $color`);
	}
}
global proc JOPA_4_1_92de112c5c170c44ad9daf4d48b1acdd(float $rad)
{
	string $objs[] = `ls-sl`;
	if(!size($objs))
		return;
	for($i=0;$i<size($objs);$i++)
		catchQuiet (`setAttr ($objs[$i] + ".radius") $rad`);
}
global proc float[] JOPA_4_1_1b2691cd3c4740f4f00465c7e94c0373(string $jnts[], float $rad)
{
    string $jnt;
    float $glob_scale[];
    float $curr_j_disp_scale=`jointDisplayScale -q -a`;
    float $fin_local_scales[];
    $i=0;
    for($jnt in $jnts)
    {
        $glob_scale=`xform -q -ws -s $jnt`;
        $glob_scale[0]= abs($glob_scale[0]);
        $glob_scale[1]= abs($glob_scale[1]);
        $glob_scale[2]= abs($glob_scale[2]);
        $glob_scale=sort( $glob_scale);
        $fin_local_scales[$i]=$rad/$glob_scale[2]/$curr_j_disp_scale;
        catchQuiet (`setAttr ($jnt + ".radius") $fin_local_scales[$i]`);
        $i++;
    }
    return $fin_local_scales;
}
global proc JOPA_4_1_29941243f77aa0343e79460d48136072 (float $local_scale)
{
	string $objs[] = `ls-sl`;
	$local_scale=JOPA_4_1_f71c299bf7b53f7243b078a9990e581c($local_scale)*JOPA_4_1_f71c299bf7b53f7243b078a9990e581c(1);
	if(!size($objs))
		return;
	for($i=0;$i<size($objs);$i++)
	{
		catchQuiet (`setAttr ($objs[$i] + ".localScaleX") $local_scale`);
		catchQuiet (`setAttr ($objs[$i] + ".localScaleY") $local_scale`);
		catchQuiet (`setAttr ($objs[$i] + ".localScaleZ") $local_scale`);
	}
}
