global proc JOPA_4_1_09f1edc0a69a4931b08e1bcc40e94a55()
{
	string $selected[]= `ls -sl`;
	if(size($selected)==0)
	{
		warning "select something!!!!";
		return;
	}
	string $crvs[] = `keyframe -q -n`;
	float $statTime[] = `keyframe -index 0 -q -tc $crvs`;
	$statTime=`sort $statTime`;
	float $null_frame = $statTime[0] - 10;
	catchQuiet(`setKeyframe -v 0 -t $null_frame -at rotateX -at rotateY -at rotateZ`) ;
	catchQuiet(`filterCurve $selected.rotateX $selected.rotateY $selected.rotateZ`);
	selectKey -clear;
	catchQuiet(`cutKey -t $null_frame  -at rotateX -at rotateY -at rotateZ `);
	selectKey -clear;
}
global proc float JOPA_4_1_c7822f1f10b007a6803735c105e40799(string $obj1, string $obj2)
{
	float $temp[]=JOPA_4_1_8598296823aa3af15686cb0d78f1615d($obj1);
	vector $point1 = <<$temp[0], $temp[1], $temp[2]>>;
	$temp=JOPA_4_1_8598296823aa3af15686cb0d78f1615d($obj2);
	vector $point2 = <<$temp[0], $temp[1], $temp[2]>>;
	float $lenght=`mag($point1-$point2)`;
	return  $lenght;
}
global proc JOPA_4_1_f17bdd4811ed4c79ad676fdc4d5a1414()
{
	string $root_namesps[]= `namespaceInfo -r  -lon  ":"`;
	$root_namesps = stringArrayRemoveDuplicates( stringArrayRemove({"ClipBuffer","UI","shared"}, $root_namesps));
	for($i=size($root_namesps)-1; $i>=0;$i--)
	{
        catchQuiet (`namespace  -mv  $root_namesps[$i] ":" -force`) ;
        catchQuiet (`namespace -removeNamespace $root_namesps[$i]`) ;
	}
	print ("Delete " + `size($root_namesps)` + " namespaces");
}
global proc string[] JOPA_4_1_5e702211108f11813c411c94f8b1b380( string $transfrm )
{
   string $shapes[];
   $shapes[0] = $transfrm;
   if ( "transform" == `nodeType $transfrm` )
		$shapes = `listRelatives -f -shapes $transfrm`;
   return $shapes;
}
global proc string[] JOPA_4_1_1ed150b12535ee196bee8b74a6bf5f5c(string $objects[], string $obj_type)
{
    string $fin_listing[];
    string $fin_listing_prev[];
    string $shape_type_listing[];
    string $tmp_shapes[];
    string $shapes[];
    for($obj in $objects)
    {
       $tmp_shapes=JOPA_4_1_5e702211108f11813c411c94f8b1b380($obj);
       appendStringArray($shapes,  $tmp_shapes, `size($tmp_shapes)`);
    }
    $j=0;
    for($obj in $shapes)
    {
        if(`objectType $obj`==$obj_type)
        {
          $shape_type_listing[$j] = $obj;
          $j++;
        }
    }
    $j=0;
    if($obj_type!="joint")
    {
        for($obj in $shape_type_listing)
        {
             $fin_listing_prev[$j]=JOPA_4_1_399e6ca23a24d0e48ed5cb872f4729dd($obj);
             $j++;
             $fin_listing=stringArrayRemoveDuplicates ($fin_listing_prev);
        }
    }
	else
       $fin_listing=$shape_type_listing;
    return $fin_listing;
}
global proc string[] JOPA_4_1_ce7b9a074764f1b06f64dfc666cf4813(string $objects[], string $side_from, string $side_to)
{
    string $name_variations[];
    string $mirr_obj_names[];
    for($obj in $objects)
    {
        $name_variations=JOPA_4_1_b3acc831f9f61a01a45fe7165ec12c62($obj,$side_from,$side_to);
        for($n in $name_variations)
            if( objExists($n))
                appendStringArray($mirr_obj_names, {$n}, 1);
    }
    return $mirr_obj_names;
}
global proc string JOPA_4_1_c954f3ebe8232ef721ae19221935b64e(string $take_name)
{
    $i=0;
    while (`objExists $take_name`)
        $take_name=( $take_name + $i);
   return $take_name;
}
global proc JOPA_4_1_95d47209f5832c068ce7614b82201089()
{
	$selection=`ls-sl`;
	$lock_name =` spaceLocator `;
	setKeyframe -at rx -at ry -at rz $lock_name[0];
	$currTime=(`currentTime -q`) -1;
    setKeyframe  -at rx -at ry -at rz -t $currTime;
	string $obj;
	int $rotOrder;
	float $rx,$ry,$rz;
	for($obj in $selection)
	{ 
	    $rotOrder=getAttr($obj + ".rotateOrder");
		$rx=getAttr($obj + ".rx");
		$ry=getAttr($obj + ".ry");
		$rz=getAttr($obj + ".rz");
		setAttr ($lock_name[0] + ".rotateOrder") $rotOrder;
		rotate -a $rx $ry $rz $lock_name[0];
		setKeyframe -at rx -at ry -at rz $lock_name[0];
		filterCurve $lock_name.rotateX $lock_name.rotateY $lock_name.rotateZ;
	    $rx=getAttr($lock_name[0] + ".rx");
		$ry=getAttr($lock_name[0] + ".ry");
		$rz=getAttr($lock_name[0] + ".rz");
		rotate -a $rx $ry $rz $obj;
	}
	delete $lock_name;
	select $selection;
}
global proc string[] JOPA_4_1_2edf2909df70a7e657b4b646868a0b9c()
{
	$selection=`ls-l-sl`;
	string  $childrens[];
	string  $childrens_last_hierarhy[];
	string  $childrens_all[];
	string  $childrens_all1[];
	for($obj in $selection)
	{
		$childrens=`listRelatives -f -c -typ "joint" $obj`;
		appendStringArray ($childrens_all,$childrens,size($childrens));
	}
	$childrens_all1=stringArrayRemove ( $selection,$childrens_all);
	return $childrens_all1;
}
global proc JOPA_4_1_a9acebc46d5277d92e6d954501ac53c7(string $axis,  string $sao_napr, string $ch_up)
{
    $axis=`tolower $axis`;
    $selection=`ls-sl`;
    JOPA_4_1_8c16c9163e07a819fc2186f2d338a280(1);
    $kk=size($selection);
    if($kk<2)
    {
        warning "select 2 or more joint";
        return;
    }
    $childrens=JOPA_4_1_2edf2909df70a7e657b4b646868a0b9c();
    int $have_childrens=0;
	string $ch_locks[];
	string  $par_ch_constrain[];
    if(size($childrens)>0)
    {
        select $childrens;
	    JOPA_4_1_8c16c9163e07a819fc2186f2d338a280(1);
	    $ch_locks=JOPA_4_1_54d92f8424c4459e6d996d9fd93902f0();
	    $par_ch_constrain=JOPA_4_1_17431451b1be026fdeee93b86579c6b6($ch_locks, $childrens);
	    $have_childrens=1;
	    select $selection;
    }
    if(size($childrens)==1)
    {
	    select $selection $childrens;
    }
    $sec_joints=JOPA_4_1_f2d5a2798ed7cfee36eb77ee8a281ed8();
    $sec_joints2=`ls-head (size($sec_joints)-1) $sec_joints`;
    if(size($childrens)==1)
    {
	    select   $sec_joints2;
    }
	JOPA_4_1_5cca387e40527d14dd0862d275b6a5fc(`ls-sl`, $axis, $sao_napr, $ch_up);
    select  $sec_joints;
    $lock=JOPA_4_1_54d92f8424c4459e6d996d9fd93902f0();
    $constr=JOPA_4_1_c99bdb5a898efbfb1d4fa2221eba881b($lock,$sec_joints);
    select -cl;
    select $sec_joints;
    JOPA_4_1_3a25eaad774c71ebdcb06ee4d2b25ce3;
    delete $constr;
    delete $lock;
    JOPA_4_1_95d47209f5832c068ce7614b82201089();
    if(size($childrens)==1)
    {
	    $sec_joints=`ls -head ($kk)  $sec_joints`;
    }
    JOPA_4_1_5e8af8371c687e5c50d7ded5040ffe13($sec_joints, $selection);
    delete $sec_joints;
    select $selection;
    if($have_childrens)
	{
	    delete  $par_ch_constrain;
	    delete $ch_locks;
	}
}
global proc JOPA_4_1_d1f6eb5ab8caa780647f498704025cf1()
{
    $selection=`ls-l-sl`;
    $b_lock=JOPA_4_1_54d92f8424c4459e6d996d9fd93902f0();
    string  $locks[];
    string  $constr[];
    $constr_point=JOPA_4_1_4a0278149f801323f33f7bb9e4ee597d($b_lock, $selection);
    select $selection;
    $children=JOPA_4_1_2edf2909df70a7e657b4b646868a0b9c();
    if(size($children)>0)
    {
        select $children;
        $locks=JOPA_4_1_54d92f8424c4459e6d996d9fd93902f0();
        $constr=JOPA_4_1_17431451b1be026fdeee93b86579c6b6($locks, $children);
    }
    select $selection;
    catchQuiet (`JOPA_4_1_3a25eaad774c71ebdcb06ee4d2b25ce3`);
