	}
	if($axis=="y")
	{
		$axis_aim={0,-1,0} ;
		$axis_up_vector={0,0,1};
		$axis_w_up_vector={0,0,1};
	}
	if($axis=="z")
	{
		$axis_aim={0,0,-1} ;
