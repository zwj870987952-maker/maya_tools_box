{
	setToolTo moveSuperContext;
	float $getPvPos[]=`manipMoveContext -q -p  Move`;
	select -cl;
	$locators = `joint -p ($getPvPos[0] + "cm") ($getPvPos[1] + "cm") ($getPvPos[2] + "cm")`;
	return $locators;
}
global proc string JOPA_4_1_94c81da260931e06d6e51c78e142796f(string $toggler_items[], string $nodename)
{
    string $nodenames=`createNode blindDataTemplate -n $nodename`;
    string $attribname;
    for($i=0;$i<size($toggler_items); $i++)
    {
       $attribname=JOPA_4_1_65107bc37ea4a0d842be293fd78287a9("toggler" + $i, $nodenames);
       connectAttr -f ($toggler_items[$i] + ".visibility")   $attribname;
    }
	return  $nodenames;
}
global proc string[] JOPA_4_1_6c03bcf1c4cd077aea727f60dfb001f6(int $mode, string $nodename_mask)
{
    string $prevouos[];
    string $next[];
    string  $connected_items[];
    int $current_item_index;
    int $connected_items_size;
    $select_items=`ls-sl`;
    $j=0;
    string $all_connected_items[];
	string $top_connected_items[];
    for($obj in $select_items)
    {
        select $obj;
        $nodename=JOPA_4_1_e8f0c3b3e6300189aca31ae83320ec92($nodename_mask);
        if($nodename!="")
        {
            $connected_items=`listConnections  -d 1 $nodename`;
            $connected_items_size =size($connected_items)-1;
            for ($i=0; $i<=$connected_items_size;$i++)
            {
              if($connected_items[$i]==$obj)
                    $current_item_index=$i;
            }
        }
        if($current_item_index!=0)
            $prevouos[$j]=$connected_items[$current_item_index -1];
        else
            $prevouos[$j]=$connected_items[$connected_items_size];
        if($current_item_index!=$connected_items_size)
            $next[$j]=$connected_items[$current_item_index+1];
        else
            $next[$j]=$connected_items[0];
        $j++;
        appendStringArray( $all_connected_items, $connected_items, `size $connected_items`);
		appendStringArray( $top_connected_items, $connected_items, 1);
    }
	$all_connected_items=stringArrayRemoveDuplicates($all_connected_items);
	$top_connected_items=stringArrayRemoveDuplicates($top_connected_items);
	select $select_items;
	if($mode==2)
		return $top_connected_items;
    if($mode==-1)
        return $prevouos;
    if($mode==1)
        return $next;
        else
        return $all_connected_items;
}
global proc JOPA_4_1_feece4078c8aeb0c08bb278bcaf1bd05(int $num , int $indexses[])
{
	string $objs[] = `ls-sl`;
	if(!size($objs))
		return;
	if ($num <= 0)
        for ($obj in $objs)
            setAttr ($obj + ".overrideEnabled") 0;
    else
    	for($i=0;$i<size($objs);$i++)
    	{
    		setAttr ($objs[$i] + ".overrideEnabled") 1;
    		setAttr -lock false ($objs[$i] + ".overrideColor") $indexses[$num];
    	}
}
global proc string[] JOPA_4_1_cf7d60c10a2e981ece1b4edc00bb807f(int $rebike_animation)
