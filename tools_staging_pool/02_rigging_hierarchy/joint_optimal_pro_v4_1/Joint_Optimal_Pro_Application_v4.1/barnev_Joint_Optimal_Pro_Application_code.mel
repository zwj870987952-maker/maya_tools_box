}
global proc string[] JOPA_4_1_c81811a11b8f20fafe4877c444b7b2a7()
{
	$all_joints=`ls-sl`;
	string $dupli[];
	string $obj;
	$k=0;
	for($obj in `ls-sl`)
	{
		if(`gmatch   $obj "*|*"`)
		{
			$dupli[$k]=$obj;
			$k++;
		}
	}
	print $dupli;
	return $dupli;
}
global proc string[] JOPA_4_1_e34225338b41391d68d09634ca599397(int $return_scene_like_first)
{
    $selection=`ls-l-sl`;
    string $parents[];
    string $tmp[];
    $i=0;
    string $s_selection[];
    for($obj in  $selection)
    {
        $s_selection[$i]=$selection[$i];
        $tmp=`listRelatives -f  -p $obj`;
        $parents[$i]= $tmp[0];
        if (size($tmp)==0&&$return_scene_like_first==0)
        {
            $parents[$i]="";
        }
        if (size($tmp)==0&&$return_scene_like_first==1)
        {
            $parents[$i]=$obj;
            $s_selection[$i]="";
        }
        $i++;
    }
    $diff = stringArrayRemove($s_selection, $parents);
    $diff =`ls-fl $diff`;
    return $diff;
}
global proc string[] JOPA_4_1_ab8c8018d47d542b750e72df0fa0b3ee()
{
    string $sorted_massive[];
    string $selected[]=`ls-fl-l-sl`;
    string $buffer[];
    float $num_list[];
    for($i=0;$i<size($selected);$i++)
        $num_list[$i]=`tokenize $selected[$i] "|" $buffer`;
    $sorted_massive=JOPA_4_1_1d56f8884d88d7b022ffa48bc52b3755 ($selected,$num_list);
    return $sorted_massive;
}
global proc string[] JOPA_4_1_cf07169f94f84aada068ef575331b875(string $mod)
{
	$selected_obj=`ls -l -sl`;
	string $buffer_1[];
	string $buffer_2[];
	string $tmpp;
	$tmpp=$selected_obj[0];
	$num_1=`tokenize $tmpp "|" $buffer_1`;
	$tmpp=$selected_obj[1];
	$num_2=`tokenize $tmpp "|" $buffer_2`;
	if($buffer_1[0]!=$buffer_2[0])
	{
		warning "this objects not in one hierarchy";
		return {};
	}
	string $buffer_1_min[];
	string $buffer_2_min[];
	string $final_hierarhy[];
	for($i=0;$i<$num_1; $i++)
	{
		for($j=0;$j<=$i;$j++)
		{
			$buffer_1_min[$i]= $buffer_1_min[$i] + ("|" +  $buffer_1[$j]);
		}
	}
	for($i=0;$i<$num_2; $i++)
	{
		for($j=0;$j<=$i;$j++)
		{
			$buffer_2_min[$i]= $buffer_2_min[$i] + ("|" +  $buffer_2[$j]);
		}
	}
	$buffer_1_max=$buffer_1_min;
	$buffer_2_max=$buffer_2_min;
	for($i=0;$i<`min $num_1 $num_2`-1;$i++)
	{
		if($buffer_1_min[$i]==$buffer_2_min[$i]&&$buffer_1_min[$i+1]==$buffer_2_min[$i+1])
			{
				stringArrayRemoveAtIndex(0, $buffer_1_max);
				stringArrayRemoveAtIndex(0, $buffer_2_max);
			}
	}
	for($i=0;$i<`min $num_1 $num_2`;$i++)
	{
		if($buffer_1[$i]==$buffer_2[$i])
		{
			stringArrayRemoveAtIndex(0, $buffer_1_min);
			stringArrayRemoveAtIndex(0, $buffer_2_min);
		}
	}
	$num_1_min=size( $buffer_1_min);
	$num_2_min=size( $buffer_2_min);
	$num_1_max=size( $buffer_1_max);
	$num_2_max=size( $buffer_2_max);
	if(`min $num_1_min $num_2_min`==0)
	{
    	if($num_1_min==0)
    	{
    		$final_hierarhy[0]=$selected_obj[0];
    		appendStringArray($final_hierarhy,$buffer_2_min,$num_2_min) ;
    	}
    	else
    	{
    		$final_hierarhy[0]=$selected_obj[1];
    		appendStringArray($final_hierarhy,$buffer_1_min,$num_1_min) ;
	    }
	}
	else
		if($num_1<=$num_2)
    	{
    		appendStringArray($final_hierarhy, JOPA_4_1_9542c11845a1e56080fc5b7a1c5e8a5b($buffer_1_max),$num_1_max) ;
    		appendStringArray($final_hierarhy,$buffer_2_max,$num_2_max) ;
    	}
    	else
    	{
    		appendStringArray($final_hierarhy, JOPA_4_1_9542c11845a1e56080fc5b7a1c5e8a5b($buffer_2_max),$num_2_max) ;
    		appendStringArray($final_hierarhy,$buffer_1_max,$num_1_max) ;
	    }
	if ($mod=="revers")
	{
		$final_hierarhy=JOPA_4_1_9542c11845a1e56080fc5b7a1c5e8a5b($final_hierarhy);
	}
	if ($mod=="")
	{
	    if ($final_hierarhy[0]!=$selected_obj[0])
		    $final_hierarhy=JOPA_4_1_9542c11845a1e56080fc5b7a1c5e8a5b($final_hierarhy);
	}
	select -cl;
	select $final_hierarhy;
	return $final_hierarhy;
}
global proc JOPA_4_1_0bec9b327a3b7f3839a0d58cf92ce02c()
{
    string $selection[]=`ls-type joint -sl`;
    string $join;
    for($join in  $selection)
    {
        select -cl;
        select `listRelatives -parent $join`  $join;
        string $tmp_joints[]=JOPA_4_1_a7e0d73da2a8798cbe2f405b170f6598();
        makeIdentity -apply true -t 0 -r 1 -s 0 -n 0 -pn 1 $tmp_joints;
        JOPA_4_1_b0727bdb3ca55fb364a5d867d3297ff5({$tmp_joints[size($tmp_joints)-1]},{$join});
        rotate 0 0 0 $join;
        delete  $tmp_joints;
    }
    select -cl;
    select  $selection;
}
global proc JOPA_4_1_0f1ac522d0b034408fd36bd87fb46cb3()
{
    string $selected[]=`ls-sl`;
    string $selected_joints[]=`ls-sl-type "joint"`;
    select  $selected_joints;
    string $lock_name[]=JOPA_4_1_54d92f8424c4459e6d996d9fd93902f0();
    string $constrain_name[]=JOPA_4_1_17431451b1be026fdeee93b86579c6b6($lock_name, $selected_joints);
    select $selected_joints;
    JOPA_4_1_3a25eaad774c71ebdcb06ee4d2b25ce3;
    delete $constrain_name;
    delete $lock_name;
    JOPA_4_1_95d47209f5832c068ce7614b82201089;
    select  $selected;
}
global proc string[] JOPA_4_1_a2b81a3977941c0eac1cda769570172c()
{
    string $uuid_selection[] = `ls -uuid -sl`;
    string $selection[]=`ls-sl`;
    string $fin_names[];
    string $joint_uid[]={};
    string $rootj,$uuid_root[];
    string $in_place_tmp_j;
    for($uid in $uuid_selection)
    {
        $tmppp=`ls -uuid $uid `;
        if(objectType($tmppp[0])=="joint")
            appendStringArray($joint_uid,{$uid},1);
        else
            catchQuiet( `parent -w $tmppp[0]`);
    }
    for($uid in $joint_uid)
    {
        $tmppp=`ls -uuid $uid `;
        select $tmppp;
        $rootj=JOPA_4_1_933d4aecbe9d9d0ce9a6591c5b2e3770($tmppp[0]);
        $uuid_root=`ls -uuid $rootj`;
        if($uuid_root[0]!= $uid)
        {
            $tmp_j=`joint`;
            $in_place_tmp_j=`disconnectJoint  $tmppp[0]`;
            delete $tmp_j  $in_place_tmp_j;
        }
        else
            catchQuiet( `parent -w $tmppp[0]`);
    }
    $fin_names=`ls -uuid $uuid_selection`;
    select -cl;
    select $fin_names;
    return $fin_names ;
}
global proc JOPA_4_1_18250f0751da33452100ea861e8e386a(string $axis)
{
	$axis=`tolower $axis`;
	int $axis_aim[];
	int $axis_up_vector[];
	int $axis_w_up_vector[];
	if($axis=="x")
	{
		$axis_aim={1,0,0} ;
		$axis_up_vector={0,1,0};
		$axis_w_up_vector={0,1,0};
	}
	if($axis=="y")
	{
		$axis_aim={0,1,0} ;
		$axis_up_vector={0,0,1};
		$axis_w_up_vector={0,0,1};
	}
	if($axis=="z")
	{
		$axis_aim={0,0,1} ;
		$axis_up_vector={1,0,0};
		$axis_w_up_vector={1,0,0};
	}
	if($axis=="-x")
	{
		$axis_aim={-1,0,0} ;
		$axis_up_vector={0,1,0};
		$axis_w_up_vector={0,1,0};
	}
	if($axis=="-y")
	{
		$axis_aim={0,-1,0} ;
		$axis_up_vector={0,0,1};
		$axis_w_up_vector={0,0,1};
	}
	if($axis=="-z")
	{
		$axis_aim={0,0,-1} ;
		$axis_up_vector={1,0,0};
		$axis_w_up_vector={1,0,0};
	}
	$cmd="aimConstraint -offset 0 0 0 -weight 1 -aimVector " + $axis_aim[0] + " " + $axis_aim[1] + " " + $axis_aim[2] + " -upVector " + " " + $axis_up_vector[0] + " " + $axis_up_vector[1] + " " + $axis_up_vector[2] + " -worldUpType \"objectrotation\" -worldUpVector  " + " " + $axis_w_up_vector[0] + " " + $axis_w_up_vector[1] + " " + $axis_w_up_vector[2] + " -worldUpObject ";
	string $temp_jnts_pair[];
	string  $tmppp[];
	$selection=`ls-l-sl`;
	string $parents[];
	$i=0;
	for($obj in $selection)
	{
		$tmppp=`listRelatives -f -c $obj`;
		$parents[$i]=$tmppp[0];
		$i++;
	}
	int $have_childrens=0;
    string $ch_locks[];
    string  $par_ch_constrain[];
    string $childrens[];
	for($i=0;$i<size($selection);$i++)
	{
		if($parents[$i]!="")
		{
		    select 	$selection[$i];
        	$childrens=JOPA_4_1_2edf2909df70a7e657b4b646868a0b9c();
        	if(size($childrens)>0)
        	{
        	    select $childrens;
        	    JOPA_4_1_8c16c9163e07a819fc2186f2d338a280(1);
        	    $ch_locks=JOPA_4_1_54d92f8424c4459e6d996d9fd93902f0();
        	    $par_ch_constrain=JOPA_4_1_17431451b1be026fdeee93b86579c6b6($ch_locks, $childrens);
        	    $have_childrens=1;
        	}
			select $parents[$i] $selection[$i];
			$temp_jnts_pair=JOPA_4_1_f2d5a2798ed7cfee36eb77ee8a281ed8();
			rotate 0 0 0 $temp_jnts_pair[1];
			$aim_name= eval ($cmd + $temp_jnts_pair[0] + " " + $temp_jnts_pair[0] + " " + $temp_jnts_pair[1]);
			select $temp_jnts_pair[1]  $selection[$i];
			JOPA_4_1_9a8d2e62249cad27916aacc736478655;
			delete $temp_jnts_pair;
			select $selection[$i];
			JOPA_4_1_95d47209f5832c068ce7614b82201089();
        	if($have_childrens)
        	{
        	    delete  $par_ch_constrain;
        	    delete $ch_locks;
        	}
		}
	}
	select  $selection;
	JOPA_4_1_8c16c9163e07a819fc2186f2d338a280(1);
}
global proc JOPA_4_1_ee505820b9f32e5106abbdfa4f840186(string $axis)
{
	$axis=`tolower $axis`;
	int $axis_aim[];
	int $axis_up_vector[];
