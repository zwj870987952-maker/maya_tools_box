    	button -h $small_button_h -w ($btnn_w/3) -command "JOPA_4_1_52c981703a2cf84e5e60002e83f3fa52(90, 0, 0);" -annotation "rotate Õ"  "rX 90";
    	button -h $small_button_h -w ($btnn_w/3) -command "JOPA_4_1_52c981703a2cf84e5e60002e83f3fa52(0, 90, 0);" -annotation "rotate Y"  "rY 90";
