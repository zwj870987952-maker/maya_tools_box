global proc float[] JOPA_4_1_a5d8b0122c186b9a25fc1b6d3ff9b430(string $objects[],float $lenght_coeff, float $distribution_coeff)
{
    if(size($objects)!=3)
    {
        warning "need 3 objects!";
        return {};
    }
    float $pA[]=JOPA_4_1_8598296823aa3af15686cb0d78f1615d($objects[0]);
    float $pB[]=JOPA_4_1_8598296823aa3af15686cb0d78f1615d($objects[1]);
    float $pC[]=JOPA_4_1_8598296823aa3af15686cb0d78f1615d($objects[2]);
    float $perp_point[]=JOPA_4_1_05c4f6d59fdd2a71f23116d9d4f892c2($pA,$pB,$pC);
    float $perp_len=JOPA_4_1_9cf10c253bb06da91bcfe3836a7e5f36($perp_point,$pC);
    float $AB_len=JOPA_4_1_9cf10c253bb06da91bcfe3836a7e5f36($pA,$pB);
    float $proportion=($perp_len/$AB_len)*$lenght_coeff;
    float $point_jo[]=JOPA_4_1_8aba008b6f6ae60b66a902e6ab3eed1c($objects,$proportion, $distribution_coeff);
    return $point_jo;
}
global proc float[] JOPA_4_1_8aba008b6f6ae60b66a902e6ab3eed1c(string $objects[], float $lenght_coeff, float $distribution_coeff)
{
	if(size($objects)!=3)
    {
        warning "need 3 objects!";
        return {};
    }
	float $fin_coords[];
	float $p1[];
	float $p2[];
	float $p3[];
	$p1 =JOPA_4_1_8598296823aa3af15686cb0d78f1615d($objects[0]);
	$p2 =JOPA_4_1_8598296823aa3af15686cb0d78f1615d($objects[1]);
	$p3 =JOPA_4_1_8598296823aa3af15686cb0d78f1615d($objects[2]);
	$vector=JOPA_4_1_6f6ae5b84133776f167ce9bbf3409540($p1,$p2,$p3);
	vector $p1_p2=<<$p1[0],$p1[1],$p1[2]>> -<<$p2[0],$p2[1],$p2[2]>>;
	$lenght=(`mag $p1_p2`)*$lenght_coeff;
	float $x=$vector[0]*$lenght + $p2[0]*$distribution_coeff + $p1[0]*(1-$distribution_coeff);
	float $y=$vector[1]*$lenght + $p2[1]*$distribution_coeff + $p1[1]*(1-$distribution_coeff);
	float $z=$vector[2]*$lenght + $p2[2]*$distribution_coeff + $p1[2]*(1-$distribution_coeff);
	$fin_coords={$x,$y,$z};
	return $fin_coords;
}
global proc float JOPA_4_1_a358a7c27f7a7b80712d695138ed032e(string $objects[], int $average)
{
    float $distance;
    for($i=0;$i<size($objects)-1;$i++)
        $distance=$distance + JOPA_4_1_c7822f1f10b007a6803735c105e40799($objects[$i] , $objects[$i+1]);
    if($average)
         $distance=$distance/(size($objects)-1);
    return $distance;
}
global proc float[] JOPA_4_1_05c4f6d59fdd2a71f23116d9d4f892c2(float $pos_A[], float $pos_B[], float $pos_C[])
{
    float $H_c=JOPA_4_1_476390711655739e4d4919b7f7336b00($pos_A,$pos_B,$pos_C);
    float $c_base_len=JOPA_4_1_9cf10c253bb06da91bcfe3836a7e5f36($pos_A, $pos_B);
    float $b=JOPA_4_1_9cf10c253bb06da91bcfe3836a7e5f36($pos_A, $pos_C);
    float $a=JOPA_4_1_9cf10c253bb06da91bcfe3836a7e5f36($pos_C, $pos_B);
    float $distA_H=sqrt(`pow $b 2` - `pow $H_c 2`);
    float $distH_B=sqrt(`pow $a 2` - `pow $H_c 2`);
    int $znak=1;
    if($distA_H + $distH_B - $c_base_len> 0.001)
    {
        if($distH_B>$distA_H)
        {
           $znak=-1;
        }
    }
    float $iskomoe[]=JOPA_4_1_3a5adc63366ca7a6c7ff1a4a0eb042a1($pos_A,$pos_B,($distA_H* $znak));
    return  $iskomoe;
}
global proc string JOPA_4_1_f9ccf45626df05475e8ab66b6f511dd6(string $objects[])
{
    $num=size($objects);
    $posA=JOPA_4_1_8598296823aa3af15686cb0d78f1615d($objects[0]);
    $posB=JOPA_4_1_8598296823aa3af15686cb0d78f1615d($objects[$num-1]);
    float $dists[];
    $dists[0]=0;
    $dists[$num-1]=0;
    for($i=1;$i<$num-1;$i++)
    {
        $pos3=JOPA_4_1_8598296823aa3af15686cb0d78f1615d($objects[$i]);
        $dists[$i]=JOPA_4_1_476390711655739e4d4919b7f7336b00($posA,$posB,$pos3);
    }
    int $index=JOPA_4_1_d0a0b515ba819d3c77adb0bbe48cfd1d( $dists,1);
    return  $objects[$index];
}
global proc int JOPA_4_1_b370e1f695c58fe83552587a1fd52907(vector $coords[])
{
	$num=size($coords);
	$posA= $coords[0];
	$posB=$coords[$num-1];
	float $dists[];
	for($i=1;$i<$num-1;$i++)
	{
		$dists[$i]=JOPA_4_1_476390711655739e4d4919b7f7336b00($posA,$posB,$coords[$i]);
	}
	$index=JOPA_4_1_d0a0b515ba819d3c77adb0bbe48cfd1d( $dists,1);
	return $index;
}
global proc vector JOPA_4_1_e3bea614176fbceebe7c7aae67e953b0(vector $coords[])
{
	int $num = `size $coords`;
	vector $ff;
	for ($each in $coords)
	    $ff+=$each;
	$ff=($ff/$num);
	return $ff;
}
global proc int JOPA_4_1_d0a0b515ba819d3c77adb0bbe48cfd1d(float $massive[],int $min_max)
{
    $num=`size $massive`;
    int $number;
    string $str_ind_massive[];
    string $buffer[];
    for($i=0;$i<$num;$i++)
    {
        $str_ind_massive[$i]=$massive[$i] + ";" + $i;
    }
     $massive=`sort  $massive`;
     float $znach=$massive[0];
     if($min_max==1)
     {
	     if($num>0)
            $znach=$massive[$num-1];
         else
            $znach=$massive[$num];
     }
     string $obj;
     for($obj in $str_ind_massive)
     {
         tokenize $obj ";" $buffer;
         if($buffer[0]==$znach)
         {
             $number=$buffer[1];
             break;
         }
     }
     return $number;
}
global proc float JOPA_4_1_4d4e630bb3f78b918b505c8ebfcbb814(float $A[], float $B[], float $C[], int $RAD)
{
    vector $vBA=JOPA_4_1_b785f6145105d03029da5b3e19367cbd($B,  $A, 1);
    vector $vBC=JOPA_4_1_b785f6145105d03029da5b3e19367cbd($B,  $C, 1);
    $grad=`angle $vBA $vBC`;
    if(!$RAD)
        $grad=rad_to_deg( $grad);
    return  $grad;
}
global proc vector[] JOPA_4_1_72d9b297f109729673f6fe9d719defbd(string $base_object, string $coords)
{
	$selected=`ls-fl-sl`;
	vector $global_positions[] = JOPA_4_1_72356eaf232b169651a82383ba9e7e57($selected);
	vector $local_positions[] = JOPA_4_1_054bd1354cce44fe1809d56e47e98bd1( $base_object,$global_positions);
	vector $new_local_pos[];
	vector $tmp_v;
    if ($coords=="x")
    {
        for($i=0;$i<`size $local_positions`;$i++)
        {
            $tmp_v=$local_positions[$i];
            $new_local_pos[$i]=<<0,$tmp_v.y,$tmp_v.z>>;
        }
    }
    if ($coords=="y")
    {
        for($i=0;$i<`size $local_positions`;$i++)
        {
            $tmp_v=$local_positions[$i];
            $new_local_pos[$i]=<<$tmp_v.x,0,$tmp_v.z>>;
        }
    }
    if ($coords=="z")
    {
        for($i=0;$i<`size $local_positions`;$i++)
        {
            $tmp_v=$local_positions[$i];
            $new_local_pos[$i]=<<$tmp_v.x,$tmp_v.y,0>>;
        }
    }
	if ($coords=="xy")
    {
        for($i=0;$i<`size $local_positions`;$i++)
        {
            $tmp_v=$local_positions[$i];
            $new_local_pos[$i]=<<0,0,$tmp_v.z>>;
        }
    }
	if ($coords=="xz")
    {
        for($i=0;$i<`size $local_positions`;$i++)
        {
            $tmp_v=$local_positions[$i];
            $new_local_pos[$i]=<<0,$tmp_v.y,0>>;
        }
    }
	if ($coords=="yz")
    {
        for($i=0;$i<`size $local_positions`;$i++)
        {
            $tmp_v=$local_positions[$i];
            $new_local_pos[$i]=<<$tmp_v.x,0,0>>;
        }
    }
	 vector $abs_coords[] =JOPA_4_1_f36a2b49955bde470eba9a552b27050a ( $base_object,$new_local_pos);
    return  $abs_coords;
}
global proc vector[] JOPA_4_1_329067de90245bf18aa04dd0b6c95e8b(string $objects[])
{
    vector $positions[];
    $i=0;
    for($obj in $objects)
    {
        $positions[$i]=`xform -q -r -translation $obj`;
		$i++;
    }
    return $positions;
}
global proc vector[] JOPA_4_1_054bd1354cce44fe1809d56e47e98bd1(string $base_object, vector $coords[])
{
    float $input_matrix[]=`xform -q -m  -ws $base_object`;
    $input_matrix[12]=JOPA_4_1_f71c299bf7b53f7243b078a9990e581c($input_matrix[12]);
    $input_matrix[13]=JOPA_4_1_f71c299bf7b53f7243b078a9990e581c($input_matrix[13]);
    $input_matrix[14]=JOPA_4_1_f71c299bf7b53f7243b078a9990e581c($input_matrix[14]);
    float $inverce_matrix[]=JOPA_4_1_67e18bc2c5d60ae22ef30973f2f543ec($input_matrix);
    matrix $m2[4][4]=JOPA_4_1_bbdcb7aa2a9fb9f578c6918e969707df($inverce_matrix);
    float $gg_hhh[];
    matrix $mr14[1][4];
    matrix $r14[1][4];
    vector $final_position[];
    $i=0;
    vector $obj;
    for($obj in $coords)
    {
        $gg_hhh=$obj;
        $mr14 = <<$gg_hhh[0],$gg_hhh[1],$gg_hhh[2],1>>;
        $r14= $mr14 * $m2;
        $final_position[$i]=<<$r14[0][0],$r14[0][1],$r14[0][2]>>;
        $i++;
    }
    return  $final_position;
}
global proc vector[] JOPA_4_1_f36a2b49955bde470eba9a552b27050a(string $base_object, vector $coords[])
{
    float $input_matrix[]=`xform -q -m -ws $base_object`;
    $input_matrix[12]=JOPA_4_1_f71c299bf7b53f7243b078a9990e581c($input_matrix[12]);
    $input_matrix[13]=JOPA_4_1_f71c299bf7b53f7243b078a9990e581c($input_matrix[13]);
    $input_matrix[14]=JOPA_4_1_f71c299bf7b53f7243b078a9990e581c($input_matrix[14]);
    matrix $m2[4][4]=JOPA_4_1_bbdcb7aa2a9fb9f578c6918e969707df($input_matrix);
    float $gg_hhh[];
    matrix $mr14[1][4];
    matrix $r14[1][4];
    vector $final_position[];
    $i=0;
    vector $obj;
    for($obj in $coords)
    {
        $gg_hhh=$obj;
        $mr14 = <<$gg_hhh[0],$gg_hhh[1],$gg_hhh[2],1>>;
        $r14= $mr14 * $m2;
        $final_position[$i]=<<$r14[0][0],$r14[0][1],$r14[0][2]>>;
        $i++;
    }
    return  $final_position;
}
global proc float JOPA_4_1_f71c299bf7b53f7243b078a9990e581c(float $input)
{
   string $un=`currentUnit -query -linear`;
   float $output;
   float $coeff;
   if($un=="mm")
       $coeff=0.1;
   if($un=="cm")
       $coeff=1;
   if($un=="m")
       $coeff=100;
   if($un=="km")
       $coeff=100000;
   if($un=="in")
       $coeff=2.54;
   if($un=="ft")
       $coeff=30.48;
   if($un=="yd")
       $coeff=91.44;
   if($un=="mi")
       $coeff=160934.4;
    $output =  $input/$coeff;
    return $output;
}
global proc matrix JOPA_4_1_bbdcb7aa2a9fb9f578c6918e969707df(float $input_float[])
{
	float $i[]=$input_float;
	matrix $m[4][4]=<<$i[0],$i[1],$i[2],$i[3];
					$i[4],$i[5],$i[6],$i[7];
					$i[8],$i[9],$i[10],$i[11];
					$i[12],$i[13],$i[14],$i[15]>>;
	return $m;
}
global proc float[] JOPA_4_1_67e18bc2c5d60ae22ef30973f2f543ec(float $input_matrix[])
{
    float $i00=$input_matrix[0];
    float $i01=$input_matrix[1];
    float $i02=$input_matrix[2];
    float $i03=$input_matrix[3];
    float $i10=$input_matrix[4];
    float $i11=$input_matrix[5];
    float $i12=$input_matrix[6];
    float $i13=$input_matrix[7];
    float $i20=$input_matrix[8];
    float $i21=$input_matrix[9];
    float $i22=$input_matrix[10];
    float $i23=$input_matrix[11];
    float $i30=$input_matrix[12];
    float $i31=$input_matrix[13];
    float $i32=$input_matrix[14];
    float $i33=$input_matrix[15];
    float $s0 = $i00 * $i11 - $i10 * $i01;
    float $s1 = $i00 * $i12 - $i10 * $i02;
    float $s2 = $i00 * $i13 - $i10 * $i03;
    float $s3 = $i01 * $i12 - $i11 * $i02;
    float $s4 = $i01 * $i13 - $i11 * $i03;
    float $s5 = $i02 * $i13 - $i12 * $i03;
    float $c5 = $i22 * $i33 - $i32 * $i23;
    float $c4 = $i21 * $i33 - $i31 * $i23;
    float $c3 = $i21 * $i32 - $i31 * $i22;
    float $c2 = $i20 * $i33 - $i30 * $i23;
    float $c1 = $i20 * $i32 - $i30 * $i22;
    float $c0 = $i20 * $i31 - $i30 * $i21;
    float $invdet = 1 / ($s0 * $c5 - $s1 * $c4 + $s2 * $c3 + $s3 * $c2 - $s4 * $c1 + $s5 * $c0);
    float $m[];
    $m[0] = ($i11 * $c5 - $i12 * $c4 + $i13 * $c3) * $invdet;
    $m[1] = (-$i01 * $c5 + $i02 * $c4 - $i03 * $c3) * $invdet;
    $m[2] = ($i31 * $s5 - $i32 * $s4 + $i33 * $s3) * $invdet;
    $m[3] = (-$i21 * $s5 + $i22 * $s4 - $i23 * $s3) * $invdet;
    $m[4] = (-$i10 * $c5 + $i12 * $c2 - $i13 * $c1) * $invdet;
    $m[5] = ($i00 * $c5 - $i02 * $c2 + $i03 * $c1) * $invdet;
    $m[6] = (-$i30 * $s5 + $i32 * $s2 - $i33 * $s1) * $invdet;
    $m[7] = ($i20 * $s5 - $i22 * $s2 + $i23 * $s1) * $invdet;
    $m[8] = ($i10 * $c4 - $i11 * $c2 + $i13 * $c0) * $invdet;
    $m[9] = (-$i00 * $c4 + $i01 * $c2 - $i03 * $c0) * $invdet;
    $m[10] = ($i30 * $s4 - $i31 * $s2 + $i33 * $s0) * $invdet;
    $m[11] = (-$i20 * $s4 + $i21 * $s2 - $i23 * $s0) * $invdet;
    $m[12] = (-$i10 * $c3 + $i11 * $c1 - $i12 * $c0) * $invdet;
    $m[13] = ($i00 * $c3 - $i01 * $c1 + $i02 * $c0) * $invdet;
    $m[14] = (-$i30 * $s3 + $i31 * $s1 - $i32 * $s0) * $invdet;
    $m[15] = ($i20 * $s3 - $i21 * $s1 + $i22 * $s0) * $invdet;
    return $m;
}
global proc string JOPA_4_1_6d2bbf47e863c2f0037cf0467b97cef6()
{
	setToolTo moveSuperContext;
	float $getPvPos[]=`manipMoveContext -q -p  Move`;
	select -cl;
	$locators = `joint -p 0 0 0`;
	xform -ws -t $getPvPos[0] $getPvPos[1] $getPvPos[2];
	return $locators;
}
