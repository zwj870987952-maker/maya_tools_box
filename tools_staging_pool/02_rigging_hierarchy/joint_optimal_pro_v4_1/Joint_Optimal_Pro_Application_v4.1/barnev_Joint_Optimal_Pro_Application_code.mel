	JOPA_4_1_32a3829df17c3736d9757e423eeaf0e3($grpps,$jnts);
	catchQuiet(delete(JOPA_4_1_ac2021d0d7ff3ecfad4dbca9f9f88248($selected,$grpps)));
	select $jnts;
	JOPA_4_1_9a3ce25cfdbc96f0053e2e03715d7f2b;
	return $grpps;
}
global proc string[] JOPA_4_1_f0209cb5b5931bdfa7ae6801db19a0f8 ()
{
	string $uid_objs[]=`ls -uuid -sl`;
    string $curr_objs[];
    string $fin_objs[];
	string $group[];
	string $transform_grpp[];
	string $tmpp[]=JOPA_4_1_a2b81a3977941c0eac1cda769570172c();;
	for ($i=0; $i<(size($uid_objs)-1);$i++)
	{
	    $curr_objs=`ls -uuid {$uid_objs[$i+1],$uid_objs[$i]}`;
        if(objectType($curr_objs[0])=="joint" && objectType($curr_objs[1])=="joint")
        {
			select $curr_objs[0];
			$group=JOPA_4_1_e34225338b41391d68d09634ca599397(1);
			$transform_grpp=stringArrayRemove($tmpp,$group);
			$curr_objs=`ls -uuid {$uid_objs[$i+1],$uid_objs[$i]}`;
			connectJoint -pm $curr_objs[0] $curr_objs[1];
			catchQuiet(`delete $transform_grpp`);
        }
        else
             catchQuiet (`parent $curr_objs[0] $curr_objs[1]`);
	}
    $fin_objs=`ls -uuid $uid_objs`;
	select -cl;
	select $fin_objs;
	return $fin_objs;
}
global proc string[] JOPA_4_1_32a3829df17c3736d9757e423eeaf0e3 (string $target[], string $object[])
{
    if(size($target)!=size($object))
		warning "size parent massives is DIFFERENT!!! Only relevant objects will be processed! This can lead to unexpected consequences!!!!";
	if(size($target)> size($object))
		$target=`ls -head (size($object)) $target`;
    string $curr_objs[];
    string $fin_objs[];
	string $uid_objs[]=`ls -uuid $object`;
	string $uid_targts[]=`ls -uuid $target`;
    for($i=0;$i<size($target);$i++)
    {
        $curr_objs=`ls -uuid {$uid_objs[$i],$uid_targts[$i]}`;
        catchQuiet (`parent $curr_objs[0] $curr_objs[1]`);
    }
    $fin_objs=`ls -uuid $uid_objs`;
	select -cl;
	select $fin_objs;
	return $fin_objs;
}
global proc string[] JOPA_4_1_4666e1e44291e7950c6d8b3906bbb9c7 (string $target[], string $object[], int $reset_scale)
{
    if(size($target)!=size($object))
		warning "size parent massives is DIFFERENT!!! Only relevant objects will be processed! This can lead to unexpected consequences!!!!";
	if(size($target)> size($object))
		$target=`ls -head (size($object)) $target`;
    string $curr_objs[];
    string $fin_objs[];
	string $uid_objs[]=`ls -uuid $object`;
	string $uid_targts[]=`ls -uuid $target`;
	select $object;
	JOPA_4_1_a2b81a3977941c0eac1cda769570172c();
    for($i=0;$i<size($target);$i++)
    {
        $curr_objs=`ls -uuid {$uid_objs[$i],$uid_targts[$i]}`;
        if(objectType($curr_objs[0])=="joint" && objectType($curr_objs[1])=="joint")
            connectJoint -pm $curr_objs[0] $curr_objs[1];
            if($reset_scale)
                scale 1 1 1 $curr_objs[0];
        else
             catchQuiet (`parent $curr_objs[0] $curr_objs[1]`);
    }
    $fin_objs=`ls -uuid $uid_objs`;
	select -cl;
	select $fin_objs;
	return $fin_objs;
}
global proc JOPA_4_1_95a1a70cbaa809195c99a215410318c8(int $scale_mod)
{
    string $selected[]=`ls-fl-sl`;
    int $num=size($selected);
    string $objects[]=`ls-fl-head ($num-1) $selected`;
    string $target[]={};
    for($i=0;$i<$num-1;$i++)
        $target[$i]=$selected[$num-1];
    JOPA_4_1_4666e1e44291e7950c6d8b3906bbb9c7 ($target, $objects,$scale_mod);
}
global proc string[] JOPA_4_1_f4a01868ca61fbc2847abcd1b618cc24()
{
	$objs = `ls -fl -os`;
	string $revers_objs[];
	$j=size($objs)-1;
	for ($obj in $objs)
	{
		$revers_objs[$j]=$obj;
		$j--;
	}
	select -cl;
	select $revers_objs;
	return $revers_objs;
}
global proc string[] JOPA_4_1_e706e982298fe9e8f94ae04b06b5d6b2(string $prefix)
{
    string $uuids[],$uid;
    string $curr_obj[], $fin_obj[];
    $uuids=`ls  -uuid-sl`;
    for($uid in $uuids)
    {
        $curr_obj=`ls -uuid $uid`;
        rename $curr_obj[0] ($prefix  + "#");
    }
    select -cl;
    $fin_obj=`ls -uuid $uuids`;
    select $fin_obj;
    return $fin_obj;
}
global proc string[] JOPA_4_1_3cee12804dcac45527d4bfcfcb7c7431(string $prefix, string $postfix)
{
    string $uuids[]=`ls  -uuid-sl`;
    string $curr_obj[], $short_name, $fin_obj[];
    for($uid in $uuids)
    {
        $curr_obj=`ls  -l -uuid $uid`;
        $short_name= `match "[^|\\]*$"$curr_obj[0]`;
        rename $curr_obj[0] ($prefix +  $short_name + $postfix);
    }
    $fin_obj= `ls -uuid $uuids`;
    select -cl;
    select -r $fin_obj;
    return $fin_obj;
}
global proc string [] JOPA_4_1_c9088e941b7677113499bb19ad80f9bf (string $prefix, string $name_massive[])
{
    string $uuids[];
    string $curr_obj[],$short_name_curr,$short_name,$namesps,$new_names[];
    $uuids=`ls  -uuid-sl`;
	for($i=0;$i<size($uuids);$i++)
	{
	    $namesps = `match "^.*:"  $name_massive[$i]`;
	    $short_name = `match "[^/\:]*$" $name_massive[$i]`;
		$fin_name=JOPA_4_1_c954f3ebe8232ef721ae19221935b64e( $namesps   + $prefix + $short_name);
		$curr_obj=`ls  -l -uuid $uuids[$i]`;
		$short_name_curr= `match "[^|\\]*$"$curr_obj[0]`;
		rename $curr_obj[0] $fin_name;
	}
	select -cl;
    $new_names=`ls -uuid $uuids`;
    select $new_names;
	return $new_names;
}
