global proc JOPA_4_1_91de40fecac3ba14bdc612af67e8ee8e( float $scale_on)
{
    string $shape_name[];
    float $num;
    for($obj in `ls-sl`)
    {
        $shape_name=JOPA_4_1_5e702211108f11813c411c94f8b1b380($obj);
        if(`attributeQuery -node $shape_name[0] -ex localScaleX`)
        {
            $num=`getAttr ($shape_name[0] + ".localScaleX")`;
            catchQuiet( `setAttr ($shape_name[0] + ".localScaleX") ($num*$scale_on)` );
            $num=`getAttr ($shape_name[0] + ".localScaleY")`;
            catchQuiet( `setAttr ($shape_name[0] + ".localScaleY") ($num*$scale_on)` );
            $num=`getAttr ($shape_name[0] + ".localScaleZ")`;
            catchQuiet( `setAttr ($shape_name[0] + ".localScaleZ") ($num*$scale_on)` );
        }
        if(`attributeQuery -node $shape_name[0] -ex radius`)
        {
            $num=`getAttr ($shape_name[0] + ".radius")`;
            catchQuiet( `setAttr ($shape_name[0] + ".radius") ($num*$scale_on)` );
        }
    }
}
global proc JOPA_4_1_bd56535e7e051ab809c6591e7c585696(string $objects[], int $lock)
{
	if(!size($objects))
		return;
	string $obj;
	for($obj in $objects)
	{
		if(objectType($obj)=="joint")
		{
    		setAttr -lock $lock ($obj + ".jointOrientX");
    		setAttr -lock $lock ($obj + ".jointOrientY");
    		setAttr -lock $lock ($obj + ".jointOrientZ");
		}
	}
}
global proc JOPA_4_1_38212629cf9ce2087192134a449b78d6(int $tx, int $ty,int $tz, int $rx, int $ry,int $rz, int $sx, int $sy,int $sz, int $viz)
{
	string $objs[] = `ls-sl`;
	if(!size($objs))
		return;
	string $obj;
	for($obj in `ls-sl`)
	{
		setAttr -lock $tx ($obj + ".translateX");
		setAttr -lock $ty ($obj + ".translateY");
		setAttr -lock $tz ($obj + ".translateZ");
		setAttr -lock $rx ($obj + ".rotateX");
		setAttr -lock $ry ($obj + ".rotateY");
		setAttr -lock $rz ($obj + ".rotateZ");
		setAttr -lock $sx ($obj + ".scaleX");
		setAttr -lock $sy ($obj + ".scaleY");
		setAttr -lock $sz ($obj + ".scaleZ");
		setAttr -lock $viz ($obj + ".visibility");
	}
}
global proc JOPA_4_1_aa074854107180f09880ea0e8edd43f8()
{
	string $objs[] = `ls-sl`;
