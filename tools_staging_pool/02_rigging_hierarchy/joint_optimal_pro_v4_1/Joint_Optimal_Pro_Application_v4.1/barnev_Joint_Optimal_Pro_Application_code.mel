	{
		$axis_aim={0,0,1} ;
		$axis_up_vector={-1,0,0};
		$axis_w_up_vector={1,0,0};
	}
	$cmd="aimConstraint -offset 0 0 0 -weight 1 -aimVector " + $axis_aim[0] + " " + $axis_aim[1] + " " + $axis_aim[2] + " -upVector " + " " + $axis_up_vector[0] + " " + $axis_up_vector[1] + " " + $axis_up_vector[2] + " -worldUpType \"objectrotation\" -worldUpVector  " + " " + $axis_w_up_vector[0] + " " + $axis_w_up_vector[1] + " " + $axis_w_up_vector[2] + " -worldUpObject ";
	string $temp_jnts_pair[];
	string  $tmppp[];
	$selection=`ls -head 1 -sl`;
	string $parents[];
	$parents=`listRelatives -p $selection[0]`;
	if($parents[0]!="")
	{
		select -cl;
		select $parents[0] $selection[0];
		$temp_jnts_pair=JOPA_4_1_f2d5a2798ed7cfee36eb77ee8a281ed8();
		rotate 0 0 0 $temp_jnts_pair[1];
		$aim_name= eval ($cmd + $temp_jnts_pair[0] + " " + $temp_jnts_pair[0] + " " + $temp_jnts_pair[1]);
		select $temp_jnts_pair[1]  $selection[0];
		JOPA_4_1_9a8d2e62249cad27916aacc736478655;
		delete $temp_jnts_pair;
		select $selection[0];
		JOPA_4_1_95d47209f5832c068ce7614b82201089();
	}
	select  $selection;
	JOPA_4_1_8c16c9163e07a819fc2186f2d338a280(1);
}
global proc JOPA_4_1_18df331e107c49828a5c6e6e0b53d687()
{
    $selection=`ls-sl`;
    for($obj in $selection)
    {
      if(size(`listConnections  -d 0 -s 1 -type "pairBlend" ($obj + ".tx")`)!=0)
       setKeyframe -at translateX $obj;
             if(size(`listConnections  -d 0 -s 1 -type "pairBlend" ($obj + ".ty")`)!=0)
       setKeyframe -at translateY $obj;
             if(size(`listConnections  -d 0 -s 1 -type "pairBlend" ($obj + ".tz")`)!=0)
       setKeyframe -at translateZ $obj;
             if(size(`listConnections  -d 0 -s 1 -type "pairBlend" ($obj + ".rx")`)!=0)
       setKeyframe -at rotateX $obj;
             if(size(`listConnections  -d 0 -s 1 -type "pairBlend" ($obj + ".ry")`)!=0)
       setKeyframe -at  rotateY $obj;
             if(size(`listConnections  -d 0 -s 1 -type "pairBlend" ($obj + ".rz")`)!=0)
       setKeyframe -at  rotateZ $obj;
               if(size(`listConnections  -d 0 -s 1 -type "pairBlend" ($obj + ".sx")`)!=0)
       setKeyframe -at  scaleX $obj;
               if(size(`listConnections  -d 0 -s 1 -type "pairBlend" ($obj + ".sy")`)!=0)
       setKeyframe -at  scaleY $obj;
               if(size(`listConnections  -d 0 -s 1 -type "pairBlend" ($obj + ".sz")`)!=0)
       setKeyframe -at  scaleZ $obj;
    }
}
global proc JOPA_4_1_ede435b7fff94dfd41b52ef93374d3ee()
{
    $selected=`ls-fl-sl`;
    if(size ($selected)!=3)
    {
        error "select 3 object!";
        return;
    }
    $locks=JOPA_4_1_54d92f8424c4459e6d996d9fd93902f0();
    select -cl;
    $joint=`joint`;
    $p1=JOPA_4_1_8598296823aa3af15686cb0d78f1615d($selected[0]);
    $p2=JOPA_4_1_8598296823aa3af15686cb0d78f1615d($selected[1]);
    $p3=JOPA_4_1_8598296823aa3af15686cb0d78f1615d($selected[2]);
    $single_curve=`curve -d 1 -p 0 0 0 -p 0 0 1 -k 0 -k 1 `;
    $arc_node=`createNode makeThreePointCircularArc`;
    connectAttr ($arc_node + ".oc") ($single_curve + ".cr");
    connectAttr ($locks[0] + ".translate") ($arc_node + ".pt1") ;
    connectAttr ($locks[1] + ".translate")($arc_node + ".pt2");
    connectAttr ($locks[2] + ".translate")($arc_node + ".pt3") ;
    connectAttr -f ($arc_node + ".center") ($joint + ".translate");
    disconnectAttr  ($arc_node + ".center") ($joint + ".translate");
    connectAttr -f ($arc_node + ".center") ($joint + ".translate");
    $pos=`getAttr ($arc_node + ".center")`;
    delete $arc_node  $locks $single_curve;
    move -ws -a $pos[0] $pos[1] $pos[2] $joint;
    select  $joint;
}
global proc string JOPA_4_1_20a28b95c1b8b4dd29397ab332dbc667()
{
    $currentPanel = `getPanel -withFocus`;
    $error=catch($cam_name=`modelEditor -q -camera  $currentPanel`);
    if($error)
    {
        $cam_name="no model panel viewport";
    }
    return $cam_name;
}
global proc string find(string $procedure)
{
	string $path= `whatIs($procedure)`;
	string $fullPath=`substring $path 25 999`;
	system("load " + $fullPath);
	return $fullPath;
}
global proc string JOPA_4_1_0bb35ddf616d7cd6bdc38d3dd23af1bf()
{
	string $cmd = "mirrorJoint";
	string $mode;
	$mode = " -mirrorYZ";
	$cmd = ($cmd + $mode);
	$func = " -mirrorBehavior";
	$cmd = ($cmd + $func);
	string $search = `optionVar -query mirrorJointSearch`;
	string $replace = `optionVar -query mirrorJointReplace`;
	if (size($search) > 0 && size($replace) > 0) {
		$cmd += (" -searchReplace \""+$search+"\" \""+$replace+"\"");
	}
    return $cmd;
}
global proc string  JOPA_4_1_933d4aecbe9d9d0ce9a6591c5b2e3770(string $jnt)
{
    string $selected[]=`ls -l $jnt`;
    string $buffer[];
    string $root;
    $buffer=JOPA_4_1_465f2c70f8e4bf417e93834f61ee4f6e($selected[0], "|");
    string $var[]={};
    for($i=1;$i<size($buffer);$i++)
        $var[$i]=$var[$i-1]+"|"+$buffer[$i];
    for($i=1;$i<size($var);$i++)
    {
        if(`objectType $var[$i]`=="joint")
        {
            $root=$var[$i];
            break;
        }
    }
    return $root;
}
global proc float[] JOPA_4_1_e849743d83b9357359884fec322c28ec(string $curve, string $objects[])
{
    float $params[];
    if(size($objects)<1)
    {
        warning "no object for connect to curve";
        return $params;
    }
    string $lock[]=JOPA_4_1_526c020cd7c9a859fd08d49719a4fddf($objects);
    string $lockfin[]=JOPA_4_1_526c020cd7c9a859fd08d49719a4fddf($objects);
    string $near_point_on_crve_nodes[];
    string $decompose_matrix_nodes[];
    string $constr[];
    string $crve_shape[]=JOPA_4_1_5e702211108f11813c411c94f8b1b380($curve);
    for($i=0;$i<size($objects);$i++)
    {
        $near_point_on_crve_nodes[$i]=`createNode nearestPointOnCurve`;
        $decompose_matrix_nodes[$i]=`createNode decomposeMatrix`;
        connectAttr -f ($lock[$i] + ".worldMatrix[0]") ($decompose_matrix_nodes[$i] + ".inputMatrix");
        connectAttr -f ($decompose_matrix_nodes[$i] + ".outputTranslate") ($near_point_on_crve_nodes[$i] + ".inPosition");
        connectAttr -f ($crve_shape[0] + ".worldSpace[0]")  ($near_point_on_crve_nodes[$i] + ".inputCurve");
        connectAttr -f ($near_point_on_crve_nodes[$i] + ".position") ($lockfin[$i] + ".translate");
        $params[$i]=`getAttr ($near_point_on_crve_nodes[$i] + ".result.parameter")`;
    }
    delete (JOPA_4_1_4a0278149f801323f33f7bb9e4ee597d($lockfin,$objects));
    delete $near_point_on_crve_nodes $decompose_matrix_nodes $lock $lockfin;
    return $params;
}
global proc string[] JOPA_4_1_33737a5f897286cfa410615445094c2a(string $side_from, string $side_to, string $rule, int $x, int $y, int $z)
{
    string $selection[]=`ls-fl-sl`;
    string $mirror_object[]=JOPA_4_1_ce7b9a074764f1b06f64dfc666cf4813($selection,  $side_from,  $side_to);
    if(size($mirror_object)!=size($selection))
    {
        warning "not all mirror objects found!";
        return $mirror_object;
    }
    if(size($mirror_object)==0)
    {
        warning "no mirror objects found!";
        return $mirror_object;
    }
    if($rule=="translate")
        JOPA_4_1_b360a99bae10f4014414d48a6e4f58bd( $selection , $mirror_object , $x, $y, $z);
    if($rule=="rotate")
        JOPA_4_1_dd7661a2f1ff7e388148027fc411f9cb( $selection , $mirror_object , $x, $y, $z);
    select $selection;
    return $mirror_object;
}
global proc float[] JOPA_4_1_b785f6145105d03029da5b3e19367cbd(float $p1[], float $p2[], int $normalize)
{
  float $v2_1[]={$p2[0]-$p1[0],$p2[1]-$p1[1],$p2[2]-$p1[2]};
  if($normalize)
      normalize ($v2_1);
  return $v2_1;
}
global proc float JOPA_4_1_9cf10c253bb06da91bcfe3836a7e5f36(float $pos1[], float $pos2[])
{
    vector $p1_p2=<<$pos1[0],$pos1[1],$pos1[2]>> -<<$pos2[0],$pos2[1],$pos2[2]>>;
    $lenght=(`mag $p1_p2`);
    return $lenght;
}
global proc float[] JOPA_4_1_6f6ae5b84133776f167ce9bbf3409540(float $point1[],float $point2[],float $point3[])
{
	float $vector1[]={$point2[0]-$point1[0],$point2[1]-$point1[1],$point2[2]-$point1[2]};
	float $vector2[]={$point3[0]-$point1[0],$point3[1]-$point1[1],$point3[2]-$point1[2]};
	float $orto[]=crossProduct($vector2, $vector1, 1, 1);
	float $result[]=crossProduct($vector1, $orto, 1, 1);
	return $result;
}
global proc float[] JOPA_4_1_3a5adc63366ca7a6c7ff1a4a0eb042a1(float $point1[],float $point2[],float $distance)
{
	float $res[];
	vector $a=<<$point1[0],$point1[1],$point1[2]>>;
	vector $b=<<$point2[0],$point2[1],$point2[2]>>;
	$c=JOPA_4_1_9cf10c253bb06da91bcfe3836a7e5f36($point1, $point2);
	$kratnost=$distance/$c;
	$k=$a + ($b-$a)*$kratnost;
	$res=$k;
	return $res;
}
global proc float JOPA_4_1_476390711655739e4d4919b7f7336b00(float $pos_A[], float $pos_B[], float $pos_C[])
{
	float $c=JOPA_4_1_9cf10c253bb06da91bcfe3836a7e5f36($pos_A, $pos_B);
    float $b=JOPA_4_1_9cf10c253bb06da91bcfe3836a7e5f36($pos_A, $pos_C);
    float $a=JOPA_4_1_9cf10c253bb06da91bcfe3836a7e5f36($pos_C, $pos_B);
    float $p=($a+$b+$c)/2;
    float  $arg=($p*($p-$a)*($p-$b)*($p-$c));
    if($arg<=0)
        $arg=0;
	float $sqr=sqrt($arg);
    float $H_c=(2*$sqr)/$c;
    return $H_c;
}
global proc string[] JOPA_4_1_1d56f8884d88d7b022ffa48bc52b3755 (string $name_massive[],float $float_massive[])
{
    global string $my_name_massive[];
    global float $my_float_massive[];
    $my_name_massive= $name_massive;
    $my_float_massive=$float_massive;
    $shapka="import maya.cmds as cmds\nimport maya.mel as mel\nimport operator\n";
    $procdres="def sort_by_float_array(arr1, float_array):\n    tmp = [(x, y) for x, y in zip(arr1, float_array)]\n    tmp.sort(key=lambda element: element[1])\n    return [x for x, _ in tmp]\n";
    $KKKK_menue=$shapka + $procdres + "stringarr = maya.mel.eval('$tmppp2string=$my_name_massive')\nfloatarr = maya.mel.eval('$tmppp2float=$my_float_massive')\nmy_python_res = sort_by_float_array(stringarr,floatarr)";
    python($KKKK_menue);
    string $TransferVarPy[] = `python "my_python_res"`;
    return $TransferVarPy;
}
global proc string JOPA_4_1_65107bc37ea4a0d842be293fd78287a9(string $attribname, string $object)
{
    addAttr -ln $attribname -nn $attribname -at long  -dv 0 $object;
    setAttr -e-channelBox true ($object + "." + $attribname);
    return   ($object + "." + $attribname);
}
global proc string JOPA_4_1_e8f0c3b3e6300189aca31ae83320ec92(string $node_name_mask)
{
	$connected_nodes=`listConnections -t node`;
	string $nodename;
	int $has_connect_to_recalculate=0;
	string $obj;
	for($obj in $connected_nodes)
		{
		   if(`gmatch $obj $node_name_mask`)
		   {
		   $nodename=$obj;
		   $has_connect_to_recalculate=1;
		   }
		}
		return  $nodename;
}
global proc JOPA_4_1_9a8d2e62249cad27916aacc736478655()
{
	$obj=`ls-sl`;
	if (size($obj) == 2)
	{
		$Rot = `xform -q -ro -ws $obj[0]`;
		rotate -ws $Rot[0] $Rot[1] $Rot[2] $obj[1];
		rotate -ws $Rot[0] $Rot[1] $Rot[2] $obj[1];
		rotate -ws $Rot[0] $Rot[1] $Rot[2] $obj[1];
	}
	else
	{
		warning "Select 2 object!";
	}
}
global proc string[] JOPA_4_1_0a10c57fddb9b8e3dc07486c3a9a5eed()
{
	string $selection[];
	$selection_true = `ls -fl -sl `;
	$selection = `ls -fl -os`;
	string $locators[];
	string $gr;
	if (size ($selection)>0)
	{
         $j=0;
	    for($obj in $selection)
	    {
            $getPvPos=JOPA_4_1_8598296823aa3af15686cb0d78f1615d($obj);
            $gr=`group -r -em`;
            $locators[$j]=$gr;
            xform -ws -t $getPvPos[0] $getPvPos[1] $getPvPos[2] $gr;
            rotate -ws $getPvPos[3] $getPvPos[4] $getPvPos[5]  $gr;
            $j++;
		}
		select -cl;
		for($obj in $locators)
		{
		    select -add $obj;
		}
	}
	else
	{
	$locators[0] = `group -r -em`;
	}
	return $locators;
}
global proc string[] JOPA_4_1_a7e0d73da2a8798cbe2f405b170f6598()
{
    string $selection[]=`ls-fl-os`;
    string $lock[]=JOPA_4_1_f2d5a2798ed7cfee36eb77ee8a281ed8();
    catchQuiet ( JOPA_4_1_d1b73d0512bac8d20998bdbab9b3aed7($selection, $lock) );
    for($i=0;$i<size($selection);$i++)
        if(!((`objectType -isType "mesh" $selection[$i]`)+(`objectType -isType "nurbsSurface" $selection[$i]`)+(`objectType -isType "nurbsCurve" $selection[$i]`)+(`objectType -isType "lattice" $selection[$i]`)))
            delete `orientConstraint $selection[$i] $lock[$i]`;
    return $lock;
}
global proc string[] JOPA_4_1_526c020cd7c9a859fd08d49719a4fddf(string $objects[])
{
	string $selection[] = `ls -fl -os`;
	select -cl;
	string $locators[],$b[];
	if (size ($objects)>0)
	{
		for($obj in $objects)
		{
			$getPvPos=JOPA_4_1_8598296823aa3af15686cb0d78f1615d($obj);
			$b=`spaceLocator -p 0 0 0`;
			appendStringArray($locators, $b, 1);
			move -a  $getPvPos[0] $getPvPos[1] $getPvPos[2] $b[0];
			rotate -ws $getPvPos[3] $getPvPos[4] $getPvPos[5]  $b[0];
		}
	}
	else
		$locators = `spaceLocator -p 0 0 0`;
	select $selection;
	return $locators;
}
global proc string [] JOPA_4_1_c99bdb5a898efbfb1d4fa2221eba881b(string $target_massiv[], string $object_massiv[])
{
	string $name_of_constrain[];
	string $tmp[];
	int $rx_lock;
	int $ry_lock;
	int $rz_lock;
	int $h;
	string $skipX;
	string $skipY;
	string $skipZ;
	string $skipped;
	for($i=0;$i<size($target_massiv);$i++)
		{
		$rx_lock=`getAttr -lock ($object_massiv[$i] + ".rx")`;
		$ry_lock=`getAttr -lock ($object_massiv[$i] + ".ry")`;
		$rz_lock=`getAttr -lock ($object_massiv[$i] + ".rz")`;
		$h=$rx_lock+$ry_lock+$rz_lock;
		if ($h<3)
		{
			$skipX= "";
			$skipY= "";
			$skipZ= "";
			if($rx_lock)
				$skipX= " -skip x";
			if($ry_lock)
				$skipY= " -skip y";
			if($rz_lock)
				$skipZ= " -skip z";
			$skipped = $skipX + $skipY + $skipZ;
			$tmp=`eval ("orientConstraint -mo " + $skipped + " " + $target_massiv[$i] + " " + $object_massiv[$i])`;
			$name_of_constrain[$i]=$tmp[0];
		}
	}
	return $name_of_constrain;
}
global proc JOPA_4_1_5e8af8371c687e5c50d7ded5040ffe13(string $target_position[], string $object_to_move[])
{
	float $Trans[];
	float $Rot[];
	for($i=0;$i<size($target_position);$i++)
	{
        $Trans=JOPA_4_1_8598296823aa3af15686cb0d78f1615d($target_position[$i]);
        $Rot={$Trans[3],$Trans[4],$Trans[5]};
		rotate -ws $Rot[0] $Rot[1] $Rot[2] $object_to_move[$i];
		move -rpr $Trans[0] $Trans[1] $Trans[2] $object_to_move[$i];
		rotate -ws $Rot[0] $Rot[1] $Rot[2] $object_to_move[$i];
		move -rpr $Trans[0] $Trans[1] $Trans[2] $object_to_move[$i];
		rotate -ws $Rot[0] $Rot[1] $Rot[2] $object_to_move[$i];
		move -rpr $Trans[0] $Trans[1] $Trans[2] $object_to_move[$i];
	}
}
global proc JOPA_4_1_b360a99bae10f4014414d48a6e4f58bd(string $target[], string $object[], int $x, int $y, int $z)
{
	string $nodename;
	for($i=0;$i<size($target);$i++)
	{
		$nodename=`createNode multiplyDivide`;
		connectAttr -f ($target[$i] + ".translate") ($nodename + ".input1");
		setAttr ($nodename + ".operation") 1;
		setAttr ($nodename + ".input2X")  1;
		setAttr ($nodename + ".input2Y")  1;
		setAttr ($nodename + ".input2Z")  1;
		if($x)
		    setAttr ($nodename + ".input2X")  -1;
		if($y)
		    setAttr ($nodename + ".input2Y")  -1;
		if($z)
		    setAttr ($nodename + ".input2Z")  -1;
		connectAttr -f ($nodename + ".output") ($object[$i] + ".translate");
	}
}
global proc JOPA_4_1_dd7661a2f1ff7e388148027fc411f9cb(string $target[], string $object[], int $x, int $y, int $z)
{
	string $nodename;
	for($i=0;$i<size($target);$i++)
	{
		$nodename=`createNode multiplyDivide`;
		connectAttr -f ($target[$i] + ".rotate") ($nodename + ".input1");
		setAttr ($nodename + ".operation") 1;
		setAttr ($nodename + ".input2X")  1;
		setAttr ($nodename + ".input2Y")  1;
		setAttr ($nodename + ".input2Z")  1;
		if($x)
		    setAttr ($nodename + ".input2X")  -1;
		if($y)
		    setAttr ($nodename + ".input2Y")  -1;
		if($z)
		    setAttr ($nodename + ".input2Z")  -1;
		connectAttr -f ($nodename + ".output") ($object[$i] + ".rotate");
	}
}
global proc string JOPA_4_1_399e6ca23a24d0e48ed5cb872f4729dd( string $shape )
{
    string $transform;
	if ( "transform" != `nodeType $shape` )
	{
		string $parents[] = `listRelatives  -parent $shape`;
		$transform = $parents[0];
	}
   return $transform;
}
global proc string[] JOPA_4_1_b3acc831f9f61a01a45fe7165ec12c62(string $full_name, string $side_from, string $side_to)
{
	string $buffer[], $short_names_buff[];
	$short_names_buff=JOPA_4_1_465f2c70f8e4bf417e93834f61ee4f6e($full_name, $side_from);
	string $fin_var[];
	int $count=size($short_names_buff)-1;
	int $bit;
	int $step=pow (2,$count);
	string $new_short[]={};
	for($j=0;$j<$step;$j++)
	{
		for($k=0;$k<$count;$k++)
		{
			$bit=JOPA_4_1_606ff0264a96e1d3ce1e41778c87d876(floor($j/(pow(2,$k))));
			if($bit)
				$new_short[$k]=$short_names_buff[$k] + $side_from;
			else
				$new_short[$k]=$short_names_buff[$k] + $side_to;
		}
		$fin_var[$j]=stringArrayToString($new_short,"") + $short_names_buff[$count];
	}
	$fin_var =stringArrayRemove({$full_name}, $fin_var);
	return  $fin_var;
}
global proc JOPA_4_1_5cca387e40527d14dd0862d275b6a5fc(string $j_chain[], string $axis, string $sao_napr, string $ch_up)
{
    float $sao_napr_angle=0;
    if($sao_napr=="down")
    {
         $sao_napr_angle=180;
    }
    float $ch_angle=0;
    if($ch_up=="change")
    {
         $ch_angle=180;
    }
    $selected=$j_chain;
    select $selected[0];
	    string $or;
        string $up;
        string $aim_V;
        string $up_v;
    if($axis=="x"||$axis=="-x")
    {
	    $or="xyz";
        $up="x" +  $sao_napr;
        $aim_V=" 0 -1 0 ";
        $up_v=" 0 0 1 ";
    }
    if($axis=="y"||$axis=="-y")
    {
        $or="yzx";
        $up="y" +  $sao_napr;
        $aim_V=" 0 0 -1 ";
        $up_v=" 1 0 0 ";
    }
    if($axis=="z"||$axis=="-z")
    {
        $or="zxy";
        $up="z" +  $sao_napr;
        $aim_V=" -1 0 0 ";
        $up_v=" 0 1 0 ";
    }
	$locks_for_aim=JOPA_4_1_54d92f8424c4459e6d996d9fd93902f0();
	select $selected;
	$max_dist=JOPA_4_1_18a895830f3c7ec611ca2fbd58e5730f(1);
	float $diist=$max_dist[2];
	vector $coords[]=JOPA_4_1_72356eaf232b169651a82383ba9e7e57($selected);
	int $ind=JOPA_4_1_b370e1f695c58fe83552587a1fd52907($coords);
    string $aim_name[];
    string $cmd;
    if ($sao_napr=="up")
        $cmd="aimConstraint -offset 0 0 0 -weight 1 -aimVector " + $aim_V + " -upVector " + $up_v + "-worldUpType \"object\" -worldUpObject " +  $selected[$ind] + " "  + $selected[size($selected)-1] + " "  + $locks_for_aim[0];
    else
        $cmd="aimConstraint -offset 0 0 0 -weight 1 -aimVector " + $up_v  + " -upVector " + $aim_V + "-worldUpType \"object\" -worldUpObject " +  $selected[$ind] + " "  + $selected[size($selected)-1] + " "  + $locks_for_aim[0];
	$aim_name =eval($cmd);
	delete $aim_name;
    $locks_true_position=`duplicate $locks_for_aim`;
	$ori_cstr=`orientConstraint -mo -weight 1 $locks_for_aim $selected[0]`;
	if($sao_napr=="up")
	    rotate -a 0 0 0  $locks_for_aim;
	    else
	    rotate -a 90 90 0  $locks_for_aim;
	delete 	$ori_cstr;
	select $selected;
	makeIdentity -apply true -t 0 -r 1 -s 0 -n 0 -pn 1;
    joint -e  -oj $or -secondaryAxisOrient $up;
    $childrens=`listRelatives -f -c -typ "joint" $selected[size($selected)-1]`;
    if (size($childrens)==0)
    {
    	setAttr ($selected[size($selected)-1] + ".jointOrientX") 0;
        setAttr ($selected[size($selected)-1] + ".jointOrientY") 0;
        setAttr ($selected[size($selected)-1] + ".jointOrientZ") 0;
    }
    $ori_cstr=`orientConstraint -mo -weight 1   $locks_for_aim $selected[0]`;
    select $locks_true_position $locks_for_aim;
    JOPA_4_1_9a8d2e62249cad27916aacc736478655();
    delete 	$ori_cstr;
    delete $locks_for_aim  $locks_true_position;
    select $selected;
    JOPA_4_1_a2b81a3977941c0eac1cda769570172c();
    if($axis=="x")
    {
        rotate -r -os -fo ($ch_angle) 0 0 ;
    }
    if($axis=="y")
    {
        rotate -r -os -fo 0 ($ch_angle) 0 ;
    }
    if($axis=="z")
    {
        rotate -r -os -fo 0 0 ($ch_angle) ;
    }
    if($axis=="-x")
    {
        rotate -r -os -fo ($ch_angle-$sao_napr_angle) 0 180 ;
    }
    if($axis=="-y")
    {
        rotate -r -os -fo 180 ($ch_angle-$sao_napr_angle) 0 ;
    }
    if($axis=="-z")
    {
        rotate -r -os -fo 0 180 ($ch_angle-$sao_napr_angle) ;
    }
    JOPA_4_1_f0209cb5b5931bdfa7ae6801db19a0f8();
    select -cl;
    select $selected;
}
global proc string[] JOPA_4_1_18a895830f3c7ec611ca2fbd58e5730f(int $min_max)
{
	$selection=`ls-fl-sl`;
	$TotSize = `size $selection`;
	string $return_pair[];
	float $pi[] = `xform -ws -q -t $selection[0]`;
	float $pj[] = `xform -ws -q -t $selection[1]`;
	float $maxdist = `mag(<<$pi[0],$pi[1],$pi[2]>> - <<$pj[0],$pj[1],$pj[2]>>)`;
	float $distance=$maxdist;
	int $found=0;
	for ($i=0;$i<$TotSize-1;$i++)
	{
		for ($j=$i+1; $j<$TotSize; $j++)
		{
			$pi = `xform -ws -q -t $selection[$i]`;
			$pj = `xform -ws -q -t $selection[$j]`;
			$distance = `mag(<<$pi[0],$pi[1],$pi[2]>>-<<$pj[0],$pj[1],$pj[2]>>)`;
			if($min_max==1)
			{
				if ($distance > $maxdist || $found==0)
				{
				    $found=1;
					$maxdist = $distance;
					$return_pair[0]=$selection[$i];
					$return_pair[1]=$selection[$j];
					$return_pair[2]=$maxdist;
				}
			}
			if($min_max==0)
			{
				if ($distance <= $maxdist || $found==0)
				{
					$found=1;
					$maxdist = $distance;
					$return_pair[0]=$selection[$i];
					$return_pair[1]=$selection[$j];
					$return_pair[2]=$maxdist;
				}
			}
		}
	}
return $return_pair;
}
global proc JOPA_4_1_b0727bdb3ca55fb364a5d867d3297ff5(string $target[], string $object[])
{
    for($i=0;$i<size($target);$i++)
    {
        setAttr ($object[$i] + ".jointOrientX") `getAttr ($target[$i] + ".jointOrientX")`;
        setAttr ($object[$i] + ".jointOrientY") `getAttr ($target[$i] + ".jointOrientY")`;
        setAttr ($object[$i] + ".jointOrientZ") `getAttr ($target[$i] + ".jointOrientZ")`;
    }
}
global proc string[] JOPA_4_1_9542c11845a1e56080fc5b7a1c5e8a5b(string $get_string_for_revers[])
{
    string $revers_objs[];
	$j=size($get_string_for_revers)-1;
	for ($obj in $get_string_for_revers)
	{
		$revers_objs[$j]=$obj;
		$j--;
	}
	return $revers_objs;
}
global proc string[] JOPA_4_1_465f2c70f8e4bf417e93834f61ee4f6e(string $stroka, string $poisk)
{
	string $buffer[]={};
	string $fin_str=$stroka;
	int $siz_stroka=sizeBytes($stroka);
	int $siz_poisk=sizeBytes($poisk);
	for($i=0;$i<($siz_stroka/ $siz_poisk)+1;$i++)
	    $fin_str=`substitute $poisk $fin_str "###^@@@"`;
	tokenize $fin_str "^" $buffer;
	for($i=0;$i<size($buffer);$i++)
	{
	    $buffer[$i]=`substitute "###" $buffer[$i] ""`;
	    $buffer[$i]=`substitute "@@@" $buffer[$i] ""`;
	}
	return $buffer;
}
global proc int JOPA_4_1_606ff0264a96e1d3ce1e41778c87d876(float $num)
{
    int $odd;
    if($num/2==ceil ($num/2))
        $odd=1;
    else
        $odd=0;
    return $odd;
}