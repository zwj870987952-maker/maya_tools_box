global proc string[] JOPA_4_1_54d92f8424c4459e6d996d9fd93902f0()
{
	string $selection[];
	$selection_true = `ls -fl -sl `;
	$selection = `ls -fl -os`;
	string $locators[];
	string $b[];
	if (size ($selection)>0)
	{
		$j=0;
		for($obj in $selection)
		{
			$getPvPos=JOPA_4_1_8598296823aa3af15686cb0d78f1615d($obj);
			$b=`spaceLocator -p 0 0 0`;
			$locators[$j]=$b[0];
			xform -ws -t $getPvPos[0] $getPvPos[1] $getPvPos[2] $b[0];
			rotate -ws $getPvPos[3] $getPvPos[4] $getPvPos[5]  $b[0];
			$j++;
		}
		select -cl;
		for($obj in $locators)
		{
			select -add $obj;
		}
	}
	else
	{
		$locators = `spaceLocator -p 0 0 0`;
	}
	return $locators;
}
global proc string[] JOPA_4_1_f2d5a2798ed7cfee36eb77ee8a281ed8()
{
	string $selection[];
	$selection_true = `ls -fl -sl `;
	$selection = `ls -fl -os`;
	string $locators[];
	string $b[];
	select -cl;
	float $getPvPos[];
	if (size ($selection)>0)
	{
	    $j=0;
	    for($obj in $selection)
	    {
            $getPvPos=JOPA_4_1_8598296823aa3af15686cb0d78f1615d($obj);
            $b[0]=`joint`;
            $locators[$j]=$b[0];
            xform -ws -t $getPvPos[0] $getPvPos[1] $getPvPos[2] $b[0];
            rotate -ws $getPvPos[3] $getPvPos[4] $getPvPos[5]  $b[0];
            $j++;
		}
		for($obj in $locators)
		{
		    select -add $obj;
		}
	}
	else
	{
		$locators[0] =`joint -p 0 0 0`;
	}
	select -cl;
	select $locators;
	return $locators;
}
global proc string JOPA_4_1_a8d1933a966541e62d79a2fcbf6e4ea4(int $interpolation)
{
    $selection_true = `ls -fl -sl `;
	string $selection[]=`ls -fl -os`;
	vector $coords[];
	string $pnt = "";
	float $getPvPos[];
	if (size ($selection)<=1)
	{
		warning "select 2 object or points";
		return "";
	}
    $coords=JOPA_4_1_72356eaf232b169651a82383ba9e7e57($selection);
    $curve_name=JOPA_4_1_83a9015d514ecd1326a1648b28396ba2($coords,$interpolation);
    return $curve_name;
}
global proc string JOPA_4_1_83a9015d514ecd1326a1648b28396ba2(vector $coords[],int $interp)
{
	string $pnt = "";
	if (size ($coords)<=1)
	{
		warning "need 2 object or points";
		return "";
	}
	for ($i=0;$i<size($coords);$i++)
	{
		$pnt= $pnt + " -p " + $coords[$i];
	}
	$curve_name=`eval("curve" + $pnt + "-d " + $interp)`;
	return $curve_name;
}
global proc string JOPA_4_1_b059868e801453725e5c31a1938f0210(float $p1[],float $p2[], float $p3[], int $degree, int $spans)
{
    $selected=`ls-sl`;
	$single_curve=`curve -d 1 -p 0 0 0 -p 0 0 1 -k 0 -k 1 `;
	$arc_node=`createNode makeThreePointCircularArc`;
	setAttr ($arc_node + ".d") $degree;
	setAttr ($arc_node + ".s") $spans;
	connectAttr ($arc_node + ".oc") ($single_curve + ".cr");
	setAttr ($arc_node + ".pt1") $p1[0] $p1[1] $p1[2] ;
	setAttr ($arc_node + ".pt2") $p2[0] $p2[1] $p2[2] ;
	setAttr ($arc_node + ".pt3") $p3[0] $p3[1] $p3[2] ;
	$curves_dup_tmp=`duplicate $single_curve`;
	delete $arc_node $single_curve;
	select 	$selected;
	return $curves_dup_tmp[0];
}
global proc string[] JOPA_4_1_e6d1cc62e700198ddfd8906d663761ba()
{
	$selected=`ls-fl-os`;
	$grpps=`JOPA_4_1_0a10c57fddb9b8e3dc07486c3a9a5eed`;
