		button  -h $mid_button_h  -w ($btnn_w*0.9) -command " JOPA_4_1_7c23beeb22741f0c0bad91ebefb06e18()" -annotation "correcting joint rotate manually"  "correct manually";
    	button   -h $mid_button_h -w ($btnn_w*0.9) -command " pickWalk -d up; pickWalk -d up; select -hi; DeleteConstraints; delete;" -annotation "delete rotators"  "delete manip";
		button   -h $mid_button_h -w ($btnn_w/2) -command "JOPA_4_1_7c23beeb22741f0c0bad91ebefb06e18();JOPA_4_1_39488f9fb9b49f3b387fe78ea9cda2f0();JOPA_4_1_cc20e95399a3b6da44eb78e45451d764(13); JOPA_4_1_6de8028af587b467034457b4d6349f89(1.5) " -annotation " - proportion_rotate - for delete - use DELETE MANIP button"  "prop";
