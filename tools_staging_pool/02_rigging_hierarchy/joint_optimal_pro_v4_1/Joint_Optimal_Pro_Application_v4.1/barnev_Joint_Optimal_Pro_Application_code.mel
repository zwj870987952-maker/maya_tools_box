		button  -h $mid_button_h -w ($btnn_w*1.5)  -command "SelectHierarchy; $sel_joints=JOPA_4_1_1ed150b12535ee196bee8b74a6bf5f5c(`ls-sl`, \"joint\");select $sel_joints;" -annotation "hierarchically selects joints only" "select joints hierarchy";
		text -label " - selects joints only" -annotation "hierarchically selects joints only";
rowLayout -p "n_tools"  -numberOfColumns 3;
		button  -h $mid_button_h -w ($btnn_w) -command "JOPA_4_1_cf07169f94f84aada068ef575331b875(\"forward\")" -annotation "hierarchically selects a piece of chain between selected joints" "select between";
		text -label " - selects a piece of chain" -annotation "select chain between 2 selected joints";
rowLayout -p "n_tools" -nc 6;
	button  -annotation " find duplicates from selected joints and create set with them"
		-h $mid_button_h -w ($btnn_w)  -c "select (`JOPA_4_1_c81811a11b8f20fafe4877c444b7b2a7`);sets -n name_Duplicates" "find duplicates";
	text -label " - finds the same names on selected" -annotation "finds the same names on selected objects";
rowLayout -p "n_tools" -numberOfColumns 3 ;
	button  -h $small_button_h -w ($btnn_w/2)  -command " selectPref -sch 1;" -annotation "highlited all childs"  "OFF";
	button -h $small_button_h -w ($btnn_w/2) -command " selectPref -sch 0;" -annotation "highlited selected objects only  "  "ON";
	text " - childs highlite mode";
 $fral=`frameLayout
            -bgc $red[0] $red[1] $red[2]
            -mh 0
            -mw 1
			-ann $jopa_version
            -cc " window -e -h 500 create_skeleton_tools"
            -p "naming" -cl 0 -cll true -l "MASS RENAME TOOLS"`;
columnLayout -adj 1  -p   $fral "n_postf";
rowLayout -cw 1 40 -cw 2 75 -cw 3 10  -cw 4 75 -cw 5 50 -p "n_postf" -adj 5 -nc 8 ;
	text -ann "rename selected object with insert prefix and suffix" -l "prefix> ";
	textField -ec "$final_name=`textField -q -tx prefix_text_field`;" -en true -cc "$final_name=`textField -q -tx prefix_text_field`;" -w 75 -rfc "$final_name=`textField -q -tx prefix_text_field`;" -ed true "prefix_text_field";
	text -ann "rename selected object with insert prefix and suffix" -l "...";
	textField -ec "$final_name=`textField -q -tx postfix_text_field`;" -en true -cc "$final_name=`textField -q -tx postfix_text_field`;" -w 75 -rfc "$final_name=`textField -q -tx postfix_text_field`;" -ed true "postfix_text_field";
	text -ann "rename selected object with insert prefix and suffix" -l "<postfix";
	button -ann "rename selected object with insert prefix and suffix"
			-c "JOPA_4_1_3cee12804dcac45527d4bfcfcb7c7431(`textField -q -tx prefix_text_field` , `textField -q -tx postfix_text_field`); "
			-w ($btnn_w*0.8)
			-l "apply";
	separator -p "naming" -width $separator_len;
rowLayout -cw 1 40 -cw 2 80 -cw 3 80 -cw 4 50 -p "n_postf" -adj 4 -nc 8 ;
	text -ann "search and replace from selected" -l "search>";
	textField -ec "$final_name=`textField -q -tx search_text_field`;" -en true -cc "$final_name=`textField -q -tx search_text_field`;" -w 80 -rfc "$final_name=`textField -q -tx search_text_field`;" -ed true "search_text_field";
 	textField -ec "$final_name=`textField -q -tx replace_text_field`;" -en true -cc "$final_name=`textField -q -tx replace_text_field`;" -w 80 -rfc "$final_name=`textField -q -tx replace_text_field`;" -ed true "replace_text_field";
	text -ann "search and replace from selected" -l "<replace";
 	button   -w ($btnn_w*0.8)
			-ann "search and replace from selected" -c "searchReplaceNames(`textField -q -tx search_text_field` , `textField -q -tx replace_text_field`,	\"selected\"); " -l "S_and_R";
rowLayout -p "n_postf"   -nc 8 ;
	button  -w ($btnn_w*1.5)
			-ann "search and replace from selected" -c " catchQuiet(`JOPA_4_1_f17bdd4811ed4c79ad676fdc4d5a1414`); " -l "remove namespaces";
	text -ann "remove all namespaces exclude from reference" -l " - remove all namespaces";
columnLayout -adj 1  -ann $jopa_version -parent "naming" "podpis2";
 text  -h ($base_text_height+5)  -p  "podpis2" -al "center" -ww false  -l "autor  Pavel Barnev       pavel_barnev2000@mail.ru";
showWindow "create_skeleton_tools";
dockControl   -h 30 -label "J.oint O.ptimal P.ro A.pplication " -aa "left" -aa "right" -aa "top" -aa "bottom"-p "tabLayout2" -a "left" -con "create_skeleton_tools" "JointOPtimalAalign";
}
global proc JOPA_4_1_f16154a48b6bb7af40bdec525973aa99(int $on_off)
{
    string $skins[] = `ls -type "skinCluster"`;
    for ($skin in $skins)
		if ($on_off)
			skinCluster -e -moveJointsMode true $skin;
		else
			skinCluster -e -moveJointsMode false $skin;
}
global proc JOPA_4_1_5ca4dc00d401eb19d3b3eaf8ceb68c51(int $mod)
{
    string $selected[]=`ls-sl`;
    string $createSetResult_object = `sets -name "object"`;
    $num=size($selected);
    if($num<=1)
    {
		warning "select more then 1 object";
		delete $createSetResult_object;
		return;
    }
    string $curve_name;
    if($mod==1)
        $curve_name=JOPA_4_1_52cb8fd96018b22c9d21d83beb0fbc31(3);
    else
        $curve_name=JOPA_4_1_a8d1933a966541e62d79a2fcbf6e4ea4(1);
    string $curves[]=`rebuildCurve -ch 1 -rpo 0 -rt 0 -end 1 -kr 0 -kcp 0 -kep 0 -kt 0 -s ($num*2) -d  3 -tol 0.01 $curve_name`;
    string $rebild_curve_shape[]=JOPA_4_1_5e702211108f11813c411c94f8b1b380($curves[0]);
    select -cl;
    float $rad=1;
    catchQuiet($rad=`getAttr  ($selected[$num-1] + ".radius")`);
	select $selected[$num-1];
	string $tmpp[]=`JOPA_4_1_f2d5a2798ed7cfee36eb77ee8a281ed8`;
    string $joint= $tmpp[0];
    JOPA_4_1_92de112c5c170c44ad9daf4d48b1acdd($rad);
    select -cl;
    select $selected;
    select -d	$selected[$num-1];
    select -add $joint  $selected[$num-1];
	string $new_selected[]=`ls-sl`;
	string $createSetResult_new_selected  = `sets -name "object"`;
	string $base_locks[]=JOPA_4_1_54d92f8424c4459e6d996d9fd93902f0();
    string $p_constrain[]=JOPA_4_1_4a0278149f801323f33f7bb9e4ee597d($base_locks,$new_selected);
    string $point_on_curve_info_node=`createNode pointOnCurveInfo`;
    connectAttr -f ($rebild_curve_shape[0] + ".worldSpace[0]") ($point_on_curve_info_node + ".inputCurve");
    float $distt=1.0/($num);
    $i=0;
    for($obj in $base_locks)
    {
        $param=$distt*$i;
        setAttr ($point_on_curve_info_node + ".parameter") $param;
        $new_pos=`getAttr  ($point_on_curve_info_node + ".position ")`;
        move -a $new_pos[0] $new_pos[1]  $new_pos[2] $obj ;
        $i++;
    }
    string $parent[]=`listRelatives -f -p $selected[$num-1]`;
    string $parent2[]=`listRelatives -f -p $selected[$num-2]`;
    string $childs[]=`listConnections-t node $createSetResult_object`;
    $childs=`ls -l $childs`;
    if ($parent[0]!="")
    {
        JOPA_4_1_4666e1e44291e7950c6d8b3906bbb9c7 ({$parent[0]}, { $joint},1);
	}
	if($parent[0]==$childs[$num-2])
	{
	    JOPA_4_1_4666e1e44291e7950c6d8b3906bbb9c7 ({$joint}, {$childs[$num-1]},1);
	}
	if($parent2[0]==$childs[$num-1])
	{
	    JOPA_4_1_4666e1e44291e7950c6d8b3906bbb9c7 ({$childs[$num-1]}, {$joint},1);
	    $childs=`listConnections -t node $createSetResult_object`;
	    $childs=`ls -l $childs`;
	    JOPA_4_1_4666e1e44291e7950c6d8b3906bbb9c7 ({$joint}, {$childs[$num-2]},1);
	}
	$childs=`listConnections -t node $createSetResult_new_selected`;
	select -cl;
    select $childs;
	JOPA_4_1_18df331e107c49828a5c6e6e0b53d687();
	catchQuiet(`delete $p_constrain`);
	catchQuiet(`delete $base_locks`);
	delete $createSetResult_object $createSetResult_new_selected;
	delete $curves $point_on_curve_info_node  $curve_name;
    select $joint;
    JOPA_4_1_d1f6eb5ab8caa780647f498704025cf1();
    select -cl;
    select $childs;
}
global proc JOPA_4_1_9d2772351e5b1bd29134402e8ccbbda0()
{
    string $selected[]=`ls -l -sl`;
    select -cl;
    select $selected;
    string $createSetResult = `sets -name "object"`;
    $num=size($selected);
    if($num<=2)
    {
        warning "select more then 2 joints";
        delete $createSetResult;
        return;
    }
    string $curve_name=JOPA_4_1_52cb8fd96018b22c9d21d83beb0fbc31(3);
    string $curves[]=`rebuildCurve -ch 1 -rpo 0 -rt 0 -end 1 -kr 0 -kcp 0 -kep 0 -kt 0 -s ($num*2) -d  3 -tol 0.01 $curve_name`;
    string $rebild_curve_shape[]=JOPA_4_1_5e702211108f11813c411c94f8b1b380($curves[0]);
    select -cl;
    select $selected[$num-1];
    string $parent[]=`listRelatives -f -p $selected[$num-1]`;
    string $parent2[]=`listRelatives -f -p $selected[$num-2]`;
    if ($parent[0]==$selected[$num-2])
    {
       JOPA_4_1_a2b81a3977941c0eac1cda769570172c();
    }
    delete $selected[$num-2];
    string $childs[]=`listConnections  -t node $createSetResult`;
    string $new_selected[]=`ls -l $childs`;
    select  $new_selected;
    string $base_locks[]=JOPA_4_1_54d92f8424c4459e6d996d9fd93902f0();
    string $p_constrain[]=JOPA_4_1_4a0278149f801323f33f7bb9e4ee597d($base_locks,$new_selected);
    string $point_on_curve_info_node=`createNode pointOnCurveInfo`;
    connectAttr -f ($rebild_curve_shape[0] + ".worldSpace[0]") ($point_on_curve_info_node + ".inputCurve");
    float $distt=1.0/($num-2);
    $i=0;
    for($obj in $base_locks)
    {
        $param=$distt*$i;
        setAttr ($point_on_curve_info_node + ".parameter") $param;
        $new_pos=`getAttr  ($point_on_curve_info_node + ".position ")`;
        move -a $new_pos[0] $new_pos[1]  $new_pos[2] $obj ;
        $i++;
    }
    if ($parent[0]!=""&& $parent2[0]!="")
    {
         JOPA_4_1_4666e1e44291e7950c6d8b3906bbb9c7 ({$parent2[0]}, {$new_selected[size($new_selected)-1]},1);
	}
	$childs=`listConnections  -t node $createSetResult`;
	select -cl;
	select $childs;
	JOPA_4_1_18df331e107c49828a5c6e6e0b53d687();
	delete $p_constrain $base_locks $createSetResult;
	delete $curves $point_on_curve_info_node  $curve_name;
}
global proc string JOPA_4_1_f911544bbc1f8bd26197ce3206a3d51e(string $mod)
{
    $selection=`ls-fl-os`;
    if(size($selection)!=3)
    {
        warning "select 3 object!";
        return "";
    }
    $lock=`JOPA_4_1_54d92f8424c4459e6d996d9fd93902f0`;
    select -cl;
    string $join=`joint`;
    string  $p_constr[];
    string $aim_c[];
    float $point_jo[];
    $mod=capitalizeString($mod);
    if($mod=="T")
    {
        $p_constr=`pointConstraint $lock[0] $lock[1] $join`;
        $aim_c=`aimConstraint -offset 0 0 0 -weight 1 -aimVector 1 0 0 -upVector 0 1 0 -worldUpType "object" -worldUpObject $lock[0] $lock[2] $join`;
    }
	if($mod=="-T"|| $mod=="-t")
    {
        $p_constr=`pointConstraint $lock[0] $lock[1] $join`;
        $aim_c=`aimConstraint -offset 0 0 0 -weight 1 -aimVector 0 1 0 -upVector 1 0 0 -worldUpType "object" -worldUpObject  $lock[2] $lock[0] $join`;
    }
    if($mod=="L")
    {
        $p_constr=`pointConstraint $lock[2] $join`;
        $aim_c=`aimConstraint -offset 0 0 0 -weight 1 -aimVector 1 0 0 -upVector 0 1 0 -worldUpType "object" -worldUpObject $lock[1] $lock[0] $join`;
    }
	if($mod=="V")
    {
		$point_jo=JOPA_4_1_a5d8b0122c186b9a25fc1b6d3ff9b430($lock,1,0.5);
		move -a  $point_jo[0]  $point_jo[1]  $point_jo[2] $lock[2];
        $p_constr=`pointConstraint $lock[2] $join`;
        $aim_c=`aimConstraint -offset 0 0 0 -weight 1 -aimVector 1 0 0 -upVector 0 1 0 -worldUpType "object" -worldUpObject $lock[1] $lock[0] $join`;
    }
    delete $p_constr $aim_c;
    delete $lock;
    select  $join;
    JOPA_4_1_8c16c9163e07a819fc2186f2d338a280(1);
    return $join;
}
global proc string JOPA_4_1_52cb8fd96018b22c9d21d83beb0fbc31(int $degree)
{
	$selection=`ls-sl`;
	string $name_s;
	string $name[];
	vector $positions[]=JOPA_4_1_72356eaf232b169651a82383ba9e7e57($selection);
	float $tmp_float0[];
	float $tmp_float1[];
	float $tmp_float2[];
	$num=`size($selection)`;
	int $spans=($num-1)/2;
	int $rought=$num- $spans*2 -1;
	string $curves_dup[];
	clear  $curves_dup;
	$j=0;
	for($i=0;$i<size($selection)-2;$i+=2)
	{
	$tmp_float0=$positions[$i];
	$tmp_float1=$positions[$i+1];
	$tmp_float2=$positions[$i+2];
		int $ang=JOPA_4_1_4d4e630bb3f78b918b505c8ebfcbb814($tmp_float0, $tmp_float1, $tmp_float2, 0);
		if($ang>0&&$ang<178)
		{
			$curves_dup[$j]=JOPA_4_1_b059868e801453725e5c31a1938f0210($tmp_float0, $tmp_float1, $tmp_float2, 1, 8);
		}else
		{
			$curves_dup[$j]=JOPA_4_1_83a9015d514ecd1326a1648b28396ba2({$positions[$i], $positions[$i+1]},1);
			$i--;
			$rought++;
		}
		$j++;
	}
	int $jj= $rought/2;
	float $kk = $rought/2.0;
	if( $jj!=$kk )
	{
		$curves_dup[$j]=JOPA_4_1_83a9015d514ecd1326a1648b28396ba2({$positions[$i], $positions[$i+1]},1);
	}
	select $curves_dup;
	for($i=1;$i<size($curves_dup);$i++)
	{
		catchQuiet ($fin_curve=`attachCurve  -ch 1 -rpo 1 -kmk 1 -m 1 -bb 0.5 -bki 0 -p 0.1 $curves_dup[0] $curves_dup[$i]`);
		DeleteHistory;
		delete $curves_dup[$i];
	}
	$fin_curve=`ls-sl`;
	select $fin_curve;
	catchQuiet (`DeleteHistory`);
	catchQuiet ($name=`rebuildCurve -ch 1 -rpo 1 -rt 0 -end 1 -kr 0 -kcp 0 -kep 0 -kt 0 -s $num -d $degree -tol 0.01 $fin_curve`);
	$name_s=$name[0];
	select $name;
	return $name_s;
}
global proc JOPA_4_1_b9629ebf4695f6ad1940993b73361ead(int $coeff)
{
    $selected=`ls-sl`;
    $base_locks=JOPA_4_1_54d92f8424c4459e6d996d9fd93902f0();
    $p_constrain=JOPA_4_1_4a0278149f801323f33f7bb9e4ee597d($base_locks,$selected);
	$curve_name=JOPA_4_1_52cb8fd96018b22c9d21d83beb0fbc31(3);
    $num=size($selected);
    int $knots=$num -$num*($coeff/100.0) -1;
    $degree=2;
    if($knots<1)
    {
        $knots=1;
        $degree=1;
    }
    $curves=`rebuildCurve -ch 1 -rpo 0 -rt 0 -end 1 -kr 1 -kcp 0 -kep 0 -kt 0 -s $knots -d  $degree -tol 0.01 $curve_name`;
    $rebild_curve_shape=JOPA_4_1_5e702211108f11813c411c94f8b1b380($curves[0]);
    $point_on_curve_node=`createNode nearestPointOnCurve`;
    connectAttr -f ($rebild_curve_shape[0] + ".worldSpace[0]") ($point_on_curve_node + ".inputCurve");
    for($obj in $base_locks)
    {
        $pos=JOPA_4_1_8598296823aa3af15686cb0d78f1615d($obj);
        setAttr ($point_on_curve_node + ".inPositionX") $pos[0];
        setAttr ($point_on_curve_node + ".inPositionY") $pos[1];
        setAttr ($point_on_curve_node + ".inPositionZ") $pos[2];
        $new_pos=`getAttr  ($point_on_curve_node + ".position ")`;
        move -a $new_pos[0] $new_pos[1]  $new_pos[2] $obj ;
    }
	select $selected;
	JOPA_4_1_18df331e107c49828a5c6e6e0b53d687();
    delete $p_constrain $base_locks $curves $curve_name;
}
global proc JOPA_4_1_a8aee5f7819058e898a22052bd3773a1()
{
    $selected=`ls-sl`;
    $base_locks=JOPA_4_1_54d92f8424c4459e6d996d9fd93902f0();
    $p_constrain=JOPA_4_1_4a0278149f801323f33f7bb9e4ee597d($base_locks,$selected);
	$curve_name=JOPA_4_1_52cb8fd96018b22c9d21d83beb0fbc31(3);
    $num=size($selected);
	select $curve_name;
    $curves=`rebuildCurve -ch 1 -rpo 0 -rt 0 -end 1 -kr 0 -kcp 0 -kep 0 -kt 0 -s ($num*2) -d  3 -tol 0.01 $curve_name`;
    $rebild_curve_shape=JOPA_4_1_5e702211108f11813c411c94f8b1b380($curves[0]);
    $point_on_curve_info_node=`createNode pointOnCurveInfo`;
    connectAttr -f ($rebild_curve_shape[0] + ".worldSpace[0]") ($point_on_curve_info_node + ".inputCurve");
    float $distt=1.0/($num-1);
    $i=0;
    for($obj in $base_locks)
    {
        $param=$distt*$i;
        setAttr ($point_on_curve_info_node + ".parameter") $param;
        $new_pos=`getAttr  ($point_on_curve_info_node + ".position ")`;
        move -a $new_pos[0] $new_pos[1]  $new_pos[2] $obj ;
        $i++;
    }
    select $selected;
	JOPA_4_1_18df331e107c49828a5c6e6e0b53d687();
	delete $p_constrain $base_locks;
	delete $curves $point_on_curve_info_node  $curve_name;
}
global proc JOPA_4_1_0cb8b5d4e384a1ba8b59ac35529bc7eb(float $coeff)
{
	$coeff=$coeff/2;
	$selected=`ls-sl`;
	$base_locks=JOPA_4_1_54d92f8424c4459e6d996d9fd93902f0();
	$p_constrain=JOPA_4_1_4a0278149f801323f33f7bb9e4ee597d($base_locks,$selected);
	$curve_name=JOPA_4_1_52cb8fd96018b22c9d21d83beb0fbc31(3);
	$num=size($selected);
	$curves=`rebuildCurve -ch 1 -rpo 0 -rt 0 -end 1 -kr 0 -kcp 0 -kep 0 -kt 0 -s ($num*2) -d  3 -tol 0.01 $curve_name`;
	$rebild_curve_shape=JOPA_4_1_5e702211108f11813c411c94f8b1b380($curves[0]);
	$point_on_curve_node=`createNode nearestPointOnCurve`;
	connectAttr -f ($rebild_curve_shape[0] + ".worldSpace[0]") ($point_on_curve_node + ".inputCurve");
	float $start_param[];
	float $new_param[];
	for($i=1;$i<$num;$i++)
	{
		$pos=JOPA_4_1_8598296823aa3af15686cb0d78f1615d($base_locks[$i]);
		setAttr ($point_on_curve_node + ".inPositionX") $pos[0];
		setAttr ($point_on_curve_node + ".inPositionY") $pos[1];
		setAttr ($point_on_curve_node + ".inPositionZ") $pos[2];
		$start_param[$i]=`getAttr  ($point_on_curve_node + ".parameter ")`;
		$p=$start_param[$i];
		$new_param[$i]=(((1-$p)*$p)/(1-$coeff))*$coeff + $p;
	}
	$point_on_curve_info_node=`createNode pointOnCurveInfo`;
	connectAttr -f ($rebild_curve_shape[0] + ".worldSpace[0]") ($point_on_curve_info_node + ".inputCurve");
	float $distt=1.0/($num-1);
	$i=0;
	for($obj in $base_locks)
	{
		setAttr ($point_on_curve_info_node + ".parameter") $new_param[$i];
		$new_pos=`getAttr  ($point_on_curve_info_node + ".position ")`;
		move -a $new_pos[0] $new_pos[1]  $new_pos[2] $obj ;
		$i++;
	}
	select $selected;
	JOPA_4_1_18df331e107c49828a5c6e6e0b53d687();
	delete $p_constrain $base_locks;
	delete $curves $point_on_curve_info_node  $curve_name;
}
global proc JOPA_4_1_266cf15f213f144bd5577f55c93329d0(int $pos)
{
    string $neighbors[];
    float $position[];
    $neighbors=JOPA_4_1_6c03bcf1c4cd077aea727f60dfb001f6(0,"*PGB_plane_joints_positioning*");
    if(size($neighbors)==0)
    {
        warning "Selected object not manual plain correction system";
        return;
    }
    if ($pos==0)
        $position=`xform -q  -os  -t $neighbors[0]`;
    if ($pos==2)
        $position=`xform -q  -os  -t $neighbors[1]`;
    if ($pos==1)
        $position={0,0,0};
    move -a -ls $position[0] $position[1] $position[2] ($neighbors[2] + ".scalePivot") ($neighbors[2] + ".rotatePivot") ;
}
global proc float JOPA_4_1_2db96bd9c47870bc6534b47731f587ae(string $joints[],float $div)
{
    float $fin_scale=0;
    if(size($joints)<=1)
    {
        warning "select few joints";
        return $fin_scale;
    }
    float $len=JOPA_4_1_a358a7c27f7a7b80712d695138ed032e(`ls-sl`,1);
    $fin_scale=$len/$div;
    JOPA_4_1_1b2691cd3c4740f4f00465c7e94c0373(`ls-sl`, $fin_scale);
    return $fin_scale;
}
global proc JOPA_4_1_d6b9c21beb7156b6229e41d3d9f7ef3c()
{
	string $selected[]=`ls-sl`;
	JOPA_4_1_8c16c9163e07a819fc2186f2d338a280(0);
	string $locators[]=JOPA_4_1_54d92f8424c4459e6d996d9fd93902f0();
	JOPA_4_1_6de8028af587b467034457b4d6349f89(0.5);
	int $num=size($selected)-1;
	JOPA_4_1_cc20e95399a3b6da44eb78e45451d764(13);
	JOPA_4_1_34cdd1e4469c2d3c695448db824d2ecb(1);
	JOPA_4_1_e9a3d5ffe283044f2485219b12ac5f73( $locators, 1);
	vector $avge=JOPA_4_1_e3bea614176fbceebe7c7aae67e953b0(JOPA_4_1_72356eaf232b169651a82383ba9e7e57({$selected[0],$selected[$num]}));
	string $plane[]=`polyPlane -w 1 -h 1 -sx 1 -sy 1 -ax 0 1 0 -cuv 2 -ch 1`;
	string $plane2[]=`polyPlane -w 1 -h 1 -sx 1 -sy 1 -ax 0 1 0 -cuv 2 -ch 1`;
	rotate  0 0 180 $plane2;
	$plane=`polyUnite -ch 1 -mergeUVSets 1 -name $plane[0] $plane[0] $plane2[0]`;
	delete -ch $plane;
	string $plane_sh[]=JOPA_4_1_5e702211108f11813c411c94f8b1b380($plane[0]);
	setAttr ($plane[0] + ".doubleSided") 0;
	setAttr ($plane[0] + ".displayBorders") 1;
	setAttr ($plane[0] + ".borderWidth") 3;
	JOPA_4_1_cc20e95399a3b6da44eb78e45451d764(13);
	polyColorPerVertex -r 0 -g 1 -b 0 -cdo $plane[0];
	polyColorPerVertex -a 0.2 -cdo $plane[0];
	move ($avge.x) ($avge.y) ($avge.z) $plane[0];
	string $max_h_j= JOPA_4_1_f9ccf45626df05475e8ab66b6f511dd6($selected);
	float $max_h_j_pos[]=JOPA_4_1_8598296823aa3af15686cb0d78f1615d($max_h_j);
	$tp_lock=`spaceLocator`;
	string $longest_height_obj=$tp_lock[0];
	move $max_h_j_pos[0] $max_h_j_pos[1] $max_h_j_pos[2] $longest_height_obj;
	delete(`aimConstraint -offset 0 0 0 -weight 1 -aimVector 1 0 0 -upVector 0 0 1 -worldUpType "object" -worldUpObject $longest_height_obj $selected[$num] $plane[0]`);
	$dist= JOPA_4_1_c7822f1f10b007a6803735c105e40799($selected[0],$selected[$num]);
	scale -a  ($dist*1.2) 1 0 $plane[0];
	makeIdentity -apply true -t 0 -r 0 -s 1 -n 0 -pn 1 $plane[0];
	parent $locators $plane[0];
	move -ls -y 0 0 0 $locators;
	rotate  0 0 0 $locators;
	JOPA_4_1_4a0278149f801323f33f7bb9e4ee597d($locators,$selected);
	select $locators;
	delete $longest_height_obj;
	vector $local_pos[]=JOPA_4_1_329067de90245bf18aa04dd0b6c95e8b($locators);
	vector $pos;
	float $z_pos[];
	for($i=0;$i<=$num;$i++)
	{
	    $pos=$local_pos[$i];
	    $z_pos[$i]=$pos.z;
	}
	$z_pos=sort($z_pos);
	float $otstup=($z_pos[$num]-$z_pos[0])/5;
    move -r -os -wd 0 0 ($z_pos[$num]+$otstup)($plane_sh[0] + ".vtx[0:1]") ($plane_sh[0] + ".vtx[4:5]") ;
    move -r -os -wd 0 0 ($z_pos[0]-$otstup) ($plane_sh[0] + ".vtx[2:3]") ($plane_sh[0] + ".vtx[6:7]") ;
	JOPA_4_1_38212629cf9ce2087192134a449b78d6(0, 1,0,1, 1,1,1, 1,1, 1);
	JOPA_4_1_94c81da260931e06d6e51c78e142796f({$locators[0],$locators[$num],$plane[0]}, "PGB_plane_joints_positioning");
	select $plane[0];
}
global proc JOPA_4_1_3ee4702003ee8d11faa99588f53763ed()
{
	$selected=`ls-sl`;
	select -cl;
	select $selected;
	$locks=JOPA_4_1_54d92f8424c4459e6d996d9fd93902f0();
	$point_constrs=JOPA_4_1_4a0278149f801323f33f7bb9e4ee597d($locks,$selected);
    $base_lock=`duplicate $locks[0]`;
	vector $coords[]=JOPA_4_1_72356eaf232b169651a82383ba9e7e57($locks);
	int $ind=JOPA_4_1_b370e1f695c58fe83552587a1fd52907($coords);
    float $tmpp[];
	$aim_name=`aimConstraint -offset 0 0 0 -weight 1 -aimVector 1 0 0 -upVector 0 1 0 -worldUpType "object" -worldUpObject $locks[$ind] $locks[size($locks)-1] $base_lock`;
	delete $aim_name;
	select $locks;
	$w_new_coords=JOPA_4_1_72d9b297f109729673f6fe9d719defbd($base_lock[0],"z");
	for($i=1;$i<size($locks)-1;$i++)
	{
		if($i!=$ind)
		{
			$tmpp=$w_new_coords[$i];
			move $tmpp[0] $tmpp[1] $tmpp[2] $locks[$i];
		}
	}
	select $selected;
	JOPA_4_1_18df331e107c49828a5c6e6e0b53d687();
	delete $point_constrs;
	delete $locks $base_lock;
}
global proc JOPA_4_1_ee610d2367958b592a8726aa94ff0ff1(string $w_axis, int $abs_mode)
{
	$selected=`ls-sl`;
	$locks=JOPA_4_1_54d92f8424c4459e6d996d9fd93902f0();
	$point_constrs=JOPA_4_1_4a0278149f801323f33f7bb9e4ee597d($locks,$selected);
	$base_lock= $locks[0];
	rotate -a 0 0 0 $base_lock;
	if($abs_mode)
	{
	    if ($w_axis=="x")
            move -a -x 0 0 0 $base_lock;
 	    if ($w_axis=="y")
            move -a -y 0 0 0 $base_lock;
	    if ($w_axis=="z")
            move -a -z 0 0 0 $base_lock;
    }
	vector $coords[]=JOPA_4_1_72356eaf232b169651a82383ba9e7e57($locks);
	float $tmpp[];
	select $locks;
	vector $w_new_coords[];
	$w_new_coords=JOPA_4_1_72d9b297f109729673f6fe9d719defbd($base_lock,$w_axis);
	for($i=1;$i<size($locks);$i++)
	{
		$tmpp=$w_new_coords[$i];
		move $tmpp[0] $tmpp[1] $tmpp[2] $locks[$i];
	}
	select $selected;
	JOPA_4_1_18df331e107c49828a5c6e6e0b53d687();
	delete $point_constrs;
	delete $locks $base_lock;
}
global proc JOPA_4_1_911ce829ffadd631db0afd6c10b8a9c1()
{
    string $obj;
    for($obj in `ls-sl`)
    {
        select $obj;
        performMirrorJoint 0;
    }
}
global proc JOPA_4_1_7c23beeb22741f0c0bad91ebefb06e18()
{
	$currentPanel = `getPanel -withFocus`;
	$panelType = `getPanel -to $currentPanel`;
	if ($panelType == "modelPanel")
	{
	  modelEditor -e -locators 1 $currentPanel;
	}
	JOPA_4_1_13f03d6a42bbd197e6eb294d298faacd();
	float $dist=50;
	$sel=`ls-head 1 -sl`;
	catchQuiet($dist=JOPA_4_1_c7822f1f10b007a6803735c105e40799($sel[0], JOPA_4_1_20a28b95c1b8b4dd29397ab332dbc667()));
	catchQuiet(JOPA_4_1_29941243f77aa0343e79460d48136072 ($dist/25));
	JOPA_4_1_cc20e95399a3b6da44eb78e45451d764(22);
}
global proc JOPA_4_1_39488f9fb9b49f3b387fe78ea9cda2f0()
{
	$selected=`ls-sl`;
	$num=size($selected);
	$len_proportion=JOPA_4_1_3f2307b9993ee7d97577d190465f37c9($selected,1);
	$node_name_pm=`createNode plusMinusAverage`;
	setAttr ($node_name_pm + ".operation") 2;
	connectAttr -f ($selected[0] + ".rx") ($node_name_pm + ".input3D[1].input3Dx");
	connectAttr -f ($selected[0] + ".ry") ($node_name_pm + ".input3D[1].input3Dy");
	connectAttr -f ($selected[0] + ".rz") ($node_name_pm + ".input3D[1].input3Dz");
	connectAttr -f ($selected[$num-1] + ".rx") ($node_name_pm + ".input3D[0].input3Dx");
	connectAttr -f ($selected[$num-1] + ".ry") ($node_name_pm + ".input3D[0].input3Dy");
	connectAttr -f ($selected[$num-1] + ".rz") ($node_name_pm + ".input3D[0].input3Dz");
	for($i=1;$i<$num-1;$i++)
	{
		$M_D_node_name=`createNode multiplyDivide`;
		connectAttr -f ($node_name_pm + ".output3Dx") ($M_D_node_name + ".input1X");
		connectAttr -f ($node_name_pm + ".output3Dy") ($M_D_node_name + ".input1Y");
		connectAttr -f ($node_name_pm + ".output3Dz") ($M_D_node_name + ".input1Z");
		setAttr($M_D_node_name + ".input2X") $len_proportion[$i];
		setAttr($M_D_node_name + ".input2Y") $len_proportion[$i];
		setAttr($M_D_node_name + ".input2Z") $len_proportion[$i];
		$node_name_pm2=`createNode plusMinusAverage`;
		setAttr ($node_name_pm2 + ".operation") 1;
		connectAttr -f ($selected[0] + ".rx") ($node_name_pm2 + ".input3D[1].input3Dx");
		connectAttr -f ($selected[0] + ".ry") ($node_name_pm2 + ".input3D[1].input3Dy");
		connectAttr -f ($selected[0] + ".rz") ($node_name_pm2 + ".input3D[1].input3Dz");
		connectAttr -f ($M_D_node_name + ".outputX") ($node_name_pm2 + ".input3D[0].input3Dx");
		connectAttr -f ($M_D_node_name + ".outputY") ($node_name_pm2 + ".input3D[0].input3Dy");
		connectAttr -f ($M_D_node_name + ".outputZ") ($node_name_pm2 + ".input3D[0].input3Dz");
		connectAttr -f ($node_name_pm2 + ".output3Dx") ($selected[$i] + ".rotateX");
		connectAttr -f ($node_name_pm2 + ".output3Dy") ($selected[$i] + ".rotateY");
		connectAttr -f ($node_name_pm2 + ".output3Dz") ($selected[$i] + ".rotateZ");
	}
	select $selected[$num-1];
}
global proc JOPA_4_1_a724b4b2abdd9e942758573c2c47afe6(int $limit)
{
    if(size(`ls-fl-sl`)<$limit)
        JOPA_4_1_f2d5a2798ed7cfee36eb77ee8a281ed8;
    else
        warning "selected more than 100 object - canselled" ;
}
global proc JOPA_4_1_52c981703a2cf84e5e60002e83f3fa52(float $rx, float $ry, float $rz)
{
    $selection=`ls-sl`;
    string $lock[]=JOPA_4_1_13f03d6a42bbd197e6eb294d298faacd();
    rotate -r -os -fo $rx $ry $rz  $lock;
    pickWalk -d up;
    pickWalk -d up;
    select -hi;
    DeleteConstraints;
    delete;
    select $selection;
}
global proc string[] JOPA_4_1_d3cdf2488e5fc40a8060f5da3e93637a()
{
    $selected=`ls-sl`;
    float $rad;
    $joints=JOPA_4_1_f2d5a2798ed7cfee36eb77ee8a281ed8();
    $joints=JOPA_4_1_a2b81a3977941c0eac1cda769570172c();
    for($i=0;$i<size($selected);$i++)
    {
        $rad=1;
        catchQuiet($rad=`getAttr ($selected[$i] + ".radius")`);
        $rad=$rad+$rad*0.1;
        setAttr ($joints[$i] + ".radius")$rad;
    }
    JOPA_4_1_4666e1e44291e7950c6d8b3906bbb9c7($selected,$joints,1);
    catchQuiet(`JOPA_4_1_3a25eaad774c71ebdcb06ee4d2b25ce3`);
    JOPA_4_1_9a3ce25cfdbc96f0053e2e03715d7f2b;
	select -cl;
	select 	$joints;
    return $joints;
}
global proc JOPA_4_1_773705e2fd3f8e12d1cd931401dc396e(string $axis)
{
	$selection=`ls-l-sl`;
	string $constr[];
	string $locks[];
	for($obj in $selection)
	{
        select -cl;
        select $obj;
    	$children=JOPA_4_1_2edf2909df70a7e657b4b646868a0b9c();
    	if (size($children)>0)
    	{
        	select $children;
        	$locks=JOPA_4_1_54d92f8424c4459e6d996d9fd93902f0();
        	$constr=JOPA_4_1_17431451b1be026fdeee93b86579c6b6($locks, $children);
        }
    	select $obj;
    	JOPA_4_1_ee505820b9f32e5106abbdfa4f840186($axis);
        if (size($children)>0)
        {
            delete  $constr;
            delete $locks ;
        }
	}
	select $selection;
}
global proc string[] JOPA_4_1_13f03d6a42bbd197e6eb294d298faacd()
{
    JOPA_4_1_8c16c9163e07a819fc2186f2d338a280(1);
    $selection=`ls-l-sl`;
    $children=JOPA_4_1_2edf2909df70a7e657b4b646868a0b9c();
	if(size( $children)>0)
        select  $children;
    else
        select $selection;
    $grpp=JOPA_4_1_cf7d60c10a2e981ece1b4edc00bb807f(0);
    $child_lock=`ls-sl`;
    string $par_grpp[];
    $parents=stringArrayRemove($children, $selection);
    if(size( $parents)>0 && size( $children)>0)
    {
        select ($parents);
        $par_grpp=JOPA_4_1_cf7d60c10a2e981ece1b4edc00bb807f(0);
    }
    if(size( $selection)!=size(`ls-sl`))
    {
        select -add $child_lock;
    }
    string $sel_lock[]=`ls-sl`;
    catchQuiet (`select  $grpp $par_grpp`);
    catchQuiet (`group`);
    select $sel_lock;
	manipRotateContext -e -ah 3 -mode 0  Rotate;
	setToolTo RotateSuperContext;
	return $sel_lock;
}
global proc JOPA_4_1_ad3e5fee1a27e33794ab15e8350f4b53(int $add)
{
    string $selected_curve[]=`filterExpand -sm 9`;
    string $selected_joints[]=`ls-sl -type "joint"`;
    string $c_shps[]=JOPA_4_1_5e702211108f11813c411c94f8b1b380($selected_curve[0]);
    float $c_par_min=`getAttr ($c_shps[0] + ".mmv.min")`;
    float $c_par_max=`getAttr ($c_shps[0] + ".mmv.max")`;
    int $curr_j_num=`size $selected_joints`;
    float $distrib_range;
    float $j_rad=1;
    string $new_jnt;
    float $pos[];
    if(!$curr_j_num && ! $add)
        return;
    if(!$curr_j_num)
        select -cl;
    else
    {
        select $selected_joints[$curr_j_num-1];
        $j_rad=`getAttr ".radius"`;
    }
    if($add)
    {
        $new_jnt=`joint -rad $j_rad `;
        appendStringArray($selected_joints,{$new_jnt},1);
        $curr_j_num=$curr_j_num+1;
    }
    else
    {
        delete $selected_joints[$curr_j_num-1];
        stringArrayRemoveAtIndex($curr_j_num-1, $selected_joints);
        $curr_j_num=$curr_j_num-1;
    }
    if(!$curr_j_num)
        $distrib_range=0;
    else
    {
        if( $curr_j_num >1)
            $distrib_range=($c_par_max-$c_par_min)/($curr_j_num-1);
    }
    for($i=0; $i<$curr_j_num; $i++)
    {
        $pos=`pointOnCurve -pr ($c_par_min + $i*$distrib_range) $selected_curve[0]`;
        move -a $pos[0] $pos[1] $pos[2] $selected_joints[$i];
    }
    select -cl;
    select  $selected_joints $selected_curve[0] ;
}
global proc float[] JOPA_4_1_972cbf131f510c941b6fca958a7d0c69()
{
    string $selected[]=`ls-fl-sl`;
    string $selected_curve[]=`filterExpand -sm 9`;
    string $objects[]=`ls -fl -sl -type "joint"`;
    float $params[]=JOPA_4_1_e849743d83b9357359884fec322c28ec($selected_curve[0], $objects);
    select $selected;
    return $params;
}
global proc JOPA_4_1_e79dd31d96c9498499196fdfdddd4698()
{
    if(`window -q -ex "per_ch_connection"`)deleteUI("per_ch_connection");
    window
        -minimizeButton true -maximizeButton true -titleBar true
        -bgc 0.2 0.555 0.580
        -t "mirror connection selection" -sizeable true -toolbox true -menuBar true "per_ch_connection";
    columnLayout "columnLayout4";
    rowLayout -numberOfColumns 4;
    text -label "from";
    textField
        -bgc 1  1.0 0.79
        -text "_L" -w 70 tx_get_from;
    text -label "to>>";
    textField
        -bgc 1  1.0 0.79
        -text "_R" -w 70 tx_set_to;
    rowLayout -parent "columnLayout4" -numberOfColumns 5;
    checkBox -v 0 -l "X" r_x_set;
    checkBox -v 0 -l "Y" r_y_set;
    checkBox -v 0 -l "Z" r_z_set;
    text -l "- inverse by channel ";
    button
        -w 90
        -c "JOPA_4_1_33737a5f897286cfa410615445094c2a(`textField -q -tx tx_get_from`,`textField -q -tx tx_set_to`, \"rotate\", `checkBox -q -v r_x_set`,`checkBox -q -v r_y_set`,`checkBox -q -v r_z_set`)"
        -bgc 0.995  1.0 0.79
        -l "rotation";
    rowLayout -parent "columnLayout4" -numberOfColumns 5;
    checkBox -v 1 -l "X" tr_x_set;
    checkBox -v 1 -l "Y" tr_y_set;
    checkBox -v 1 -l "Z" tr_z_set;
    text -l "- inverse by channel ";
    button
        -w 90
        -c "JOPA_4_1_33737a5f897286cfa410615445094c2a(`textField -q -tx tx_get_from`,`textField -q -tx tx_set_to`, \"translate\",`checkBox -q -v tr_x_set`,`checkBox -q -v tr_y_set`,`checkBox -q -v tr_z_set`)"
        -bgc 0.995  1.0 0.79
        -l "translation";
    showWindow "per_ch_connection";
}
global proc string[] JOPA_4_1_a0656c7a9e8e5e98ead5c90575dbfb28()
{
    string $createSetResult;
    string $selected[]=`ls -sl`;
    string $selected_long[]=`ls-l-sl`;
    if(size($selected)==0)
    {
        warning "select something";
        return {};
    }
    string $sets[]={};
    string $side_from = `optionVar -query mirrorJointSearch`;
	string $side_to = `optionVar -query mirrorJointReplace`;
    string $parents[]=JOPA_4_1_e34225338b41391d68d09634ca599397(1);
    string $mirror_parent[]=JOPA_4_1_ce7b9a074764f1b06f64dfc666cf4813($parents,  $side_from, $side_to);
	print "\n\nfind mirrored parents:\n";
	print $mirror_parent;
    if(size($mirror_parent)!=size($selected) )
    {
        warning "one ore more joint parent not have mirrored pair. Check Replacement names for duplicated joints";
        return $mirror_parent;
    }
    for($obj in $selected)
    {
        select $obj;
        $createSetResult=`sets -name "set1"`;
        appendStringArray($sets,  {$createSetResult},1);
    }
    string $root=JOPA_4_1_933d4aecbe9d9d0ce9a6591c5b2e3770($selected[0]);
    select $root;
    string $dupli_root[]=`duplicate $root`;
    JOPA_4_1_90a059e9200ad500213586e0ecabdd0d($dupli_root,0,0,0,0);
    select $dupli_root[0];
    string $cmd=JOPA_4_1_0bb35ddf616d7cd6bdc38d3dd23af1bf();
    eval($cmd);
    string $new_root[]=`ls-sl`;
    delete $dupli_root[0];
    string $mirrored[]={};
    for($i=0;$i<size($selected_long);$i++)
    {
        sets -e -rm $sets[$i] $selected_long[$i];
        appendStringArray( $mirrored,`sets -q $sets[$i]`,1);
    }
    select $mirrored;
    JOPA_4_1_90a059e9200ad500213586e0ecabdd0d($mirrored,1,1,1,1);
    JOPA_4_1_bd56535e7e051ab809c6591e7c585696($mirrored,1);
    $mirrored=JOPA_4_1_a2b81a3977941c0eac1cda769570172c();
    string $group[]=JOPA_4_1_e34225338b41391d68d09634ca599397(1);
    string $transform_grpp[]=stringArrayRemove($mirrored,$group);
    delete $new_root;
    JOPA_4_1_4666e1e44291e7950c6d8b3906bbb9c7 ($mirror_parent,$mirrored,0);
    $mirrored=`sets -q $sets`;
    JOPA_4_1_90a059e9200ad500213586e0ecabdd0d($mirrored,0,0,0,0);
    JOPA_4_1_bd56535e7e051ab809c6591e7c585696($mirrored,0);
    delete $sets;
    if(size($transform_grpp)>0)
        delete $transform_grpp;
    return $mirrored;
}
global proc JOPA_4_1_9e849622a64e61725d0526208e8aee88()
{
    if(`window -q -ex "JOPA_4_1_9e849622a64e61725d0526208e8aee88"`)deleteUI("JOPA_4_1_9e849622a64e61725d0526208e8aee88");
