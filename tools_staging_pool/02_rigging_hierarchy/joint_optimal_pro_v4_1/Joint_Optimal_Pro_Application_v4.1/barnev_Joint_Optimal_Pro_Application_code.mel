				-c "repeatLast -ac \"JOPA_4_1_91de40fecac3ba14bdc612af67e8ee8e(0.5) \" -acl \" scale size 0.5 \"; JOPA_4_1_91de40fecac3ba14bdc612af67e8ee8e(0.5)"
				-annotation "scale size selected joints by 0.5"  -l "--";
				button -w ($btnn_w/3) -h $small_button_h
				-c "repeatLast -ac \"JOPA_4_1_91de40fecac3ba14bdc612af67e8ee8e(0.9) \" -acl \" scale size 0.9 \"; JOPA_4_1_91de40fecac3ba14bdc612af67e8ee8e(0.9)"
				-annotation "scale size selected joints by 0.9"  -l "-";
				button -w ($btnn_w/3) -h $small_button_h
				-c "repeatLast -ac \"JOPA_4_1_91de40fecac3ba14bdc612af67e8ee8e(1.1) \" -acl \" scale size 1.1 \"; JOPA_4_1_91de40fecac3ba14bdc612af67e8ee8e(1.1)"
				-annotation "scale size selected joints by 1.1"  -l "+";
				button -w ($btnn_w/3) -h $small_button_h
				-c "repeatLast -ac \"JOPA_4_1_91de40fecac3ba14bdc612af67e8ee8e(1.5) \" -acl \" scale size 1.5 \"; JOPA_4_1_91de40fecac3ba14bdc612af67e8ee8e(1.5)"
				-annotation "scale size selected joints by 1.5"  -l "++";
				 text " - change joint size";
				button -w ($btnn_w/3) -h $small_button_h
						-c "repeatLast -ac \"JOPA_4_1_2db96bd9c47870bc6534b47731f587ae(`ls-sl`,6) \" -acl \" set size by lenght \"; JOPA_4_1_2db96bd9c47870bc6534b47731f587ae(`ls-sl`,6)"
						-annotation "set size selected joints by average lenght"  -l "len";
				 button -w ($btnn_w/3) -h $small_button_h
							-c "repeatLast -ac \"JOPA_4_1_15760bd5ac6225f582185bab24346a67(0.5) \" -acl \" set size by camera dist \"; JOPA_4_1_15760bd5ac6225f582185bab24346a67(0.5)"
							-annotation "set size selected joints by distance to viewport camera"  -l "cam";
 $fral=`frameLayout
            -bgc 0.6 0.42 0.6
            -mh 0
            -mw 1
			-ann $jopa_version
            -cc " window -e -h 500 create_skeleton_tools"
            -p "skeleton_scripts" -cl 0 -cll true -l "ORIENTING"`;
	columnLayout -adj 1 -p $fral "orienting";
	rowLayout -p "orienting"  -numberOfColumns 13 ;
    	text "<";
        	radioCollection;
           global string $barnev_skeleton_menue_axis="x";
           radioButton -sl -label "x" -cc "$barnev_skeleton_menue_axis=\"x\"";
           radioButton -label "y" -cc "$barnev_skeleton_menue_axis=\"y\"";
           radioButton -label "z" -cc "$barnev_skeleton_menue_axis=\"z\"";
           radioButton -label "-x" -cc "$barnev_skeleton_menue_axis=\"-x\"";
           radioButton -label "-y" -cc "$barnev_skeleton_menue_axis=\"-y\"";
           radioButton -label "-z" -cc "$barnev_skeleton_menue_axis=\"-z\"";
     	text ">";
    	text " - set axis ";
         rowLayout -p "orienting"  -numberOfColumns 4 ;
            button  -w ($btnn_w )-h $mid_button_h  -command "repeatLast -ac \" JOPA_4_1_d1f6eb5ab8caa780647f498704025cf1(); JOPA_4_1_a9acebc46d5277d92e6d954501ac53c7( $barnev_skeleton_menue_axis , $SAO_napr, $minus_up); JOPA_4_1_95d47209f5832c068ce7614b82201089;	\" -acl \" orient joint null rotate\";JOPA_4_1_d1f6eb5ab8caa780647f498704025cf1(); JOPA_4_1_a9acebc46d5277d92e6d954501ac53c7( $barnev_skeleton_menue_axis , $SAO_napr, $minus_up); JOPA_4_1_95d47209f5832c068ce7614b82201089;	" -annotation "improved version of the standard system. Well oriented along the axes"  "true orient";
            text " - orient joint";
			global string $minus_up="";
			global string $minus_MM="";
			checkBox -v false -l " - inverse up" -onCommand "$minus_MM=\"-\";$minus_up=\"change\"" -offCommand "$minus_MM=\"\";$minus_up=\"\"" inv_up;
			global string $SAO_napr="up";
			checkBox -v false -l " - change up"  -onCommand "$SAO_napr=\"down\"" -offCommand "$SAO_napr=\"up\""ch_up;
     	rowLayout -p "orienting" -numberOfColumns 2 "child_bttn";
        	button -w ($btnn_w*1.5)  -h $mid_button_h -p "child_bttn" -command "repeatLast -ac \" JOPA_4_1_773705e2fd3f8e12d1cd931401dc396e($minus_MM + $barnev_skeleton_menue_axis)\" -acl \" orient joint on parent\"; JOPA_4_1_773705e2fd3f8e12d1cd931401dc396e($minus_MM + $barnev_skeleton_menue_axis);" -annotation "orient the bone by the selected axis from the parent"  "orient joint from parent";
        	button -w ($btnn_w*1.5)  -h $mid_button_h -p "child_bttn" -command "repeatLast -ac \" JOPA_4_1_18250f0751da33452100ea861e8e386a($minus_MM + $barnev_skeleton_menue_axis)\" -acl \" orient joint on parent\"; JOPA_4_1_18250f0751da33452100ea861e8e386a($minus_MM +  $barnev_skeleton_menue_axis);" -annotation "orient the bone chosen for the child"  "orient joint on child";
 $fral=`frameLayout
