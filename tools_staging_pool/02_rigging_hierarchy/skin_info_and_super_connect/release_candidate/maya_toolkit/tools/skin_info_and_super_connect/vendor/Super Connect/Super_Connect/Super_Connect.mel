if (`window -exists Super_Connect`)
{
   deleteUI Super_Connect;
}
//windowPref -ra;

window -rtf off -t "Super Connect v1.00" -s on -wh 300 100 -minimizeButton false -maximizeButton false Super_Connect;
columnLayout -adj on -rowSpacing 1 -w 550  -columnAttach "both" 7;

rowLayout -numberOfColumns 3
    //-columnWidth3 80 75 150
    -adjustableColumn 2
    -columnAlign  1 "right"
    -columnAttach 1 "both" 0
    -columnAttach 2 "both" 0
    -columnAttach 3 "both" 0;
    columnLayout -adj off -rowSpacing 1;
		text -al "left" -l "" -h 5;
		text -al "left" -l "Source objects." -font "boldLabelFont";
		text -al "left" -l "" -h 5;
		button -l "Add Selection" -w 120 -h 20  -c "Store_02";
		text -al "left" -l "" -h 2;
		textScrollList -highlightColor 0.40 0.6 0.1 -h 80 ChangeControlsTSL_02;
		text -al "left" -l "" -h 2;
		textFieldGrp 
			-columnAlign 1 left 
			-columnAlign 2 right 
			-columnWidth 1 90 
			-columnWidth 2 158 
			-l "Source prefix:" 
			-highlightColor 0.40 0.6 0.1 
			-tx "" 
			SourceTXF;
		setParent ..;
    
	separator -horizontal off -style "shelf" -h 150;

    columnLayout -adj off -rowSpacing 1;
		text -al "left" -l "" -h 5;
		text -al "left" -l "Destination objects." -font "boldLabelFont";
		text -al "left" -l "" -h 5;
		button -l "Add Selection" -w 120 -h 20  -c "Store_01";
		text -al "left" -l "" -h 2;
		textScrollList -highlightColor 0.40 0.6 0.1 -h 80 ChangeControlsTSL_01;
		text -al "left" -l "" -h 2;
		textFieldGrp 
			-columnAlign 1 left 
			-columnAlign 2 right 
			-columnWidth 1 110 
			-columnWidth 2 138 
			-l "Destination prefix:" 
			-highlightColor 0.40 0.6 0.1 
			-tx "" 
			DestinationTXF;
		setParent ..;

setParent ..;





separator  -st "in" ;
text -al "left" -l "" -h 2;


rowLayout -numberOfColumns 3
    -columnWidth3 200 200 150
    -adjustableColumn 2
    -columnAlign  1 "left"
    -columnAlign  3 "right"
    -columnAttach 1 "both" 0
    -columnAttach 2 "both" 0
    -columnAttach 3 "both" 0;
	radioCollection;
    radioButton 
        -label "Direct Connect" 
        -sl 
        -offCommand "checkBoxGrp -e -editable off Direct_T_CHB; checkBoxGrp -e -editable off Direct_R_CHB; checkBoxGrp -e -editable off Direct_S_CHB;"
        -onCommand "checkBoxGrp -e -editable on Direct_T_CHB; checkBoxGrp -e -editable on Direct_R_CHB; checkBoxGrp -e -editable on Direct_S_CHB;"
        RB1;
    radioButton 
        -label "Parent Constraint"  
        -offCommand "checkBoxGrp -e -editable off Parent_constraints_CHB;"
        -onCommand "checkBoxGrp -e -editable on Parent_constraints_CHB;"
        RB2;
	radioButton 
        -label "Point / Orient Constraint"  
        -offCommand "checkBoxGrp -e -editable off Point_Orient_constraints_CHB;"
        -onCommand "checkBoxGrp -e -editable on Point_Orient_constraints_CHB;"
        RB3;
    setParent ..;

rowLayout -numberOfColumns 3
    -columnWidth3 200 200 150
    -adjustableColumn 2
    -columnAlign  1 "left"
    -columnAlign  3 "right"
    -columnAttach 1 "both" 0
    -columnAttach 2 "both" 0
    -columnAttach 3 "both" 0;
	columnLayout ; // First column.
		checkBoxGrp // Translate.
			-numberOfCheckBoxes 3
            -highlightColor 0.40 0.6 0.1 
            -columnWidth 1 50
            -columnWidth 2 50
            -columnWidth 3 50
			-l1 "Tx" -l2 "Ty" -l3 "Tz"
			-v1 1 -v2 1 -v3 1
			Direct_T_CHB;

        checkBoxGrp // Rotate.
			-numberOfCheckBoxes 3
            -highlightColor 0.40 0.6 0.1 
            -columnWidth 1 50
            -columnWidth 2 50
            -columnWidth 3 50
			-l1 "Rx" -l2 "Ry" -l3 "Rz"
			-v1 1 -v2 1 -v3 1
			Direct_R_CHB;

        checkBoxGrp // Scale.
			-numberOfCheckBoxes 3
            -highlightColor 0.40 0.6 0.1 
            -columnWidth 1 50
            -columnWidth 2 50
            -columnWidth 3 50
			-l1 "Sx" -l2 "Sy" -l3 "Sz"
			-v1 1 -v2 1 -v3 1
			Direct_S_CHB;
		
		setParent ..;
	columnLayout ; // Second column.
        checkBoxGrp // Parent constraints.
			-numberOfCheckBoxes 2
            -highlightColor 0.40 0.6 0.1 
            -columnWidth 1 200
            -columnWidth 2 200
            -rowAttach 1 "top" 0
            -rowAttach 2 "top" 10
            -vertical
            -editable off
			-l1 "Maintain offset"
            -l2 "Parent Constraint"
			-v1 1 -v2 1
			Parent_constraints_CHB;

		setParent ..;
	columnLayout ; // Third column.
        checkBoxGrp // Point / Orient constraints.
			-numberOfCheckBoxes 3
            -highlightColor 0.40 0.6 0.1 
            -columnWidth 1 200
            -columnWidth 2 200
            -rowAttach 1 "top" 0
            -vertical
            -editable off
			-l1 "Maintain offset"
            -l2 "Point Constraint"
            -l3 "Orient Constraint"
			-v1 1 -v2 0 -v3 0
			Point_Orient_constraints_CHB;

		setParent ..;
    setParent ..;




text -al "left" -l "" -h 2;
separator -st "in" ;


text -l "" -h 3;
progressBar -minValue 0 -maxValue 10 -height 14  -highlightColor 0.40 0.45 0.1 CBSprogressBar; 
text -l "" -h 3;
separator -st "in" ;


text -l "" -h 3;
button -l "Connect" -w 100 -h 25 -bgc 0.40 0.45 .1 -c "Connect" button1;
text -l "" -h 3;
separator -st "in" ;


//text -l "^_^"  ;
textField -backgroundColor .2 .2 .2 -editable false -height 22 -tx "-------------------------------------------    Developed by: Khaled Hussein    -------------------------------------------";
text -l "" -h 3 ;
showWindow Super_Connect;
//=========================================================================================================================================



global string $Destination_prefix;
global string $Source_prefix; 
textFieldGrp -e -tx $Destination_prefix DestinationTXF;
textFieldGrp -e -tx $Source_prefix SourceTXF;



global proc Store_01()
{
	string $stor1[] = `ls -sl`;
	int $stor1Size1 = `size $stor1`;
	textScrollList -e -ra ChangeControlsTSL_01;
	for ($R=0 ; $R < $stor1Size1; $R=$R)
	{
		textScrollList -e -ai -a $stor1[$R]  ChangeControlsTSL_01;
		++$R;
	}
}


global proc Store_02()
{
	string $stor2[] = `ls -sl`;
	int $stor1Size2 = `size $stor2`;
	textScrollList -e -ra ChangeControlsTSL_02;
	for ($T=0 ; $T < $stor1Size2; $T=$T)
	{
		textScrollList -e -ai -a $stor2[$T]  ChangeControlsTSL_02;
		++$T;
	}
}

global proc Connect()
{
	string $sel1[] = `textScrollList -q -ai ChangeControlsTSL_01`;
	int $sizeSel1 = `size $sel1`;
	
	
	string $sel2[] = `textScrollList -q -ai ChangeControlsTSL_02`;
	int $sizeSel2 = `size $sel2`;
	
    if($sizeSel1 < 1 || $sizeSel2 < 1)
    {
        error -n "We have no data to deal with, Please fill in source and destination lists";
    }
		
	// Query for radioButton:
    int $Direct_Connect = `radioButton -q -sl RB1`;
    int $Parent_Constraints = `radioButton -q -sl RB2`;
    int $Point_Orient_Constraint = `radioButton -q -sl RB3`;
	
	// query for textField:
	string $DestinationTXF = `textFieldGrp -q -tx DestinationTXF`;
	string $SourceTXF = `textFieldGrp -q -tx SourceTXF`;
	
    global string $Destination_prefix;
    global string $Source_prefix; 

    $Destination_prefix = $DestinationTXF;
    $Source_prefix = $SourceTXF; 

	//progressBar -e  -progress 0 CBSprogressBar;
	//progressBar -e -minValue 0 -maxValue $sizeSel1  CBSprogressBar;
	
	if($Direct_Connect) Super_Direct_Connect;

    if($Parent_Constraints) Super_ParentConstraint;

    if($Point_Orient_Constraint) Super_Point_Orient;
	
}



// Remove Namespace:============================================================================================
global proc string Remove_nameSpace(string $name)
{
    string $spliters[];
    tokenize  $name ":" $spliters; // Remove namespace:
    $name = $spliters[size($spliters)-1];
    //print $name;
    return $name;
}// End Remove Namespace:=======================================================================================



// Direct Connect:-----------------------------------------------------------------------------------------------------
global proc Super_Direct_Connect()
{
    print "Direct Connect";
    // query for textField:
	string $DestinationTXF = `textFieldGrp -q -tx DestinationTXF`;
	string $SourceTXF = `textFieldGrp -q -tx SourceTXF`;

    
    string $source_Items [] = `textScrollList -q -ai ChangeControlsTSL_02`;
	int $sizeSel1 = `size $source_Items`;
	
	
    string $destination_Items [] = `textScrollList -q -ai ChangeControlsTSL_01`;
	int $sizeSel2 = `size $destination_Items`;

    // query checkBox:
    // Translate.
    int $Translate_x = `checkBoxGrp -q -v1 Direct_T_CHB`;
    int $Translate_y = `checkBoxGrp -q -v2 Direct_T_CHB`;
    int $Translate_z = `checkBoxGrp -q -v3 Direct_T_CHB`;

    // Rotate.
    int $Rotate_x = `checkBoxGrp -q -v1 Direct_R_CHB`;
    int $Rotate_y = `checkBoxGrp -q -v2 Direct_R_CHB`;
    int $Rotate_z = `checkBoxGrp -q -v3 Direct_R_CHB`;

    // Scale.
    int $Scale_x = `checkBoxGrp -q -v1 Direct_S_CHB`;
    int $Scale_y = `checkBoxGrp -q -v2 Direct_S_CHB`;
    int $Scale_z = `checkBoxGrp -q -v3 Direct_S_CHB`;


    progressBar -e -beginProgress CBSprogressBar; 
    progressBar -e -minValue 0 -maxValue $sizeSel1  CBSprogressBar;


    // Connecting ...
    for($N=0; $N < $sizeSel1; $N++)
    {
        string $source_with_no_namespace = Remove_nameSpace($source_Items[$N]) ;       // Remove namespace from source object 
        //print ("\n Source name : " + $source_with_no_namespace);
        string $NewName_source = `substitute $SourceTXF $source_with_no_namespace ""`; // Remove prefix name from source object
        //print ("\n Source new name : " + $NewName_source);
        textScrollList -e -selectItem  $source_Items[$N]    ChangeControlsTSL_02;
        refresh -f -cv;

        for($item in $destination_Items)
        {
            //print ($item + "\n");
            string $destination_with_no_namespace = Remove_nameSpace($item) ; // Remove namespace from destination object
            //print ("\n Dest name : " + $source_with_no_namespace);
            string $NewName_dest = `substitute $DestinationTXF $destination_with_no_namespace ""`;     // Remove prefix name from destination object
            //print ("\n Dest new name : " + $NewName_source);

            if($NewName_dest == $NewName_source)
            {
                //print ($source_Items[$N] + "\n");
                //print ($item + "\n");
                if($Translate_x) connectAttr -f ($source_Items[$N] + ".translateX") ($item + ".translateX"); 
                if($Translate_y) connectAttr -f ($source_Items[$N] + ".translateY") ($item + ".translateY");
                if($Translate_z) connectAttr -f ($source_Items[$N] + ".translateZ") ($item + ".translateZ");

                if($Rotate_x) connectAttr -f ($source_Items[$N] + ".rotateX") ($item + ".rotateX");
                if($Rotate_y) connectAttr -f ($source_Items[$N] + ".rotateY") ($item + ".rotateY");
                if($Rotate_z) connectAttr -f ($source_Items[$N] + ".rotateZ") ($item + ".rotateZ");

                if($Scale_x) connectAttr -f ($source_Items[$N] + ".scaleX") ($item + ".scaleX");
                if($Scale_y) connectAttr -f ($source_Items[$N] + ".scaleY") ($item + ".scaleY");
                if($Scale_z) connectAttr -f ($source_Items[$N] + ".scaleZ") ($item + ".scaleZ");

                print ($item + "  ...  Has connected to  ...  " + $source_Items[$N] + "\n");
                select -r $item;
                textScrollList -e -selectItem  $item  ChangeControlsTSL_01;
                //refresh -f -cv;
                //pause -sec 1;
            }
            
        }
        progressBar -e -step 1 CBSprogressBar;
    }// Connecting Done.
    progressBar -e -endProgress CBSprogressBar;
    print "\nResult:  Direct connect is completed \n";
}

// Parent Constraint:-----------------------------------------------------------------------------------------------------
global proc Super_ParentConstraint()
{
    // print "Parent Constraints";
    // query for textField:
	string $DestinationTXF = `textFieldGrp -q -tx DestinationTXF`;
	string $SourceTXF = `textFieldGrp -q -tx SourceTXF`;

    string $source_Items [] = `textScrollList -q -ai ChangeControlsTSL_02`;
	int $sizeSel1 = `size $source_Items`;
	
	
	string $destination_Items [] = `textScrollList -q -ai ChangeControlsTSL_01`;
	int $sizeSel2 = `size $destination_Items`;

    // Query checkBox:
    int $maintainOffset = `checkBoxGrp -q -v1 Parent_constraints_CHB`;
    int $parentCons = `checkBoxGrp -q -v2 Parent_constraints_CHB`;

    progressBar -e -beginProgress CBSprogressBar; 
    progressBar -e -minValue 0 -maxValue $sizeSel1  CBSprogressBar; 

    // Connecting ...
    for($N=0; $N < $sizeSel1; $N++)
    {
        string $source_with_no_namespace = Remove_nameSpace($source_Items[$N]) ;       // Remove namespace from source object
        string $NewName_source = `substitute $SourceTXF $source_with_no_namespace ""`; // Remove prefix name from source object
        textScrollList -e -selectItem  $source_Items[$N]    ChangeControlsTSL_02;
        refresh -f -cv;

        for($item in $destination_Items)
        {
            //print ($item + "\n");
            string $destination_with_no_namespace = Remove_nameSpace($item) ; // Remove namespace from destination object
            string $NewName_dest = `substitute $DestinationTXF $destination_with_no_namespace ""`;     // Remove prefix name from destination object

            if($NewName_dest == $NewName_source)
            {
                //print ($NewJnts[$N] + "\n");
                if($parentCons) 
                {
                    if($maintainOffset)
                    {
                        parentConstraint -weight 1.0  -maintainOffset $source_Items[$N] $item;
                    }else{
                        parentConstraint -weight 1.0  $source_Items[$N] $item;
                    }
                }
                print ($item + "  ...  Has connected to  ...  " + $source_Items[$N] + "\n");
                select -r $item;
                textScrollList -e -selectItem  $item  ChangeControlsTSL_01;
                //refresh -f -cv;
                //pause -sec 1;
            }
            
        }
        progressBar -e -step 1 CBSprogressBar;
    }// Connecting Done.
    progressBar -e -endProgress CBSprogressBar;
}


// Point\Orient Constraint:-----------------------------------------------------------------------------------------------------
global proc Super_Point_Orient()
{
    print "Point/Orient Constraints";
    // query for textField:
	string $DestinationTXF = `textFieldGrp -q -tx DestinationTXF`;
	string $SourceTXF = `textFieldGrp -q -tx SourceTXF`;

    string $source_Items [] = `textScrollList -q -ai ChangeControlsTSL_02`;
	int $sizeSel1 = `size $source_Items`;
	
	
	string $destination_Items [] = `textScrollList -q -ai ChangeControlsTSL_01`;
	int $sizeSel2 = `size $destination_Items`;

    // Query checkBox:
    int $maintainOffset = `checkBoxGrp -q -v1 Point_Orient_constraints_CHB`; // Maintain offset
    int $pointCons = `checkBoxGrp -q -v2 Point_Orient_constraints_CHB`;      // Point Constraint
    int $orientCons = `checkBoxGrp -q -v3 Point_Orient_constraints_CHB`;     // Orient Constraint
    

    progressBar -e -beginProgress CBSprogressBar; 
    progressBar -e -minValue 0 -maxValue $sizeSel1  CBSprogressBar; 

    // Connecting ...
    for($N=0; $N < $sizeSel1; $N++)
    {
        string $source_with_no_namespace = Remove_nameSpace($source_Items[$N]) ;       // Remove namespace from source object
        string $NewName_source = `substitute $SourceTXF $source_with_no_namespace ""`; // Remove prefix name from source object
        textScrollList -e -selectItem  $source_Items[$N]    ChangeControlsTSL_02;
        refresh -f -cv;

        for($item in $destination_Items)
        {
            //print ($item + "\n");
            string $destination_with_no_namespace = Remove_nameSpace($item) ; // Remove namespace from destination object
            string $NewName_dest = `substitute $DestinationTXF $destination_with_no_namespace ""`;     // Remove prefix name from destination object

            if($NewName_dest == $NewName_source)
            {
                //print ($NewJnts[$N] + "\n");
                
                if($maintainOffset)
                {
                    // with maintainOffset:
                    if($pointCons) pointConstraint -w 1.0 -maintainOffset $source_Items[$N] $item;
                    if($orientCons) orientConstraint -w 1.0 -maintainOffset $source_Items[$N] $item;
                }else{
                    // without maintainOffset:
                    if($pointCons) pointConstraint -w 1.0  $source_Items[$N] $item;
                    if($orientCons) orientConstraint -w 1.0  $source_Items[$N] $item;
                }
                
                print ($item + "  ...  Has connected to  ...  " + $source_Items[$N] + "\n");
                select -r $item;
                textScrollList -e -selectItem  $item  ChangeControlsTSL_01;
                //refresh -f -cv;
                //pause -sec 1;
            }
                        
        }
        progressBar -e -step 1 CBSprogressBar;
    }// Connecting Done.
    progressBar -e -endProgress CBSprogressBar;
}




