global proc scpstg_skin192_AutoImport() {python("__import__('maya_toolkit.tools.skin_info_and_super_connect.ui',fromlist=['dispatch']).dispatch('skin192','AutoImport')");}
global proc string scpstg_skin192_SelectInfluences() {string $unused = python("__import__('maya_toolkit.tools.skin_info_and_super_connect.ui',fromlist=['dispatch']).dispatch('skin192','SelectInfluences')"); return "";}
global proc scpstg_skin192_ImportSkin_proc() {python("__import__('maya_toolkit.tools.skin_info_and_super_connect.ui',fromlist=['dispatch']).dispatch('skin192','ImportSkin_proc')");}
