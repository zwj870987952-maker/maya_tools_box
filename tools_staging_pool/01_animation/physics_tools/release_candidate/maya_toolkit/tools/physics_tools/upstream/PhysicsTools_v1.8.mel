global proc ruidoA()
    {
    python("\n\n\n\namplitude = 1\n\nimport maya.cmds as cmds\nimport maya.mel as mel\nimport random as rand\n\n\naTimeSlider = mel.eval('$tmpVar=$gPlayBackSlider')\ntimeRange = cmds.timeControl(aTimeSlider, q=True, rangeArray=True)\nobjects = cmds.ls ( orderedSelection = True, long = True)\n\n\nif objects:\n    timeRange[1] = timeRange[1]-1\n    \n    curvesToBake = cmds.channelBox(\"mainChannelBox\", q=1, sma=1)\n    \n    aLayer = mel.eval('treeView -query -selectItem (\"AnimLayerTabanimLayerEditor\")')\n    \n    if not aLayer or len(aLayer) <= 1:\n        \n        if curvesToBake:\n            \n            if not aLayer:\n                aLayer = []\n                aLayer.append(cmds.animLayer('noiseLayer'))\n            elif aLayer[0] == 'BaseAnimation':\n                aLayer[0] = cmds.animLayer('noiseLayer')\n            cmds.animLayer(aLayer[0], edit=True, addSelectedObjects=True)\n            \n            \n            if (timeRange[1]) - timeRange[0] == 0:\n                \n                startTime = cmds.playbackOptions( q=True, minTime=True )\n                endTime = cmds.playbackOptions( q=True, maxTime=True )\n                \n                for x in curvesToBake:\n                    \n                    \n                    cmds.bakeResults( objects, attribute=x, time=(startTime, endTime), simulation=False, preserveOutsideKeys = True, destinationLayer=aLayer[0])\n                    \n                    for o in objects:\n                        \n                        for t in range(int(startTime),int(endTime+1)):\n                            v = cmds.keyframe( o, attribute=x, query=True, eval=True, time=(t,t))\n                            randV = rand.uniform(-1*amplitude,amplitude)\n                            cmds.keyframe(o, attribute=x, valueChange=randV, time=(t,t))\n                        \n                        cmds.setKeyframe(o, identity=True, dirtyDG=True, time=(startTime,startTime))\n                        cmds.setKeyframe(o, identity=True, dirtyDG=True, time=(endTime,endTime))\n                   \n            \n            else:\n                \n                for x in curvesToBake:\n                    \n                    cmds.bakeResults( objects, attribute=x, time=(timeRange[0], timeRange[1]), simulation=False, preserveOutsideKeys = True, destinationLayer=aLayer[0])\n                    \n                    for o in objects:\n                        for t in range(int(timeRange[0]),int(timeRange[1])):\n                            if t == int(timeRange[0]):\n                                \n                                cmds.setKeyframe(o, attribute=x)\n                            else:\n                                \n                                v = cmds.keyframe( o, attribute=x, query=True, eval=True, time=(t,t))\n                                randV = rand.uniform(-1*amplitude,amplitude)\n                                cmds.keyframe(o, attribute=x, valueChange=randV, time=(t,t))\n                        \n                        cmds.setKeyframe(o, identity=True, dirtyDG=True, time=(timeRange[0],timeRange[0]))\n                        cmds.setKeyframe(o, identity=True, dirtyDG=True, time=(timeRange[1],timeRange[1]))\n\n\n        else: cmds.confirmDialog(title='Error', message='Select one or channels to apply noise')\n    else: cmds.confirmDialog(title='Error', message='Select one or less animation layers to apply noise')\nelse: cmds.confirmDialog(title='Error', message='Select one or more objects to convert to apply noise')");    
    }

global proc ruidoB()
    {
    python("\n\n\n\namplitude = 2\n\nimport maya.cmds as cmds\nimport maya.mel as mel\nimport random as rand\n\n\naTimeSlider = mel.eval('$tmpVar=$gPlayBackSlider')\ntimeRange = cmds.timeControl(aTimeSlider, q=True, rangeArray=True)\nobjects = cmds.ls ( orderedSelection = True, long = True)\n\n\nif objects:\n    timeRange[1] = timeRange[1]-1\n    \n    curvesToBake = cmds.channelBox(\"mainChannelBox\", q=1, sma=1)\n    \n    aLayer = mel.eval('treeView -query -selectItem (\"AnimLayerTabanimLayerEditor\")')\n    \n    if not aLayer or len(aLayer) <= 1:\n        \n        if curvesToBake:\n            \n            if not aLayer:\n                aLayer = []\n                aLayer.append(cmds.animLayer('noiseLayer'))\n            elif aLayer[0] == 'BaseAnimation':\n                aLayer[0] = cmds.animLayer('noiseLayer')\n            cmds.animLayer(aLayer[0], edit=True, addSelectedObjects=True)\n            \n            \n            if (timeRange[1]) - timeRange[0] == 0:\n                \n                startTime = cmds.playbackOptions( q=True, minTime=True )\n                endTime = cmds.playbackOptions( q=True, maxTime=True )\n                \n                for x in curvesToBake:\n                    \n                    \n                    cmds.bakeResults( objects, attribute=x, time=(startTime, endTime), simulation=False, preserveOutsideKeys = True, destinationLayer=aLayer[0])\n                    \n                    for o in objects:\n                        \n                        for t in range(int(startTime),int(endTime+1)):\n                            v = cmds.keyframe( o, attribute=x, query=True, eval=True, time=(t,t))\n                            randV = rand.uniform(-1*amplitude,amplitude)\n                            cmds.keyframe(o, attribute=x, valueChange=randV, time=(t,t))\n                        \n                        cmds.setKeyframe(o, identity=True, dirtyDG=True, time=(startTime,startTime))\n                        cmds.setKeyframe(o, identity=True, dirtyDG=True, time=(endTime,endTime))\n                   \n            \n            else:\n                \n                for x in curvesToBake:\n                    \n                    cmds.bakeResults( objects, attribute=x, time=(timeRange[0], timeRange[1]), simulation=False, preserveOutsideKeys = True, destinationLayer=aLayer[0])\n                    \n                    for o in objects:\n                        for t in range(int(timeRange[0]),int(timeRange[1])):\n                            if t == int(timeRange[0]):\n                                \n                                cmds.setKeyframe(o, attribute=x)\n                            else:\n                                \n                                v = cmds.keyframe( o, attribute=x, query=True, eval=True, time=(t,t))\n                                randV = rand.uniform(-1*amplitude,amplitude)\n                                cmds.keyframe(o, attribute=x, valueChange=randV, time=(t,t))\n                        \n                        cmds.setKeyframe(o, identity=True, dirtyDG=True, time=(timeRange[0],timeRange[0]))\n                        cmds.setKeyframe(o, identity=True, dirtyDG=True, time=(timeRange[1],timeRange[1]))\n\n\n        else: cmds.confirmDialog(title='Error', message='Select one or channels to apply noise')\n    else: cmds.confirmDialog(title='Error', message='Select one or less animation layers to apply noise')\nelse: cmds.confirmDialog(title='Error', message='Select one or more objects to convert to apply noise')");
    }

global proc ruidoC()
    {
    python("\n\n\n\namplitude = 5\n\nimport maya.cmds as cmds\nimport maya.mel as mel\nimport random as rand\n\n\naTimeSlider = mel.eval('$tmpVar=$gPlayBackSlider')\ntimeRange = cmds.timeControl(aTimeSlider, q=True, rangeArray=True)\nobjects = cmds.ls ( orderedSelection = True, long = True)\n\n\nif objects:\n    timeRange[1] = timeRange[1]-1\n    \n    curvesToBake = cmds.channelBox(\"mainChannelBox\", q=1, sma=1)\n    \n    aLayer = mel.eval('treeView -query -selectItem (\"AnimLayerTabanimLayerEditor\")')\n    \n    if not aLayer or len(aLayer) <= 1:\n        \n        if curvesToBake:\n            \n            if not aLayer:\n                aLayer = []\n                aLayer.append(cmds.animLayer('noiseLayer'))\n            elif aLayer[0] == 'BaseAnimation':\n                aLayer[0] = cmds.animLayer('noiseLayer')\n            cmds.animLayer(aLayer[0], edit=True, addSelectedObjects=True)\n            \n            \n            if (timeRange[1]) - timeRange[0] == 0:\n                \n                startTime = cmds.playbackOptions( q=True, minTime=True )\n                endTime = cmds.playbackOptions( q=True, maxTime=True )\n                \n                for x in curvesToBake:\n                    \n                    \n                    cmds.bakeResults( objects, attribute=x, time=(startTime, endTime), simulation=False, preserveOutsideKeys = True, destinationLayer=aLayer[0])\n                    \n                    for o in objects:\n                        \n                        for t in range(int(startTime),int(endTime+1)):\n                            v = cmds.keyframe( o, attribute=x, query=True, eval=True, time=(t,t))\n                            randV = rand.uniform(-1*amplitude,amplitude)\n                            cmds.keyframe(o, attribute=x, valueChange=randV, time=(t,t))\n                        \n                        cmds.setKeyframe(o, identity=True, dirtyDG=True, time=(startTime,startTime))\n                        cmds.setKeyframe(o, identity=True, dirtyDG=True, time=(endTime,endTime))\n                   \n            \n            else:\n                \n                for x in curvesToBake:\n                    \n                    cmds.bakeResults( objects, attribute=x, time=(timeRange[0], timeRange[1]), simulation=False, preserveOutsideKeys = True, destinationLayer=aLayer[0])\n                    \n                    for o in objects:\n                        for t in range(int(timeRange[0]),int(timeRange[1])):\n                            if t == int(timeRange[0]):\n                                \n                                cmds.setKeyframe(o, attribute=x)\n                            else:\n                                \n                                v = cmds.keyframe( o, attribute=x, query=True, eval=True, time=(t,t))\n                                randV = rand.uniform(-1*amplitude,amplitude)\n                                cmds.keyframe(o, attribute=x, valueChange=randV, time=(t,t))\n                        \n                        cmds.setKeyframe(o, identity=True, dirtyDG=True, time=(timeRange[0],timeRange[0]))\n                        cmds.setKeyframe(o, identity=True, dirtyDG=True, time=(timeRange[1],timeRange[1]))\n\n\n        else: cmds.confirmDialog(title='Error', message='Select one or channels to apply noise')\n    else: cmds.confirmDialog(title='Error', message='Select one or less animation layers to apply noise')\nelse: cmds.confirmDialog(title='Error', message='Select one or more objects to convert to apply noise')");
    }
