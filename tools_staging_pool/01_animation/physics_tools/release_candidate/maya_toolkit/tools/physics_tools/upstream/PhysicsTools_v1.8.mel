//-----------------------------------------------------------------------------------------------Bake Para o controlador
global proc BakeinfoController()
{
    select PhysicsSets;
    refresh -su true;
    string $startFrame = `playbackOptions -q -min`;
    string $endFrame = `playbackOptions -q -max`;
    bakeResults -t (($startFrame) + ":" + ($endFrame)) -sm true -sr false -sb 1.0 -pok true -dl "bakedTRANS";
    refresh -su false; 
    string $selected[]=`ls -sl`;
    for ($node in $selected )
    {
        string $layernamee = $node+"_Translations";
        rename BakeResults $layernamee;
    }
    select -clear;
    select -add Physics_grp;
    Delete;
    select PhysicsSets;
    sets -remove "PhysicsSets";
    select -r -ne PhysicsSets ;
    doDelete;
    playbackOptions -playbackSpeed 1;
    print "The Magic is Done!";
    
}
//-----------------------------------------------------------------------------------------------Cria Locator na selecao
global proc toLocator(){
    string $selected[]=`ls -sl`;
    for ($node in $selected ){
        string $imLocatorName = "imLocator_"+$node; 
        if (`objExists $imLocatorName`){
            delete $imLocatorName;
        }
        spaceLocator -name $imLocatorName;
        setAttr ($imLocatorName+".rotateOrder") `getAttr ($node+".rotateOrder")`;
        delete `parentConstraint $node $imLocatorName`;
        select -add $imLocatorName;
        select -deselect $node;         
        }
         print "Done!";     
}
//-----------------------------------------------------------------------------------------------Cria Locator na selecao
global proc createlocs(){
    if( `objExists "PointAimVector1"` ) {
         print "You already clicked";
     }
     else{      
    select "PhysicRotationAimSets";
    select -add "PointAimVector";
    parentConstraint -mo -weight 1;
    select -clear;
    select "PointAimVector";
    refresh -su true;
    string $startFrame = `playbackOptions -q -min`;
    string $endFrame = `playbackOptions -q -max`;
    bakeResults -t (($startFrame) + ":" + ($endFrame)) -sm true -sr false -sb 1.0 -pok true;
    refresh -su false;
    select "PointAimVector";
    delete -cn;
    select -cl;
    select "PhysicRotationAimSets";
    selectMode -object;
    sets -n "ControlerSetAim";
    spaceLocator -n "FirstLoc" -p 0 0 0;
    spaceLocator -n "SecondLoc" -p 0 0 0;
    parent SecondLoc FirstLoc ;
    select "ControlerSetAim";
    select -add "FirstLoc";
    pointConstraint -offset 0 0 0 -weight 1;
    orientConstraint -offset 0 0 0 -weight 1;
    select -add "FirstLoc";
    setAttr -lock true "FirstLoc.tx";
    setAttr -lock true "FirstLoc.ty";
    setAttr -lock true "FirstLoc.tz";
    select -clear; 
    select "FirstLoc";
    refresh -su true;
    string $startFrame = `playbackOptions -q -min`;
    string $endFrame = `playbackOptions -q -max`;
    bakeResults -t (($startFrame) + ":" + ($endFrame)) -sm true -sr false -sb 1.0 -pok true;
    refresh -su false;
    delete FirstLoc_orientConstraint1;
    select "PointAimVector";
    select -add "SecondLoc";
    aimConstraint -mo -weight 1 -aimVector 0 1 0 -upVector 0 1 0 -worldUpType "objectrotation" -worldUpVector 0 1 0 -worldUpObject FirstLoc;
    select "SecondLoc";
    select -add PhysicRotationAimSets;
    orientConstraint -offset 0 0 0 -weight 1;
    select -clear;
    select "PointAimVector";
    animLayer  PointAimVector;
    animLayer -e -addSelectedObjects PointAimVector1;
    select -clear;
    manipMoveContext -edit -mode 2 Move;
    print "Done!";
         }     
}
