    spaceLocator -n "FirstLoc_00" -p 0 0 0;
    spaceLocator -n "SecondLoc_00" -p 0 0 0;
    parent SecondLoc_00 FirstLoc_00 ;
    select "ObjectLocal_00";
    select -add "FirstLoc_00";
    pointConstraint -offset 0 0 0 -weight 1;
    orientConstraint -offset 0 0 0 -weight 1;
    select -add "FirstLoc_00";
    setAttr -lock true "FirstLoc_00.tx";
