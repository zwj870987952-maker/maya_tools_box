}
//-----------------------------------------------------------------------------------------------
global proc SetupRotationsXmais()
{
    select PhysicsRotationSets;
    select -add RotationPointAimVector;
    parentConstraint -mo -weight 1;
    select RotationPointAimVector;
    refresh -su true;
    string $startFrame = `playbackOptions -q -min`;
    string $endFrame = `playbackOptions -q -max`;
    bakeResults -t (($startFrame) + ":" + ($endFrame)) -sm true -sr false -sb 1.0 -pok true;
    refresh -su false;
    select RotationPointAimVector;
    delete -cn;
    select RotationPointAimVector;
    select -add PhysicsRotationSets;
    aimConstraint -mo -weight 1 -aimVector 1 0 0 -upVector 0 1 0 -worldUpType "object" -worldUpObject |RotationPointUpVector;
    select RotationPointAimVector;
        selectMode -object;
        sets -n "PhysicsSets";
        spaceLocator -n "InsertKeyframes";
        setupNParticleConnections "MagicDustShape";
        particle -n "MagicDust" -p -0 -0 -0 -c 1 ;
        escapeCurrentTool;
        select -r MagicDust ;
        setAttr "MagicDustShape.particleRenderType" 4;
        ConnectionEditor;
        select -r MagicDustShape ;
        connectWindowFillFromActiveList 0;
        nodeOutliner -e -replace MagicDustShape connectWindow|tl|cwForm|connectWindowPane|leftSideCW;
        connectWindowSetLeftLabel MagicDustShape;
        select -r InsertKeyframes ;
        nodeOutlinerOutputsCmd connectWindow|tl|cwForm|connectWindowPane|leftSideCW connectWindow|tl|cwForm|connectWindowPane|rightSideCW;
        nodeOutliner -e -replace InsertKeyframes connectWindow|tl|cwForm|connectWindowPane|rightSideCW;
        connectWindowSetRightLabel InsertKeyframes;
        nodeOutlinerOutputsCmd connectWindow|tl|cwForm|connectWindowPane|leftSideCW connectWindow|tl|cwForm|connectWindowPane|rightSideCW;
        nodeOutlinerInputsCmd connectWindow|tl|cwForm|connectWindowPane|leftSideCW connectWindow|tl|cwForm|connectWindowPane|rightSideCW; nodeOutliner -e -r connectWindow|tl|cwForm|connectWindowPane|rightSideCW;
        connectAttr -f MagicDustShape.worldCentroid InsertKeyframes.translate;
        spaceLocator -n "PathLocator";
        select -r MagicDustShape ;
        select -add PathLocator ;
        Goal;
        performDynamics 0 Goal 0;
        goal -w 0.5 -utr 0   -g PathLocator  MagicDust;
        deleteUI connectWindow;
        getUIComponentDockControl("Tool Settings", false);
        select -r MagicDust ;
        select -add PathLocator ;
        select -add InsertKeyframes ;
        group -n "Physics"; 
        select PhysicsSets;
        select -add Physics;
        parentConstraint -weight 1;
        parent -world Physics|MagicDust;
        parent -world Physics|InsertKeyframes;
        parent -world Physics|PathLocator;
        select -r MagicDust;
        select -add Physics;
        select -add InsertKeyframes;
        select -add PathLocator;
        group -n "Physics_grp";
        select Physics;
        delete;
        select PhysicsSets;
        select -add PathLocator;
        parentConstraint -weight 1;
        select PathLocator;
        refresh -su true;
        //string $startFrame = `playbackOptions -q -min`;    
        //string $endFrame = `playbackOptions -q -max`;
        bakeResults -t (($startFrame) + ":" + ($endFrame)) -sm true -sr false -sb 1.0 -pok true;
        refresh -su false;
        select PathLocator;
        delete -cn;
        select InsertKeyframes;
        select -add PhysicsSets;
        pointConstraint -mo;
        select MagicDustShape;
    float $GoalsmoothPhysicsAdvance = `floatSliderGrp -q -value "GoalsmoothTwo"`;
        setAttr "MagicDustShape.goalSmoothness" $GoalsmoothPhysicsAdvance;
    float $GoalWeightTwoPhysicsAdvance = `floatSliderGrp -q -value "GoalWeightTwo"`;
        setAttr "MagicDustShape.goalWeight[0]" $GoalWeightTwoPhysicsAdvance; 
        select PathLocator;
        parent "RotationPointUpVector";
        print "Press Play, move the sliders to preview the results";        
}
