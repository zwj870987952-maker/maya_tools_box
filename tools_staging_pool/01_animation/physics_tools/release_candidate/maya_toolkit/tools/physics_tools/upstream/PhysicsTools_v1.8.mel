global proc Iframe()
{     
   timeSliderEditKeys addInbetween; 
}
global proc Rframe()
{ 
    timeSliderEditKeys removeInbetween;
}

//-----------------------------------------------------------------------------------------------Faz bake para o locator
global proc BakeAnimtoLocatorParentRotworkflow()
{ 
       if( `objExists "ProxyLocsObjectsSL*"` ) {
         warning("You already have clicked!");
         }
     else {
         selectMode -object;
         sets -n "ProxyLocsObjectsSL";
         string $selected[]=`ls -sl`;
    for ($node in $selected ){
        string $imLocatorName = "ProxyLocator_"+$node; 
        if (`objExists $imLocatorName`){
            delete $imLocatorName;
        }
        spaceLocator -name $imLocatorName;
        setAttr ($imLocatorName+".rotateOrder") `getAttr ($node+".rotateOrder")`;
        parentConstraint -skipTranslate x -skipTranslate y -skipTranslate z $node $imLocatorName;
        refresh -su true;
        string $startFrame = `playbackOptions -q -min`;
        string $endFrame = `playbackOptions -q -max`;
        bakeResults -t (($startFrame) + ":" + ($endFrame)) -sm true -sr false -sb 1.0 -pok true;
        refresh -su false;
        delete -cn;
        parentConstraint -skipTranslate x -skipTranslate y -skipTranslate z $imLocatorName $node ;
        }
        print "Tip, select the locators and offset some keys)";  
        }
}
global proc RotWorkflowSelect()
{ 
    if (`objExists "*ProxyLocator_*"`){
            select "*ProxyLocator_*";
        }
    if (`objExists "*ProxyLocator_*:*"`){
            select "*ProxyLocator_*:*";
        }
    if (`objExists "*ProxyLocator_*:*:*"`){
            select "*ProxyLocator_*:*:*";
        }
    doSetInfinity "-pri cycleRelative" graphEditor1GraphEd "bufferCurve useSmoothness"; animCurveEditor -edit -displayInfinities 1 graphEditor1GraphEd;
    setInfinity -pri cycleRelative graphEditor1FromOutliner;
    doSetInfinity "-poi cycleRelative" graphEditor1GraphEd "bufferCurve useSmoothness"; animCurveEditor -edit -displayInfinities 1 graphEditor1GraphEd;
    setInfinity -poi cycleRelative graphEditor1FromOutliner;
}
global proc BakeRotWork()
{    
    select "ProxyLocsObjectsSL";
    string $startFrame = `playbackOptions -q -min`;
    string $endFrame = `playbackOptions -q -max`;
    bakeResults -t (($startFrame) + ":" + ($endFrame)) -sm true -sr false -sb 1.0 -pok true -dl "bakedLayer";
    string $selected[]=`ls -sl`;
    for ($node in $selected )
    {
        string $layernamee = $node+"_layer";
        rename BakeResults $layernamee;
        delete "*Proxy*";
        delete "*ProxyLocsObjectsSL*";
    }
    print "All Baked"; 
}


//Gerar os Cubos
global proc CreateCube(){
string $selected[]=`ls -sl`;
    for ($node in $selected ){
        string $imCubeName = "imCube_"+$node; 
        if (`objExists $imCubeName`){
            delete $imCubeName;
        }
        polyCube -name $imCubeName;
        setAttr ($imCubeName+".rotateOrder") `getAttr ($node+".rotateOrder")`;
        parentConstraint $node $imCubeName;
        }
}
//----------------------------------------------------------------------------------------------------------------------
//Gerar os Cubos
global proc CreateSpheres(){
string $selected[]=`ls -sl`;
    for ($node in $selected ){
        string $imSphereName = "imSphere_"+$node; 
        if (`objExists $imSphereName`){
            delete $imSphereName;
        }
        polySphere -name $imSphereName;
        setAttr ($imSphereName+".rotateOrder") `getAttr ($node+".rotateOrder")`;
        parentConstraint $node $imSphereName;
        }
}
//----------------------------------------------------------------------------------------------------------------------
//Select aos Cubos
global proc SProxies(){
    if (`objExists "imCube*"`){
            select -add "imCube*";
        }
    if (`objExists "imSphere*"`){
            select -add "imSphere*";
        }
    if (`objExists "imCube*:*"`){
            select -add "imCube*:*";
        }
    if (`objExists "imSphere*:*"`){
            select -add "imSphere*:*";
        }
    if (`objExists "imCube*:*:*"`){
            select -add "imCube*:*:*";
        }
    if (`objExists "imSphere*:*:*"`){
            select -add "imSphere*:*:*";
        }

select -d "*_parentConstraint*";
}
//----------------------------------------------------------------------------------------------------------------------
//Select aos Cubos
global proc SProxiesSpheres(){
if (`objExists "imSphere_*"`){
            select -add "imSphere_*";
        }
if (`objExists "imSphere_*:*"`){
            select -add "imSphere_*:*";
        }
if (`objExists "imSphere_*:*:*"`){
            select -add "imSphere_*:*:*";
        }
select -d "*_parentConstraint*";
}
//----------------------------------------------------------------------------------------------------------------------
//Select aos Cubos
global proc SProxiesCubes(){
if (`objExists "imCube_*"`){
            select -add "imCube_*";
        }
if (`objExists "imCube_*:*"`){
            select -add "imCube_*:*";
        }
if (`objExists "imCube_*:*:*"`){
            select -add "imCube_*:*:*";
        }
select -d "*_parentConstraint*";
}
//----------------------------------------------------------------------------------------------------------------------
//Select aos Cubos
global proc SProxiesMais(){
string $selected[]=`ls -sl`;
    for ($node in $selected ){
    scale -r 1.1 1.1 1.1;
}
}
//----------------------------------------------------------------------------------------------------------------------
//Select aos Cubos
global proc SProxiesMenos(){
string $selected[]=`ls -sl`;
    for ($node in $selected ){
    scale -r -0.9 -0.9 -0.9;
}
}
//----------------------------------------------------------------------------------------------------------------------
//Select aos Cubos
global proc CL(){
    if (`objExists "imCube*"`){
            select "imCube*";
            createDisplayLayer -name "ProxyMeshCubes" -number 1 -nr;
        }
    if (`objExists "imSphere*"`){
            select "imSphere*";
            createDisplayLayer -name "ProxyMeshCubes" -number 1 -nr;
        }
    if (`objExists "imCube*:*"`){
            select "imCube*:*";
            createDisplayLayer -name "ProxyMeshCubes" -number 1 -nr;
        }
    if (`objExists "imSphere*:*"`){
            select "imSphere*:*";
            createDisplayLayer -name "ProxyMeshSpheres" -number 1 -nr;
    }
     if (`objExists "imCube*:*:*"`){
            select "imCube*:*:*";
            createDisplayLayer -name "ProxyMeshCubes" -number 1 -nr;
        }
    if (`objExists "imSphere*:*:*"`){
            select "imSphere*:*:*";
            createDisplayLayer -name "ProxyMeshSpheres" -number 1 -nr;
    }
    

}
