//-----------------------------------------------------------------------------------------------Parent Constraint mo
global proc PCT()
{
    parentConstraint -mo -skipRotate x -skipRotate y -skipRotate z -weight 1;
    print "Done!"; 
}
//-----------------------------------------------------------------------------------------------Parent Constraint
global proc PCToff()
{
    parentConstraint -skipRotate x -skipRotate y -skipRotate z -weight 1;
    print "Done!"; 
}
//-----------------------------------------------------------------------------------------------
global proc PCR()
{
    parentConstraint -mo -skipTranslate x -skipTranslate y -skipTranslate z -weight 1;
    print "Done!"; 
}
//-----------------------------------------------------------------------------------------------
global proc ParentConstraintNormal()
{
  parentConstraint -mo -weight 1;
  print "Done!"; 
}
//-----------------------------------------------------------------------------------------------
global proc Aim()
{
  AimConstraintOptions;
  print "Done!"; 
}
//-----------------------------------------------------------------------------------------------
global proc Bake()
{
    //refresh -su true;
    string $startFrame = `playbackOptions -q -min`;
    string $endFrame = `playbackOptions -q -max`;
    bakeResults -t (($startFrame) + ":" + ($endFrame)) -sm true -sr false -sb 1.0 -pok true -dl "bakedLayer";
    string $selected[]=`ls -sl`;
    for ($node in $selected )
    {
        string $layernamee = $node+"_layer";
        rename BakeResults $layernamee;
    }
    //refresh -su false; 
    print "All Baked"; 
}
