global proc RedoDRW(){
    if (`objExists "*ProxyLocator_*"`){
            delete "*ProxyLocator_*";
        }
    if (`objExists "*Proxy*"`){
            delete "*Proxy*";
        }
    if (`objExists "*ProxyLocs*"`){
            delete "*ProxyLocs*";
        }
    if (`objExists "*ProxyLocsObjectsSL*"`){
            delete "*ProxyLocsObjectsSL*";
        }
    if (`objExists "*ProxyLocator_*:*"`){
            delete "*ProxyLocator_*:*";
        }
    if (`objExists "*Proxy*:*"`){
            delete "*Proxy*:*";
        }
    if (`objExists "*ProxyLocs*:*"`){
            delete "*ProxyLocs*:*";
        }
    if (`objExists "*ProxyLocsObjectsSL*:*"`){
            delete "*ProxyLocsObjectsSL*:*";
        }
    if (`objExists "*ProxyLocator_*:*:*"`){
            delete "*ProxyLocator_*:*:*";
        }
    if (`objExists "*Proxy*:*:*"`){
            delete "*Proxy*:*:*";
        }
    if (`objExists "*ProxyLocs*:*:*"`){
            delete "*ProxyLocs*:*:*";
        }
    if (`objExists "*ProxyLocsObjectsSL*:*:*"`){
            delete "*ProxyLocsObjectsSL*:*:*";
        }
    if (`objExists "*imLocator_*"`){
            delete "*imLocator_*";
        }
    if (`objExists "*imLocator_*:*"`){
            delete "*imLocator_*:*";
        }
    if (`objExists "*imLocator_*:*:*"`){
            delete "*imLocator_*:*:*";
        }
}

//cena das maos
global proc createlochandR(){
    if (`objExists "ControllerRightHand_0"`){
        select "ControllerRightHand_0";
}
else {
    selectMode -object;
    sets -n "RightHandController";
    spaceLocator -n "ParentR00" -p 0 0 0;
    select "RightHandController";
    select -add "ParentR00";
    pointConstraint -offset 0 0 0 -weight 1;
    orientConstraint -offset 0 0 0 -weight 1;
    select "ParentR00";
    delete -cn;
    spaceLocator -n "ControllerRightHand_0" -p 0 0 0;
    spaceLocator -n "ParentR01" -p 0 0 0;
    select "ParentR00";
    select -add "ControllerRightHand_0";
    pointConstraint -offset 0 0 0 -weight 1;
    orientConstraint -offset 0 0 0 -weight 1;
    delete -cn;
    select "ControllerRightHand_0";
    select -add "ParentR01";
    pointConstraint -offset 0 0 0 -weight 1;
    orientConstraint -offset 0 0 0 -weight 1;
    delete -cn;
    select "ControllerRightHand_0";
    select -add "ParentR00";
    select -add "ParentR01";
    makeIdentity -apply true -t 1 -r 1 -s 1 -n 0 -pn 1;
    parent ControllerRightHand_0 ParentR00 ;
    parent ParentR01 ControllerRightHand_0 ;
    delete "RightHandController";
    select "ControllerRightHand_0";
    color -rgb 1 1 0;
    }
}
