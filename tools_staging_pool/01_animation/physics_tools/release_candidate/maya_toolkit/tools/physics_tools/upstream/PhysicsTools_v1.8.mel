//-----------------------------------------------------------------------------------------------
global proc Aimcontrolerselect()
{
   select "PointAimVector";
}
//-----------------------------------------------------------------------------------------------
global proc AimDelete()
{
        if( `objExists "PointAimVector"` ) {
         delete "PointAimVector";
     }
     else{
         print "clean!";
         }
             if( `objExists "PhysicRotationAimSets"` ) {
         delete "PhysicRotationAimSets";
     }
     else{
         print "clean!";
         }
             if( `objExists "FirstLoc"` ) {
         delete "FirstLoc";
     }
     else{
         print "clean!";
         }
             if( `objExists "SecondLoc"` ) {
         delete "SecondLoc";
     }
     else{
         print "clean!";
         }
             if( `objExists "ControlerSetAim"` ) {
         delete "ControlerSetAim";
     }
     else{
         print "clean!";
         }
         if( `objExists "PointAimVector*"` ) {
         delete "PointAimVector*";
     }
     else{
         print "clean!";
         }
           
}
//-----------------------------------------------------------------------------------------------
global proc CreateLocatorRotationsAim()
{
            if( `objExists PointAimVector` ) {
             warning("You already have clicked!");
         }
         else {
    selectMode -object;
    sets -n "PhysicRotationAimSets";
    spaceLocator -n "PointAimVector";
    select PhysicRotationAimSets;
    select -add PointAimVector;
    parentConstraint -weight 1;
    delete -cn;
    select PointAimVector; 
    manipMoveContext -edit -mode 0 Move;
    print "Done!";
    }
}
//-----------------------------------------------------------------------------------------------
global proc CreateLocatorRotations()
{
            if( `objExists RotationPointAimVector` ) {
             warning("You already have clicked!");
         }
         else {
    selectMode -object;
    sets -n "PhysicsRotationSets";
    spaceLocator -n "RotationPointAimVector";
    select PhysicsRotationSets;
    select -add RotationPointAimVector;
    parentConstraint -weight 1;
    delete -cn;
    select RotationPointAimVector; 
    manipMoveContext -edit -mode 0 Move;
    print "Move forward, same direction the initial pose aim vector.";
    }
}
//-----------------------------------------------------------------------------------------------
global proc CreateLocatorUpVectorRotations()
{
            if( `objExists RotationPointUpVector` ) {
