        setAttr "MagicDustShape.goalSmoothness" $GoalsmoothPhysicsAdvance;
    float $GoalWeightTwoPhysicsAdvance = `floatSliderGrp -q -value "GoalWeightTwo"`;
        setAttr "MagicDustShape.goalWeight[0]" $GoalWeightTwoPhysicsAdvance; 
        select PathLocator;
        parent "RotationPointUpVector";
        print "Press Play, move the sliders to preview the results";            
}
//-----------------------------------------------------------------------------------------------
global proc RefeshParticleSettingsTwo()
{
    if( `objExists "MagicDustShape"` ){ 
    select MagicDustShape;
    float $GoalsmoothPhysicsAdvance = `floatSliderGrp -q -value "GoalsmoothTwo"`;
        setAttr "MagicDustShape.goalSmoothness" $GoalsmoothPhysicsAdvance;
        select MagicDustShape;
    float $GoalWeightTwoPhysicsAdvance = `floatSliderGrp -q -value "GoalWeightTwo"`;
        setAttr "MagicDustShape.goalWeight[0]" $GoalWeightTwoPhysicsAdvance;
        select MagicDustShape; 
        }
        else {
            print "Setup First";
            }
}
//-----------------------------------------------------------------------------------------------
global proc RotationsBake()
{
    select MagicDustShape;
    float $GoalsmoothPhysicsFourtin = `floatSliderGrp -q -value "GoalsmoothTwo"`;
        setAttr "MagicDustShape.goalSmoothness" $GoalsmoothPhysicsFourtin;
    float $GoalWeightTwoPhysicsFourtin = `floatSliderGrp -q -value "GoalWeightTwo"`;
        setAttr "MagicDustShape.goalWeight[0]" $GoalWeightTwoPhysicsFourtin; 
    select InsertKeyframes;
    refresh -su true;
    string $startFrame = `playbackOptions -q -min`;
    string $endFrame = `playbackOptions -q -max`;
    bakeResults -t (($startFrame) + ":" + ($endFrame)) -sm true -sr false -sb 1.0 -pok true;
    refresh -su false;
    select -clear; 
    select MagicDust;
    select -add PathLocator;
    delete;
    select InsertKeyframes;
    select -add PhysicsSets;
    parentConstraint -mo -skipRotate x -skipRotate y -skipRotate z -weight 1;
    select PhysicsSets;
    refresh -su true;
    //string $startFrame = `playbackOptions -q -min`;
    //string $endFrame = `playbackOptions -q -max`;
    bakeResults -t (($startFrame) + ":" + ($endFrame)) -sm true -sr false -sb 1.0 -pok true;
    refresh -su false; 
    select -clear;
    select "RotationPointUpVector";
    Delete;
    select -add Physics_grp;
    Delete;
    select PhysicsSets;
    sets -remove "PhysicsSets";
    select -r -ne PhysicsSets ;
    doDelete;
    manipMoveContext -edit -mode 2 Move;   
}
//-----------------------------------------------------------------------------------------------
global proc FinalRotationsBake()
{
    select PhysicsRotationSets;
    refresh -su true;
    string $startFrame = `playbackOptions -q -min`;
    string $endFrame = `playbackOptions -q -max`;
    bakeResults -t (($startFrame) + ":" + ($endFrame)) -sm true -sr false -sb 1.0 -pok true -dl "bakedROTATIONS";
    refresh -su false; 
    string $selected[]=`ls -sl`;
    for ($node in $selected )
    {
        string $layernamee = $node+"_Rotations";
        rename BakeResults $layernamee;
    }
    select PhysicsRotationSets;
    delete -cn;
    select PhysicsRotationSets;
    sets -remove "PhysicsRotationSets";
    select -r -ne PhysicsRotationSets;
    doDelete;
    select RotationPointAimVector;
    doDelete;
    select -add Physics_grp;
    Delete;
    playbackOptions -playbackSpeed 1;
    manipMoveContext -edit -mode 2 Move;
    print "The Magic is Done!";         
}
//-----------------------------------------------------------------------------------------------FootPlacer
global proc footPlacer()
{
  if( `objExists "footPlacerSet*"` ) {
       warning("You already have clicked!");
        }
   else {
   selectMode -object;
   sets -n "footPlacerSet";
   setKeyframe;
   spaceLocator -name locFootPlacer;  
   select locFootPlacer;
   select -add footPlacerSet;
   parentConstraint -weight 1 -mo;
   select locFootPlacer;
   print "Now press offset + or -";
   }     
}
//-----------------------------------------------------------------------------------------------DeleteFootPlacer
global proc footPlacerDeleter()
{ 
    if( `objExists "*locFootPlacer*"` ) {
    delete "*locFootPlacer*";
    }
    else {
    warning("Clean");
    } 
    if( `objExists "*footPlacerSet*"` ) {
    delete "*footPlacerSet*";
    }
    else {
    warning("Clean");
    }      
}
//-----------------------------------------------------------------------------------------------OffsetKeysLessSL
global proc OffsetKeysLessSL()
{ 
    select -r footPlacerSet;
    setKeyframe;
    nextOrPreviousFrame "previous";
    print "Keyframe back";  
}
//-----------------------------------------------------------------------------------------------OffsetKeysMoreSL
global proc OffsetKeysMoreSL()
{ 
    select -r footPlacerSet;
    setKeyframe;
    nextOrPreviousFrame "next";
    print "Keyframe forward"; 
}
//-----------------------------------------------------------------------------------------------OffsetKeysMoreSL
global proc AlignCommand()
{ 
    string $parCns[] = `parentConstraint -n "MagicAlignment_"`;
    setKeyframe;
    delete "*MagicAlignment_*";
    print "All Aligned";  
}
//-----------------------------------------------------------------------------------------------CleanMahShit
global proc cleanMAHshit()
{
    if( `objExists "*Physics*"` ) {
    delete "*Physics*";
    }
    else {
    warning("Clean");
    }   
    if( `objExists "*Physics_grp*"` ) {
    delete "*Physics_grp*";
    }
    else {
    warning("Clean");
    }
    if( `objExists "*PhysicsSets*"` ) {
    delete "*PhysicsSets*";
    }
    else {
    warning("Clean");
    }
    if( `objExists "*InsertKeyframes*"` ) {
    delete "*InsertKeyframes*";
    }
    if( `objExists "*particle*"` ) {
    delete "*particle*";
    }
    else {
    warning("Clean");
    }
    if( `objExists "*MagicDust*"` ) {
    delete "*MagicDust*";
    }
    else {
    warning("Clean");
    }
    if( `objExists "*PhysicsSets*"` ) {
    delete "*PhysicsSets*";
    }
    else {
    warning("Clean");
    }
     if( `objExists "*PhysicsRotationSets*"` ) {
    delete "*PhysicsRotationSets*";
    }
    else {
    warning("Clean");
    }
    if (`objExists "*imLocator_"`){
            delete "*imLocator_";
        }
    else {
        warning("Clean");
        }
    if (`objExists "*imLocator_*:*"`){
            delete "*imLocator_*:*";
        }
    else {
        warning("Clean");
        }
    if (`objExists "*imLocator_*:**:*"`){
            delete "*imLocator_*:**:*";
        }
    else {
        warning("Clean");
        }
    if( `objExists "*RotationPoint*"` ) {
    delete "*RotationPoint*";
    }
        else {
        warning("Clean");
        }
    if( `objExists "*nucleus*"` ) {
    delete "*nucleus*";
    }
        else {
        warning("Clean");
        }
        playbackOptions -playbackSpeed 1;                          
}
print "Do your Magic!";
