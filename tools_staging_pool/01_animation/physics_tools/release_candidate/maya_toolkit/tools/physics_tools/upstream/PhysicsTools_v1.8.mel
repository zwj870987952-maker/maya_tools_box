global proc BakeEverything()
{
    select "PhysicRotationAimSets";
    refresh -su true;
    string $startFrame = `playbackOptions -q -min`;
    string $endFrame = `playbackOptions -q -max`;
    bakeResults -t (($startFrame) + ":" + ($endFrame)) -sm true -sr false -sb 1.0 -pok true -dl "bakedLayer";
    string $selected[]=`ls -sl`;
    for ($node in $selected )
    {
        string $layernamee = $node+"_layer";
        rename BakeResults $layernamee;
    }
    refresh -su false;
    if( `objExists "PointAimVector"` ) {
         delete "PointAimVector";
     }
     else{
         print "clean!";
         }
             if( `objExists "PhysicRotationAimSets"` ) {
         delete "PhysicRotationAimSets";
     }
     else{
         print "clean!";
         }
             if( `objExists "FirstLoc"` ) {
         delete "FirstLoc";
     }
     else{
         print "clean!";
         }
             if( `objExists "SecondLoc"` ) {
         delete "SecondLoc";
     }
     else{
         print "clean!";
         }
             if( `objExists "ControlerSetAim"` ) {
         delete "ControlerSetAim";
     }
     else{
         print "clean!";
         }
         if( `objExists "PointAimVector1"` ) {
         delete "PointAimVector1";
     }
     else{
         print "clean!";
         }
         if( `objExists "PointAimVector2"` ) {
         delete "PointAimVector2";
     }
     else{
         print "clean!";
         }
         if( `objExists "PointAimVector3"` ) {
         delete "PointAimVector3";
     }
     else{
         print "clean!";
         }
         if( `objExists "PointAimVector4"` ) {
         delete "PointAimVector4";
     }
     else{
         print "clean!";
         }
         if( `objExists "PointAimVector5"` ) {
         delete "PointAimVector5";
