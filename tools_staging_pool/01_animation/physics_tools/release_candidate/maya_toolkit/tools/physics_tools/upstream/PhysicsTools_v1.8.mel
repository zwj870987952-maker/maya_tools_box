//LocalspaceLoccontrolerselect---------------------------------------------------------------------------------------
global proc LocalspaceLoccontrolerselect()
{ 
    select "SecondLoc_*";
}
//BakeLocalspaceLoc---------------------------------------------------------------------------------------------------
global proc BakeLocalspaceLoc()
{ 
    select "ObjectLocal_*";
    refresh -su true;
    string $startFrame = `playbackOptions -q -min`;
    string $endFrame = `playbackOptions -q -max`;
    bakeResults -t (($startFrame) + ":" + ($endFrame)) -sm true -sr false -sb 1.0 -pok true -dl "bakedROTATIONS";
    refresh -su false; 
    rename BakeResults "LocalSpace";
    select -cl;
    if( `objExists "FirstLoc_0*"` ) {
         delete "FirstLoc_0*";
     }
     else{
         print "clean!";
         }
          if( `objExists "SecondLoc_0*"` ) {
         delete "SecondLoc_0*";
     }
     else{
         print "clean!";
         }
         if( `objExists "ObjectLocal_0*"` ) {
         delete "ObjectLocal_0*";
     }
     else{
         print "clean!";
         }
}
//LocalspaceLocDelete---------------------------------------------------------------------------------------------------------------
global proc LocalspaceLocDelete()
{ 
    if( `objExists "FirstLoc_0*"` ) {
         delete "FirstLoc_0*";
     }
     else{
         print "clean!";
         }
          if( `objExists "SecondLoc_0*"` ) {
         delete "SecondLoc_0*";
     }
     else{
         print "clean!";
         }
               if( `objExists "ObjectLocal_0*"` ) {
         delete "ObjectLocal_0*";
     }
     else{
         print "clean!";
         }
}


//----------------------------------------------------------------------------------------------------------------------------------------------
global proc keyframeDy()
{ 
if( `objExists MagicDust` ){
    select MagicDustShape;
    setKeyframe;
    }
}
global proc keyframeDyy()
{ 
if( `objExists JiggleMe` ){
    select jiggle1;
    setKeyframe;
    }
}
//----------------------------------------------------------------------------------------------------------------------------------------------
global proc SetupPhysics()
{
    if( `objExists "JiggleMe"` ) {
         print "You already clicked!";
     }
     else{
    selectMode -object;
    sets -n "JiggleSet";
    polyPlane -n "JiggleMe" -w 1 -h 1 -sx 1 -sy 1 -ax 0 1 0 -cuv 2 -ch 1;
    select  "JiggleMe";
    doJiggle 1 { "0.1", "0.5", "0.9", "0", "0", "default", "" };
    select  "JiggleSet";
    select  -add "JiggleMe";
    parentConstraint -weight 1;
    setAttr "JiggleMe.visibility" 0;
        float $GoalsmoothPhysicsStiffnessTR = `floatSliderGrp -q -value "Goalstiffness"`;
        setAttr "jiggle1.stiffness" $GoalsmoothPhysicsStiffnessTR;
        select jiggle1;
    float $GoalsmoothPhysicsDampingTR = `floatSliderGrp -q -value "Goaldamping"`;
        setAttr "jiggle1.damping" $GoalsmoothPhysicsDampingTR;
        select jiggle1; 
    float $GoalWeightPhysicsWeighttTR = `floatSliderGrp -q -value "GoalWeightt"`;
        setAttr "jiggle1.jiggleWeight" $GoalWeightPhysicsWeighttTR;
        select jiggle1;
    select "JiggleMe";
    refresh -su true;
    string $startFrame = `playbackOptions -q -min`;
    string $endFrame = `playbackOptions -q -max`;
    bakeResults -t (($startFrame) + ":" + ($endFrame)) -sm true -sr false -sb 1.0 -pok true;
    refresh -su false;
    select "JiggleMe";
    delete - cn;
    select "JiggleMe";
    createHair 1 1 10 0 0 0 0 5 0 1 1 1;
    rename "hairSystem1Follicles" "DontTouch";
    rename "JiggleMeFollicle5050" "JiggleMeFollicle";
    select "pfxHair*";
    select -add "curve1";
    select -add "hairSystem*";
    select -add "nucleus*";
    delete;
    select "JiggleMeFollicle";
    select -add "JiggleSet";
    parentConstraint -mo -weight 1;
    select "JiggleMe";
    select -add "DontTouch";
    group -n "Nothing";
    //setAttr DontTouch.hiddenInOutliner true;AEdagNodeCommonRefreshOutliners();
    setAttr "JiggleMe.hideOnPlayback" 1;
    diskCache -ea -da;
    print "Magic!";
    }
}
//Passar para o Locator---------------------------------------------------------------------------------------------------------------
global proc PlayEveryframe()
{   
    playbackOptions -e -playbackSpeed 0 -maxPlaybackSpeed 0;
    print "Play Every Frame!";
}
//Passar para o Locator---------------------------------------------------------------------------------------------------
global proc PlayNormalframe()
{   
    playbackOptions -playbackSpeed 1;
    print "Play Realtime!";
}
//Passar para o Locator---------------------------------------------------------------------------------------------------------------
global proc CacheMe()
{
    select "JiggleMe";
    diskCache -os -ea -ct mcj -sr 1 -enabledCachesOnly;
}

//Passar para o Locator---------------------------------------------------------------
global proc BakePhysics()
{
    //select "JiggleMe";
    //doCreateGeometryCache 6 { "2", "1", "10", "OneFilePerFrame", "1", "","0","","0", "add", "0", "1", "1","0","1","mcx","0" } ;
    select "JiggleSet";
    refresh -su true;
    string $startFrame = `playbackOptions -q -min`;
    string $endFrame = `playbackOptions -q -max`;
    bakeResults -t (($startFrame) + ":" + ($endFrame)) -sm true -sr false -sb 1.0 -pok true -dl "bake";
    refresh -su false; 
    string $selected[]=`ls -sl`;
    for ($node in $selected )
    {
        string $layernamee = $node+"_Overlap";
        rename BakeResults $layernamee;
    }
    select "Nothing"; 
    delete;
    select -r -ne JiggleSet;
    doDelete;
    playbackOptions -playbackSpeed 1;
    print "Magic!";
}
//Para deletar-----------------------------------------------------------------------
global proc RedoMe()
{
    if( `objExists "Nothing*"` ) {
         delete "Nothing*";
     }
     else{
         print "clean!";
         }
     if( `objExists "JiggleMe*"` ) {
         delete "JiggleMe*";
     }
     else{
         print "clean!";
         }
         if( `objExists "JiggleMeFollicle*"` ) {
         delete "JiggleMeFollicle*";
     }
     else{
         print "clean!";
         }
         if( `objExists "DontTouch*"` ) {
         delete "DontTouch*";
     }
     else{
         print "clean!";
         }
         if( `objExists "JiggleSet*"` ) {
         delete "JiggleSet*";
     }
     else{
         print "clean!";
         }
         playbackOptions -playbackSpeed 1;
    print "Scene Clean!";
}
//Settings dos sliders---------------------------------------------------------------
global proc RefeshParticleSettings4()
{
    if( `objExists "JiggleMe"` ) {
    select jiggle1;
    float $GoalsmoothPhysicsStiffnessTR = `floatSliderGrp -q -value "Goalstiffness"`;
        setAttr "jiggle1.stiffness" $GoalsmoothPhysicsStiffnessTR;
        select jiggle1;
    float $GoalsmoothPhysicsDampingTR = `floatSliderGrp -q -value "Goaldamping"`;
        setAttr "jiggle1.damping" $GoalsmoothPhysicsDampingTR;
        select jiggle1; 
    float $GoalWeightPhysicsWeighttTR = `floatSliderGrp -q -value "GoalWeightt"`;
        setAttr "jiggle1.jiggleWeight" $GoalWeightPhysicsWeighttTR;
        select jiggle1;
            }
    else {
        print "Click 1.- Setup";
        }
}

global proc RefeshParticleSettingsRotations()
{
    if( `objExists "JiggleMe"` ) {
    select jiggle1;
    float $GoalsmoothPhysicsStiffness = `floatSliderGrp -q -value "GoalstiffnessRotations"`;
        setAttr "jiggle1.stiffness" $GoalsmoothPhysicsStiffness;
        select jiggle1;
    float $GoalsmoothPhysicsDamping = `floatSliderGrp -q -value "GoaldampingRotations"`;
        setAttr "jiggle1.damping" $GoalsmoothPhysicsDamping;
        select jiggle1; 
    float $GoalWeightPhysicsWeight = `floatSliderGrp -q -value "GoalWeightRotations"`;
        setAttr "jiggle1.jiggleWeight" $GoalWeightPhysicsWeight;
        select jiggle1;
            }
    else {
        print "Click 1.- Setup";
        }
}

global proc SetupRotationsPhysics()
{
     if( `objExists "JiggleMe"` ) {
         print "You already clicked!";
     }
     else{
    selectMode -object;
    sets -n "JiggleSet";
    polyPlane -n "JiggleMe" -w 1 -h 1 -sx 1 -sy 1 -ax 0 1 0 -cuv 2 -ch 1;
    select  "JiggleMe";
    doJiggle 1 { "0.1", "0.5", "0.9", "0", "0", "default", "" };
    select  "JiggleSet";
    select  -add "JiggleMe";
    parentConstraint -weight 1;
    setAttr "JiggleMe.visibility" 0;
    select jiggle1;
    float $GoalsmoothPhysicsStiffness = `floatSliderGrp -q -value "GoalstiffnessRotations"`;
        setAttr "jiggle1.stiffness" $GoalsmoothPhysicsStiffness;
        select jiggle1;
    float $GoalsmoothPhysicsDamping = `floatSliderGrp -q -value "GoaldampingRotations"`;
        setAttr "jiggle1.damping" $GoalsmoothPhysicsDamping;
        select jiggle1; 
    float $GoalWeightPhysicsWeight = `floatSliderGrp -q -value "GoalWeightRotations"`;
        setAttr "jiggle1.jiggleWeight" $GoalWeightPhysicsWeight;
        select jiggle1;
    select "JiggleMe";
    refresh -su true;
    string $startFrame = `playbackOptions -q -min`;
    string $endFrame = `playbackOptions -q -max`;
    bakeResults -t (($startFrame) + ":" + ($endFrame)) -sm true -sr false -sb 1.0 -pok true;
    refresh -su false;
    select "JiggleMe";
    delete - cn;
    select "JiggleMe";
    createHair 1 1 10 0 0 0 0 5 0 1 1 1;
    rename "hairSystem1Follicles" "DontTouch";
    rename "JiggleMeFollicle5050" "JiggleMeFollicle";
    select "pfxHair*";
    select -add "curve1";
    select -add "hairSystem*";
    select -add "nucleus*";
    delete;
    select "JiggleMeFollicle";
    select -add "JiggleSet";
    parentConstraint -mo -st x -st y -st z -weight 1;
    select "JiggleMe";
    select -add "DontTouch";
    group -n "Nothing";
    diskCache -ea -da; 
    //setAttr DontTouch.hiddenInOutliner true;AEdagNodeCommonRefreshOutliners();
    print "Magic!";
    }
}

