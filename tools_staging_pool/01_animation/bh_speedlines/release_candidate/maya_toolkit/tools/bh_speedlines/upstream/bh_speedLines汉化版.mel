// bh_speedLines v1.02 19-11-2020 



// added depth slider for the drawing plane
// added about menu
// now the smooth curve and simplify curve procs do a center pivot on the curve(s) too 
// make geo proc now freezes rotation on the geo relative to the camera so that it can be moved easily in camera space.. 
// fixed key vis so it doesn't key the shape node too
// put in ScriptJob to toggle the Draw mode off if the user hits Enter or switches tool while drawing IN EP MODE ONLY

// added option to use EP tool instead of Pencil 
// add the 'simplify curve proc'
// simplify geo now works with multiple selected meshes
// various UI tweaks
// made camera field non-editable so that it doesn't steal focus (makes Undoing more fluid when using tools)
// made the 'flip' command work with multiple meshes
// set up good default settings for geometry creation
// added option to create high-res geo
// improved Draw button so that it's a toggle rather than 2 separate buttons, also changes color to make it clear when in drawing mode
// added option to key visibility for 2 frames 
// added an option to set up a display layer for geo and have new drawn geo added to it on create
// took out the simplify geo happening by default when converting..




global proc bh_speedLines()
{
    bh_setUpConvertPrefs;
    bh_speedLinesUI;
}


bh_speedLines;

global proc bh_setUpConvertPrefs()
{// set this to get Quad meshes from conversion.. // these settings should give good results in the majority of cases.. 
    	
nurbsToPolygonsPref  -f 0 -pt 1 -pc 100 -chr 0.1 -ft 0.01 -mel 0.001 -d 0.1 -ut 1 -un 3 -vt 1 -vn 3 -uch 0 -ucr 0 -cht 0.2 -es 0  -mrt 0  ;
    	 
}


