				-command "SW_194c7b09c27128a45486ac17560c7a25($BARN_curve_sword_remember_BASE_SYSTEM)";
			button -width 50 -height 20
				-annotation "select all created objects - for delete"
				-backgroundColor 0.800000011921 0.699999988079 0.799000024796 -label "all sys" -recomputeSize true
				-command "SW_194c7b09c27128a45486ac17560c7a25($BARN_curve_sword_remember_DELETE_AFTER_BAKE)";
			button -width 40 -height 20
				-annotation "delete selected"
				-backgroundColor 0.5 0.5 0.5 -label "delete" -recomputeSize true
				-command "doDelete";
separator -parent "columnLayout1_ui" -enable false -height 3 -style "none" -horizontal true;
separator -parent "columnLayout1_ui" -enable true -height 1 -visible true
				-backgroundColor 0.671000003815 0.671000003815 0.671000003815 -style "none" -horizontal true;
rowLayout -parent "columnLayout1_ui"
				-backgroundColor 0.850000023842 0.850000023842 0.800000011921 -numberOfColumns 2 -columnAlign 1 left -columnAlign 2 right -adjustableColumn 1;
text
				-backgroundColor 0.850000023842 0.839999973774 0.800000011921 -label "make path curve" -align "center" -recomputeSize false;
button -height 15
				-backgroundColor 0.913999974728 0.768999993801 0.782999992371 -enableBackground true -label "?" -recomputeSize true
			-c "SW_27a3aeea33f2574ca7ae454bf2a971ed($sword_help_path + \"help_path_polish.mel\", \"path polish help\")";
separator -parent "columnLayout1_ui" -enable true -height 1 -visible true
				-backgroundColor 0.56099998951 0.56099998951 0.56099998951 -style "none" -horizontal true;
separator -parent "columnLayout1_ui" -enable false -height 5 -visible true -style "doubleDash" -horizontal true;
		columnLayout -parent "columnLayout1_ui" -adjustableColumn true "make_path_curve_ui";
		rowLayout -numberOfColumns 5 -columnWidth 1 30 -columnWidth 2 17 -columnWidth 3 80 -adjustableColumn 4 "rowLayout3_ui";
			intField -width 30 -height 30
				-backgroundColor 0.778500020504 0.7799000144 0.737800002098 -value 3 -minValue 2 -maxValue 20 -step 1 -editable true "path_curve_controls_size_ui";
			columnLayout -adjustableColumn true -rowSpacing 2;
			button -width 14 -height 14 -label "+"
				-command " intField  -e -v (`intField -q -v path_curve_controls_size_ui` + 1) path_curve_controls_size_ui";
			button -width 14 -height 14 -label "-"
				-command "intField  -e -v (`intField -q -v path_curve_controls_size_ui` - 1) path_curve_controls_size_ui";
			text -parent "rowLayout3_ui" -label "< ctrl number";
			checkBox -parent "rowLayout3_ui"
				-annotation "show source path of object" -enableBackground false -label "show source" "bake_anim_to_cuve_ui";
			rowLayout -parent "rowLayout3_ui" -numberOfColumns 2;
			button -width 80 -height 43
				-annotation "select a TimeRange or Keys. The movement of the selected object will be transferred to the smoothed curve"
				-backgroundColor 0.990000009537 0.889999985695 0.776000022888
					-label "arc polish"
				-command "SW_692e2fda85cadfdf0f28e93323f58c08; catch (SW_216cd5229394f893f58516bc1517892a(`intField -q -v path_curve_controls_size_ui`, `checkBox -q -v bake_anim_to_cuve_ui`)); SW_f4b1a2b52ab1771321003f86cde63160" "buttn_path_ui";
			columnLayout -width 15 -adjustableColumn true -rowSpacing 1;
			button -width 13 -height 13
				-annotation "quick select SOURCE object"
				-backgroundColor 0.889999985695 0.481489986181 0.481489986181 -label "1"
				-command "SW_194c7b09c27128a45486ac17560c7a25($BARN_curve_motion_path_remember1)";
			button -width 13 -height 13
				-annotation "quick select on CURVE locator"
				-backgroundColor 0.377552986145 0.672999978065 0.377552986145 -label "2"
				-command "SW_194c7b09c27128a45486ac17560c7a25($BARN_curve_motion_path_remember2)";
			button -width 13 -height 13
				-annotation "quick select all system - usually for deleting after bake source object"
				-backgroundColor 0.548765957355 0.548765957355 0.773999989033 -label "3"
				-command "SW_194c7b09c27128a45486ac17560c7a25($BARN_curve_motion_path_remember3)";
separator -parent "columnLayout1_ui" -enable false -height 3 -style "none" -horizontal true;
separator -parent "columnLayout1_ui" -enable true -height 1 -visible true
				-backgroundColor 0.671000003815 0.671000003815 0.671000003815 -style "none" -horizontal true;
rowLayout -parent "columnLayout1_ui"
				-backgroundColor 0.850000023842 0.850000023842 0.800000011921 -numberOfColumns 2 -columnAlign 1 left -columnAlign 2 right -adjustableColumn 1;
text
				-backgroundColor 0.850000023842 0.839999973774 0.800000011921 -label "fast bake selected" -align "center" -recomputeSize false;
button -height 15
				-backgroundColor 0.913999974728 0.768999993801 0.782999992371 -enableBackground true -label "?" -recomputeSize true
			-c "SW_27a3aeea33f2574ca7ae454bf2a971ed($sword_help_path + \"help_bake.mel\", \"bake help\")";
separator -parent "columnLayout1_ui" -enable true -height 1 -visible true
				-backgroundColor 0.56099998951 0.56099998951 0.56099998951 -style "none" -horizontal true;
separator -parent "columnLayout1_ui" -enable false -height 2 -visible true -style "doubleDash" -horizontal true;
		rowLayout -parent "columnLayout1_ui" -height 42 -numberOfColumns 4 -columnWidth 1 115 -columnWidth 2 115 -columnAlign 1 left -columnAlign 2 left -columnAlign 3 right "bake_row_ui";
		button -width 90 -height 30
				-annotation "fast bake selected"
				-backgroundColor 0.990999996662 0.889999985695 0.776000022888 -label "bake"
				-command "SW_692e2fda85cadfdf0f28e93323f58c08;SW_de88efca2929f0080ae1d45ff5db42d4;SW_09f1edc0a69a4931b08e1bcc40e94a55;SW_f4b1a2b52ab1771321003f86cde63160";
		button -width 90 -height 30
				-annotation "fast bake selected to override layer"
				-backgroundColor 0.990999996662 0.889999985695 0.776000022888 -label "layer bake"
				-command "SW_692e2fda85cadfdf0f28e93323f58c08;SW_c830bbb3bb6041f72a5fb76403fcabe8();SW_09f1edc0a69a4931b08e1bcc40e94a55;SW_f4b1a2b52ab1771321003f86cde63160";
		button -width 60 -height 30
				-annotation "update all motion trails"  -label "MT update"
				-command "SW_9b29b86e5de4ada4b19840df4e8973d5";
		button -width 20 -height 25
				-annotation "show display if something doing wrong" -label "VP"
				-command "SW_f4b1a2b52ab1771321003f86cde63160";
	separator -parent "columnLayout1_ui" -enable true -height 1 -visible true
				-backgroundColor 0.512694001198 0.540614962578 0.546000003815 -style "none" -horizontal true;
	text -parent "columnLayout1_ui" -height 16
				-backgroundColor 0.624455034733 0.720480024815 0.739000022411 -label " (c) Pavel Barnev     pavel_barnev2000@mail.ru" -align "right" -font "smallObliqueLabelFont";
	window -e -w 324 -h 282 "sword_anim_polish_window_ui";
	showWindow "sword_anim_polish_window_ui";
}
global proc SW_692e2fda85cadfdf0f28e93323f58c08()
{
	global float $startTime;
	global string $my_eval_mode[];
	float $mayaVersion;
	global string $gMainPane;
	$startTime = `timerX`;
	refresh -su 1;
	setTimeSliderVisible 0;
	$mayaVersion = `getApplicationVersionAsFloat` ;
	if ($mayaVersion>=2016)
	{
		$my_eval_mode=`evaluationManager -q -mode`;
		evaluationManager -mode "off";
	}
}
global proc SW_f4b1a2b52ab1771321003f86cde63160()
{
	global float $startTime;
	global string $my_eval_mode[];
	global string $gMainPane;
	float $mayaVersion;
	$totalTime = `timerX -startTime $startTime`;
	print ("Total Time: "+$totalTime+"\n");
	refresh -su 0;
	setTimeSliderVisible 1;
	$mayaVersion = `getApplicationVersionAsFloat` ;
	if ($mayaVersion>=2016)
	{
		evaluationManager -mode $my_eval_mode[0];
	}
}
global proc string SW_c830bbb3bb6041f72a5fb76403fcabe8()
{
    $selection=`ls-sl`;
    $mayaVersion = `getApplicationVersionAsFloat` ;
    string $eval_mode[];
    if ($mayaVersion>=2016)
    {
        $eval_mode=`evaluationManager -q -mode`;
		if($eval_mode[0]!="off")
			evaluationManager -mode "off";
    }
    $min=`playbackOptions -q -ast`;
    $max=`playbackOptions -q -aet`;
    string $lay=`animLayer -override 1  "BakedAnim"`;
    $its_baked=catch (`bakeResults -sm 1 -s false -t ($min+":"+$max) -dl $lay  -minimizeRotation true  $selection`) ;
    if ($mayaVersion>=2016)
    {
		if($eval_mode[0]!="off")
			evaluationManager -mode $eval_mode[0];
    }
    if($its_baked)
    {
        warning "select something!";
    }
    select  $selection;
    return  $lay;
}
global proc SW_de88efca2929f0080ae1d45ff5db42d4()
{
	$selection=`ls-sl`;
    $mayaVersion = `getApplicationVersionAsFloat` ;
    string $eval_mode[];
    if ($mayaVersion>=2016)
    {
        $eval_mode=`evaluationManager -q -mode`;
		if($eval_mode[0]!="off")
			evaluationManager -mode "off";
    }
    $min=`playbackOptions -q -ast`;
    $max=`playbackOptions -q -aet`;
    $its_baked=catchQuiet (`bakeResults -sm 1 -s false -t ($min+":"+$max) $selection`);
	if ($mayaVersion>=2016)
    {
		if($eval_mode[0]!="off")
			evaluationManager -mode $eval_mode[0];
    }
    if($its_baked)
    {
        warning "select something!";
    }
}
global proc SW_09f1edc0a69a4931b08e1bcc40e94a55()
{
	$selected= `ls -sl`;
	if(size($selected)==0)
	{
		warning "select something!!!!";
		return;
	}
	string $crvs[] = `keyframe -q -n`;
	float $statTime[] = `keyframe -index 0 -q -tc $crvs`;
	$statTime=`sort $statTime`;
	$null_frame = $statTime[0] - 10;
	setKeyframe -v 0 -t $null_frame $selected.rx $selected.ry $selected.rz;
	filterCurve $selected.rotateX $selected.rotateY $selected.rotateZ;
	cutKey -t $null_frame $selected.rx $selected.ry $selected.rz;
}
global proc string[] SW_194c7b09c27128a45486ac17560c7a25(string $objs[])
{
	string $new_selected[];
	$j=0;
	for($i=0;$i<size($objs);$i++)
	{
		if( `objExists $objs[$i]` )
		{
			$new_selected[$j] = $objs[$i];
			$j++;
		}
	}
	select -r $new_selected;
	return $new_selected;
}
