// SWORD anim polish tool
// Author: Pavel Barnev pavel_barnev2000@mail.ru
// Installation:
// Quick Installation:
    // unzip the file into a directory of choice
    // Start Maya.
    // Drag file:
	// Drag_and_Drop_to_install.mel
	// into a MAYA window. The script icon will appear on current tab on the Shelf Editor
// This tool is for:
	// polishing weapon animation (sword, axe, spear etc..)
	// 1. 	correction of the trajectory of the weapon even if it moves inside the hand
			// At the same time, movement relative to the wrist is maintained
	// 2. 	fixing and animating the situation when the weapon sticks into an object or into the ground
	// 3. 	working with two-handed weapons
	// 4. 	interaction of weapons - and not only them - with other objects
	// 6.	powerful tool for correcting arc paths - Arc polish tool
	// 5. 	and much more
// Best way to use tool:
	// 1.	sketch out the animation with the weapon.
	// 2.	the main thing is to get an overall good sketch of the movement.
	// 3.	Ignore the inaccuracies of weapon animations
	// 4.	after that - use these tools to bring the weapon to perfection
// sword_anim_polish_tool
global proc sword_anim_polish_tool(string $script_path)
{
	catchQuiet(`loadPlugin matrixNodes`);
	catchQuiet(`pluginInfo -edit -autoload true matrixNodes`);
	global string $BARN_curve_motion_path_remember1[];
	global string $BARN_curve_motion_path_remember2[];
	global string $BARN_curve_motion_path_remember3[];
	global string $BARN_curve_sword_remember_SOURCE[];
	global string $BARN_curve_sword_remember_AIM_TOP[];
	global string $BARN_curve_sword_remember_AIM_SIDE[];
	global string $BARN_curve_sword_remember_BASE_SYSTEM[];
	global string $BARN_curve_sword_remember_DELETE_AFTER_BAKE[];
	global string $sword_help_path;
	 $sword_help_path=$script_path + "/misc/";
	if(`window -query -exists "sword_anim_polish_window_ui"`)deleteUI("sword_anim_polish_window_ui");
	window -title "sword anim polishing" -sizeable 0 -titleBar true -minimizeButton false -maximizeButton false -menuBar false -toolbox true -titleBarMenu true -widthHeight 221 270 "sword_anim_polish_window_ui";
	columnLayout
				-backgroundColor 0.699999988079 0.75 0.7799000144 -adjustableColumn true "columnLayout1_ui";
separator -enable false -height 3
				-backgroundColor 0.864913463593 0.758615970612 0.758616030216 -style "none" -horizontal true;
separator -enable true -height 1 -visible true
				-backgroundColor 0.671000003815 0.671000003815 0.671000003815 -style "none" -horizontal true;
rowLayout
				-backgroundColor 0.850000023842 0.850000023842 0.800000011921 -numberOfColumns 3 -columnAlign 1 left -columnAlign 2 right -adjustableColumn 1;
text
				-backgroundColor 0.850000023842 0.839999973774 0.800000011921 -label "sword animation > to system" -align "center" -recomputeSize false;
button -height 15
				-backgroundColor 0.913999974728 0.768999993801 0.782999992371
		-enableBackground true -label "?" -recomputeSize true
		-c "SW_27a3aeea33f2574ca7ae454bf2a971ed($sword_help_path + \"help_parent_make_aim_tools.mel\", \"base tools help\")";
button -height 15
				-backgroundColor 0.913999974728 0.768999993801 0.782999992371
		-enableBackground true -label "?" -recomputeSize true
		-c "SW_27a3aeea33f2574ca7ae454bf2a971ed($sword_help_path + \"help_sword_reverse_tools.mel\", \"base tools help\")";
separator -parent "columnLayout1_ui" -enable true -height 1 -visible true
				-backgroundColor 0.56099998951 0.56099998951 0.56099998951 -style "none" -horizontal true;
separator -parent "columnLayout1_ui" -enable false -height 8 -visible true -style "doubleDash" -horizontal true;
int $clmn_w=70;
int $clmn_sp=15;
		rowColumnLayout -parent "columnLayout1_ui" -visible true -preventOverride false -numberOfColumns 4 -columnWidth 1 $clmn_w -columnWidth 2 $clmn_w -columnWidth 3 $clmn_w -columnWidth 4 $clmn_w -columnSpacing 2  $clmn_sp -columnSpacing 3  $clmn_sp -columnSpacing 4  $clmn_sp;
		button -height 40
				-annotation "select object. the animation will be baked inside the last selected object"
				-backgroundColor 0.990999996662 0.889999985695 0.776000022888
				-label "parent In"
				-command " SW_692e2fda85cadfdf0f28e93323f58c08; SW_cf01bdffb1989adef0d5abffde9c5a33(1);SW_09f1edc0a69a4931b08e1bcc40e94a55; SW_f4b1a2b52ab1771321003f86cde63160; " "SW_cf01bdffb1989adef0d5abffde9c5a33_ui";
		button -height 40
				-annotation "select object. After press button. Move created locators to the sides TOP (usually edge of sword) and SIDE (usually blade of sword). Then click the mouse into the void (deselect all)"
				-backgroundColor 0.990999996662 0.889999985695 0.776000022888 -label "make aim"
				-command "SW_6cbceab3c5b6c616d252d08ce5624f3b(1)" "aim_ui";
		button -height 40
				-annotation "select SWORD control and HAND control . After press button. Move 2 created locators to the sides TOP (usually edge of sword) and SIDE (usually blade of sword). Then click the mouse into the void (deselect all)"
				-backgroundColor 0.990999996662 0.889999985695 0.776000022888 -label "make sword"
				-command "SW_51ef5f996bc4f51959ade4cf9878f9b3" "sword_ui";
		button -height 40
				-annotation "select SWORD control and HAND control . After press button. Move 3 created locators to the PIVOT position, then sides TOP (usually edge of sword) and SIDE (usually blade of sword). Then click the mouse into the void (deselect all)"
				-backgroundColor 0.990999996662 0.889999985695 0.776000022888 -label "make reverse"
				-command "SW_0f6b87b682f999b1ba225892b54147c2(1)" "reverse_ui";
separator -parent "columnLayout1_ui" -enable false -height 8 -style "none" -horizontal true;
separator -parent "columnLayout1_ui" -enable true -height 1 -visible true
				-backgroundColor 0.671000003815 0.671000003815 0.671000003815 -style "none" -horizontal true;
rowLayout -parent "columnLayout1_ui"
				-backgroundColor 0.850000023842 0.850000023842 0.800000011921 -numberOfColumns 1 -adjustableColumn 1;
text
				-backgroundColor 0.850000023842 0.839999973774 0.800000011921 -label "quick selection last applied system" -align "center" -recomputeSize false;
separator -parent "columnLayout1_ui" -enable true -height 1 -visible true
				-backgroundColor 0.56099998951 0.56099998951 0.56099998951 -style "none" -horizontal true;
separator -parent "columnLayout1_ui" -enable true -height 2 -visible true -style "none";
		rowLayout -parent "columnLayout1_ui" -width 320 -numberOfColumns 6 -columnWidth 1 52 -columnWidth 2 52 -columnWidth 3 52 -columnWidth 4 52 -columnWidth 5 60 -columnAlign 6 right "fast_selection_row_ui";
			button -width 50 -height 20 -preventOverride false
				-annotation "select source controls - need for bake"
				-backgroundColor 0.800000011921 0.699999988079 0.699999988079 -label "source" -recomputeSize true
				-command "SW_194c7b09c27128a45486ac17560c7a25($BARN_curve_sword_remember_SOURCE)";
			button -width 50 -height 20
				-annotation "select aim top locator"
				-backgroundColor 0.699999988079 0.800000011921 0.699999988079 -label "aim top" -recomputeSize true
				-command "SW_194c7b09c27128a45486ac17560c7a25($BARN_curve_sword_remember_AIM_TOP)";
			button -width 50 -height 20
				-annotation "select aim side locator"
				-backgroundColor 0.699999988079 0.699999988079 0.800000011921 -label "aim side" -recomputeSize true
