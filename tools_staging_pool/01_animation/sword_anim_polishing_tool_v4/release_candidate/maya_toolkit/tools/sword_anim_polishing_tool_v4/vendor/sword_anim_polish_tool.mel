global proc vector SW_e3bea614176fbceebe7c7aae67e953b0(vector $coords[])
{
	int $num = `size $coords`;
	vector $ff;
	for ($each in $coords)
	    $ff+=$each;
	$ff=($ff/$num);
	return $ff;
}
