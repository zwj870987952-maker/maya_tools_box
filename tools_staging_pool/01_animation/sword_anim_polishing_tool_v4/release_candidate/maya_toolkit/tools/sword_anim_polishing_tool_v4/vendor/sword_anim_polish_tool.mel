	{
		warning "need 2 object or points";
		return "";
	}
	for ($i=0;$i<size($coords);$i++)
	{
		$pnt= $pnt + " -p " + $coords[$i];
	}
	$curve_name=`eval("curve" + $pnt + "-d " + $interp)`;
	return $curve_name;
}
global proc SW_2e50fb684e35f7dc58ab390d98530944(float $color[])
