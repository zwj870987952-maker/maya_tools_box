		aimConstraint -mo -weight 1 -aimVector 1 0 0 -upVector 0 1 0 -worldUpType "object" -worldUpObject $select_loc_side[$int_i];
	}
	select $select_loc_top $select_loc_side;
	string $aims_lock_to_return[];
