global proc string SW_7b95c992be7b036735f7298f89ab9556(string $object,string $curve_name, float $framerange[], string $curve_movement_loc, int $bake_anim)
{
    undoInfo  -ock -cn "curve_motion_path";
	if( ($framerange[1]- $framerange[0])==1)
	{
		$framerange[0]=`playbackOptions -q -ast`;
		$framerange[1]=(`playbackOptions -q -aet`) + 1;
	}
	string $m_path=`pathAnimation -fractionMode 0 -follow true -followAxis x -upAxis z -worldUpType "scene" -inverseUp false -inverseFront false -bank false -startTimeU $framerange[0] -endTimeU ($framerange[1]-1) $curve_name $curve_movement_loc`;
	if($bake_anim)
	{
		string $near_point_on_crve_node=`createNode nearestPointOnCurve`;
		string $decompose_matrix_node=`createNode decomposeMatrix`;
		connectAttr -f ($object + ".worldMatrix[0]") ($decompose_matrix_node + ".inputMatrix");
		connectAttr -f ($decompose_matrix_node + ".outputTranslate") ($near_point_on_crve_node + ".inPosition");
		string $crve_shape[]=SW_5e702211108f11813c411c94f8b1b380($curve_name);
		connectAttr -f ($crve_shape[0] + ".worldSpace[0]")  ($near_point_on_crve_node + ".inputCurve");
		select $m_path;
		int $j=0;
		float $U_V_param[];
		for($i=$framerange[0]; $i<$framerange[1];$i++)
		{
			currentTime $i;
			$U_V_param[$j]=getAttr ($near_point_on_crve_node + ".parameter");
			setKeyframe  -v $U_V_param[$j] -t $i ($m_path + ".uValue");
			keyframe -e -vc $U_V_param[$j]  -t $i ($m_path + "_uValue");
			$j++;
		}
		keyTangent -itt spline -ott spline $m_path;
		delete $near_point_on_crve_node $decompose_matrix_node;
	}
    string $find_double_linear[]=`listConnections  -d 1 -s 0 -scn 1 -type "addDoubleLinear"  $curve_movement_loc `;
    connectAttr -f ($m_path + ".allCoordinates") ($curve_movement_loc + ".translate");
    delete $find_double_linear;
	return $m_path;
}
global proc float[] SW_cba6da1b519f7600c71b7de0d52d2c3e()
{
	float $num_frame[] = `keyframe -q  -sl`;
	$num_frame=`sort  $num_frame`;
	if(size($num_frame)==0)
	{
		warning "no interval selected" ;
		return {0,0};
	}
	return {$num_frame[0], $num_frame[size($num_frame)-1]};
}
global proc string[] SW_f2d5a2798ed7cfee36eb77ee8a281ed8()
{
	string $selection[];
	$selection_true = `ls -fl -sl `;
	$selection = `ls -fl -os`;
	string $locators[];
	string $b[];
	select -cl;
	float $getPvPos[];
	if (size ($selection)>0)
	{
	    $j=0;
	    for($obj in $selection)
	    {
            $getPvPos=SW_8598296823aa3af15686cb0d78f1615d($obj);
            $b[0]=`joint`;
            $locators[$j]=$b[0];
            xform -ws -t $getPvPos[0] $getPvPos[1] $getPvPos[2] $b[0];
            rotate -ws $getPvPos[3] $getPvPos[4] $getPvPos[5]  $b[0];
            $j++;
		}
		for($obj in $locators)
		{
		    select -add $obj;
		}
	}
	else
	{
		$locators[0] =`joint -p 0 0 0`;
	}
	select -cl;
	select $locators;
	return $locators;
}
global proc SW_d68451d42d330e385dd0c090bd6877a0(string $prefix)
{
	$objs = `ls -l -selection`;
	string $clear_name[];
	string $buffer[];
	int $ff;
	for($k=0;$k<size($objs);$k++)
	{
		string $curr_obj=$objs[$k];
		tokenize  $curr_obj "|" $buffer;
		$clear_name[$k]=$buffer[size($buffer)-1];
	}
	string $name;
	for($i=0;$i<size($objs);$i++)
	{
		$name=($prefix + $clear_name[$i]);
		rename $objs[$i] $name;
		$objs = `ls -l -selection`;
	}
}
global proc SW_1f3f21e017b74355329202016bf1b177()
{
	for($objs in `ls-sl`)
	{
		setAttr -lock true ($objs + ".translateX");
		setAttr -lock true ($objs + ".translateY");
		setAttr -lock true ($objs + ".translateZ");
	}
}
global proc SW_92de112c5c170c44ad9daf4d48b1acdd(float $rad)
{
	$objs = `ls-sl`;
	for($i=0;$i<size($objs);$i++)
		catchQuiet (`setAttr ($objs[$i] + ".radius") $rad`);
}
global proc SW_15760bd5ac6225f582185bab24346a67(float $subScale)
{
	float $dist=50;
	$sel=`ls-head 1 -sl`;
	string $camera_name="";
	float $camera_scale=1;
	catchQuiet( $camera_name= SW_20a28b95c1b8b4dd29397ab332dbc667());
	catchQuiet( $camera_scale=`getAttr ($camera_name + ".cameraScale")`);
	catchQuiet($dist=SW_c7822f1f10b007a6803735c105e40799($sel[0], $camera_name));
	catchQuiet( $camera_ortograf=`getAttr ($camera_name + ".orthographic")`);
	catchQuiet( $camera_orthographicWidth=`getAttr ($camera_name + ".orthographicWidth")`);
	if(!$camera_ortograf)
	    catchQuiet(SW_92de112c5c170c44ad9daf4d48b1acdd (($dist/25)*$subScale* (1/`jointDisplayScale -q`)*$camera_scale));
	else
	    catchQuiet(SW_92de112c5c170c44ad9daf4d48b1acdd (($camera_orthographicWidth/25)*$subScale* (1/`jointDisplayScale -q`)*$camera_scale));
}
global proc string SW_e0b44e5f427a869b704a743cf1d3614c()
{
	$obj=`ls-sl`;
	string $name_of_constrain[];
	$tx_lock=`getAttr -lock ($obj[1] + ".tx")`;
	$ty_lock=`getAttr -lock ($obj[1] + ".ty")`;
	$tz_lock=`getAttr -lock ($obj[1] + ".tz")`;
	$h=$tx_lock+$ty_lock+$tz_lock;
	if ($h<3)
	{
		$skipX= "";
		$skipY= "";
		$skipZ= "";
		if($tx_lock)
			$skipX= " -skip x";
		if($ty_lock)
			$skipY= " -skip y";
		if($tz_lock)
			$skipZ= " -skip z";
		$skipped = $skipX + $skipY + $skipZ;
		string $objects = "";
		for($i=0;$i<size($obj);$i++)
		{
			$objects = $objects + $obj[$i] + " ";
		}
			$name_of_constrain=`eval ("pointConstraint  " + $skipped + " " + $objects)`;
	}
	return  $name_of_constrain[0];
}
global proc string SW_dfb2ed0c2c53945ca7515c674763faa0()
{
	$obj=`ls-sl`;
	string $tmp_constr[];
	$rx_lock=`getAttr -lock ($obj[(size($obj)-1)] + ".rx")`;
	$ry_lock=`getAttr -lock ($obj[(size($obj)-1)] + ".ry")`;
	$rz_lock=`getAttr -lock ($obj[(size($obj)-1)] + ".rz")`;
	$h=$rx_lock+$ry_lock+$rz_lock;
	if ($h<3)
	{
		$skipX= "";
		$skipY= "";
		$skipZ= "";
		if($rx_lock)
			$skipX= " -skip x";
		if($ry_lock)
			$skipY= " -skip y";
		if($rz_lock)
			$skipZ= " -skip z";
		string $objects = "";
		$skipped = $skipX + $skipY + $skipZ;
		for($i=0;$i<size($obj);$i++)
		{
			$objects = $objects + $obj[$i] + " ";
		}
		$tmp_constr=`eval ("orientConstraint -mo " + $skipped + " " + $objects)`;
	}
	return $tmp_constr[0];
}
global proc string SW_3ed0416e2547f09f133c132ecd5ccd97()
{
	$obj=`ls-sl`;
	string $ret_name;
	string $name_of_constrain[];
	$weight_all=SW_9de233870ac6b9c5087a491c3b4ca38a($obj);
	$rx_lock=`getAttr -lock ($obj[(size($obj)-1)] + ".rx")`;
	$ry_lock=`getAttr -lock ($obj[(size($obj)-1)] + ".ry")`;
	$rz_lock=`getAttr -lock ($obj[(size($obj)-1)] + ".rz")`;
	$tx_lock=`getAttr -lock ($obj[(size($obj)-1)] + ".tx")`;
	$ty_lock=`getAttr -lock ($obj[(size($obj)-1)] + ".ty")`;
	$tz_lock=`getAttr -lock ($obj[(size($obj)-1)] + ".tz")`;
	$h=$rx_lock+$ry_lock+$rz_lock+$tx_lock+$ty_lock+$tz_lock;
	if ($h<6)
	{
		$skipTX= "";
		$skipTY= "";
		$skipTZ= "";
		$skipRX= "";
		$skipRY= "";
		$skipRZ= "";
		if($tx_lock)
			$skipTX= " -st x";
		if($ty_lock)
			$skipTY= " -st y";
		if($tz_lock)
			$skipTZ= " -st z";
		if($rx_lock)
			$skipRX= " -sr x";
		if($ry_lock)
			$skipRY= " -sr y";
		if($rz_lock)
			$skipRZ= " -sr z";
		$skipped = $skipTX + $skipTY + $skipTZ + $skipRX + $skipRY + $skipRZ;
		string $objects = "";
		for($i=0;$i<size($obj);$i++)
		{
			$objects = $objects + $obj[$i] + " ";
		}
		$name_of_constrain=`eval ("parentConstraint -mo " + $skipped + " " + $objects)`;
		for($i=0;$i<(size($obj)-1);$i++)
		{
			$attr_name=`listAttr -string ("*W" + $i) $name_of_constrain[0]`;
			catch (`setAttr ($name_of_constrain[0] + "." +  $attr_name[0]) $weight_all[$i]`);
		}
	}
		$ret_name=$name_of_constrain[0];
		return $ret_name;
}
global proc string SW_29a2189faa1ce9571a1184989dc7f462()
{
	string $tmp[];
	string $locs[]=`ls -sl`;
	select -r $locs[0];
	select -add $locs[2];
	$tmp=`aimConstraint -mo -weight 1 -aimVector 0 1 0 -upVector 0 0 1 -worldUpType "object" -worldUpObject $locs[1]`;
	return $tmp[0];
}
global proc float[] SW_9de233870ac6b9c5087a491c3b4ca38a(string $objects[])
{
	float $distanse_all[];
	float $distanse_all_normalized[];
	float $weight_all[];
	float $getPvPos[];
    $getPvPos=SW_174b5e03acbe9a8ba7bf83b031094a2e( $objects[size($objects)-1]);
	vector $end_point = <<$getPvPos[0], $getPvPos[1], $getPvPos[2]>>;
	for($i=0;$i<(size($objects)-1);$i++)
	{
        $getPvPos=SW_174b5e03acbe9a8ba7bf83b031094a2e($objects[$i]);
		vector $start_point = <<$getPvPos[0], $getPvPos[1], $getPvPos[2]>>;
		$distanse_all[$i]=mag($start_point - $end_point);
	}
	$sort_dist=`sort $distanse_all`;
	float $max_dist = $sort_dist[size($sort_dist)-1];
	float $min_dist = $sort_dist[0];
	if($min_dist>0)
	{
		for($i=0;$i<size($distanse_all);$i++)
		{
		$distanse_all_normalized[$i]=$distanse_all[$i]/$max_dist;
		$weight_all[$i]=1/$distanse_all_normalized[$i] ;
		}
	}
	else
	{
		for($i=0;$i<size($distanse_all);$i++)
		{
			if($distanse_all[$i])
			{
			$weight_all[$i]=0;
			}
			else
			{
			$weight_all[$i]=1;
			}
		}
	}
	float $summ=0;
	for($obj in $weight_all)
	    $summ+=$obj;
	float $weight_all_normi[];
	for($i=0;$i<size($weight_all);$i++)
	{
	    $weight_all_normi[$i]=$weight_all[$i]/$summ;
	}
	return $weight_all_normi;
}
global proc float[] SW_174b5e03acbe9a8ba7bf83b031094a2e(string $object)
{
    float $getPvPos[];
    float $getPvRot[];
    string $obj_selected_shape[];
    string $obj_selected[];
		if ((`objectType -isType "mesh" $object`)+(`objectType -isType "nurbsSurface" $object`)+(`objectType -isType "nurbsCurve" $object`))
			{
				$getPvPos=`pointPosition -world $object`;
                $obj_selected_shape = `listRelatives -f -p  $object`;
                $obj_selected = `listRelatives -f -p $obj_selected_shape`;
                $getPvRot = `xform -q -ro -ws $obj_selected[0]`;
			}
			else
			{
				$getPvPos = `xform -q -ws -piv $object`;
                $getPvRot = `xform -q -ro -ws $object`;
			}
	$getPvPos[3]=$getPvRot[0];
	$getPvPos[4]=$getPvRot[1];
	$getPvPos[5]=$getPvRot[2];
	return $getPvPos;
}