global proc string[] SW_e706e982298fe9e8f94ae04b06b5d6b2(string $prefix)
{
	string $objs[] = `ls -selection`;
	$j=0;
		for($i=0;$i<size($objs);$i++)
		{
			while (`objExists ($prefix + $j)`)
			{
				$j++;
			}
		rename $objs[$i]($prefix + $j);
		$objs = `ls -selection`;
		}
	return $objs;
}
