global proc SW_6cbceab3c5b6c616d252d08ce5624f3b(float $size_lock)
{
	global string $BARN_curve_sword_remember_SOURCE[];
	clear $BARN_curve_sword_remember_SOURCE;
	global string $BARN_curve_sword_remember_AIM_TOP[];
	clear	$BARN_curve_sword_remember_AIM_TOP;
	global string $BARN_curve_sword_remember_AIM_SIDE[];
	clear $BARN_curve_sword_remember_AIM_SIDE;
	global string $BARN_curve_sword_remember_BASE_SYSTEM[];
	clear	$BARN_curve_sword_remember_BASE_SYSTEM;
	global string $BARN_curve_sword_remember_DELETE_AFTER_BAKE[];
	clear	$BARN_curve_sword_remember_DELETE_AFTER_BAKE;
	$BARN_curve_sword_remember_SOURCE=`ls-sl`;
    manipMoveContext -edit -mode 0 Move;
    setToolTo moveSuperContext;
    string $aims[]=SW_c642429ed9a3aabf65a66eefcd97bfbb();
	SW_2e50fb684e35f7dc58ab390d98530944({0.45, 0.7, 0.45});
    $selected=`ls-sl`;
    select $aims;
    SW_6de8028af587b467034457b4d6349f89($size_lock);
    select -cl;
    select $selected;
    $BARN_curve_sword_remember_AIM_TOP=`ls -head(size($aims)/2) $aims`;
    $BARN_curve_sword_remember_AIM_SIDE=`ls -tail(size($aims)/2) $aims`;
    $BARN_curve_sword_remember_DELETE_AFTER_BAKE=$aims;
    scriptJob -ro 1 -cf "SomethingSelected" " SW_692e2fda85cadfdf0f28e93323f58c08; SW_10df34add5a583f84d24608e860c1b4b() ; SW_f4b1a2b52ab1771321003f86cde63160;";
}
global proc string[] SW_cf01bdffb1989adef0d5abffde9c5a33(float $lock_size)
{
    global string $BARN_curve_sword_remember_SOURCE[];
    clear $BARN_curve_sword_remember_SOURCE;
    global string $BARN_curve_sword_remember_BASE_SYSTEM[];
    clear	$BARN_curve_sword_remember_BASE_SYSTEM;
    global string $BARN_curve_sword_remember_DELETE_AFTER_BAKE[];
    clear	$BARN_curve_sword_remember_DELETE_AFTER_BAKE;
    $selected=`ls-sl`;
    if(!size($selected))
    {
        warning "select something!!!!";
        return {};
    }
    SW_ac692345fba3e827ad5d6e26de39ba07;
    $BARN_curve_sword_remember_SOURCE=$selected;
    $locators=SW_54d92f8424c4459e6d996d9fd93902f0();
    $BARN_curve_sword_remember_DELETE_AFTER_BAKE=$locators;
    $constr=SW_17431451b1be026fdeee93b86579c6b6($selected, $locators);
    SW_3323b46f97bc12510f86536ae21ff525;
    catchQuiet(`parent`);
    SW_cc20e95399a3b6da44eb78e45451d764(22);
    select $locators;
    SW_6de8028af587b467034457b4d6349f89($lock_size);
    SW_c89bf830cdb2b9cc874e6c8604e8b257;
    SW_de88efca2929f0080ae1d45ff5db42d4;
    delete $constr;
    SW_17431451b1be026fdeee93b86579c6b6($locators, $selected);
    select $locators[size ($locators)-1];
    SW_cc20e95399a3b6da44eb78e45451d764(13);
    SW_5fce4865a9fd47748e6796c1be9d64b2;
    $BARN_curve_sword_remember_BASE_SYSTEM=`ls-sl`;
    return $locators;
}
global proc SW_9b29b86e5de4ada4b19840df4e8973d5()
{
	$Names = `ls -sl`;
	$mt=`ls "motionTrail*"`;
	if(size($mt))
	{
		catchQuiet (`select $mt`);
		updateMotionTrail;
		select $Names;
	}
	else
		warning "No motion trails in scene";
}
global proc  SW_51ef5f996bc4f51959ade4cf9878f9b3()
{
    manipMoveContext -edit -mode 0 Move;
    setToolTo moveSuperContext;
	global string $BARN_curve_sword_remember_SOURCE[];
	clear $BARN_curve_sword_remember_SOURCE;
