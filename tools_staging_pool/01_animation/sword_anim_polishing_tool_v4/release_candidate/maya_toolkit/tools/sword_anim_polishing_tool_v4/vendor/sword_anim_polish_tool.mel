	$aim_lock_to_return=`ls-sl`;
	SW_29941243f77aa0343e79460d48136072 (20);
	select -r $select_loc_top;
	print("done.\n");
	return  $aim_lock_to_return;
}
global proc string[] SW_cfc20aa23531f881688ec3a171beaae5(string $m_path)
{
    string $connected_items_by_group[] =`listConnections  -d 1 $m_path`;
    string $buffer[];
    string $markers[];
    $j=0;
    for( $k = 0; $k <size($connected_items_by_group);$k++)
    {
        if(`gmatch $connected_items_by_group[$k] "*positionMarker*"`)
        {
            $markers[$j]=$connected_items_by_group[$k];
            $j++;
        }
    }
    string $obj;
    string $markers_all[];
    $j=0;
    for ($obj in $markers)
    {
        tokenize $obj "->" $buffer;
        $markers_all[$j]=$buffer[1];
        $j++;
    }
    return $markers_all;
}
