	cutKey -cl -t ":" -f ":" -at "rx" -at "ry" -at "rz" $aims_lock_to_return;
	rotate -a 0 0 0 $aims_lock_to_return;
	SW_ef6700cd4efa166b5d6bde47732f420a;
	select -cl;
	select  $select_loc_top;
	return $aims_lock_to_return;
}
global proc string [] SW_c642429ed9a3aabf65a66eefcd97bfbb ()
{
	string $select[] = `ls -sl -l`;
	SW_ac692345fba3e827ad5d6e26de39ba07;
	global string $select_joint[];
	clear($select_joint);
	global string $loc_joint[];
	clear($loc_joint);
	global string $select_loc_top[];
	clear($select_loc_top);
	global string $select_loc_side[];
	clear($select_loc_side);
	$select_joint = $select;
	for( $joint in $select_joint )
	{
		if ( `match "|" $joint` == "" )
		{
			$loc_joint[`size $loc_joint`] = $joint;
		}
		else
		{
			$loc_joint[`size $loc_joint`] = `substitute ".*|" $joint ""`;
		}
	}
	print("1. Selected joint:\n");
	for( $int_i = 0; $int_i < size( $select_joint ); $int_i++ )
	{
		print( "\t" + $int_i + ": " + $select_joint[$int_i] + "\n" );
	}
	print("2. Create locator per joint:\n");
	for( $int_i = 0; $int_i < size( $select_joint ); $int_i++)
	{
		string $loc = stringArrayToString( `spaceLocator -name ( $loc_joint[$int_i] + "_top" )`, "" );
		$select_loc_top[$int_i] = $loc;
		eval("setAttr -k off " + $loc + ".scaleX");
		eval("setAttr -k off " + $loc + ".scaleY");
		eval("setAttr -k off " + $loc + ".scaleZ");
		eval("setAttr -k off " + $loc + ".visibility");
		select -r $select_joint[$int_i];
		select -add $loc;
		string $constraint = stringArrayToString( `parentConstraint -dc -weight 1`, "" );
		delete $constraint;
		print("\tlocator " + $loc + " created for " + $select_joint[$int_i] + " joint\n");
		$loc =  stringArrayToString( `spaceLocator -name ( $loc_joint[$int_i] + "_side" )`, "" );
		$select_loc_side[$int_i] = $loc;
		eval("setAttr -k off " + $loc + ".scaleX");
		eval("setAttr -k off " + $loc + ".scaleY");
		eval("setAttr -k off " + $loc + ".scaleZ");
		eval("setAttr -k off " + $loc + ".visibility");
		select -r $select_joint[$int_i];
		select -add $loc;
		$constraint = stringArrayToString( `parentConstraint -dc -weight 1`, "" );
		delete $constraint;
		setAttr ( $loc + ".overrideEnabled") 1;
		setAttr ( $loc + ".overrideColor") 21;
		print("\tlocator " + $loc + " created for " + $select_joint[$int_i] + " joint\n");
	}
	print("3. Select top locators:\n");
	select -r $select_loc_top;
	SW_5fce4865a9fd47748e6796c1be9d64b2;
	select -add $select_loc_side;
	SW_3323b46f97bc12510f86536ae21ff525;
