global proc string[] SHIFT3_2_5e702211108f11813c411c94f8b1b380( string $transfrm )
{
   string $shapes[];
   $shapes[0] = $transfrm;
   if ( "transform" == `nodeType $transfrm` )
   {
		$shapes = `listRelatives -f -shapes $transfrm`;
   }
   return $shapes;
}
global proc string[] SHIFT3_2_9145a4487029b640fc70278199ce684f()
{
	string $facesShapes[] = `ls -l -sl -o`;
	string $str1=stringArrayToString($facesShapes, " ");
	string $selected[]=`ls -l -sl`;
	string $str2=stringArrayToString($selected, " ");
	string $obj_selected[];
	if( $str1!=$str2 )
	     $obj_selected = `listRelatives -f -p $facesShapes`;
	    else
	        $obj_selected=$selected;
	if (size ($obj_selected)==0)
	{
	    $obj_selected=$facesShapes;
	}
	return $obj_selected;
}
global proc string[] SHIFT3_2_9542c11845a1e56080fc5b7a1c5e8a5b(string $get_string_for_revers[])
{
    string $revers_objs[];
	$j=size($get_string_for_revers)-1;
	for ($obj in $get_string_for_revers)
	{
		$revers_objs[$j]=$obj;
		$j--;
	}
	return $revers_objs;
}
global proc string[] SHIFT3_2_ab8c8018d47d542b750e72df0fa0b3ee()
{
    string $sorted_massive[];
    string $selected[]=`ls-fl-l-sl`;
    string $buffer[];
    float $num_list[];
    for($i=0;$i<size($selected);$i++)
        $num_list[$i]=`tokenize $selected[$i] "|" $buffer`;
    $sorted_massive=SHIFT3_2_1d56f8884d88d7b022ffa48bc52b3755 ($selected,$num_list);
    return $sorted_massive;
}
global proc string SHIFT3_2_20a28b95c1b8b4dd29397ab332dbc667()
{
    $currentPanel = `getPanel -withFocus`;
    $error=catch($cam_name=`modelEditor -q -camera  $currentPanel`);
    if($error)
    {
        $cam_name="no model panel viewport";
    }
    return $cam_name;
}
global proc string[] SHIFT3_2_46e3c16f7c510db12bc5343ac1a842b6(int $color, int $template, int $show_outliner)
{
	$selection=`ls-sl`;
	$curv=SHIFT3_2_a8d1933a966541e62d79a2fcbf6e4ea4(1);
	if($color)
		SHIFT3_2_cc20e95399a3b6da44eb78e45451d764($color);
	if( $template)
		SHIFT3_2_8071326ac26a590fcb224ddba406d389();
	string $tmpp[];
	string $curves[] = `listRelatives -f -shapes -type "nurbsCurve" $curv`;
	int $numCVs = `getAttr -size ($curves[0] + ".controlPoints")`;
	string $cluster_names[];
	clear $cluster_names;
	for($i=0;$i<$numCVs;$i++)
	{
		$tmpp=`cluster -envelope 1 ($curv + ".cv[" + $i + "]")` ;
		$cluster_names[$i]=$tmpp[1];
	}
	SHIFT3_2_32a3829df17c3736d9757e423eeaf0e3($selection,$cluster_names);
	select  $cluster_names;
	SHIFT3_2_4c2952dd9f486573856c8eb6a0dc46ac(0);
	select $curv;
	select -add  $cluster_names;
	SHIFT3_2_1b3bfd1d62d966ea966f5caca72bac5d(`ls-sl`, $show_outliner);
	SHIFT3_2_aa074854107180f09880ea0e8edd43f8;
	SHIFT3_2_b6a5017ee305f5ba0bbf3116243cc3af;
	SHIFT3_2_1f3f21e017b74355329202016bf1b177;
	SHIFT3_2_ade4e354383a28fcefcaf5ce40e6639d;
	string $ret[]=`ls-sl`;
	select $selection;
	return $ret;
}
global proc SHIFT3_2_1b3bfd1d62d966ea966f5caca72bac5d(string $objects[], int $hidden)
{
    string $shapes[];
    for ($obj in $objects)
    {
        setAttr ($obj  +  ".hiddenInOutliner") $hidden;
        $shapes=SHIFT3_2_5e702211108f11813c411c94f8b1b380($obj);
        for($shape in $shapes)
        {
             setAttr ($shape  +  ".hiddenInOutliner") $hidden;
        }
    }
}
global proc string[] SHIFT3_2_95aedc626a621231a66a091788483a9e(string $curveName, int $sequent_parent)
{
	string $curve_Shape[] = `listRelatives -shapes -f -type "nurbsCurve" $curveName`;
	int $numCVs = `getAttr -size ($curve_Shape[0] + ".controlPoints")`;
	catchQuiet(`setAttr ($curve_Shape[0] + ".lockLength") 0`);
	string $loks[];
	string $clusters[], $tmppo[];
	for($i=0;$i< $numCVs;$i++)
	{
		$tmppo=`cluster ($curveName + ".cv[" + $i + "]")`;
		$clusters[$i]=$tmppo[1];
	}
	$loks=SHIFT3_2_526c020cd7c9a859fd08d49719a4fddf($clusters);
	SHIFT3_2_32a3829df17c3736d9757e423eeaf0e3($loks,$clusters);
	SHIFT3_2_4c2952dd9f486573856c8eb6a0dc46ac(0);
	SHIFT3_2_113374ba19bc1f4dc9b1cc9706816f86($clusters);
	SHIFT3_2_b6a5017ee305f5ba0bbf3116243cc3af;
	SHIFT3_2_ade4e354383a28fcefcaf5ce40e6639d;
	SHIFT3_2_aa074854107180f09880ea0e8edd43f8;
	SHIFT3_2_8071326ac26a590fcb224ddba406d389();
	SHIFT3_2_1b3bfd1d62d966ea966f5caca72bac5d($clusters, 1);
	if($sequent_parent)
	{
		select  $loks;
		SHIFT3_2_f0209cb5b5931bdfa7ae6801db19a0f8;
	}
	return $loks;
}
global proc SHIFT3_2_57a906823be3ff74fc67f225ea020d49(string $objects[])
{
    string $attr[],$obj,$att;
    for($obj in $objects)
    {
        $attr=`listAttr -r -st "blendParent*" -st "blendOrient*" -st "blendPoint*" -st "blendAim*" -st "MaxHandle*" $obj `;
        for($att in $attr)
        {
            cutKey -cl -t ":" -f ":" -at $att $obj;
            catch (`deleteAttr -attribute $att $obj`);
        }
    }
}
global proc SHIFT3_2_e654812187805dfb8c3722d661c85115()
{
    $selected_loc=`ls-sl`;
	float $rx=1;
	float $ry=1;
	float $local_pos[];
	float $local_rot[];
	float $local_rotTmp[];
	float $joint_radius=0.5;
	string $shapes[];
	int $is_locator;
	float $curr_unit=SHIFT3_2_f71c299bf7b53f7243b078a9990e581c(1);
	for($loc in $selected_loc)
	{
	   	$shapes1=`listRelatives  -type "shape"  -f  $loc`;
		$color=`getAttr  ($loc + ".overrideColor") `;
		catchQuiet($joint_radius = (`getAttr  ($loc + ".radius")`));
        catchQuiet($local_pos = (`getAttr  ($loc + ".localPosition")`));
		$is_locator=catchQuiet($local_rot = (`getAttr ($shapes1[0] + ".localScale")`)  );
		select -cl;
		$cirle=SHIFT3_2_8a435c1e94becce7728e63b61ba412bd(2*$curr_unit);
		move -a $local_pos[0]  $local_pos[1] $local_pos[2] $cirle;
		delete -ch;
		if( `objectType $loc` =="joint")
		    scale -r -p  ($local_pos[0] + "cm") ($local_pos[1] + "cm") ($local_pos[2] + "cm") ($joint_radius/$curr_unit/$curr_unit) ($joint_radius/$curr_unit/$curr_unit) ($joint_radius/$curr_unit/$curr_unit) ($cirle[0] + ".cv[0:7]");
		else
    		if($is_locator==0)
    		    scale -r -p  ($local_pos[0] + "cm") ($local_pos[1] + "cm") ($local_pos[2] + "cm") ($local_rot[0]/$curr_unit/$curr_unit) ($local_rot[1]/$curr_unit/$curr_unit) ($local_rot[2]/$curr_unit/$curr_unit) ($cirle[0] + ".cv[0:7]");
		delete `orientConstraint $loc $cirle[0]`;
		select $loc $cirle[0];
		$objects=`ls-sl`;
		$shapes=`listRelatives  -type "shape"  -f  $objects[0]`;
		catchQuiet(`setAttr ($shapes[0] + ".visibility") 1`);
		for($i=1;$i<size($objects);$i++)
		{
			$shapes=`listRelatives -shapes  $objects[$i]`;
			delete (`parentConstraint $objects[0] $objects[$i] `);
			parent $objects[$i] $objects[0];
			makeIdentity -apply 1 $objects[$i];
			$j=0;
			for($sh in $shapes)
			{
			    $ren=`rename $sh  ($loc+ "Shape" + $j)`;
			    parent -add  -s $ren $objects[0];
			}
		}
		catchQuiet(`delete $shapes1`);
		delete $objects[1];
		select $objects[0];
		$shapes=`listRelatives  -type "shape"  -f  $objects[0]`;
		catchQuiet(`setAttr -keyable false -channelBox true ($shapes[1] + ".rcurve")`);
		catchQuiet(`setAttr -keyable false -channelBox true  ($shapes[1] + ".cwdth")`);
		catchQuiet(`setAttr -keyable false -channelBox true  ($shapes[1] + ".srate")`);
		catchQuiet(`setAttr -keyable false -channelBox true  ($shapes[1] + ".ai_curve_shaderr")`);
		catchQuiet(`setAttr -keyable false -channelBox true  ($shapes[1] + ".ai_curve_shaderg")`);
