			$attribname=SHIFT3_2_41a30a2e9e6a02aac72ab138d3f62f90("scale_vertical", $top_lock[0]);
			setAttr ($attribname) 1;
			if($axis=="z")
				move -r 0 0 150 $top_gr;
			else
				move -r 0 150 0 $top_gr;
			if (!$independence)
                parent $top_gr $obj_on_cuve;
			pointConstraint -mo -weight 1 $obj_on_cuve[0] $top_gr[0];
			orientConstraint -mo -weight 1 $obj_on_cuve[0] $top_gr[0];
