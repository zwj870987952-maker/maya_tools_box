	$maya_unit=`currentUnit -q -l`;
	if ($maya_unit!="cm")
	{
		currentUnit  -l cm;
	}
	$j=0;
	for($obj in `ls-l-sl`)
	{
		select $obj;
		$nodename=SHIFT3_2_e8f0c3b3e6300189aca31ae83320ec92("anim_movement_on_curve_tool_obraz*");
