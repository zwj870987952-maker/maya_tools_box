    {
         $curr_layer_curve=`keyframe -q -n`;
    }
    if (`size $curr_layer_curve`==0)
    {
        warning "no layer and no object selected";
        return {0};
    }
    float $range[]=`keyframe  -query -timeChange  $curr_layer_curve`;
    $range =`sort $range`;
    return  {$range[0],$range[size($range)-1]};
}
global proc float[] SHIFT3_2_386a32a262bb9d12d279c0e143b212e3(string $anim_layer_name)
{
    string $curr_layer_curve[];
    if ($anim_layer_name!="BaseAnimation"&&$anim_layer_name!="")
    {
        $curr_layer_curve=`animLayer -q -animCurves  $anim_layer_name`;
    }
    else
    {
         $curr_layer_curve=`keyframe -q -n`;
    }
    if (`size $curr_layer_curve`==0)
    {
        warning "no layer and no object selected";
        return {0};
    }
    float $range[]=`keyframe  -query -timeChange  $curr_layer_curve`;
    string $string_range[];
    $range =`sort $range`;
    for($i=0;$i<size($range);$i++)
    {
        $string_range[$i]=$range[$i];
    }
     $string_range=stringArrayRemoveDuplicates($string_range);
     float $final_range[];
    for($i=0;$i<size($string_range);$i++)
    {
        $final_range[$i]=$string_range[$i];
    }
    return  $final_range;
}
global proc SHIFT3_2_273526a87547ffdcb7ae088d08bdf57e(string $master_layer, string $slave_layer)
{
	string $m_d_node=`createNode multiplyDivide`;
	connectAttr -f ($master_layer + ".weight") ( $m_d_node + ".input1X");
	setAttr ( $m_d_node + ".input2X") -1;
	setAttr ( $m_d_node + ".input1Y") 1;
	string $p_m_node=`createNode  plusMinusAverage`;
	connectAttr -f ($m_d_node + ".outputX") ($p_m_node + ".input1D[0]");
	connectAttr -f ($m_d_node + ".outputY") ($p_m_node + ".input1D[1]");
	connectAttr -f ($p_m_node + ".output1D") ($slave_layer + ".weight");
	setAttr -lock true ($slave_layer + ".wgth");
}
global proc SHIFT3_2_14a16299b2c9c132f2cee1181c46be19(int $spans_num)
{
	$selected=`ls-sl`;
	$shape=SHIFT3_2_5e702211108f11813c411c94f8b1b380($selected[0]);
	if(`objectType $shape[0]`=="nurbsCurve")
	{
    	$dgrees=`getAttr ($selected[0] + ".d")`;
    	catchQuiet(`rebuildCurve -ch 0 -rpo 1 -rt 0 -end 1 -kr 1 -kcp 0 -kep 0 -kt 0 -s $spans_num -d $dgrees -tol 0.01`);
	}
	else
	{
	    warning "select curve";
	}
	select $selected;
}
global proc string[] SHIFT3_2_96e2470b3ed39e03b8584a3bc1addada(string $objects_to_bake[], string $curve_name, float $framernge[])
{
	global string $WBend_sets_name[];
	float $time=`currentTime -q`;
    string $items_to_parent[];
	if (!`objExists $curve_name`)
	{
		print "curve not exists!!!!";
		return {};
	}
	string $maya_unit=`currentUnit -q -l`;
	if ($maya_unit!="cm")
	{
		currentUnit  -l cm;
	}
	select $curve_name;
	SHIFT3_2_c0333f01c0305441f7e870d2e8681fb9();
	optionVar -intValue animBlendingOpt 1;
	optionVar -intValue animBlendBrokenInputOpt 1;
    string $tmp_selected[];
    select $objects_to_bake;
	string $objects[];
	float $mayaVersion = `getApplicationVersionAsFloat` ;
    string $eval_mode[];
    if ($mayaVersion>=2019)
    {
		python("from maya.plugin.evaluator.cache_preferences import CachePreferenceEnabled");
		python("CachePreferenceEnabled().set_value( False )");
    }
	global string $eval_mode[];
	if ($mayaVersion>=2016)
	{
		$eval_mode=`evaluationManager -q -mode`;
		evaluationManager -mode "off";
	}
	$WBend_sets_name[0] = `sets -name "WALKING_rig_obj"`;
    $objects=`SHIFT3_2_ec8fef482e9931b7fcc91a980b89860a`;
	SHIFT3_2_6de8028af587b467034457b4d6349f89(0.5);
	$WBend_sets_name[1] = `sets -name "WALKING_Parent_obj"`;
	SHIFT3_2_34cdd1e4469c2d3c695448db824d2ecb(1);
    string $obj,$gr_name,$node_name,$attribname;
    int $j=0;
    for($obj in $objects)
    {
        SHIFT3_2_9be2eef2a802c350cd492d919a5a748a($obj, $curve_name, $framernge);
        $tmp_selected=`ls-sl`;
        $items_to_parent[$j]=$tmp_selected[0];
        $j++;
    }
	SHIFT3_2_e9caf5289a585699aa818aadd00d2a1a($items_to_parent,  $objects);
	for($i=0 ;$i<size($items_to_parent);$i++)
	{
		$gr_name=`group $objects[$i]`;
		xform -os -piv 0 0 0;
		$node_name=`createNode blindDataTemplate -n "anim_movement_on_curve_tool_obraz"`;
		$attribname=SHIFT3_2_65107bc37ea4a0d842be293fd78287a9("obj_on_curve", $node_name);
		connectAttr -f ($items_to_parent[$i] + ".visibility")   $attribname;
		$attribname=SHIFT3_2_65107bc37ea4a0d842be293fd78287a9("parent_object", $node_name);
		connectAttr -f ($objects[$i] + ".visibility")   $attribname;
		$attribname=SHIFT3_2_65107bc37ea4a0d842be293fd78287a9("parent_group", $node_name);
		connectAttr -f ($gr_name + ".visibility")   $attribname;
	}
	group -n "WALKING_system_gr" $items_to_parent $curve_name;
	xform -piv 0 0 0;
	select $objects;
	currentTime $time;
	currentUnit  -l $maya_unit;
	evaluationManager -mode $eval_mode;
	return $objects;
}
global proc string SHIFT3_2_9be2eef2a802c350cd492d919a5a748a(string $object, string $curve_name, float $framerange[])
{
	if( ($framerange[1]- $framerange[0])==1)
	{
		$framerange[0]=`playbackOptions -q -ast`;
		$framerange[1]=(`playbackOptions -q -aet`) + 1;
	}
	string $curve_movement_loc[],$m_path,$near_point_on_crve_node,$decompose_matrix_node,$crve_shape[];
	$curve_movement_loc=`spaceLocator`;
	$curve_movement_loc=SHIFT3_2_e706e982298fe9e8f94ae04b06b5d6b2("b_cuv_move");
	$m_path=`pathAnimation -fractionMode 0 -follow true -followAxis x -upAxis z -worldUpType "scene" -inverseUp false -inverseFront false -bank false -startTimeU $framerange[0] -endTimeU ($framerange[1]-1) $curve_name $curve_movement_loc[0]`;
	$near_point_on_crve_node=`createNode nearestPointOnCurve`;
	$decompose_matrix_node=`createNode decomposeMatrix`;
	connectAttr -f ($object + ".worldMatrix[0]") ($decompose_matrix_node + ".inputMatrix");
	connectAttr -f ($decompose_matrix_node + ".outputTranslate") ($near_point_on_crve_node + ".inPosition");
	$crve_shape=SHIFT3_2_5e702211108f11813c411c94f8b1b380($curve_name);
	connectAttr -f ($crve_shape[0] + ".worldSpace[0]")  ($near_point_on_crve_node + ".inputCurve");
	select $m_path;
	$j=0;
	float $U_V_param[];
	for($i=$framerange[0]; $i<$framerange[1];$i++)
	{
		currentTime $i;
		$U_V_param[$j]=getAttr ($near_point_on_crve_node + ".parameter");
		setKeyframe  -v $U_V_param[$j] -t $i ($m_path + ".uValue");
		keyframe -e -vc $U_V_param[$j]  -t $i ($m_path + "_uValue");
		$j++;
	}
		string $mark;
	for($mark in `SHIFT3_2_cfc20aa23531f881688ec3a171beaae5($m_path)`)
	{
		setAttr ($mark  +  ".lodVisibility") 0;
		setAttr ($mark  +  ".visibility") 0;
		setAttr ($mark  +  ".hideOnPlayback") 1;
		setAttr ($mark  +  ".hiddenInOutliner") 1;
		$marker_shape=SHIFT3_2_5e702211108f11813c411c94f8b1b380($mark);
		setAttr ($marker_shape[0]  +  ".lodVisibility") 0;
		setAttr ($marker_shape[0]  +  ".visibility") 0;
		setAttr ($marker_shape[0]  +  ".hideOnPlayback") 1;
		setAttr ($marker_shape[0]  +  ".hiddenInOutliner") 1;
	}
	keyTangent -itt linear -ott linear $m_path;
	delete $near_point_on_crve_node $decompose_matrix_node;
	select $curve_movement_loc;
		$lock_shape=SHIFT3_2_5e702211108f11813c411c94f8b1b380($curve_movement_loc[0]);
	setAttr ($lock_shape[0] + ".visibility") 0;
	return $m_path;
}
global proc string SHIFT3_2_ea9ab7919e5a9de4f76ea8a166ea2117(int $step_count, float $frame_range[], int $from_edge_position, int $delete_vertical_movement, int $twise_motion)
{
	$time=`currentTime -q`;
    string $selection[]=`ls-sl -head 1`;
	$mayaVersion = `getApplicationVersionAsFloat` ;
	global string $eval_mode[];
	if ($mayaVersion>=2016)
	{
		$eval_mode=`evaluationManager -q -mode`;
		if ($eval_mode[0]!="off")
			evaluationManager -mode "off";
	}
	if( ($frame_range[1]- $frame_range[0])==1)
	{
		$frame_range[0]=`playbackOptions -q -ast`;
		$frame_range[1]=(`playbackOptions -q -aet`) + 1;
	}
	vector $coords[];
	vector $tmp_vec, $first_CV;
	float $getPvPos[];
	if($from_edge_position==0)
	{
	    $coords=SHIFT3_2_4ad38bb85176eb981038083a281c91d6($selection[0], {$frame_range[0],$frame_range[1]-1});
	}
    else
    {
        currentTime  ($frame_range[1]-1);
		$getPvPos=`xform -q -ws -piv $selection`;
    	$coords[1]=<<$getPvPos[0],$getPvPos[1],$getPvPos[2]>>;
        currentTime  $frame_range[0];
        $getPvPos=`xform -q -ws -piv $selection`;
    	$coords[0]=<<$getPvPos[0],$getPvPos[1],$getPvPos[2]>>;
    }
	if($delete_vertical_movement)
	{
		$first_CV=$coords[0];
		if (`upAxis -q -axis`=="z")
			for($i=0;$i<size ($coords);$i++)
			{
				$tmp_vec=$coords[$i];
				$coords[$i]=<<$tmp_vec.x,$tmp_vec.y,$first_CV.z>>;
			}
		else
			for($i=0;$i<size ($coords);$i++)
			{
				$tmp_vec=$coords[$i];
				$coords[$i]=<<$tmp_vec.x,$first_CV.y,$tmp_vec.z>>;
			}
	}
	$no_intervals_coords=SHIFT3_2_2774c56ee9a8ad22e22f5e8c75ed4f4d($coords);
	if ($twise_motion)
	    $no_intervals_coords=SHIFT3_2_fe600b241bc9b3be89efa455d18bd9f9($no_intervals_coords);
	string $crve;
	if($from_edge_position)
		$crve=SHIFT3_2_83a9015d514ecd1326a1648b28396ba2($no_intervals_coords,1);
	else
		$crve=SHIFT3_2_83a9015d514ecd1326a1648b28396ba2($no_intervals_coords,3);
	if($crve=="")
	{
		print "\n Object not moving! I can create a curve!\n";
		select $selection;
		currentTime $time;
		return "";
	}
	SmoothHairCurves 100;
	int $rebuild_step=($frame_range[1]-$frame_range[0])/$step_count;
	string $cuve_reb[]=`rebuildCurve -ch 0 -rpo 1 -rt 0 -end 1 -kr 1 -kcp 0 -kep 0 -kt 0 -s $rebuild_step -d 3 -tol 0.01 $crve`;
	$cuve_reb=`rebuildCurve -ch 0 -rpo 1 -rt 0 -end 1 -kr 1 -kcp 0 -kep 0 -kt 0 -s $rebuild_step -d 3 -tol 0.01 $cuve_reb[0]`;
	select $cuve_reb[0];
	setAttr ( $cuve_reb[0] + ".dispCV") 1;
	currentTime $time;
	evaluationManager -mode $eval_mode;
	return $cuve_reb[0];
}
global proc string[] SHIFT3_2_cfc20aa23531f881688ec3a171beaae5(string $m_path)
{
    string $connected_items_by_group[] =`listConnections  -d 1 $m_path`;
    string $buffer[];
    string $markers[];
    $j=0;
    for( $k = 0; $k <size($connected_items_by_group);$k++)
    {
        if(`gmatch $connected_items_by_group[$k] "*positionMarker*"`)
        {
            $markers[$j]=$connected_items_by_group[$k];
            $j++;
        }
    }
    string $obj;
    string $markers_all[];
    $j=0;
    for ($obj in $markers)
    {
        tokenize $obj "->" $buffer;
        $markers_all[$j]=$buffer[1];
        $j++;
    }
    return $markers_all;
}
