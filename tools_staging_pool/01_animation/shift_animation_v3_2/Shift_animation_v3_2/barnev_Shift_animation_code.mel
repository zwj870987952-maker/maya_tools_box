global proc string[] SHIFT3_2_f0209cb5b5931bdfa7ae6801db19a0f8 ()
{
	$obj=`ls-sl`;
	$createSetResult_object = `sets -name "object"`;
	for ($i=0; $i<(size($obj)-1);$i++)
	{
	    $childs=`listConnections -t node $createSetResult_object`;
		catch (`parent $childs[$i+1] $childs[$i]`);
