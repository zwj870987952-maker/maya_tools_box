		{
			warning ("object " + $obj + " not connected");
		}
		else
		{
		    tokenize  $obj "|" $buffer;
		    $WB_group_name=$buffer[0];
			$obj_on_cuve=SHIFT3_2_ffecd01738add909a797cd04488b55bd($nodename, "obj_on_curve");
			$parent_grpp=SHIFT3_2_ffecd01738add909a797cd04488b55bd($nodename, "parent_group");
