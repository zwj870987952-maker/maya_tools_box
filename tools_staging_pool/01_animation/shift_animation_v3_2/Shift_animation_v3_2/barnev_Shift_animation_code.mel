		animLayerEditorOnSelect $AUTOPATH_curr_selected_layers[0] 1;
		animLayerEditorOnSelect $WB_layer 0;
		animLayer -edit -mute 1 $WB_layer;
		animLayer -edit -mute 0 $AUTOPATH_curr_selected_layers[0];
		$shift_lay=SHIFT3_2_36e868f70d3bc857bf7c0d874db1cf86(1);
		$shift_lay=`rename $shift_lay by_shift_master`;
