global proc string SHIFT3_2_e8f0c3b3e6300189aca31ae83320ec92(string $node_name_mask)
{
	$connected_nodes=`listConnections -t node`;
	string $nodename;
	int $has_connect_to_recalculate=0;
	string $obj;
	for($obj in $connected_nodes)
		{
		   if(`gmatch $obj $node_name_mask`)
		   {
		   $nodename=$obj;
		   $has_connect_to_recalculate=1;
		   }
		}
		return  $nodename;
}
global proc string[] SHIFT3_2_6c03bcf1c4cd077aea727f60dfb001f6(int $mode, string $nodename_mask)
{
    string $prevouos[];
    string $next[];
    string  $connected_items[];
    int $current_item_index;
    int $connected_items_size;
    $select_items=`ls-sl`;
    $j=0;
    string $all_connected_items[];
	string $top_connected_items[];
    for($obj in $select_items)
    {
        select $obj;
        $nodename=SHIFT3_2_e8f0c3b3e6300189aca31ae83320ec92($nodename_mask);
        if($nodename!="")
        {
            $connected_items=`listConnections  -d 1 $nodename`;
            $connected_items_size =size($connected_items)-1;
            for ($i=0; $i<=$connected_items_size;$i++)
            {
              if($connected_items[$i]==$obj)
                    $current_item_index=$i;
            }
        }
        if($current_item_index!=0)
            $prevouos[$j]=$connected_items[$current_item_index -1];
        else
            $prevouos[$j]=$connected_items[$connected_items_size];
        if($current_item_index!=$connected_items_size)
            $next[$j]=$connected_items[$current_item_index+1];
        else
            $next[$j]=$connected_items[0];
        $j++;
        appendStringArray( $all_connected_items, $connected_items, `size $connected_items`);
		appendStringArray( $top_connected_items, $connected_items, 1);
    }
	$all_connected_items=stringArrayRemoveDuplicates($all_connected_items);
	$top_connected_items=stringArrayRemoveDuplicates($top_connected_items);
	select $select_items;
	if($mode==2)
		return $top_connected_items;
    if($mode==-1)
        return $prevouos;
    if($mode==1)
        return $next;
        else
        return $all_connected_items;
}
global proc string[] SHIFT3_2_ffecd01738add909a797cd04488b55bd(string $nodename, string $attrib_name_mask)
{
	$connected_items_by_group=`listConnections  -c 1 $nodename`;
	string $connected_objects[];
	string $tmk;
	$j=0;
	for($i=0;$i<size($connected_items_by_group);$i++)
	{
		$tmk=$connected_items_by_group[$i];
		if(`gmatch  $tmk ("*." + $attrib_name_mask )`)
		{
			$connected_objects[$j]= $connected_items_by_group[$i+1];
			$j++;
		}
	}
	return  $connected_objects;
}
global proc string SHIFT3_2_e2ba956c9c1fac6238ed43e940bd7a18(string $main_ctrl, string $pelvis_ctrl, string $freeze_ctrls[], int $rotate_mode, int $flat_mode)
