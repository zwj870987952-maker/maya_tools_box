			SHIFT3_2_4c2952dd9f486573856c8eb6a0dc46ac(0);
			move -r -os 150 0 0 $side_lock;
			parent $side_lock $obj_on_cuve;
			SHIFT3_2_d299a61e0c068c7b602aab3964148a23 ($parent_grpp, $top_lock,$side_lock);
            select $top_gr;
			$top_scale_gr=`group`; xform -piv 0 0 0;
			if ($independence)
				parent $top_scale_gr $helper[0] $WB_group_name;
			else
				parent $helper[0] $WB_group_name;
			connectAttr -f $attribname ($top_scale_gr + ".scaleX");
			connectAttr -f $attribname ($top_scale_gr + ".scaleY");
			connectAttr -f $attribname ($top_scale_gr + ".scaleZ");
			$vertical_independence_node_name=`createNode blindDataTemplate -n "anim_movement_on_curve_tool_vertical_independence"`;
			$attribname=SHIFT3_2_65107bc37ea4a0d842be293fd78287a9("top_aim_lock", $vertical_independence_node_name);
			connectAttr -f ($top_lock[0] + ".visibility")   $attribname;
			$attribname=SHIFT3_2_65107bc37ea4a0d842be293fd78287a9("top_aim_gr", $vertical_independence_node_name);
			connectAttr -f ($top_gr[0] + ".visibility")   $attribname;
			$attribname=SHIFT3_2_65107bc37ea4a0d842be293fd78287a9("side_aim_lock", $vertical_independence_node_name);
			connectAttr -f ($side_lock[0] + ".visibility")   $attribname;
			$attribname=SHIFT3_2_65107bc37ea4a0d842be293fd78287a9("helper_curve", $vertical_independence_node_name);
			connectAttr -f ($helper[0] + ".visibility")   $attribname;
			$locks[$j]=$top_lock[0];
			$j++;
		}
	}
    select $locks;
	SHIFT3_2_29941243f77aa0343e79460d48136072 (8);
	if ($independence)
	{
		SHIFT3_2_cc20e95399a3b6da44eb78e45451d764(13);
		SHIFT3_2_e706e982298fe9e8f94ae04b06b5d6b2("incline_ind_vert");
	}
	else
	{
		SHIFT3_2_cc20e95399a3b6da44eb78e45451d764(22);
		SHIFT3_2_e706e982298fe9e8f94ae04b06b5d6b2("incline_to_curve");
	}
	SHIFT3_2_34cdd1e4469c2d3c695448db824d2ecb(1);
	SHIFT3_2_b6a5017ee305f5ba0bbf3116243cc3af;
	SHIFT3_2_aa074854107180f09880ea0e8edd43f8;
	SHIFT3_2_ade4e354383a28fcefcaf5ce40e6639d;
	currentUnit  -l $maya_unit;
