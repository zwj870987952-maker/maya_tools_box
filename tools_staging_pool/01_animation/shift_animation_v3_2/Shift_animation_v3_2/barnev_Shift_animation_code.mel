			setKeyframe -t ($AUTOPATH_framernge[0] - $easing_frame) -t ($AUTOPATH_framernge[1] + $easing_frame) -v 0 -itt "flat" -ott "flat" ($parent_items[0] + ".rotates") ;
			setKeyframe -t $AUTOPATH_framernge[0] -t $AUTOPATH_framernge[1]  -v 1 -itt "flat" -ott "flat" ($parent_items[0] + ".rotates") ;
		}
