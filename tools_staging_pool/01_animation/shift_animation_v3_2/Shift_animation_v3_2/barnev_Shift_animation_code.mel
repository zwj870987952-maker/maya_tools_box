global proc SHIFT3_2_6de8028af587b467034457b4d6349f89(float $subScale)
{
    int $camera_ortograf=0;
	float $dist=50;
	$subScale=SHIFT3_2_f71c299bf7b53f7243b078a9990e581c($subScale)/SHIFT3_2_f71c299bf7b53f7243b078a9990e581c(1)/SHIFT3_2_f71c299bf7b53f7243b078a9990e581c(1);
	$sel=`ls-head 1 -sl`;
	string $camera_name="";
	float $camera_scale=1;
	catchQuiet( $camera_name= SHIFT3_2_20a28b95c1b8b4dd29397ab332dbc667());
	if( $camera_name =="no model panel viewport")
	    $camera_name="persp";
	catchQuiet( $camera_scale=`getAttr ($camera_name + ".cameraScale")`);
	catchQuiet( $dist=SHIFT3_2_c7822f1f10b007a6803735c105e40799($sel[0], $camera_name));
	catchQuiet( $camera_ortograf=`getAttr ($camera_name + ".orthographic")`);
	catchQuiet( $camera_orthographicWidth=`getAttr ($camera_name + ".orthographicWidth")`);
	if(!$camera_ortograf)
	    catchQuiet(SHIFT3_2_29941243f77aa0343e79460d48136072 (($dist/25)*$subScale*$camera_scale));
	else
	   catchQuiet(SHIFT3_2_29941243f77aa0343e79460d48136072 (($camera_orthographicWidth/25)*$subScale*$camera_scale));
}
global proc string [] SHIFT3_2_ac2021d0d7ff3ecfad4dbca9f9f88248(string $target_massiv[], string $object_massiv[])
{
	string $name_of_constrain[];
	string $tmp[];
	for($i=0;$i<size($target_massiv);$i++)
		{
		$rx_lock=`getAttr -lock ($object_massiv[$i] + ".rx")`;
		$ry_lock=`getAttr -lock ($object_massiv[$i] + ".ry")`;
		$rz_lock=`getAttr -lock ($object_massiv[$i] + ".rz")`;
		$h=$rx_lock+$ry_lock+$rz_lock;
		if ($h<3)
		{
			$skipX= "";
			$skipY= "";
			$skipZ= "";
			if($rx_lock)
				$skipX= " -skip x";
			if($ry_lock)
				$skipY= " -skip y";
			if($rz_lock)
				$skipZ= " -skip z";
			$skipped = $skipX + $skipY + $skipZ;
			$tmp=`eval ("orientConstraint  " + $skipped + " " + $target_massiv[$i] + " " + $object_massiv[$i])`;
			$name_of_constrain[$i]=$tmp[0];
		}
	}
	return $name_of_constrain;
}
global proc float[] SHIFT3_2_8598296823aa3af15686cb0d78f1615d(string $selection)
{
    float $objPosition[];
    float $getPvPos[];
    float $Rot[];
    string $buffer[];
    string $e_f_result[];
    vector $coords[];
    vector $coo;
    float $pos[];
    int $num;
    if ((`objectType -isType "mesh" $selection`)+(`objectType -isType "nurbsSurface" $selection`)+(`objectType -isType "nurbsCurve" $selection`)+(`objectType -isType "lattice" $selection`))
	{
        if (`objectType -isType "mesh" $selection`)
        {
            tokenize  $selection "." $buffer;
            $objname=$buffer[0];
            tokenize  $buffer[1] "[]" $buffer;
            $component_name=$buffer[0];
            if($component_name=="vtx")
            {
                $getPvPos=`pointPosition -world $selection`;
                $objPosition={$getPvPos[0],$getPvPos[1],$getPvPos[2],0,0,0};
            }
            if($component_name=="e")
            {
                $e_f_result=`polyInfo -ev $selection`;
                $num=`tokenize  $e_f_result[0] " " $buffer`;
                $j=0;
                for($i=2;$i<$num-1;$i++)
                {
                    $getPvPos=`pointPosition -world ($objname + ".vtx[" + $buffer[$i] + "]")`;
                    print ($objname + ".vtx[" + $buffer[$i] + "]");
                    $coords[$j]=<<$getPvPos[0],$getPvPos[1],$getPvPos[2]>>;
                    $j++;
                }
                $coo=SHIFT3_2_e3bea614176fbceebe7c7aae67e953b0($coords);
                $objPosition={$coo.x,$coo.y,$coo.z,0,0,0};
            }
            if($component_name=="f")
            {
                $e_f_result=`polyInfo -fv $selection`;
                tokenize  $e_f_result[0] " " $buffer;
                $j=0;
                for($i=2;$i<size($buffer)-1;$i++)
                {
                    $getPvPos=`pointPosition -world ($objname + ".vtx[" + $buffer[$i] + "]")`;
                    $coords[$j]=<<$getPvPos[0],$getPvPos[1],$getPvPos[2]>>;
                    $j++;
                }
                $coo=SHIFT3_2_e3bea614176fbceebe7c7aae67e953b0($coords);
                $objPosition={$coo.x,$coo.y,$coo.z,0,0,0};
            }
        }
        else
        {
    		$getPvPos=`pointPosition -world $selection`;
    		$objPosition={$getPvPos[0],$getPvPos[1],$getPvPos[2],0,0,0};
		}
	}
	else
	{
		$getPvPos = `xform -q -ws -piv $selection `;
		$Rot= `xform -q -ro -ws $selection`;
		$objPosition={$getPvPos[0],$getPvPos[1],$getPvPos[2],$Rot[0],$Rot[1],$Rot[2]};
	}
	return $objPosition;
}
global proc vector[] SHIFT3_2_4ad38bb85176eb981038083a281c91d6(string $selection, float $framerange[])
{
    float $objPosition[];
    vector $getPvPos_range[];
    vector $tmpp;
    float $getPvPos[];
    float $Rot[];
    int $j=0;
    for($i=$framerange[0];$i<=($framerange[1]);$i++)
    {
        currentTime $i;
        if ((`objectType -isType "mesh" $selection`)+(`objectType -isType "nurbsSurface" $selection`)+(`objectType -isType "nurbsCurve" $selection`))
    	{
    		$getPvPos=`pointPosition -world $selection`;
    		$tmpp=<<$getPvPos[0],$getPvPos[1],$getPvPos[2]>>;
    	}
    	else
    	{
    		$getPvPos = `xform -q -ws -piv $selection `;
    		$tmpp=<<$getPvPos[0],$getPvPos[1],$getPvPos[2]>>;
       	}
       	$getPvPos_range[$j]=$tmpp;
       	$j++;
     }
	return $getPvPos_range;
}
global proc string[] SHIFT3_2_17431451b1be026fdeee93b86579c6b6(string $target_massiv[], string $object_massiv[])
{
	string $name_constrain[];
	string $tmp_constrain[];
	string $skipTX;
	string $skipTY;
	string $skipTZ;
	string $skipRX;
	string $skipRY;
	string $skipRZ;
	string $delChannelTX;
	string $delChannelTY;
	string $delChannelTZ;
	string $delChannelRX;
	string $delChannelRY;
	string $delChannelRZ;
	int $rx_lock;
	int $ry_lock;
	int $rz_lock;
	int $tx_lock;
	int $ty_lock;
	int $tz_lock;
	if(size($target_massiv)!=size($object_massiv))
		warning "size smart_parent constraints massives is DIFFERENT!!! Only relevant objects will be processed! This can lead to unexpected consequences!!!!";
	if(size($target_massiv)> size($object_massiv))
		$target_massiv=`ls -head (size($object_massiv)) $target_massiv`;
	for($i=0;$i<size($target_massiv);$i++)
	{
		$rx_lock=`getAttr -lock ($object_massiv[$i] + ".rx")`;
		$ry_lock=`getAttr -lock ($object_massiv[$i] + ".ry")`;
		$rz_lock=`getAttr -lock ($object_massiv[$i] + ".rz")`;
		$tx_lock=`getAttr -lock ($object_massiv[$i] + ".tx")`;
		$ty_lock=`getAttr -lock ($object_massiv[$i] + ".ty")`;
		$tz_lock=`getAttr -lock ($object_massiv[$i] + ".tz")`;
		$h=$rx_lock+$ry_lock+$rz_lock+$tx_lock+$ty_lock+$tz_lock;
		if ($h<6)
		{
			$skipTX= "";
			$skipTY= "";
			$skipTZ= "";
			$skipRX= "";
			$skipRY= "";
			$skipRZ= "";
			$delChannelTX = "";
			$delChannelTY = "";
			$delChannelTZ = "";
			$delChannelRX = "";
			$delChannelRY = "";
			$delChannelRZ = "";
			if($tx_lock)
				$skipTX= " -st x";
			else
				$delChannelTX =" -at \"tx\"";
			if($ty_lock)
				$skipTY= " -st y";
			else
				$delChannelTY =" -at \"ty\"";
			if($tz_lock)
				$skipTZ= " -st z";
			else
				$delChannelTZ =" -at \"tz\"";
			if($rx_lock)
				$skipRX= " -sr x";
			else
				$delChannelRX =" -at \"rx\"";
			if($ry_lock)
				$skipRY= " -sr y";
			else
				$delChannelRY =" -at \"ry\"";
			if($rz_lock)
				$skipRZ= " -sr z";
			else
				$delChannelRZ =" -at \"rz\"";
			$skipped = $skipTX + $skipTY + $skipTZ + $skipRX + $skipRY + $skipRZ;
			if($target_massiv[$i]!="")
			{
			$tmp_constrain=`eval ("parentConstraint -mo " + $skipped + " " + $target_massiv[$i] + " " + $object_massiv[$i])`;
			}
			$name_constrain[$i]=$tmp_constrain[0];
		}
	}
	return $name_constrain;
}
global proc string[] SHIFT3_2_d299a61e0c068c7b602aab3964148a23 (string $object[], string $aim_top_target[], string $aim_side_target[])
{
	string $name_of_constrain[];
	string $tmp[];
	for($i=0;$i<size($object);$i++)
	{
		$tmp=`aimConstraint -mo -weight 1 -aimVector 0 1 0 -upVector 0 0 1 -worldUpType "object" -worldUpObject $aim_side_target[$i] $aim_top_target[$i] $object[$i]`;
		$name_of_constrain[$i]=$tmp[0];
	}
	return $name_of_constrain;
}
global proc string SHIFT3_2_c830bbb3bb6041f72a5fb76403fcabe8()
{
    $selection=`ls-sl`;
    $mayaVersion = `getApplicationVersionAsFloat` ;
    string $eval_mode[];
    if ($mayaVersion>=2016)
    {
        $eval_mode=`evaluationManager -q -mode`;
		if($eval_mode[0]!="off")
			evaluationManager -mode "off";
    }
    $min=`playbackOptions -q -ast`;
    $max=`playbackOptions -q -aet`;
    string $lay=`animLayer -override 1  "BakedAnim"`;
    $its_baked=catch (`bakeResults -sm 1 -s false -t ($min+":"+$max) -dl $lay  -minimizeRotation true  $selection`) ;
    if ($mayaVersion>=2016)
    {
		if($eval_mode[0]!="off")
			evaluationManager -mode $eval_mode[0];
    }
    if($its_baked)
    {
        warning "select something!";
    }
    select  $selection;
    return  $lay;
}
global proc SHIFT3_2_e02b9af8de573969d2834f5d4e4228fd(float $min, float $max, string $objects[])
{
	$mayaVersion = `getApplicationVersionAsFloat` ;
    string $eval_mode[];
    if ($mayaVersion>=2016)
    {
        $eval_mode=`evaluationManager -q -mode`;
		if($eval_mode[0]!="off")
			evaluationManager -mode "off";
    }
    catchQuiet(`selectKey -clear`);
	$its_baked=catchQuiet (`bakeResults -sm 1 -s false -t  ($min + ":" + $max) $objects`);
    if ($mayaVersion>=2016)
    {
		if($eval_mode[0]!="off")
			evaluationManager -mode $eval_mode[0];
    }
    if($its_baked)
    {
        warning "select something!";
    }
}
global proc SHIFT3_2_d1b73d0512bac8d20998bdbab9b3aed7(string $target[], string $object[])
{
	int $ro;
	for($i=0;$i<size($target);$i++)
	{
		$ro=`getAttr($target[$i] + ".rotateOrder")`;
		setAttr ($object[$i] + ".rotateOrder")$ro;
	}
}
global proc SHIFT3_2_5e8af8371c687e5c50d7ded5040ffe13(string $target_position[], string $object_to_move[])
{
	float $Trans[];
	float $Rot[];
	for($i=0;$i<size($target_position);$i++)
	{
        $Trans=SHIFT3_2_8598296823aa3af15686cb0d78f1615d($target_position[$i]);
        $Rot={$Trans[3],$Trans[4],$Trans[5]};
		rotate -ws $Rot[0] $Rot[1] $Rot[2] $object_to_move[$i];
		move -rpr $Trans[0] $Trans[1] $Trans[2] $object_to_move[$i];
		rotate -ws $Rot[0] $Rot[1] $Rot[2] $object_to_move[$i];
		move -rpr $Trans[0] $Trans[1] $Trans[2] $object_to_move[$i];
		rotate -ws $Rot[0] $Rot[1] $Rot[2] $object_to_move[$i];
		move -rpr $Trans[0] $Trans[1] $Trans[2] $object_to_move[$i];
	}
}
global proc SHIFT3_2_13f67b1447d1fe0d15313a69cb76f8e6(string $target_position[], string $object_to_move[])
{
	int $lock_rot[];
	int $lock_trans[];
	for($i=0;$i<size($target_position);$i++)
	{
		$Rot = `getAttr ($target_position[$i] + ".rotate")`;
		$Trans = `getAttr ($target_position[$i] + ".translate")`;
		$lock_rot[0] = `getAttr -l ($object_to_move[$i] + ".rotateX")`;
		$lock_rot[1] = `getAttr -l ($object_to_move[$i] + ".rotateY")`;
		$lock_rot[2] = `getAttr -l ($object_to_move[$i] + ".rotateZ")`;
		$lock_trans[0] = `getAttr -l ($object_to_move[$i] + ".translateX")`;
		$lock_trans[1] = `getAttr -l ($object_to_move[$i] + ".translateY")`;
		$lock_trans[2] = `getAttr -l ($object_to_move[$i] + ".translateZ")`;
		if(!$lock_rot[0])
            setAttr ($object_to_move[$i] + ".rotateX")  $Rot[0];
		if(!$lock_rot[1])
            setAttr ($object_to_move[$i] + ".rotateY")  $Rot[1];
		if(!$lock_rot[2])
            setAttr ($object_to_move[$i] + ".rotateZ")  $Rot[2];
		if(!$lock_trans[0])
            setAttr ($object_to_move[$i] + ".translateX") $Trans[0];
        if(!$lock_trans[1])
            setAttr ($object_to_move[$i] + ".translateY") $Trans[1];
        if(!$lock_trans[2])
            setAttr ($object_to_move[$i] + ".translateZ") $Trans[2];
	}
}
global proc SHIFT3_2_9a3ce25cfdbc96f0053e2e03715d7f2b()
{
	$objs = `ls-sl`;
	for($obj in $objs)
	{
		if(!`getAttr -lock ($obj + ".rx") `)
			setAttr ($obj + ".rx") 0;
		if(!`getAttr  -lock ($obj + ".ry") `)
			setAttr ($obj + ".ry") 0;
		if(!`getAttr  -lock ($obj + ".rz")`)
			setAttr ($obj + ".rz") 0;
	}
}
global proc SHIFT3_2_09f1edc0a69a4931b08e1bcc40e94a55()
{
	string $selected[]= `ls -sl`;
	if(size($selected)==0)
	{
		warning "select something!!!!";
		return;
	}
	string $crvs[] = `keyframe -q -n`;
	float $statTime[] = `keyframe -index 0 -q -tc $crvs`;
	$statTime=`sort $statTime`;
	float $null_frame = $statTime[0] - 10;
	catchQuiet(`setKeyframe -v 0 -t $null_frame -at rotateX -at rotateY -at rotateZ`) ;
	catchQuiet(`filterCurve $selected.rotateX $selected.rotateY $selected.rotateZ`);
	selectKey -clear;
	catchQuiet(`cutKey -t $null_frame  -at rotateX -at rotateY -at rotateZ `);
	selectKey -clear;
}
global proc string[] SHIFT3_2_194c7b09c27128a45486ac17560c7a25(string $objs[])
{
	string $new_selected[];
	$j=0;
	for($i=0;$i<size($objs);$i++)
	{
		if( `objExists $objs[$i]` )
		{
			$new_selected[$j] = $objs[$i];
			$j++;
		}
	}
	select -r $new_selected;
	return $new_selected;
}
global proc float SHIFT3_2_c7822f1f10b007a6803735c105e40799(string $obj1, string $obj2)
{
	float $temp[]=SHIFT3_2_8598296823aa3af15686cb0d78f1615d($obj1);
	vector $point1 = <<$temp[0], $temp[1], $temp[2]>>;
	$temp=SHIFT3_2_8598296823aa3af15686cb0d78f1615d($obj2);
	vector $point2 = <<$temp[0], $temp[1], $temp[2]>>;
	float $lenght=`mag($point1-$point2)`;
	return  $lenght;
}
global proc SHIFT3_2_54f6a67095b91b940ce86c3f80137d58(string $target[], string $object[])
