	$childs=`listConnections -t node $createSetResult_object`;
	delete $createSetResult_object;
	return $childs;
}
global proc SHIFT3_2_32a3829df17c3736d9757e423eeaf0e3 (string $target[], string $object[])
{
    if(size($target)!=size($object))
		warning "size parent massives is DIFFERENT!!! Only relevant objects will be processed! This can lead to unexpected consequences!!!!";
	if(size($target)> size($object))
		$target=`ls -head (size($object)) $target`;
	select $object;
    $createSetResult_object = `sets -name "object"`;
    for($i=0;$i<size($target);$i++)
    {
        $childs=`listConnections -t node $createSetResult_object`;
        catchQuiet (`parent $childs[$i] $target[$i]`);
    }
    $childs=`listConnections -t node $createSetResult_object`;
    select  $childs;
    delete $createSetResult_object;
}
global proc string[] SHIFT3_2_e706e982298fe9e8f94ae04b06b5d6b2(string $prefix)
{
	string $objs[] = `ls -selection`;
	$j=0;
