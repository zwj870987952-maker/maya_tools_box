global proc float[] SHIFT3_2_629955dac26448fd4dac7dd44010a6ea(string $curve_name)
{
    float $percentage[];
    float $dynVal[] = `keyframe -q -vc  $curve_name`;
    float $changeValues[]={0};
    for($i=1;$i<size($dynVal);$i++)
    {
        $changeValues[$i]=abs($dynVal[$i-1]-$dynVal[$i]);
    }
    $tot_len= SHIFT3_2_6878d678f96f9a2494927fe9200e401e($curve_name);
    for($i=0;$i<size($changeValues);$i++)
    {
        if($tot_len!=0)
        {
            $percentage[$i]=(100/ $tot_len)* $changeValues[$i];
        }
        else
            $percentage[$i]=0;
    }
    return $percentage;
}
global proc float SHIFT3_2_6878d678f96f9a2494927fe9200e401e(string $curve_name)
{
    float $dynVal[] = `keyframe -q -vc  $curve_name`;
    float $tot_path=0;
    for($i=1;$i<size($dynVal);$i++)
    {
        $tot_path+=abs($dynVal[$i]-$dynVal[$i-1]);
    }
    return  $tot_path;
}
global proc SHIFT3_2_00541a9a17599f40188bcea78040440d(string $base_curve,float $range[], float $value[])
