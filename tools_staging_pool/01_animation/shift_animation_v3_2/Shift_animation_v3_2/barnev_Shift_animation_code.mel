		animLayerEditorOnSelect $WB_layer 1;
		animLayerEditorOnSelect $AUTOPATH_curr_selected_layers[0] 0;
	}
	select $b_curve[0];
delete `pickWalk -d up`  $AUTOPATH_second_curve;
