global proc vector[] SHIFT3_2_2774c56ee9a8ad22e22f5e8c75ed4f4d(vector $coords[])
{
    vector $final_coords[];
    int $j=0;
    vector $delta;
    for($i=0;$i<size($coords)-1;$i++)
    {
        $delta=$coords[$i]-$coords[$i+1];
        if(`mag $delta`> 0.001)
        {
            $final_coords[$j]=$coords[$i];
            $j++;
        }
    }
    $final_coords[$j]=$coords[size($coords)-1];
    return  $final_coords;
}
global proc float[] SHIFT3_2_d43bd93439ed3879a3deac8b4d5b5d0d(float $point1[],float $point2[],float $kratDistances)
{
	float $res[];
	vector $a=<<$point1[0],$point1[1],$point1[2]>>;
	vector $b=<<$point2[0],$point2[1],$point2[2]>>;
	$k=$a + ($b-$a)*$kratDistances;
	$res=$k;
	return $res;
}
global proc vector SHIFT3_2_e3bea614176fbceebe7c7aae67e953b0(vector $coords[])
{
	int $num = `size $coords`;
	vector $ff;
	for ($each in $coords)
	    $ff+=$each;
	$ff=($ff/$num);
	return $ff;
}
global proc string[] SHIFT3_2_1d56f8884d88d7b022ffa48bc52b3755 (string $name_massive[],float $float_massive[])
{
    global string $my_name_massive[];
    global float $my_float_massive[];
    $my_name_massive= $name_massive;
    $my_float_massive=$float_massive;
    $shapka="import maya.cmds as cmds\nimport maya.mel as mel\nimport operator\n";
    $procdres="def sort_by_float_array(arr1, float_array):\n    tmp = [(x, y) for x, y in zip(arr1, float_array)]\n    tmp.sort(key=lambda element: element[1])\n    return [x for x, _ in tmp]\n";
    $KKKK_menue=$shapka + $procdres + "stringarr = maya.mel.eval('ls $my_name_massive')\nfloatarr = maya.mel.eval('$tmppp2float=$my_float_massive')\nmy_python_res = sort_by_float_array(stringarr,floatarr)";
    python($KKKK_menue);
    string $TransferVarPy[] = `python "my_python_res"`;
    return $TransferVarPy;
}
global proc float SHIFT3_2_f71c299bf7b53f7243b078a9990e581c(float $input)
{
   string $un=`currentUnit -query -linear`;
   float $output;
   float $coeff;
   if($un=="mm")
       $coeff=0.1;
   if($un=="cm")
       $coeff=1;
   if($un=="m")
       $coeff=100;
   if($un=="km")
       $coeff=100000;
   if($un=="in")
       $coeff=2.54;
   if($un=="ft")
       $coeff=30.48;
   if($un=="yd")
       $coeff=91.44;
   if($un=="mi")
       $coeff=160934.4;
    $output =  $input/$coeff;
    return $output;
}
