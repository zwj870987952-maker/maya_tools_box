{
	if(!size($objects))
		return;
	string $obj;
	for($obj in $objects)
	{
		setAttr -lock true ($obj + ".translateX");
		setAttr -lock true ($obj + ".translateY");
		setAttr -lock true ($obj + ".translateZ");
	}
}
global proc SHIFT3_2_90a059e9200ad500213586e0ecabdd0d(string $objects[], int $t_lock, int $r_lock, int $s_lock, int $v_lock)
{
    if(!size($objects))
        return;
    string $obj;
    for($obj in $objects)
    {
        if($t_lock==1)
        {
            setAttr ($obj + ".tx") -lock 1;
            setAttr ($obj + ".ty") -lock 1;
            setAttr ($obj + ".tz") -lock 1;
        }
        if($t_lock==0)
        {
            setAttr -lock false ($obj + ".translate");
            setAttr ($obj + ".tx") -lock 0;
            setAttr ($obj + ".ty") -lock 0;
            setAttr ($obj + ".tz") -lock 0;
        }
        if($t_lock==2)
        {
            setAttr ($obj + ".tx") -lock (!`getAttr -lock ($obj + ".tx")`);
            setAttr ($obj + ".ty") -lock (!`getAttr -lock ($obj + ".ty")`);
            setAttr ($obj + ".tz") -lock (!`getAttr -lock ($obj + ".tz")`);
        }
        if($r_lock==1)
        {
            setAttr ($obj + ".rx") -lock 1;
            setAttr ($obj + ".ry") -lock 1;
            setAttr ($obj + ".rz") -lock 1;
        }
        if($r_lock==0)
        {
            setAttr -lock false ($obj + ".rotate");
            setAttr ($obj + ".rx") -lock 0;
            setAttr ($obj + ".ry") -lock 0;
            setAttr ($obj + ".rz") -lock 0;
        }
        if($r_lock==2)
        {
            setAttr ($obj + ".rx") -lock (!`getAttr -lock ($obj + ".rx")`);
            setAttr ($obj + ".ry") -lock (!`getAttr -lock ($obj + ".ry")`);
            setAttr ($obj + ".rz") -lock (!`getAttr -lock ($obj + ".rz")`);
        }
        if($s_lock==1)
        {
            setAttr ($obj + ".sx") -lock 1;
            setAttr ($obj + ".sy") -lock 1;
            setAttr ($obj + ".sz") -lock 1;
        }
        if($s_lock==0)
        {
            setAttr -lock 0 ($obj + ".scale");
            setAttr ($obj + ".sx") -lock 0;
            setAttr ($obj + ".sy") -lock 0;
            setAttr ($obj + ".sz") -lock 0;
        }
        if($s_lock==2)
        {
            setAttr ($obj + ".sx") -lock (!`getAttr -lock ($obj + ".sx")`);
            setAttr ($obj + ".sy") -lock (!`getAttr -lock ($obj + ".sy")`);
            setAttr ($obj + ".sz") -lock (!`getAttr -lock ($obj + ".sz")`);
        }
        if($v_lock==1)
            setAttr ($obj + ".v") -lock 1;
        if($v_lock==0)
            setAttr ($obj + ".v") -lock 0;
        if($v_lock==2)
            setAttr ($obj + ".v") -lock (!`getAttr -lock ($obj + ".v")`);
    }
}
global proc string [] SHIFT3_2_4a0278149f801323f33f7bb9e4ee597d(string $target_massiv[], string $object_massiv[])
{
	string $name_of_constrain[];
	string $tmp[];
	int $tx_lock;
	int $ty_lock;
	int $tz_lock;
	int $h;
	string $skipX;
	string $skipY;
	string $skipZ;
	string $skipped;
	if(size($target_massiv)!=size($object_massiv))
		warning "size smart_point constraints massives is DIFFERENT!!! Only relevant objects will be processed! This can lead to unexpected consequences!!!!";
	if(size($target_massiv)> size($object_massiv))
		$target_massiv=`ls -head (size($object_massiv)) $target_massiv`;
	for($i=0;$i<size($target_massiv);$i++)
	{
		$tx_lock=`getAttr -lock ($object_massiv[$i] + ".tx")`;
		$ty_lock=`getAttr -lock ($object_massiv[$i] + ".ty")`;
		$tz_lock=`getAttr -lock ($object_massiv[$i] + ".tz")`;
		$h=$tx_lock+$ty_lock+$tz_lock;
		if ($h<3)
		{
			$skipX= "";
			$skipY= "";
			$skipZ= "";
			if($tx_lock)
				$skipX= " -skip x";
			if($ty_lock)
				$skipY= " -skip y";
			if($tz_lock)
				$skipZ= " -skip z";
			$skipped = $skipX + $skipY + $skipZ;
			$tmp=`eval ("pointConstraint " + $skipped + " " + $target_massiv[$i] + " " + $object_massiv[$i])`;
			$name_of_constrain[$i]=$tmp[0];
		}
	}
	return $name_of_constrain;
}
global proc string [] SHIFT3_2_c99bdb5a898efbfb1d4fa2221eba881b(string $target_massiv[], string $object_massiv[])
{
	string $name_of_constrain[];
	string $tmp[];
	int $rx_lock;
	int $ry_lock;
	int $rz_lock;
	int $h;
	string $skipX;
	string $skipY;
	string $skipZ;
	string $skipped;
	for($i=0;$i<size($target_massiv);$i++)
		{
		$rx_lock=`getAttr -lock ($object_massiv[$i] + ".rx")`;
		$ry_lock=`getAttr -lock ($object_massiv[$i] + ".ry")`;
		$rz_lock=`getAttr -lock ($object_massiv[$i] + ".rz")`;
		$h=$rx_lock+$ry_lock+$rz_lock;
		if ($h<3)
		{
			$skipX= "";
			$skipY= "";
			$skipZ= "";
			if($rx_lock)
				$skipX= " -skip x";
			if($ry_lock)
				$skipY= " -skip y";
			if($rz_lock)
				$skipZ= " -skip z";
			$skipped = $skipX + $skipY + $skipZ;
			$tmp=`eval ("orientConstraint -mo " + $skipped + " " + $target_massiv[$i] + " " + $object_massiv[$i])`;
			$name_of_constrain[$i]=$tmp[0];
		}
	}
	return $name_of_constrain;
}
global proc SHIFT3_2_3323b46f97bc12510f86536ae21ff525()
{
	global string $GloabalCopyPaste2[];
	$GloabalCopyPaste2=`ls-sl`;
}
global proc SHIFT3_2_de88efca2929f0080ae1d45ff5db42d4()
{
	$selection=`ls-sl`;
    $mayaVersion = `getApplicationVersionAsFloat` ;
    string $eval_mode[];
    if ($mayaVersion>=2016)
    {
        $eval_mode=`evaluationManager -q -mode`;
		if($eval_mode[0]!="off")
			evaluationManager -mode "off";
    }
    $min=`playbackOptions -q -ast`;
    $max=`playbackOptions -q -aet`;
    $its_baked=catchQuiet (`bakeResults -sm 1 -s false -t ($min+":"+$max) $selection`);
	if ($mayaVersion>=2016)
    {
		if($eval_mode[0]!="off")
			evaluationManager -mode $eval_mode[0];
    }
    if($its_baked)
    {
        warning "select something!";
    }
}
global proc string SHIFT3_2_c954f3ebe8232ef721ae19221935b64e(string $take_name)
{
    $i=0;
    while (`objExists $take_name`)
    {
        $take_name=( $take_name + $i);
	}
   return $take_name;
}
global proc vector[] SHIFT3_2_3c3ce83b4c7fdce5b7da19beca86d659(vector $get_vector_for_revers[])
{
    vector $revers_objs[];
    vector $obj;
	$j=size($get_vector_for_revers)-1;
	for ($obj in $get_vector_for_revers)
	{
		$revers_objs[$j]=$obj;
		$j--;
	}
	return $revers_objs;
}
global proc string[] SHIFT3_2_8a435c1e94becce7728e63b61ba412bd(float $radius)
{
	$selection = `ls -fl -sl `;
	string $curve_sphere[];
	if(size($selection)>0)
	{
		for($i=0;$i<size($selection);$i++)
		{
			$curve_sphere[$i]=SHIFT3_2_1a0417e38be183894da98c3ef5716f0d($radius);
		}
		SHIFT3_2_847308ac6f1debf8edcc8d63e128d64c( $selection, $curve_sphere);
		SHIFT3_2_7f958423a7cfe1774157efdcb79ac0be( $selection,$curve_sphere);
	}
	else
	{
		$curve_sphere[0]=SHIFT3_2_1a0417e38be183894da98c3ef5716f0d($radius);
	}
   select $curve_sphere ;
   return $curve_sphere;
}
global proc string SHIFT3_2_1a0417e38be183894da98c3ef5716f0d(float $radius)
{
	string $curves[];
	$crv=`curve -d 1
        -p 0  0.5  0
        -p 0  -0.5  0
        -p 0  0  0
        -p 0.5  0  0
        -p -0.5  0  0
        -p 0  0  0
        -p 0  0  0.5
        -p 0  0  -0.5 ` ;
        scale -a (1*$radius) (1*$radius) (1*$radius)  $crv;
        makeIdentity -apply true -t 1 -r 1 -s 1 -n 0 -pn 1;
        select $crv;
        return $crv;
};
global proc SHIFT3_2_7f958423a7cfe1774157efdcb79ac0be(string $target_position[], string $object_to_move[])
{
	if(size($target_position)!=size($object_to_move))
		warning "size objects to rotate is DIFFERENT!!! Only relevant objects will be processed! This can lead to unexpected consequences!!!!";
	if(size($target_position)> size($object_to_move))
		$target_position=`ls -head (size($object_to_move)) $target_position`;
	float $Rot[];
	for($i=0;$i<size($target_position);$i++)
	{
		$Rot = `xform -q -ro -ws $target_position[$i]`;
		rotate -ws $Rot[0] $Rot[1] $Rot[2] $object_to_move[$i];
		rotate -ws $Rot[0] $Rot[1] $Rot[2] $object_to_move[$i];
		rotate -ws $Rot[0] $Rot[1] $Rot[2] $object_to_move[$i];
	}
}
global proc vector[] SHIFT3_2_2bf8a8136110c57d5b95308ba444b308(vector $coords[])
{
    vector $final_coords[]={};
    vector $radius;
    int $index_mass[];
    for($i=0;$i<size($coords);$i++)
        $index_mass[$i]=1;
    for($i=0;$i<size($coords)-1;$i++)
	{
        if($index_mass[$i]==1&&$index_mass[$i+1]==1)
        {
            $radius=$coords[$i]-$coords[$i+1];
            for($k=$i+2;$k<size($coords);$k++)
                if(`mag $radius`>`mag ($coords[$i]-$coords[$k])`)
                    $index_mass[$k]=0;
        }
	}
	int $j=0;
    for($i=0;$i<size($coords);$i++)
	{
        if($index_mass[$i]==1)
        {
            $final_coords[$j]=$coords[$i];
            $j++;
        }
	}
    return  $final_coords;
}
global proc vector[] SHIFT3_2_72356eaf232b169651a82383ba9e7e57(string $objects[])
{
    vector $vec_pos[];
    $i=0;
	float $pos[];
   for($obj in $objects)
   {
       $pos=SHIFT3_2_8598296823aa3af15686cb0d78f1615d($obj);
       $vec_pos[$i]=<<$pos[0],$pos[1],$pos[2]>>;
       $i++;
   }
   return $vec_pos;
}
global proc SHIFT3_2_bb5805895dc14a829576cd013ec234e4(string $objects[])
{
    string $result[];
    string $channels[]={".tx",".ty",".tz",".rx",".ry",".rz"};
    for($obj in $objects)
    {
        for($ch in $channels)
        {
            $result=`listConnections -d off -s on ($obj + $ch)`;
            if($result[0]=="")
            {
               catchQuiet (`setKeyframe -breakdown 0 -hierarchy none -controlPoints 0 -shape 0 ($obj + $ch)`);
            }
        }
    }
}
global proc SHIFT3_2_847308ac6f1debf8edcc8d63e128d64c(string $target_position[], string $object_to_move[])
{
    if(size($target_position)!=size($object_to_move))
		warning "size objects to move is DIFFERENT!!! Only relevant objects will be processed! This can lead to unexpected consequences!!!!";
	if(size($target_position)> size($object_to_move))
		$target_position=`ls -head (size($object_to_move)) $target_position`;
	float $Trans[];
	for($i=0;$i<size($target_position);$i++)
	{
        $Trans=SHIFT3_2_8598296823aa3af15686cb0d78f1615d($target_position[$i]);
		move -rpr $Trans[0] $Trans[1] $Trans[2] $object_to_move[$i];
		move -rpr $Trans[0] $Trans[1] $Trans[2] $object_to_move[$i];
		move -rpr $Trans[0] $Trans[1] $Trans[2] $object_to_move[$i];
	}
}