global proc string[] SHIFT3_2_54d92f8424c4459e6d996d9fd93902f0()
{
	string $selection[];
	$selection_true = `ls -fl -sl `;
	$selection = `ls -fl -os`;
	string $locators[];
	string $b[];
	if (size ($selection)>0)
	{
		$j=0;
		for($obj in $selection)
		{
			$getPvPos=SHIFT3_2_8598296823aa3af15686cb0d78f1615d($obj);
			$b=`spaceLocator -p 0 0 0`;
			$locators[$j]=$b[0];
			xform -ws -t $getPvPos[0] $getPvPos[1] $getPvPos[2] $b[0];
			rotate -ws $getPvPos[3] $getPvPos[4] $getPvPos[5]  $b[0];
			$j++;
		}
		select -cl;
		for($obj in $locators)
		{
			select -add $obj;
		}
	}
	else
	{
		$locators = `spaceLocator -p 0 0 0`;
	}
	return $locators;
}
global proc string SHIFT3_2_83a9015d514ecd1326a1648b28396ba2(vector $coords[],int $interp)
{
	string $pnt = "";
	if (size ($coords)<=1)
	{
		warning "need 2 object or points";
		return "";
	}
	for ($i=0;$i<size($coords);$i++)
	{
		$pnt= $pnt + " -p " + $coords[$i];
	}
	$curve_name=`eval("curve" + $pnt + "-d " + $interp)`;
	return $curve_name;
}
global proc float[] SHIFT3_2_44d7389cf1da23b6064a4bcbaf8f4f7b(string $curve, float $position)
{
    string $curve_Shape[] = `listRelatives -shapes -f -type "nurbsCurve" $curve`;
	int $numCVs = `getAttr -size ($curve_Shape[0] + ".controlPoints")`;
	catchQuiet(`setAttr ($curve_Shape[0] + ".lockLength") 0`);
    float $CVpos1[],$CVpos2[],$fin_position[];
	$CVpos1=SHIFT3_2_8598296823aa3af15686cb0d78f1615d($curve + ".cv[0]");
	$CVpos2=SHIFT3_2_8598296823aa3af15686cb0d78f1615d($curve + ".cv[" + ($numCVs-1) + "]");
	$fin_position=SHIFT3_2_d43bd93439ed3879a3deac8b4d5b5d0d($CVpos1,$CVpos2,$position);
    string $CV_locators[],$top_aim[], $parents[], $tmp_cuv_name[], $tmp_CV_lock_name[];
    $CV_locators=SHIFT3_2_526c020cd7c9a859fd08d49719a4fddf({$curve + ".cv[0]",$curve + ".cv[" + ($numCVs-1) + "]"});
    $top_aim=`duplicate $CV_locators[0]`;
    if(`upAxis -q -axis`=="z")
        move -r -ws 0 0 10 $top_aim;
    else
        move -r -ws 0 10 0 $top_aim;
	delete `aimConstraint -offset 0 0 0 -weight 1 -aimVector 0 -1 0 -upVector 0 0 1 -worldUpType "object" -worldUpObject $top_aim[0] $CV_locators[1] $CV_locators[0]`;
	move -a -ws $fin_position[0] $fin_position[1] $fin_position[2] $CV_locators[0];
	$parents=`listRelatives -p $curve`;
	$tmp_CV_lock_name[0]=$curve;
	$tmp_CV_lock_name[0]=$CV_locators[0];
	if($parents[0]!="")
	    $tmp_CV_lock_name=`parent $CV_locators[0] $parents[0]`;
	$tmp_cuv_name=`parent $curve $tmp_CV_lock_name[0]`;
	makeIdentity -apply true -t 1 -r 1 -s 0 -n 0 -pn 1 $tmp_cuv_name;
	makeIdentity -apply 0 -t 1 -r 1 -s 0 -n 0 -pn 1 $tmp_cuv_name;
	if($parents[0]!="")
	    $tmp_cuv_name=`parent $tmp_cuv_name $parents[0]`;
	else
	    $tmp_cuv_name=`parent -w $tmp_cuv_name`;
	if($tmp_cuv_name[0]!=$curve)
	    rename $tmp_cuv_name[0] $curve;
	delete -ch $tmp_cuv_name[0];
	delete $CV_locators $top_aim $tmp_CV_lock_name;
    return {$CVpos1[0],$CVpos1[1],$CVpos1[2],$CVpos2[0],$CVpos2[1],$CVpos2[2]};
}
