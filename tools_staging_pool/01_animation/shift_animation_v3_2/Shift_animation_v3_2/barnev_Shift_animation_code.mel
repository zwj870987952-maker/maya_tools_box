global proc float[] SHIFT3_2_4456cc602c2236c5ece51bee2a5b2ee6(string $curve_name,float $StartStopVal[], int $AbsRelMode)
{
	float $startValue =$StartStopVal[0];
	float $stopValue =$StartStopVal[1];
	float $spValues[] =  `keyframe -q -vc  $curve_name`;
	float $percentage[]=SHIFT3_2_629955dac26448fd4dac7dd44010a6ea($curve_name);
	$tot_len= SHIFT3_2_6878d678f96f9a2494927fe9200e401e($curve_name);
	float $totalPoseLayerChange = abs($stopValue - $startValue);
	float $previousValue = $startValue;
	float $poseLayerFCurves[]={0.0};
	$i=0;
	float  $currentValue,$valueDelta,$value;
	if($tot_len!=0)
	{
    	for($value in $percentage)
    	{
    		$valueDelta=($totalPoseLayerChange/100)*$value;
    		if ($stopValue > $startValue)
    			$currentValue = $previousValue + $valueDelta;
    		else
    			$currentValue = $previousValue - $valueDelta;
    		if($AbsRelMode==0)
    			$poseLayerFCurves[$i]= $currentValue;
    		else
    			$poseLayerFCurves[$i]= $currentValue + $spValues[$i];
    		$previousValue = $currentValue;
    		$i++;
    	}
    }
    else
    {
        $valueDelta=($totalPoseLayerChange/(size($percentage)));
        for($value in $percentage)
        {
			if ($stopValue > $startValue)
    			$currentValue = $previousValue + $valueDelta;
    		else
    			$currentValue = $previousValue - $valueDelta;
    		if($AbsRelMode==0)
    			$poseLayerFCurves[$i]= $currentValue;
    		else
    			$poseLayerFCurves[$i]= $currentValue + $spValues[$i];
    		$previousValue = $currentValue;
    		$i++;
    	}
    }
	return $poseLayerFCurves;
}
