// Shift_animation tool
// Author: Pavel Barnev pavel_barnev2000@mail.ru
// Installation:
// Quick Installation:
    // unzip the file into a directory of choice
    // Start Maya.
    // Drag file:
	// drag_and_drop_THIS_FILE_on_maya_window_for_install_Shift_animation_tool.mel
	// into a MAYA window. The script icon will appear on Custom tab on the Shelf Editor
// This tool is for:
	// Most effective - working with motion capture
	// Correction of moving animation without feet sliding
	// Shifting animation without feet sliding
	// Recalculating the animation from a different pose
	// Rotating the animation without feet sliding
// How it works.
	// The tool looks for a selected animation layer
	// Determines which objects are in the layer
	// Determines how the objects moved with the layer and how they moved without it
	// Based on this data, calculates the shift
	// It works via acceleration analysis algorithm
	// In other words, the movement of objects is calculated in a way, that extra shifting in the layer would happen in areas where the object is moving in source animation
// Using the tool:
	// Start the tool
	// Select feet, main control and pelvis (depends on a task, can be different objects)
	// Move them to a separate animation layer (the tool will work with objects on this layer)
	// Shift the object within the new layer the way you need
	// Select the layer
	// Press "MATCH from animLayer"
	// The tool will recalculate the shift to the same animation layer
// Extra information.
	// The more footsteps in the animation and the longer the animation, the better and smoother the result will be
	// If you need to both shift and rotate the animation, it's better to do it in 2 passes. Shift in the first pass, rotate in the second one
	// If you need to shift an animation with hands (e.g. running on all fours or jumping over obstacles using a hand) then add the hand to the initial animation layer
	// You can do multiple shifts, the tool will analyze the distances between the keys and will calculate the shift
	// Careful! Curve tangents are irrelevant, only keys values matter. The shift between them is calculated linearly
// SHIFTING_animation_menue()
global proc SHIFTING_animation_menue()
{
	float $white[]={0.98,0.98,0.98};
	float $red[]={0.98,0.75,0.75};
	float $red_light[]={0.95,0.88,0.88};
	float $green[]={0.85,0.98,0.85};
	float $green_light[]={0.9,0.95,0.9};
	float $blue[]={0.78,0.78,0.98};
	float $blue_light[]={0.9,0.9,0.95};
    if(`window -q -ex "SHIFTING_animation"`)deleteUI("SHIFTING_animation");
    window  -bgc $white[0] $white[1] $white[2]
			-minimizeButton false
			-maximizeButton false
			-titleBar true
			-menuBar true
			-title "SHIFTING v.3_2" "SHIFTING_animation";
    window -e -w 200 - h 80 "SHIFTING_animation";
		columnLayout -adj 1"cceu1";
			button  -h 60
					-p "cceu1"
					-bgc $green[0] $green[1] $green[2]
					-label "MATCH from animLayer"
					-ann " - calculate animation shift in selected layer"
					-c " SHIFT3_2_d3d5060e35d6738adc9ec43bc95dfe74; SHIFT3_2_692e2fda85cadfdf0f28e93323f58c08(); SHIFT3_2_36e868f70d3bc857bf7c0d874db1cf86(1); SHIFT3_2_f4b1a2b52ab1771321003f86cde63160; SHIFT3_2_e322163f473d9ee1fb5be6b3f746dab1()";
			button  -h 25
					-p "cceu1"
					-bgc $blue[0] $blue[1] $blue[2]
					-label "extract to separate animLayer"
					-ann " extract selected to separate animLayer"
					-c "SHIFT3_2_21b7c17e232d97d5c941030f7d497200(`ls-sl`)";
frameLayout
	-p "cceu1"
	-bgc $red_light[0] $red_light[1] $red_light[2]
	-ebg true -bv false
	-cl 1 -cll true
	-l "path from layer"
	-la "top"
	-mw 0
	-mh 0
	-cc "catchQuiet(`window -e -h 100 SHIFTING_animation`)"
	eu1;
			button  -h 60
					-p "eu1"
					-bgc $green[0] $green[1] $green[2]
					-label "AUTOPATH from animLayer"
					-ann " - calculate animation by path in selected layer. Main control must be moving. Good work with rootmotion animation only "
					-c " SHIFT3_2_692e2fda85cadfdf0f28e93323f58c08; SHIFT3_2_8327291d23e32e708ec222974d35f87a(`intField -q -v CV_byAnim`,`textField -q -tx curve_calculate`,`checkBox -q -v flat_vert`,0); SHIFT3_2_d0162d537d4e82bff3de890c7c1b848d(`intField -q -v framesEasing`, 0,`checkBox -q -v vert_independ`); SHIFT3_2_f4b1a2b52ab1771321003f86cde63160;";
       rowLayout
			-p "eu1"
			-nc 8 -adj 4
			RW_lay_name;
							textField
								-ekf 0
								-font  "obliqueLabelFont"
								-pht "autodetection"
								-bgc $blue_light[0] $blue_light[1] $blue_light[2]
								-ann "set name object for curve calculatin within the scene or selected frameRange. Set nothing for AUTO mode"
								 "curve_calculate";
							button -l "<<"
									-ann "create a curve from object animation within the scene or selected frameRange. Set nothing for AUTO mode"
									-c "$curve_name =`ls-fl-sl`;textField -edit -tx $curve_name[0] curve_calculate;" "set_curve_name";
							text -ann "set object name for curve calculating or nothing for AUTO mode" -l " curve object";
							text "";
			rowLayout
			-p "eu1"
			-nc 8 -adj 4
					RW_lay;
					intField
							-w 50
							-v 5
							-bgc $blue_light[0] $blue_light[1] $blue_light[2]
							-ann "CV by anim range"
							-ekf 0
							-min 1
							-s 1 "CV_byAnim";
					text
							-ann "CV by anim range"
							-l "<CV   ";
					checkBox -l "flat"
							-ann "create curve with flat vertical translate"
							-v true "flat_vert";
					text
							-l "";
					text
							-ann "in how many frames the bending will be softened if it was applied to part of the animation. If Easing=0 then the last few CVs should be left unchanged when not using rootMotion."
							-l "easing>";
					intField
							-w 20
							-bgc $blue_light[0] $blue_light[1] $blue_light[2]
							-ekf 0
							-v 10
							-ann "in how many frames the bending will be softened if it was applied to part of the animation"
							-min 0
							-s 1 "framesEasing";
			rowLayout
			-p "eu1"
			-nc 2 -adj 4
					RW_lay_ind;
					checkBox -l "vertical independent"
							-ann "create curve with flat vertical translate"
							-v true "vert_independ";
	   frameLayout
			-p "eu1"
			-bgc $red_light[0] $red_light[1] $red_light[2]
			-ebg true -bv false
			-cl 1 -cll true
			-l "manual path"
			-la "top"
			-mw 0
			-mh 0
			-cc "catchQuiet(`window -e -h 150 SHIFTING_animation`)"
			SHifting_by_path;
		columnLayout -bgc $red_light[0] $red_light[1] $red_light[2] -adj 1 -p "SHifting_by_path" "eu2";
		separator -st "none" -bgc $red_light[0] $red_light[1] $red_light[2] -h 10 -p "eu2";
			button  -h 40
					-bgc $red[0] $red[1] $red[2]
					-label "create path curve"
					-ann "create path curve from layer"
					-c " SHIFT3_2_692e2fda85cadfdf0f28e93323f58c08; SHIFT3_2_8327291d23e32e708ec222974d35f87a(`intField -q -v CV_byAnim`,`textField -q -tx curve_calculate`,`checkBox -q -v flat_vert`,0); SHIFT3_2_f4b1a2b52ab1771321003f86cde63160;";
			rowLayout -p "eu2" -nc 8 -adj 2
					-bgc $red_light[0] $red_light[1] $red_light[2]
					RW_layINTR;
					columnLayout -bgc $blue_light[0] $blue_light[1] $blue_light[2] -adj 1 -p "RW_layINTR" clmn_unlock;
							button
									-h 20
									-p "clmn_unlock"
									-w 40
									-label "lock_len"
									-ann "lock the lenght of the curve"
									-c "SHIFT3_2_c0333f01c0305441f7e870d2e8681fb9" "lock_len";
							separator -st "none" -bgc $red_light[0] $red_light[1] $red_light[2] -h 1 ;
							button -h 20
									-p "clmn_unlock"
									-l "unlock_len"
									-ann "unlocks the length of the curve"
									-c "UnlockCurveLength" "unlock_len";
					button	-p "RW_layINTR" -l "project" -h 40
							-ann "projecting to another curve. Select curve and another curve"
							-c "SHIFT3_2_9ae282fb1fe972d565d0cedb2f703421()";
					columnLayout -bgc $blue_light[0] $blue_light[1] $blue_light[2] -adj 1 -p "RW_layINTR" clmn_curve_ctrl;
							button
									-h 20
									-p "clmn_curve_ctrl"
									-w 40
									-label "curve control"
									-ann "curve control through objects in each CV"
									-c "SHIFT3_2_2948842313131fcddb41ac6ad1efd38c;";
							separator -st "none" -bgc $red_light[0] $red_light[1] $red_light[2] -h 1 ;
							rowLayout  -p "clmn_curve_ctrl" -nc 2 Curve_CTRL;
											button -h 20
													-l "arrange"
													-ann "rearrange curve control"
													-c "SHIFT3_2_dfd04e9fc8891230ecf4649c050058d5;" "reparent";
											button -h 20
													-p "Curve_CTRL"
													-l "delete"
													-ann "delete the system while maintaining the shape of the curve"
													-c "SHIFT3_2_4ec8ec2e22058b36b7f19c5b04a2deed" ;
			button 	-h 40
					-p "eu2"
					-bgc $green[0] $green[1] $green[2]
					-w 20
					-label "apply"
					-ann "calculate from curve and animLayer"
					-c " SHIFT3_2_692e2fda85cadfdf0f28e93323f58c08;catch(SHIFT3_2_d0162d537d4e82bff3de890c7c1b848d(`intField -q -v framesEasing`, 0,`checkBox -q -v vert_independ`)); SHIFT3_2_f4b1a2b52ab1771321003f86cde63160;";
			separator -st "none" -bgc $red_light[0] $red_light[1] $red_light[2] -h 10 -p "eu2";
frameLayout
		-p "eu1"
		-bgc $green_light[0] $green_light[1] $green_light[2]
		-ebg true
		-cl 1 -cll 1
		-l "utililies"
		-la "top"
		-mw 0
		-mh 0
		-cc "catchQuiet(`window -e -h 150 SHIFTING_animation`)"
		SHifting_instuments_frame;
		columnLayout
			-adj 1 -rowSpacing 0 -p "SHifting_instuments_frame" SHifting_instuments;
			frameLayout
					-p "SHifting_instuments"
					-bgc $white[0] $white[1] $white[2]
					-ebg 1 -bv false
					-cl 1 -cll 1
					-l "rootmotion"
					-la "top"
					-mw 3
					-mh 0
					-cc "catchQuiet(`window -e -h 150 SHIFTING_animation`)"
					SHifting_rootmotion_fr;
						columnLayout
			-adj 1 -p "SHifting_rootmotion_fr" SHifting_rootmotion;
				rowLayout
				-nc 3;
				textField  -ekf 0
						-font  "obliqueLabelFont"
						-pht "insert Main"
						-bgc $blue_light[0] $blue_light[1] $blue_light[2]
						-ann "set name object for curve calculatin within the scene or selected frameRange. Set nothing for AUTO mode"
						 "rootField";
				button -l "<<"
						-c "$curve_name =`ls-fl-sl`;textField -edit -tx $curve_name[0] rootField;";
				text -l " insert root";
				rowLayout -p "SHifting_rootmotion" -nc 3;
				textField  -ekf 0
						-font  "obliqueLabelFont"
						-pht "insert Pelvis"
						-bgc $blue_light[0] $blue_light[1] $blue_light[2]
						-ann "set name object for curve calculatin within the scene or selected frameRange. Set nothing for AUTO mode"
						pelvisField;
				button -l "<<"
						-c "$curve_name =`ls-fl-sl`;textField -edit -tx $curve_name[0] pelvisField;";;
				text -l " insert movable"
						- ann "insert the name of the moving object. (pelvis or stationary object to fix the root) ";
				columnLayout -p "SHifting_rootmotion" -adj true;
				rowLayout -p "SHifting_rootmotion" -nc 3 -adj 2;
				checkBox -l "rotate"
						-ann "rootmotion rotation"
						-v 0 "rotate_mode";
				text "";
				checkBox -l "flat"
						-ann "flat from first root position"
						-v 1 "flat_mode";
				button -l "calculate rootmotion"
						-bgc $blue_light[0] $blue_light[1] $blue_light[2]
						-p "SHifting_rootmotion"
						-ann "place in animLayer all rig controls, the movement of which must be preserved (usually Legs, Knee, Pelvis), insert Main control, insert Pelvis control"
						-c "SHIFT3_2_692e2fda85cadfdf0f28e93323f58c08; catch(SHIFT3_2_f86532f512c57532bf69080729fb7c0c(`textField -q -tx rootField`, `textField -q -tx pelvisField`, `checkBox -q -v rotate_mode`, `checkBox -q -v flat_mode`)); SHIFT3_2_f4b1a2b52ab1771321003f86cde63160;";
				separator -st "none"
				-h 10
				-p "SHifting_rootmotion";
		frameLayout
			-p "SHifting_instuments"
			-bgc $white[0] $white[1] $white[2]
			-ebg 1 -bv false
			-cl 1 -cll 1
			-l "circle walk"
			-la "top"
			-mw 3
			-mh 3
			-cc "catchQuiet(`window -e -h 150 SHIFTING_animation`)"
			SHifting_circular_fr;
			columnLayout
			-rowSpacing 2
			-adj 1 -p "SHifting_circular_fr" SHifting_circular;
			          rowLayout
							-p "SHifting_circular"
							-nc 8 -adj 4
							RW_circle;
											textField
												-ekf 0
												-font  "obliqueLabelFont"
												-pht "autodetection"
												-bgc $blue_light[0] $blue_light[1] $blue_light[2]
												-ann "set name object for curve calculatin within the scene or selected frameRange. Set nothing for AUTO mode"
												 "curve_calculate_circle";
											button -l "<<"
													-ann "create a curve from object animation within the scene or selected frameRange. Set nothing for AUTO mode"
													-c "$curve_name =`ls-fl-sl`;textField -edit -tx $curve_name[0] curve_calculate_circle;";
											text -ann "set object name for curve calculating or nothing for AUTO mode" -l " curve object";
											text "";
							button -l "create bend curve"
									-bgc $blue_light[0] $blue_light[1] $blue_light[2]
									-p "SHifting_circular"
									-ann "place in animLayer all rig controls, the movement of which must be preserved (usually Legs, Knee, Pelvis), insert Main control, insert Pelvis control"
									-c "SHIFT3_2_692e2fda85cadfdf0f28e93323f58c08; SHIFT3_2_8327291d23e32e708ec222974d35f87a(1,`textField -q -tx curve_calculate_circle`,1,1); SHIFT3_2_f4b1a2b52ab1771321003f86cde63160; SHIFT3_2_762f049a0ffb16260649a1d60212ee9f()";
							button -l "calculate circle walk"
									-bgc $blue_light[0] $blue_light[1] $blue_light[2]
									-p "SHifting_circular"
									-ann "place in animLayer all rig controls, the movement of which must be preserved (usually Legs, Knee, Pelvis), insert Main control, insert Pelvis control"
									-c " SHIFT3_2_692e2fda85cadfdf0f28e93323f58c08;catch(SHIFT3_2_d0162d537d4e82bff3de890c7c1b848d(0, 0,0)); SHIFT3_2_f4b1a2b52ab1771321003f86cde63160";
								separator -st "none"
									-h 10
									-p "SHifting_circular";
			   button 	-h 25
				-p "SHifting_instuments"
				-bgc $blue[0] $blue[1] $blue[2]
				-w 20
				-label "Euler filter"
				-ann " - normalized Euler filter on selected objects"
				-c "SHIFT3_2_09f1edc0a69a4931b08e1bcc40e94a55 ";
	   rowLayout  -p "cceu1" -numberOfColumns 2 -adj 2 "ggg";
			button      -h 25
						-p "ggg"
						-bgc 0.9 0.9 0.9
						-w 20
						-label "VP"
						-ann " - In case something goes wrong and the viewport doesn't respond "
						-c " SHIFT3_2_f4b1a2b52ab1771321003f86cde63160 ;";
columnLayout -p "ggg" -adj 1   "podpis";
				text    -h 16
						-p  "podpis"
						-al "right"
						-ww false
						-fn smallObliqueLabelFont
						-l " (c) Pavel Barnev";
				text    -h 16
						-p  "podpis"
						-al "right"
						-ww false
						-fn obliqueLabelFont
						-l "    pavel_barnev2000@mail.ru";
    showWindow "SHIFTING_animation";
}
global proc SHIFT3_2_8327291d23e32e708ec222974d35f87a(int $points_on_animrange, string $curve_calcul_object, int $flat, int $circle_mod)
{
    global string $AUTOPATH_error;
	$AUTOPATH_error="";
    global string $AUTOPATH_second_curve;
    global string $AUTOPATH_base_curve;
    global string $AUTOPATH_base_objects[];
	global float  $AUTOPATH_framernge[];
	global string $AUTOPATH_curr_selected_layers[];
	global int $AUTOPATH_circle_mod;
	global int $AUTOPATH_curve_obj_in_layer;
	global string $AUTOPATH_circle_fake_curve;
	global float $AUTOPATH_circle_position[];
	$AUTOPATH_circle_mod=$circle_mod;
	$AUTOPATH_base_objects={};
	$AUTOPATH_circle_fake_curve="";
    $AUTOPATH_curr_selected_layers = getSelectedAnimLayer("AnimLayerTab");
	if($AUTOPATH_curr_selected_layers[0]==""||$AUTOPATH_curr_selected_layers[0]=="BaseAnimation"||size($AUTOPATH_curr_selected_layers)>1)
	{
		print "*****************************************************************\n";
		print "ERROR:    no animation layer found!!!!!! Select animation layer!!!\n";
		print "*****************************************************************\n";
		$AUTOPATH_error="error";
		return;
	}
	layerEditorSelectObjectAnimLayer($AUTOPATH_curr_selected_layers);
	string $obj_in_layer[],$tmp_obj[];
	$obj_in_layer=`ls-fl-sl`;
	if ($curve_calcul_object=="")
	{
		$tmp_obj=SHIFT3_2_ab8c8018d47d542b750e72df0fa0b3ee();
		$obj_in_layer=$tmp_obj;
		$curve_calcul_object=$tmp_obj[0];
	}
  $AUTOPATH_curve_obj_in_layer = stringArrayContains($curve_calcul_object, $obj_in_layer);
	if($AUTOPATH_curve_obj_in_layer)
	{
		stringArrayInsertAtIndex(0, $obj_in_layer, $curve_calcul_object);
		$obj_in_layer=`ls -fl $obj_in_layer`;
		$obj_in_layer=stringArrayRemoveDuplicates($obj_in_layer);
		$obj_in_layer=`ls -fl $obj_in_layer`;
	}
	select -cl;
	print "***************************\n";
	print "***************************\n";
	print "create curve from  ";
	print $curve_calcul_object;
	print "\n***************************\n";
	print "***************************\n";
	$AUTOPATH_base_objects=$obj_in_layer;
    $AUTOPATH_framernge= SHIFT3_2_cb2b62a77c624e5fccb988d5e684b2e9($AUTOPATH_curr_selected_layers[0]);
	if($AUTOPATH_framernge[1]-$AUTOPATH_framernge[0]==0)
		{
			$AUTOPATH_framernge[0]=`playbackOptions -q -ast`;
			$AUTOPATH_framernge[1]=`playbackOptions -q -aet`;
		}
	$AUTOPATH_framernge[1]=$AUTOPATH_framernge[1]+1;
    float $frame_step=($AUTOPATH_framernge[1]-$AUTOPATH_framernge[0]-1)/$points_on_animrange;
    select $curve_calcul_object;
    string $tmp_cuv[],$fake_curve[];
	if(!$circle_mod)
	{
		$AUTOPATH_second_curve=SHIFT3_2_ea9ab7919e5a9de4f76ea8a166ea2117($frame_step,$AUTOPATH_framernge,0,$flat,1);
		SHIFT3_2_c0333f01c0305441f7e870d2e8681fb9;
		select $curve_calcul_object;
		animLayer -edit -mute 1 $AUTOPATH_curr_selected_layers[0];
		$AUTOPATH_base_curve=SHIFT3_2_ea9ab7919e5a9de4f76ea8a166ea2117($frame_step,$AUTOPATH_framernge,0,$flat,1);
		SHIFT3_2_c0333f01c0305441f7e870d2e8681fb9;
	}
	float $CVpos[], $cuve_len;
	if($circle_mod)
	{
		$AUTOPATH_second_curve=SHIFT3_2_ea9ab7919e5a9de4f76ea8a166ea2117(1,$AUTOPATH_framernge,0,1,0);
		$CVpos=SHIFT3_2_44d7389cf1da23b6064a4bcbaf8f4f7b($AUTOPATH_second_curve, 0);
		$cuve_len=SHIFT3_2_9cf10c253bb06da91bcfe3836a7e5f36({$CVpos[0],$CVpos[1],$CVpos[2]},{$CVpos[3],$CVpos[4],$CVpos[5]});
		$fake_curve=`duplicate $AUTOPATH_second_curve`;
		$AUTOPATH_circle_fake_curve=$fake_curve[0];
		select  $AUTOPATH_second_curve;
		SHIFT3_2_4c2952dd9f486573856c8eb6a0dc46ac(0);
		$AUTOPATH_circle_position={$CVpos[0],$CVpos[1],$CVpos[2]};
		scale -r 2 2 2  $AUTOPATH_second_curve;
		move -r -os -wd 0 ($cuve_len/2) 0 $AUTOPATH_second_curve;
		$tmp_cuv=`duplicate $AUTOPATH_second_curve`;
		$AUTOPATH_base_curve=$tmp_cuv[0];
		animLayer -edit -mute 0 $AUTOPATH_curr_selected_layers[0];
	}
    SHIFT3_2_4c2952dd9f486573856c8eb6a0dc46ac(0);
    parent $AUTOPATH_base_curve  $AUTOPATH_second_curve;
	if($circle_mod)
		parent $fake_curve[0] $AUTOPATH_second_curve;
    animLayer -edit -mute 0 $AUTOPATH_curr_selected_layers[0];
    select $AUTOPATH_second_curve;
}
global proc SHIFT3_2_762f049a0ffb16260649a1d60212ee9f()
{
    global string $AUTOPATH_second_curve;
    global string $AUTOPATH_base_curve;
    global float $AUTOPATH_circle_position[];
    global string $AUTOPATH_bend_control;
	global string $AUTOPATH_circle_fake_curve;
	parent -w $AUTOPATH_base_curve;
	SHIFT3_2_4c2952dd9f486573856c8eb6a0dc46ac(0);
	select $AUTOPATH_second_curve;
	string $bend_control[]=SHIFT3_2_54d92f8424c4459e6d996d9fd93902f0();
	rotate -a 0 0 0 $bend_control;
    move -a $AUTOPATH_circle_position[0] $AUTOPATH_circle_position[1] $AUTOPATH_circle_position[2] $bend_control[0];
    $bend_control[0]=`rename $bend_control[0] "Bend_Control"`;
    SHIFT3_2_cc20e95399a3b6da44eb78e45451d764(13);
