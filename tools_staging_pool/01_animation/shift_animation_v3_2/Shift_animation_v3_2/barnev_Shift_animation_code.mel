    if($axis=="z")
    {
        selectKey {($main_pos_lock[0] + ".translateX"), ($main_pos_lock[0] + ".translateY"),($main_pos_lock[0] + ".rotateZ")};
		if($mayaVersion<2019)
			filterCurve -f simplify -timeTolerance 0.05 ;
		else
			filterCurve -f keyReducer -selectedKeys -precisionMode 1 -precision 1.8 -preserveKeyTangent "smooth" -preserveKeyTangent "clamped";
    }
    else
    {
        selectKey {($main_pos_lock[0] + ".translateX"), ($main_pos_lock[0] + ".translateZ"),($main_pos_lock[0] + ".rotateY")};
		if($mayaVersion<2019)
			filterCurve -f simplify -timeTolerance 0.05 ;
		else
			filterCurve -f keyReducer -selectedKeys -precisionMode 1 -precision 1.8 -preserveKeyTangent "smooth" -preserveKeyTangent "clamped";
    }
    SHIFT3_2_57a906823be3ff74fc67f225ea020d49($freeze_ctrls);
    SHIFT3_2_57a906823be3ff74fc67f225ea020d49({$main_ctrl});
    select $main_ctrl $freeze_ctrls;
    $WB_layer=SHIFT3_2_c830bbb3bb6041f72a5fb76403fcabe8();
    SHIFT3_2_09f1edc0a69a4931b08e1bcc40e94a55;
    $WB_layer=`rename $WB_layer rootMotion_over`;
    setAttr ($WB_layer + ".rotationAccumulationMode") 1;
    animLayerEditorOnSelect $WB_layer 1;
    delete $main_pos_lock $parent_lock;
	return $WB_layer;
