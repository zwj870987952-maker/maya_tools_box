global proc ebLabs_animTools_screenSpaceSmartBakeMulti()
{
//get list of rigs
string $selected[] = `ls -selection`;
string $controlsToBake[];
string $errorMsg[];

//set selections
select -cl;
for($obj in $selected)
	{
	if(!(`objExists $obj`))
		{
		ebLabs_screenSpace_updateRigList;
		}
	else
		{
		if (`gmatch $obj "*_screenSpaceControl"`)
			{
			$controlsToBake[`size($controlsToBake)`] = $obj;
			}
		else
			{
			$errorMsg[`size($errorMsg)`] = ("Object isn't a screen space control: " + $obj);
			}
		}
	}

if((`size($errorMsg)`==0))
	{
	for($control in $controlsToBake)
		{

		//make sure at least one translate key on screen space control
		if((`keyframe -query -keyframeCount ($control + ".tx")`)==0 && (`keyframe -query -keyframeCount ($control + ".ty")`)==0 && (`keyframe -query -keyframeCount ($control + ".tz")`)==0)
			{
			$errorMsg[`size($errorMsg)`] = ("Object needs at least one translation key to smart bake: " + $control);
			}

		//check use orientation attribute
		int $orientationExists = `objExists ($control + ".useOrientation")`;
		int $useOrientationValue = 0;
		if($orientationExists)
			{
			$useOrientationValue = `getAttr ($control + ".useOrientation") `;
			}

		//make sure theres at least one rotation key
		if(($orientationExists)&&($useOrientationValue)&&((`keyframe -query -keyframeCount ($selected[0] + ".rx")`)==0)&&((`keyframe -query -keyframeCount ($selected[0] + ".ry")`)==0)&&((`keyframe -query -keyframeCount ($selected[0] + ".rz")`)==0))
			{
			$errorMsg[`size($errorMsg)`] = ("Object needs at least one rotation key to smart bake rotations: " + $control);
			}
		}
	}

if((`size($errorMsg)`==0))
	{
	//hide UI
	ebLabs_screenSpace_enableMayaUI(off, "ebLabs_screenSpace");

	//smart bake animation
	for($control in $controlsToBake)
		{
		ebLabs_animTools_screenSpaceSmartBake($control);
		}

	//enable UI
	ebLabs_screenSpace_enableMayaUI(on, "ebLabs_screenSpace");

	//update rig list
	ebLabs_screenSpace_updateRigList;
	}

//spit out any error message
if((`size($errorMsg)`!=0)){ebLabs_screenSpace_errorDialogue($errorMsg);}

}
//######################################################################################################################

global proc ebLabs_animTools_screenSpaceSmartBake(string $control)
{

//setup
float $now = `currentTime -query`;
string $errorMsg[];

//define variables
string $tAttributes[] = {"translateX", "translateY", "translateZ"};
string $rAttributes[] = {"rotateX", "rotateY", "rotateZ"};
string $trAttributes[] = {"translateX", "translateY", "translateZ", "rotateX", "rotateY", "rotateZ"};
string $keyPrepAttr[];

string $object = substituteAllString($control, "_screenSpaceControl", "");
string $rig = ($object + "_screenSpaceRig");
//$object = substituteAllString($object, "__", ":");

//check use orientation attribute
int $orientationExists = `objExists ($control + ".useOrientation")`;
int $useOrientationValue = 0;
if($orientationExists)
	{
	$useOrientationValue = `getAttr ($control + ".useOrientation") `;
	}

//setup list of attributes to prep
if($useOrientationValue)
	{
	$keyPrepAttr = $trAttributes;
	}
else
	{
	$keyPrepAttr = $tAttributes;
	}

//get list of keyable unlocked attributes
string $keyableList[] = `listAttr -k -u $object`;

//keyPrepSource
float $firstKey = (`findKeyframe -which first $control`);
currentTime $firstKey;
setKeyframe $control;


//key prep for destination
for($a in $keyPrepAttr)
	{
	//continue if the attribute is keyable and unlocked
	int $attrCheck = stringArrayContains($a, $keyableList);
	if($attrCheck==1)
		{
		//make sure there is a key on all tran/rot channels that are keyable/unlocked on target
		if((`keyframe -query -keyframeCount ($object + "." + $a)`)==0)
			{
			//find first keyframe time for control
			float $firstKey = (`findKeyframe -which first $control`);
			currentTime $firstKey;
			setKeyframe ($object + "." + $a);
			}
		//copy and paste keys for timing reference
		copyKey -time ":" -option keys ($control + "." + $a);
		pasteKey -option "replace" ($object + "." + $a) ;
		}
	}

//smart baking go through and set keys on available translation
for ($a in $tAttributes)
	{
	//continue if the attribute is keyable and unlocked
	int $attrCheck = stringArrayContains($a, $keyableList);
	if($attrCheck==1)
		{
		//query key count
		int $keyCount = (`keyframe -query -keyframeCount ($object + "." + $a)`);
		for ($f = 0; $f < $keyCount; $f++)
			{
			float $timeCheck[] = (`keyframe -index $f -query ($object + "." + $a)`);
			currentTime $timeCheck[0];
			//print ($object + "." + $a + " " + $timeCheck[0] + "\n" );
			//key all translations
			for ($transAttr in $tAttributes)
				{
				setKeyframe ($object + "." + $transAttr);
				}
			ebLabs_screenSpace_updateProgress($f, $keyCount, "ebLabs_sc_progress");

			}
		//print ($object + "." + $a + " " + "\n" );
		keyTangent -itt plateau -ott plateau -attribute $a ($object);
		}
	}

if($useOrientationValue)
	{

	//smart baking go through and set keys on available translation
	for ($a in $rAttributes)
		{
		//continue if the attribute is keyable and unlocked
		int $attrCheck = stringArrayContains($a, $keyableList);
		if($attrCheck==1)
			{
			//query key count
			int $keyCount = (`keyframe -query -keyframeCount ($object + "." + $a)`);
			for ($f = 0; $f < $keyCount; $f++)
				{
				float $timeCheck[] = (`keyframe -index $f -query ($object + "." + $a)`);
				currentTime $timeCheck[0];

				//key all translations
				for ($rotsAttr in $rAttributes)
					{
					setKeyframe ($object + "." + $rotsAttr);
					}
				ebLabs_screenSpace_updateProgress($f, $keyCount, "ebLabs_sc_progress");
				}
			keyTangent -itt plateau -ott plateau -attribute $a ($object);
			}
		}
	//euler filter curves
	filterCurve $object;
	}

//delete rig
delete ($rig);
select ($object);
currentTime $now;

//set progress bar to 100%
ebLabs_screenSpace_updateProgress(100, 100, "ebLabs_sc_progress");

}


//######################################################################################################################

global proc ebLabs_screenSpace_deleteRig()
{
//get selection from list
string $selectListObjects[] = `textScrollList -q -si eb_labs_screenSpace_rigList`;
string $deleteMe[];

//set selections
select -cl;
for($obj in $selectListObjects)
	{
	if(!(`objExists $obj`))
		{
		ebLabs_screenSpace_updateRigList;
		}
	else
		{
		$deleteMe[`size($deleteMe)`] = $obj;
		}
	}

//run through and delete rigs
for($control in $deleteMe)
	{

	//figure out rig name
	string $rig = substituteAllString($control, "_screenSpaceControl", "");
	$rig = ($rig + "_screenSpaceRig");

	if(`objExists $rig`)
		{
		//print ($rig + "\n");
		delete $rig;
		}
	}
ebLabs_screenSpace_updateRigList;
}


//######################################################################################################################

global proc ebLabs_animTools_screenSpaceRig(string $inputCam, string $inputObj)
{

//setup
float $now = `currentTime -query`;

//orientation checkbox
int $orientationChkBox = `checkBox -q -v ebLabs_sc_orientationChkBox`;

//check if its possible to have orientation, of not, then set this off
if($orientationChkBox==1)
	{
	if((`keyframe -query -keyframeCount ($inputObj + ".rx")`)==0 && (`keyframe -query -keyframeCount ($inputObj + ".ry")`)==0 && (`keyframe -query -keyframeCount ($inputObj + ".rz")`)==0)
		{
		//override checkbox
		$orientationChkBox = 0;
		}
	}

//channel lists
string $trAttributes[] = {"translateX", "translateY", "translateZ", "rotateX", "rotateY", "rotateZ"};
string $tAttributes[] = {"translateX", "translateY", "translateZ"};
string $rAttributes[] = {"rotateX", "rotateY", "rotateZ"};

//set buffer curves for source object
bufferCurve -overwrite true $inputObj;

//define variables and gather data
string $camera = substituteAllString($inputCam, ":", "__");
$camera = substituteAllString($camera, "|", "__");
string $object = $inputObj;
string $rigGroup = $object + "_screenSpaceRig";
string $controlGroup = $object + "_controlGroup";
string $aimGroup = $object + "_aimGroup";
string $depthLoc = $object + "_zDepth";
string $newControl = $object + "_screenSpaceControl";
string $camConstraint = $object + "_pcCam_" + $camera;
string $aimConstraint = $object + "_ac_" + $camera;
string $orientConstraint = $object + "_oc_" + $camera;
string $pointConstraint = $object + "_pc_" + $camera;
string $aimControlConstraint = $object + "_acControl_" + $camera;
string $camShp[] = `listRelatives -fullPath -type "camera" -shapes $inputCam`;
//float $camClipPlanes[] = `getAttr ($camShp[0] + ".nearClipPlane")`;
//float $camClipPlane =  $camClipPlanes[0];
float $camClipPlane = `getAttr ($camShp[0] + ".nearClipPlane")`;

//groups and parenting
group -em -name $rigGroup;
group -em -name $controlGroup;
group -em -name $aimGroup;
spaceLocator -n $depthLoc;

//make a different control object depending on the orient check box
if($orientationChkBox)
	{
	ebLabs_screenSpace_makeCurveCube($newControl);
	scale  .1 .1 .1 $newControl;
	}else{
	circle -r 0.1 -n $newControl;
	}

//apply rando colours
ebLabs_screenSpace_setRandoColor({$newControl});

//freeze transformation on new control
makeIdentity -apply true -t 0 -r 0 -s 1 -n 0 $newControl;

//match rotation orders, not needed except for orientation mode
float $getOrder = (`getAttr ($inputObj + ".rotateOrder")`);
setAttr ($newControl + ".rotateOrder") $getOrder;

//finish up parenting
parent ($newControl) ($controlGroup);
parent ($controlGroup) ($rigGroup);
parent ($aimGroup) ($rigGroup);
parent ($depthLoc) ($aimGroup);
parentConstraint -n ($camConstraint) $inputCam ($rigGroup);
aimConstraint -n ($aimConstraint) ($newControl) ($aimGroup);

//add attributes to new control
addAttr -ln "zDepth"  -at double  ($newControl);
setAttr -e-keyable true ($newControl + ".zDepth");
setKeyframe ($newControl + ".zDepth");

addAttr -ln "planeAdjust"  -at double  ($newControl);
setAttr -cb true ($newControl + ".planeAdjust");
setAttr ($newControl + ".planeAdjust") 1;

addAttr -ln "controlRadius"  -at double  ($newControl);
setAttr -cb true ($newControl + ".controlRadius");
setAttr ($newControl + ".controlRadius") 1;

if($orientationChkBox)
	{
	addAttr -ln "useOrientation"  -at bool  ($newControl);
	setAttr -cb true ($newControl + ".useOrientation");
	setAttr ($newControl + ".useOrientation") 1;
	//set min and max
	}

//pre-key all rotation channels on first frame, for using maintain offset with orient constraint
if($orientationChkBox)
	{
	for ($a in $rAttributes)
		{
		//find first keyframe set a key on all rotation channels
		float $firstKey = `findKeyframe -which first $inputObj`;
		currentTime $firstKey;
		setKeyframe ($newControl + "." + $a);
		}
}

//go through keys on input object and set keys on new control
for ($a in $tAttributes)
	{
	//get keyable list on input object
	string $keyableList[] = `listAttr -k -u $inputObj`;
	int $attrCheck = stringArrayContains($a, $keyableList);

	//query key count
	int $keyCount = `keyframe -q -keyframeCount ($inputObj + "." + $a)`;

	if(($keyCount>0)&&($attrCheck==1))
		{
		for ($f = 0; $f < $keyCount; $f++)
			{

			//query keyframe time and go there
			float $timeCheck[] = `keyframe -index $f -query ($inputObj + "." + $a)`;
			currentTime $timeCheck[0];

			//update progress bar
			ebLabs_screenSpace_updateProgress($f, $keyCount, "ebLabs_sc_progress");

			//get aligned position
			float $objectPos[] = `xform -q -ws -rp ($inputObj)`;
			float $camPos[] = `xform -q -ws -rp ($inputCam)`;
			move -ws ($objectPos[0]) ($objectPos[1]) ($objectPos[2]) ($newControl);
			move -ws ($objectPos[0]) ($objectPos[1]) ($objectPos[2]) ($depthLoc);

			//get local values, normalize to z
			//divide x,y,z by distance(or rather magnitude), this will calculate x and y position with a fixed z value of 1
			float $normalizer = (`getAttr ($newControl + ".tz")`);
			$normalizer = `abs $normalizer`;

			//this is a bit of code to handle an object going behind the camera, or closer than z value 1
			if((`getAttr ($newControl + ".tz")`)>-1)
				{
				//creates a new normalization value that is 1 unit distant to the camera
				vector $diffVector = <<($objectPos[0]-$camPos[0]), ($objectPos[1]-$camPos[1]), ($objectPos[2]-$camPos[2])>>;
				$normalizer = `mag $diffVector`;
				}

			//key control and depth locator
			setAttr ($newControl + ".tx") ((`getAttr ($newControl + ".tx")`)/$normalizer);
			setAttr ($newControl + ".ty") ((`getAttr ($newControl + ".ty")`)/$normalizer);
			setAttr ($newControl + ".tz") ((`getAttr ($newControl + ".tz")`)/$normalizer);
			setKeyframe ($newControl + ".tx");
			setKeyframe ($newControl + ".ty");
			setKeyframe ($newControl + ".tz");
			setKeyframe ($depthLoc + ".tx");
			keyTangent -itt auto -ott auto -attribute translateZ $newControl;
			}
		}
	}

//if orientation is included, key rotation
if($orientationChkBox)
	{

	//add orient constraint after key is addd to new control
	orientConstraint -n ($orientConstraint) ($inputObj) ($newControl);

	//go through rotation channel keys
	for ($a in $rAttributes)
		{

		//get keyable list on input object
		string $keyableList[] = `listAttr -k -u $inputObj`;
		int $attrCheck = stringArrayContains($a, $keyableList);

		//query key count
		int $keyCount = `keyframe -q -keyframeCount ($inputObj + "." + $a)`;

		if(($keyCount>0)&&($attrCheck==1))
			{
			//query key count
			int $keyCount = `keyframe -q -keyframeCount ($inputObj + "." + $a)`;
				for ($f = 0; $f < $keyCount; $f++)
				{
				//query keyframe time and go there
				float $timeCheck[] = `keyframe -index $f -query ($inputObj + "." + $a)`;
				currentTime $timeCheck[0];

				//update progress bar
				ebLabs_screenSpace_updateProgress($f, $keyCount, "ebLabs_sc_progress");

				//key all rotations
				for ($ra in $rAttributes)
					{
					setKeyframe ($newControl + "." + $ra);
					}
				}
			}
		}

	//remove constraint and apply it to $object
	delete $orientConstraint;
	}

//tidy up

//copy over z depth values
//copyKey -time ":" -option keys -attribute "tx" ($depthLoc);
cutKey -time ":" -option keys -attribute "tx" ($depthLoc);
pasteKey -option "replace" -attribute "zDepth"  ($newControl);
//delete ($depthLoc + "_translateX");

//connect attributes and set channel states
connectAttr -f ($newControl + ".zDepth") ($depthLoc + ".tx");
connectAttr -f ($newControl + ".planeAdjust") ($controlGroup + ".sx");
connectAttr -f ($newControl + ".planeAdjust") ($controlGroup + ".sy");
connectAttr -f ($newControl + ".planeAdjust") ($controlGroup + ".sz");
connectAttr -f ($newControl + ".controlRadius") ($newControl + ".sx");
connectAttr -f ($newControl + ".controlRadius") ($newControl + ".sy");
connectAttr -f ($newControl + ".controlRadius") ($newControl + ".sz");

//apply euler filter to all curves
filterCurve $newControl;

string $skipTX = "none";
string $skipTY = "none";
string $skipTZ = "none";
string $skipRX = "none";
string $skipRY = "none";
string $skipRZ = "none";

//setup parent constraint depeneding on what channels are available
string $attrList[] = `listAttr -k -u $inputObj`;

if(!(stringArrayContains("translateX", $attrList))){$skipTX = "x";}
if(!(stringArrayContains("translateY", $attrList))){$skipTY = "y";}
if(!(stringArrayContains("translateZ", $attrList))){$skipTZ = "z";}
if(!(stringArrayContains("rotateX", $attrList))){$skipRX = "x";}
if(!(stringArrayContains("rotateY", $attrList))){$skipRY = "y";}
if(!(stringArrayContains("rotateZ", $attrList))){$skipRZ = "z";}

//setup constraints
if($orientationChkBox)
	{
	//go to first frame, just so that maintain offset will match
	float $firstKey = `findKeyframe -which first $inputObj`;
	currentTime $firstKey;

	//orientConstraint -mo -sk $skipRX -sk $skipRY -sk $skipRZ -n ($orientConstraint) ($newControl) ($inputObj);
	orientConstraint -sk $skipRX -sk $skipRY -sk $skipRZ -n ($orientConstraint) ($newControl) ($inputObj);
	//print $orientConstraint;
	}
pointConstraint -sk $skipTX -sk $skipTY -sk $skipTZ -n ($pointConstraint) ($depthLoc) ($inputObj);

parent ($pointConstraint) ($rigGroup);
if($orientationChkBox==1){parent ($orientConstraint) ($rigGroup);}
setAttr -keyable false -channelBox true ($newControl + ".v");
setAttr -keyable false -channelBox false -lock true ($newControl + ".sx");
setAttr -keyable false -channelBox false -lock true ($newControl + ".sy");
setAttr -keyable false -channelBox false -lock true ($newControl + ".sz");

//if translations only keep control facing the camera
if($orientationChkBox==0){aimConstraint -n ($aimControlConstraint) -aim 0 0 1 ($inputCam) ($newControl);}

//lock orientation if translate only
if($orientationChkBox==0)
	{
	setAttr -keyable false -channelBox false -lock true ($newControl + ".rx");
	setAttr -keyable false -channelBox false -lock true ($newControl + ".ry");
	setAttr -keyable false -channelBox false -lock true ($newControl + ".rz");
	}

//move control ahead of clipping plane by a hair
setAttr ($newControl + ".planeAdjust") ($camClipPlane*1.1);


//update attr list
$attrList = `listAttr -k -u $inputObj`;

//make pairblends non keyable and link to orientation switch
for($attr in $attrList)
	{
	//print $attr;
	//fix for attributes named "blender"
	if((`gmatch $attr "blendPoint*"`)&&(!(`gmatch $attr "*blender*"`)))
		{
		setAttr -keyable false -channelBox true ($inputObj + "." + $attr);
		}
	if(`gmatch $attr "blendOrient*"`)
		{
		//connectAttr -f ($newControl + ".useOrientation") ($inputObj + "." + $attr);
		}
	}



//friendly code for user
select ($newControl);
currentTime $now;

//set progress bar to 100%
ebLabs_screenSpace_updateProgress(100, 100, "ebLabs_sc_progress");

//update rig list
ebLabs_screenSpace_updateRigList;
}


//######################################################################################################################

global proc ebLabs_animTools_screenSpaceRigMulti()
{

//get camera
string $selectedCamera[] = `textScrollList -q -si eb_labs_screenSpace_cameraList`;

//get selection
string $selected[] = `ls -selection`;

//remove cameras from selected
for ($f = 0; $f < (`size($selected)`); $f++)
	{
	if(`ebLabs_isCamera($selected[$f])`)
		{
		$selected[$f] = "";
		}
	}
$selected = stringArrayRemove({""}, $selected);


//variables
int $orientationChkBox = `checkBox -q -v ebLabs_sc_orientationChkBox`;

//error checking

string $errorMsg[];

//check if the camera exist in the scene
if(!(`objExists $selectedCamera[0]`))
	{
	$errorMsg[`size($errorMsg)`] = ("Camera doesnt exist: " + $selectedCamera[0]);
	}
if($selectedCamera[0]=="")
	{
	$errorMsg[`size($errorMsg)`] = ("Please select a camera from the list");
	}

//check if anything is selected
if(`size($selected)`==0)
	{
	$errorMsg[`size($errorMsg)`] = ("Select object in scene first.");
	}

//check if the objects exist in the scene
for($s in $selected)
	{
	if(!(`objExists $s`))
		{
		$errorMsg[`size($errorMsg)`] = ("Object doesnt exist: " + $s);
		}
	}

for($s in $selected)
	{
	//make sure that a screenspace rig isnt selected
	int $isScreenSpaceCheck =  (`gmatch $s "*_screenSpace*"`);
	if($isScreenSpaceCheck)
		{
		$errorMsg[`size($errorMsg)`] = ("Object is already a screen space rig: " + $s);
		}
	}

//check if rigs already exist
if(`size($selected)`!=0)
	{
	for($s in $selected)
		{
		//pre define variables for error checking
		string $camera = substituteAllString($selectedCamera[0], ":", "__");
		$camera = substituteAllString($camera, "|", "__");
		string $object = $s;
		string $rigGroup = $object + "_screenSpaceRig";
		string $controlGroup = $object + "_controlGroup";
		string $aimGroup = $object + "_aimGroup";
		string $depthLoc = $object + "_zDepth";
		string $newControl = $object + "_screenSpaceControl" ;
		string $camConstraint = $object + "_pcCam_" + $camera;
		string $aimConstraint = $object + "_ac_" + $camera;
		string $pointConstraint = $object + "_pc_" + $camera;
		string $aimControlConstraint = $object + "_acControl_" + $camera;

		//check that rig parts don't already exist
		if(`objExists $rigGroup`){$errorMsg[`size($errorMsg)`] = ("ScreenSpace controls already exists: " + $rigGroup);}
		if(`objExists $controlGroup`){$errorMsg[`size($errorMsg)`] = ("ScreenSpace controls already exists: " + $controlGroup);}
		if(`objExists $aimGroup`){$errorMsg[`size($errorMsg)`] = ("ScreenSpace controls already exists: " + $aimGroup);}
		if(`objExists $depthLoc`){$errorMsg[`size($errorMsg)`] = ("ScreenSpace controls already exists: " + $depthLoc);}
		if(`objExists $newControl`){$errorMsg[`size($errorMsg)`] = ("ScreenSpace controls already exists: " + $newControl);}
		if((`objExists $newControl`)||(`objExists $controlGroup`)||(`objExists $aimGroup`)||(`objExists $depthLoc`)||(`objExists $newControl`)||(`objExists $newControl`)){$errorMsg[`size($errorMsg)`] = ("Try deleting your old screen space rig first.");}

		//check that there is actualy translation animation on the object
		if((`keyframe -query -keyframeCount ($s + ".tx")`)==0 && (`keyframe -query -keyframeCount ($s + ".ty")`)==0 && (`keyframe -query -keyframeCount ($s + ".tz")`)==0)
			{
			$errorMsg[`size($errorMsg)`] = "Make sure you have at least one key on any of the translation channels";
			}
		}
	}
//create screen space rigs
if((`size($errorMsg)`==0))
	{

	//hide UI
	ebLabs_screenSpace_enableMayaUI(off, "ebLabs_screenSpace");

	for($s in $selected)
		{
		ebLabs_animTools_screenSpaceRig($selectedCamera[0], $s);
		}

	//enable UI
	ebLabs_screenSpace_enableMayaUI(on, "ebLabs_screenSpace");
	}

//spit out any error message
if((`size($errorMsg)`!=0)){ebLabs_screenSpace_errorDialogue($errorMsg);}

}

//###########################################################################################################################
global proc ebLabs_screenSpace_selCamFromList()
{
//get selection from list
string $selectListObjects[] = `textScrollList -q -si eb_labs_screenSpace_cameraList`;

//set selections
select -cl;
for($obj in $selectListObjects)
	{
	select -add $obj;
	}
}

//###########################################################################################################################
global proc ebLabs_screenSpace_selRigFromList()
{
//get selection from list
string $selectListObjects[] = `textScrollList -q -si eb_labs_screenSpace_rigList`;



//set selections
select -cl;
for($obj in $selectListObjects)
	{
	if(!(`objExists $obj`))
		{
		ebLabs_screenSpace_updateRigList;
		}
	else
		{
		select -add $obj;
		}
	}

}

//######################################################################################################################
global proc ebLabs_screenSpace_updateRigList()
{

//get list of all nurbs curves
string $selection[] = `ls -type nurbsCurve`;
string $list[] = `listRelatives -allParents $selection`;

string $rigList[];
string $obj;

//sort through and see which one is a screenspace control
for($obj in $list)
	{
	if (`gmatch $obj "*_screenSpaceControl"`)
		{
		$rigList[`size($rigList)`] = $obj;
		}
	}

//clear rig list
textScrollList -e -ra eb_labs_screenSpace_rigList;

//add rigs
for ($f = 0; $f < (`size($rigList)`); $f++)
	{
	//add cams to list
	textScrollList -e -append ($rigList[$f]) eb_labs_screenSpace_rigList;
	}
}

//######################################################################################################################
global proc ebLabs_screenSpace_camExistCheck()
{
string $selectedCam[] = `textScrollList -q -si eb_labs_screenSpace_cameraList`;

//update if the selected camera doesnt exist
if(!(`objExists $selectedCam[0]`))
	{
	ebLabs_screenSpace_updateCameraList;
	}

}

//######################################################################################################################
global proc ebLabs_screenSpace_updateCameraList()
{

//get list of all nurbs curves
string $camShapes[] = `ls -type camera`;
string $cameraCheckList[] = `listRelatives -allParents -path $camShapes`;
string $cameraList[];

//clear cam list
textScrollList -e -ra eb_labs_screenSpace_cameraList;

//sort through and ignore orthographic cameras
for($cam in $cameraCheckList)
	{
	if (!(`camera -q -o $cam`))
		{
		$cameraList[`size($cameraList)`] = $cam;
		//print $cam;
		}
	}
//print $cameraList;

//add cams
for ($f = 0; $f < (`size($cameraList)`); $f++)
	{

	//add cams to list
	textScrollList -e -append ($cameraList[$f]) eb_labs_screenSpace_cameraList;

	//select the first control for timewarp list(dont select anything for untimewarp list)
	textScrollList -e -sii 1 eb_labs_screenSpace_cameraList;
	}
}



//######################################################################################################################
//#######Utility Functions


//######################################################################################################################

global proc ebLabs_screenSpace_makeCurveCube(string $name)
{
string $box = `curve -d 1 -p -0.5 -0.5 0.5 -p 0.5 -0.5 0.5 -p 0.5 -0.5 -0.5
-p -0.5 -0.5 -0.5 -p -0.5 -0.5 0.5 -p -0.5 0.5 0.5 -p 0.5 0.5 0.5
-p 0.5 0.5 -0.5 -p -0.5 0.5 -0.5 -p -0.5 0.5 0.5 -p -0.5 -0.5 0.5
-p -0.5 -0.5 -0.5 -p -0.5 0.5 -0.5 -p 0.5 0.5 -0.5 -p 0.5 -0.5 -0.5
-p 0.5 -0.5 0.5 -p 0.5 0.5 0.5 -k 0 -k 1 -k 2 -k 3 -k 4 -k 5 -k 6
-k 7 -k 8 -k 9 -k 10 -k 11 -k 12 -k 13 -k 14 -k 15 -k 16` ;

rename $box $name;
}

//######################################################################################################################

global proc ebLabs_screenSpace_enableMayaUI(int $on, string $ignore)
{

	//if turning off, add safety popup
	if($on==off)
		{
		if (`window -exists ebLabs_UIFIX`){deleteUI ebLabs_UIFIX; windowPref -remove ebLabs_UIFIX;}
		string $window = `window -widthHeight 200 100 -bgc 1 1 1 -title "ebLabs UI Restore" ebLabs_UIFIX`;
		columnLayout -adjustableColumn true;
		text -label "\nClick to restore UI, \nif there are any errors\n" -align "center";
		button -label "RestoreUI" -command "global string $gMainPane;for($p in (`lsUI -typ window`)){ if (!(catchQuiet (`window -e -i 0 $p`))) {window -e -i 0 $p;}}paneLayout -e -m 1 $gMainPane;print \"\*Restoring Maya UI...\\n\"; if (`window -exists ebLabs_UIFIX`){deleteUI ebLabs_UIFIX; windowPref -remove ebLabs_UIFIX;}";
		showWindow $window;
		}

	if($on==on)
		{
		if (`window -exists ebLabs_UIFIX`){deleteUI ebLabs_UIFIX; windowPref -remove ebLabs_UIFIX;}
		}

	//modified from NaughtyNathan on cgtalk.com
	print (($on) ? "*Enabling Maya UI...\n" : "*Disabling Maya UI...\n");
	global string $gMainPane;
	string $windows[] = `lsUI -typ window`;
	for ($window in $windows)
		if ($window != "MayaWindow" && $window != "CommandWindow" && $window != $ignore && $window != "ebLabs_UIFIX")
		  {

		  //this is to fix some weird window error, not sure what or why this is erroring on some UI elements
		  if (!(catchQuiet (`window -e -i (!$on) $window`)))
		    {
		    window -e -i (!$on) $window;
		    }
		  else
		    {
		    //print ("erroring on " + $window);
		    }
		  }
	paneLayout -e -m $on $gMainPane;
}

//######################################################################################################################

global proc ebLabs_screenSpace_updateProgress(float $value, float $max, string $pbar)
{
progressBar -edit -pr ($value) -maxValue ($max) $pbar;

//flip visibility
if($value!=$max)
	{

	//in progress
	progressBar -edit -vis 1 ebLabs_sc_progress;
	button -e -vis 0 ebLabs_sc_refreshListsButton;
	}
else
	{
	progressBar -edit -vis 0 ebLabs_sc_progress;
	button -e -vis 1 ebLabs_sc_refreshListsButton;
	}


}

//######################################################################################################################

global proc ebLabs_screenSpace_errorDialogue(string $msgs[])
{
$msgs = `stringArrayRemoveDuplicates($msgs)`;
string $longMessage;
string $msg;
for($msg in $msgs)
	{
	$longMessage += ($msg + "\n");
	}

confirmDialog -title "Confirm" -message $longMessage -button "no worries mate" ;
}

//######################################################################################################################

global proc int ebLabs_isCamera(string $object)
{
int $result = 0;

if($object!="")
	{
	string $shapeChk[] = `listRelatives -type "camera" -shapes $object`;
	if($shapeChk[0]!="")
		{
		$result = 1;
		}
	}
return $result;
}

//######################################################################################################################

global proc int ebLabs_KUchannelCheck(string $object)
{
int $checkChannels = 3;
string $attrList[] = `listAttr -k -u $object`;
if((stringArrayContains("translateX", $attrList)) && (stringArrayContains("translateY", $attrList)) && (stringArrayContains("translateZ", $attrList)) && (stringArrayContains("rotateX", $attrList)) && (stringArrayContains("rotateY", $attrList)) && (stringArrayContains("rotateZ", $attrList)))
{
//both rotation and translation are keyable and unlocked
$checkChannels = 0;
}
else if((stringArrayContains("translateX", $attrList)) && (stringArrayContains("translateY", $attrList)) && (stringArrayContains("translateZ", $attrList)))
{
//only translate is keyable and unlocked
$checkChannels = 1;
}
else if((stringArrayContains("rotateX", $attrList)) && (stringArrayContains("rotateY", $attrList)) && (stringArrayContains("rotateZ", $attrList)))
{
//only rotation is keyable and unlocked
$checkChannels = 2;
}
return  $checkChannels;
}

//######################################################################################################################

global proc ebLabs_screenSpace_quickUndo(string $action)
{
if($action=="undo")
	{
	//hide UI
	ebLabs_screenSpace_enableMayaUI(off, "ebLabs_worldSpace");

	//do the undo
	undo;

	//unhide UI
	ebLabs_screenSpace_enableMayaUI(on, "ebLabs_worldSpace");
	}
else if($action=="redo")
	{
	//hide UI
	ebLabs_screenSpace_enableMayaUI(off, "ebLabs_worldSpace");

	//do the undo
	redo;

	//unhide UI
	ebLabs_screenSpace_enableMayaUI(on, "ebLabs_worldSpace");
	}
}




}//end of entire script
