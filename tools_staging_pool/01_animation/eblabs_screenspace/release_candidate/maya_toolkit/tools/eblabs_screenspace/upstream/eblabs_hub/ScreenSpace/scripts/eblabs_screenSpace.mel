{
//screen space tool
//(C)Eric Bates 2011
//Maya 2011
//MEL script



//## Defaults
string $ebLabs_screenSpace_defaultTangentType = "spline";
global string $ebLabs_screenSpace_version = "v2017-05-12";
//define global string for progress indicator
global string $ebLabs_screenSpace_progressControl;

//######################################################################################################################

global proc ebLabs_screenSpace()
{

//remove window
string $windowName = "ebLabs_screenSpace";
if (`window -exists $windowName`)
	{
	deleteUI $windowName;
	}

//remove prefs
if (`windowPref -exists $windowName`)
	{
	windowPref -remove $windowName;
	}

//make sure default namespace is set to root
namespace -set ":";

string $window = `window -widthHeight 250 432 -title $windowName ebLabs_screenSpace`;
string $form = `formLayout`;
string $tabs = `tabLayout -innerMarginWidth 5 -innerMarginHeight 5`;

	string $child1 = `formLayout`;

	//send to screen space
	string $toScreenFrame = `frameLayout -label "Send To Screen Space" `;
	string $toScreenFrame_inside = `formLayout`;
	string $camListHeader = `text -label "[cameras in scene]"   -align "left"`;
	string $cameraListScrollBox = `textScrollList -font "fixedWidthFont" -h 10 -w 10  -allowMultiSelection 0 -sc "ebLabs_screenSpace_camExistCheck" -dcc "ebLabs_screenSpace_selCamFromList" eb_labs_screenSpace_cameraList`;
	string $orientationChkBox = `checkBox -label "+include orientation" -ann "include rotations on screen space controls" ebLabs_sc_orientationChkBox`;
	string $createScrSpcRig = `button -label "Create ScreenSpace Rig" -ann "highlight your camera in the list, then select all the controls youd like to send to screen space" -c "ebLabs_animTools_screenSpaceRigMulti()"`;

	setParent ..;

	formLayout -edit

	//toScreenFrame
	-attachForm     $camListHeader     "top"    2
	-attachForm     $camListHeader     "left"   2
	-attachNone     $camListHeader     "bottom"
	-attachForm     $camListHeader     "right" 2

	-attachNone     $createScrSpcRig     "top"
	-attachForm     $createScrSpcRig     "left"   2
	-attachForm     $createScrSpcRig     "bottom" 2
	-attachForm     $createScrSpcRig     "right" 2

	-attachNone     $orientationChkBox     "top"
	-attachForm     $orientationChkBox     "left"   2
	-attachControl  $orientationChkBox     "bottom" 2 $createScrSpcRig
	-attachForm     $orientationChkBox     "right" 2

	-attachControl  $cameraListScrollBox     "top" 2 $camListHeader
	-attachForm     $cameraListScrollBox     "left"   2
	-attachControl  $cameraListScrollBox     "bottom" 2 $orientationChkBox
	-attachForm     $cameraListScrollBox     "right" 2

	$toScreenFrame_inside;

	setParent ..;

	//send to local space
	string $toLocalFrame = `frameLayout -label "Send To Local Space" `;
	string $toLocalFrame_inside = `formLayout`;
	string $rigListHeader = `text -label "[screen space rigs]"   -align "left"`;
	string $screenSpaceRigList = `textScrollList -font "fixedWidthFont" -h 10 -w 10 -ann "click to select screen space controls in scene" -allowMultiSelection 1 -sc "ebLabs_screenSpace_selRigFromList" eb_labs_screenSpace_rigList`;
	string $deleteRig = `button -label "delete rig" -h 15 -ann "delete selected screen space rigs, animation will go back to previous state" -c "ebLabs_screenSpace_deleteRig"`;
	string $smartBakeButton = `button -label "Smart Bake" -ann "send animation back to the original controls, use only existing keyframes" -c "ebLabs_animTools_screenSpaceSmartBakeMulti()"`;
	string $fullBakeButton = `button -label "Full Bake" -ann "bake animation back to controls" -c "ebLabs_animTools_screenSpaceFullBakeMulti()"`;

	setParent ..;
	formLayout -edit

	//toScreenFrame
	-attachForm     $rigListHeader     "top"    2
	-attachForm     $rigListHeader     "left"   2
	-attachNone     $rigListHeader     "bottom"
	-attachForm     $rigListHeader     "right" 2

	-attachNone     $smartBakeButton     "top"
	-attachForm     $smartBakeButton     "left"   2
	-attachForm     $smartBakeButton     "bottom" 2
	-attachPosition $smartBakeButton     "right" 2 50

	-attachNone     $fullBakeButton     "top"
	-attachControl  $fullBakeButton     "left"   2 $smartBakeButton
	-attachForm     $fullBakeButton     "bottom" 2
	-attachForm     $fullBakeButton     "right" 2

	-attachNone     $deleteRig     "top"
	-attachForm     $deleteRig     "left"   2
	-attachControl  $deleteRig     "bottom" 2 $smartBakeButton
	-attachNone     $deleteRig     "right"


	-attachControl  $screenSpaceRigList     "top" 2 $rigListHeader
	-attachForm     $screenSpaceRigList     "left"   2
	-attachControl  $screenSpaceRigList     "bottom" 2 $deleteRig
	-attachForm     $screenSpaceRigList     "right" 2

	$toLocalFrame_inside;

	setParent ..;

	//bottom buttons
	string $qUndo = `button -label "quick undo" -ann "quick undo with maya UI disabled" -c "ebLabs_screenSpace_quickUndo(\"undo\")"`;
	string $qRedp = `button -label "quick redo" -ann "quick redo with maya UI disabled" -c "ebLabs_screenSpace_quickUndo(\"redo\")"`;
	string $update = `button -label "refresh lists" -ann "refresh lists" -bgc .404 0.553 0.698 -c "ebLabs_screenSpace_updateAllLists" ebLabs_sc_refreshListsButton`;
	$ebLabs_screenSpace_progressControl = `progressBar -vis 0 -maxValue 100 ebLabs_sc_progress`;
	setParent ..;

	formLayout -edit

	//toScreenFrame
	-attachForm     $toScreenFrame     "top"    5
	-attachForm     $toScreenFrame     "left"   5
	-attachPosition $toScreenFrame     "bottom" 3 40
	-attachForm     $toScreenFrame     "right" 5

	//$qUndo
	-attachNone     $qUndo     "top"
	-attachForm     $qUndo     "left"   5
	-attachForm     $qUndo     "bottom" 5
	-attachPosition $qUndo     "right" 2 50

	//$qredo
	-attachNone     $qRedp     "top"
	-attachControl  $qRedp     "left"   2 $qUndo
	-attachForm     $qRedp     "bottom" 5
	-attachForm     $qRedp     "right" 5

	//$update
	-attachNone     $update     "top"
	-attachForm     $update     "left"   5
	-attachControl  $update     "bottom" 2 $qUndo
	-attachForm     $update     "right" 5

	//$ebLabs_screenSpace_progressControl
	-attachNone     $ebLabs_screenSpace_progressControl     "top"
	-attachForm     $ebLabs_screenSpace_progressControl     "left"   5
	-attachControl  $ebLabs_screenSpace_progressControl     "bottom" 2 $qUndo
	-attachForm     $ebLabs_screenSpace_progressControl     "right" 5

	//toLocalFrame
	-attachControl  $toLocalFrame     "top"    5 $toScreenFrame
	-attachForm     $toLocalFrame     "left"   5
	-attachControl  $toLocalFrame     "bottom" 5 $update
	-attachForm     $toLocalFrame     "right" 5

	$child1;

	string $child3 = `formLayout`;
	string $t1Text = "";
	$t1Text += ". ebLabs ||.Screen Space Tool\n";
	$t1Text += "         ||.version " + $ebLabs_screenSpace_version + "\n";
	$t1Text += "..(c)ericBates 2012\n";
	$t1Text += "...eric-bates.com\n";
	$t1Text += "\n";
	$t1Text += "             o\n";
	$t1Text += "        o    |\n";
	$t1Text += "         \\   |\n";
	$t1Text += "          \\  |\n";
	$t1Text += "           \\.|-.\n";
	$t1Text += "           (\\|  )\n";
	$t1Text += "  .==================.\n";
	$t1Text += "  | .--------------. |\n";
	$t1Text += "  | |--.__.--.__.--| |\n";
	$t1Text += "  | |--.__.--.__.--| |\n";
	$t1Text += "  | |--.__.--.__.--| |\n";
	$t1Text += "  | |--.__.--.__.--| |\n";
	$t1Text += "  | |--.__.--.__.--| |\n";
	$t1Text += "  | '--------------'o|\n";
	$t1Text += "  | LI LI \"\"\"\"\"\"\"   o|\n";
	$t1Text += "  '=================='\n";
	$t1Text += "\n";
	$t1Text += ". Manual\n";
	$t1Text += "\nCreate Screen Space Rig:\nCreates a new control attached to the camera and control you have selected.\n";
	$t1Text += "\nChannelBox:PlaneAdjust:\nIn case the control is hidden by the clipping plane, use this to slide the control away from the camera.\n";
	$t1Text += "\nSmart Bake Animation:\nSends the animation back to your controls using only existing keyframes, and deletes the rig.\n";
	$t1Text += "\nFull Bake Animation:\nSends the animation back to your controls baking out all frames, and deletes the rig.\n";
	$t1Text += "\nQuick Undo Redo:\nDisables the Maya UI while Undo and Redo run.\n";
	string $helpText = `scrollField -wordWrap true -w 230 -h 400 -editable false -text $t1Text`;
	setParent ..;

	formLayout -edit

	//help frame
	-attachForm     $helpText     "top"    2
	-attachForm     $helpText     "left"   2
	-attachForm     $helpText     "bottom" 2
	-attachForm     $helpText     "right" 2
	$child3;


	tabLayout -edit
		-tabLabel $child1 "Screen Space Tools" -tabLabel $child3 "Help"
		$tabs;

	formLayout -edit
		-attachForm $tabs "top"    0
		-attachForm $tabs "left"   0
		-attachForm $tabs "bottom" 0
		-attachForm $tabs "right"  0

		$form;

showWindow;
ebLabs_screenSpace_updateAllLists;
}


//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
global proc ebLabs_screenSpace_setRandoColor(string $objects[])
{
if(`size($objects)`!=0)
	{
	for($o in $objects)
		{
		//find objects shape first!
		string $shapes[] = `listRelatives -ad -s $o`;

		//choose random color between 0-31
		int $rand = `rand 0 32`;

		//apply override
		setAttr ($o + ".overrideEnabled") 1;
		setAttr ($o + ".overrideColor") $rand;

		}
	}
}

//######################################################################################################################

global proc ebLabs_screenSpace_updateAllLists()
{
ebLabs_screenSpace_updateCameraList;
ebLabs_screenSpace_updateRigList;
}

//######################################################################################################################

global proc ebLabs_animTools_screenSpaceFullBakeMulti()
{
//get list of rigs
string $selected[] = `ls -selection`;
string $controlsToBake[];
string $errorMsg[];

//set selections
select -cl;
for($obj in $selected)
	{
	if(!(`objExists $obj`))
		{
		ebLabs_screenSpace_updateRigList;
		}
	else
		{
		if (`gmatch $obj "*_screenSpaceControl"`)
			{
			$controlsToBake[`size($controlsToBake)`] = $obj;
			}
		else
			{
			$errorMsg[`size($errorMsg)`] = ("Object isn't a screen space control: " + $obj);
			}
		}
	}

if((`size($errorMsg)`==0))
	{
	for($control in $controlsToBake)
		{

		//make sure at least one translate key on screen space control
		if((`keyframe -query -keyframeCount ($control + ".tx")`)==0 && (`keyframe -query -keyframeCount ($control + ".ty")`)==0 && (`keyframe -query -keyframeCount ($control + ".tz")`)==0)
			{
			$errorMsg[`size($errorMsg)`] = ("Object needs at least one translation key to smart bake: " + $control);
			}

		//check use orientation attribute
		int $orientationExists = `objExists ($control + ".useOrientation")`;
		int $useOrientationValue = 0;
		if($orientationExists)
			{
			$useOrientationValue = `getAttr ($control + ".useOrientation") `;
			}

		//make sure theres at least one rotation key
		if(($orientationExists)&&($useOrientationValue)&&((`keyframe -query -keyframeCount ($selected[0] + ".rx")`)==0)&&((`keyframe -query -keyframeCount ($selected[0] + ".ry")`)==0)&&((`keyframe -query -keyframeCount ($selected[0] + ".rz")`)==0))
			{
			$errorMsg[`size($errorMsg)`] = ("Object needs at least one rotation key to smart bake rotations: " + $control);
			}
		}
	}

if((`size($errorMsg)`==0))
	{
	//hide UI
	ebLabs_screenSpace_enableMayaUI(off, "ebLabs_screenSpace");

	//smart bake animation
	for($control in $controlsToBake)
		{
		//get current time
		float $now = `currentTime -query`;

		//bake out everyframe here
		float $firstKey = (`findKeyframe -which first $control`);
		float $lastKey = (`findKeyframe -which last $control`);
		for ($f = $firstKey; $f < ($lastKey+1); $f++)
			{
			currentTime $f;
			setKeyframe $control;
			}
		//reset current time
		currentTime $now;
		//continue on with the smart baking
		ebLabs_animTools_screenSpaceSmartBake($control);
		}

	//enable UI
	ebLabs_screenSpace_enableMayaUI(on, "ebLabs_screenSpace");

	//update rig list
	ebLabs_screenSpace_updateRigList;
	}

//spit out any error message
if((`size($errorMsg)`!=0)){ebLabs_screenSpace_errorDialogue($errorMsg);}

}


