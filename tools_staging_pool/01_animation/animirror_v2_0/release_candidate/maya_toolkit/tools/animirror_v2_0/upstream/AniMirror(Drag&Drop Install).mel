create_shelf_Animall();
global proc create_shelf_Animall()
{
    global string $gShelfTopLevel;
    string $shelves[] = `tabLayout -q -childArray $gShelfTopLevel`;
	string $valid=stringArrayContains("Animall",$shelves);
	if($valid==0)
		addNewShelfTab("Animall");
    shelf_AnimExport_button ();
}
global proc shelf_AnimExport_button () {
        
        shelfButton -parent "Animall"
        -enableCommandRepeat 1
        //-flexibleWidthType 3
        //-flexibleWidthValue 64
        -enable 1
        -width 35
        -height 34
        -manage 1
        -visible 1
        -preventOverride 0
        -annotation "Animation Mirror Tool" 
        -enableBackground 0
        -backgroundColor 0 0 0 
        //-highlightColor 0.321569 0.521569 0.65098 
        -align "center" 
        -label "AnMirror" 
        -labelOffset 0
        -rotation 0
        -flipX 0
        -flipY 0
        -useAlpha 1
        -font "plainLabelFont" 
        -imageOverlayLabel "AnExport" 
        -overlayLabelColor 0.8 0.8 0.8 
        -overlayLabelBackColor 0 0 0 0.5 
        -image "commandButton.png" 
        -image1 "commandButton.png" 
        -style "iconOnly" 
        -marginWidth 1
        -marginHeight 1
                -command "aniMirror_menu();\n\nproc aniMirror_menu()\n{\nif (`window -exists AniMirror`) deleteUI AniMirror;\nwindow -s 0\n-w 280 -h 400\n-title \"AniMirror v2.00\"\n-iconName \"AniMirror\"\n//-dockStation\n-bgc 0.265 0.265 0.265\n-nestedDockingEnabled true AniMirror;\nshowWindow AniMirror;\nwindow -e -resizeToFitChildren 1 -w 280 -h 250 -s 0 AniMirror;\n\nframeLayout -la \"center\" -lv 1 -cll 0 -label \"                 Animation Mirror Tool\" -w 270 -backgroundColor 0.5 0.2 0.2 -backgroundShade 0;\ncolumnLayout -bgc 0.242 0.207 0.3 -co both 0 -rs 2 -ann \"ThisCreateCol\"\"ThisCreateCol\";\n\n    columnLayout  -co both 5 -columnWidth 250  -adjustableColumn 0 -columnAlign \"center\" -rs 5 -ann \"InfoTextCol\"\"InfoTextCol\";\n        text -h 2 \"  \";\n        text -align \"center\" -h 10 \"                  1. Select centeral object\";\n        text -h 10 \"                  2. Add reference object\";\n        text -h 10 \"                  3. Add object for mirror\";\n        text -h 2 \" \";\n        separator -w 270;\n        setParent ..;\n\n\nrowLayout -columnAttach 1 \"left\" 5  -numberOfColumns 6 -ann \"TranslationModeRow\"\"TranslationModeRow\";\n        checkBox -label \"Translations\" -en 1 -v 1 -w 100 -cc \"change_options_mirror()\" -ann \"TranslationsCheckbox\"\"TranslationsCheckbox\";\n        radioCollection;\n            radioButton -sl -label \"XZ\" -ann \"XAxisTransRadio\"\"XAxisTransRadio\";\n            radioButton -label \"YX\" -ann \"YAxisTransRadio\"\"YAxisTransRadio\";\n            radioButton -label \"ZY\" -ann \"ZAxisTransRadio\"\"ZAxisTransRadio\";\n        setParent ..;         \n              \nrowLayout -columnAttach 1 \"left\" 5  -numberOfColumns 6 -ann \"RotateModeRow\"\"RotateModeRow\";\n        checkBox -label \"Rotations\" -en 1 -v 1 -w 100 -cc \"change_options_mirror()\" -ann \"RotationsCheckbox\"\"RotationsCheckbox\";\n        checkBox -label \"X\" -en 1 -v 0 -ann \"XAxisRotCheckbox\"\"XAxisRotCheckbox\";\n        checkBox -label \"Y\" -en 1 -v 1 -ann \"YAxisRotCheckbox\"\"YAxisRotCheckbox\";\n        checkBox -label \"Z\" -en 1 -v 1 -ann \"ZAxisRotCheckbox\"\"ZAxisRotCheckbox\";\n        setParent ..;\n              \n        \nrowLayout -columnAttach 1 \"left\" 5  -numberOfColumns 6  -ann \"MirrorRealRow\"\"MirrorRealRow\";\n        button -en 1 -h 30 -w 120 -enableBackground 1 -bgc 0.25 0.5 0.4 -label \"Interactive Mirror\" -c \"mirror_animation(0);\" -ann \"MirrorRealButton\"\"MirrorRealButton\";\n        button -en 1 -h 30 -w 70 -enableBackground 1 -bgc 0.65 0.5 0.4 -label \"Undo\" -c \"delete_all_created()\" -ann \"UndoMirrorButton\"\"UndoMirrorButton\";\n        button -en 1 -h 30 -w 70 -enableBackground 1 -bgc 1 0.5 0.4 -label \"Bake\" -c \"fast_bake(1)\" -ann \"BakeMirrorButton\"\"BakeMirrorButton\";\n        setParent ..;\n        \nrowLayout -columnAttach 1 \"left\" 5  -numberOfColumns 6  -ann \"MirrorBakeRow\"\"MirrorBakeRow\";\n        button -en 1 -h 30 -w 264 -enableBackground 1 -bgc 0.25 0.5 0.4 -label \"Mirror with Bake\" -c \"mirror_animation(1)\" -ann \"MirrorBakeButton\"\"MirrorBakeButton\";\n        setParent ..;       \n\n}\nglobals_variables();\nproc globals_variables()\n{\n    global string $centerJoint[];\n    global string $operatorTrans[];\n    global string $operatorRotate[];\n    global string $mirrorObject[];\n    global int $ind = 0;\n    global int $iTo;\n\n    global int $iRo;\n\n    \n    clear $centerJoint $operatorTrans $operatorRotate $mirrorObject;\n    $ind = 0; $iTo = 0; $iRo = 0;\n}\n\nproc change_options_mirror()\n{\n    if (`checkBox -q -v TranslationsCheckbox`)\n    {radioButton -e -en 1 XAxisTransRadio; radioButton -e -en 1 YAxisTransRadio;radioButton -e -en 1 ZAxisTransRadio;}\n    else {radioButton -e -en 0 XAxisTransRadio; radioButton -e -en 0 YAxisTransRadio; radioButton -e -en 0 ZAxisTransRadio;}\n    \n    if (`checkBox -q -v RotationsCheckbox`)\n    {checkBox -e -en 1 XAxisRotCheckbox; checkBox -e -en 1 YAxisRotCheckbox; checkBox -e -en 1 ZAxisRotCheckbox;}\n    else {checkBox -e -en 0 XAxisRotCheckbox; checkBox -e -en 0 YAxisRotCheckbox; checkBox -e -en 0 ZAxisRotCheckbox;}\n        \n}\n\nproc mirror_animation(int $withBake)\n{\n    global string $centerObject[];\n    global string $referenceObject[];\n    global string $mirrorObject[];\n    global string $centerJoint[];\n    global int $ind;\n    \n        $doTransforms = `checkBox -q -v TranslationsCheckbox`;\n        $doRotations = `checkBox -q -v RotationsCheckbox`;\n        \n\t    $selected = `ls -selection`; //записываем выделенные объекты\n\t    \n        if (size($selected) < 3) error \"Select at least two objects for mirror animation\";\n        \n        $centerObject[$ind] = $selected[0];\n        $referenceObject[$ind] = $selected[1]; //Присваиваем первый выделенный объект центральным\n        $mirrorObject[$ind] = $selected[2];\n        \n        \n        if (`checkBox -q -v RotationsCheckbox`)\n        {\n            $referenceObjectRotate = `xform -q -os -ro $referenceObject[$ind]`;\n            if (`checkBox -q -v XAxisRotCheckbox`) $valX = -1; else $valX = 1;\n            if (`checkBox -q -v YAxisRotCheckbox`) $valY = -1; else $valY = 1;\n            if (`checkBox -q -v ZAxisRotCheckbox`) $valZ = -1; else $valZ = 1;\n            xform -os -ro ($referenceObjectRotate[0]*$valX) ($referenceObjectRotate[1]*$valY) ($referenceObjectRotate[2]*$valZ) $mirrorObject[$ind];\n        }\n \n    //Creating joints hierarchy----\n        select -cl;\n        $centerJoint[$ind] = `joint -rad 1`;\n        setAttr ($centerJoint[$ind] + \".visibility\") 0; \n    \n    //Center joint constrain\n        parentConstraint -weight 1 $centerObject[$ind] $centerJoint[$ind]; //parent for snap trans and rotations\n    \n    //Reference joint\n        select -cl;\n        select $centerJoint[$ind]; //select for continue hierarchy\n        $referenceJoint = `joint -rad 1`; //create ref joint in hierarchy\n               \n        pointConstraint -weight 1 $referenceObject[$ind] $referenceJoint;\n        orientConstraint -weight 1 $referenceObject[$ind] $referenceJoint;\n        delete -cn $referenceJoint;\n        makeIdentity -apply true -t 0 -r 1 -s 0 -n 0 -pn 1 $referenceJoint;\n        \n      string $mirrorJoint[]; \n    //Mirror joint\n        if (`checkBox -q -v TranslationsCheckbox`)\n        {\n            if (`radioButton -q -sl XAxisTransRadio`) $mirrorJoint = `mirrorJoint -mirrorXY -mirrorBehavior $referenceJoint`;\n            if (`radioButton -q -sl YAxisTransRadio`) $mirrorJoint = `mirrorJoint -mirrorYZ -mirrorBehavior $referenceJoint`;\n            if (`radioButton -q -sl ZAxisTransRadio`) $mirrorJoint = `mirrorJoint -mirrorXZ -mirrorBehavior $referenceJoint`;\n        }else $mirrorJoint = `mirrorJoint -mirrorYZ -mirrorBehavior $referenceJoint`;\n        \n    //Reference joint constrain after mirror (nessasary)\n        pointConstraint -weight 1 $referenceObject[$ind] $referenceJoint;\n        orientConstraint -weight 1 $referenceObject[$ind] $referenceJoint;\n\n        if ($doRotations == 1)\n        {\n            orientConstraint -weight 1 $mirrorObject[$ind] $mirrorJoint;\n            delete -cn $mirrorJoint;\n            makeIdentity -apply true -t 0 -r 1 -s 0 -n 0 -pn 1 $mirrorJoint;\n            orientConstraint -weight 1 $mirrorJoint $mirrorObject[$ind];\n            rotate_connect_operator($mirrorJoint[0], $referenceJoint);\n        }\n        \n        if ($doTransforms == 1)\n        {\n            pointConstraint -weight 1 $mirrorJoint $mirrorObject[$ind];\n            transform_connect_operator($mirrorJoint[0], $referenceJoint);\n\n            \n        }\n    if ($withBake == 1) fast_bake(1);    \n    $ind = $ind + 1;\n}\n\nproc transform_connect_operator(string $mirrorJoint, string $referenceJoint)\n{    \n    global int $iTo;\n    global string $operatorTrans[];\n    \n    $transX = `radioButton -q -sl XAxisTransRadio`;\n    $transY = `radioButton -q -sl YAxisTransRadio`;\n    $transZ = `radioButton -q -sl ZAxisTransRadio`;\n    \n    $constPoint = `pointConstraint -weight 1 $referenceJoint $mirrorJoint`;\n    \n    if ($transX == 1)\n    {\n        $operatorTrans[$iTo] = `shadingNode -asUtility floatMath`;\n        setAttr ($operatorTrans[$iTo] + \".floatB\") -1;\n        setAttr ($operatorTrans[$iTo] + \".operation\") 2;\n        \n        connectAttr -f ($constPoint[0] + \".constraintTranslateX\") ($operatorTrans[$iTo] + \".floatA\");\n        connectAttr -f ($operatorTrans[$iTo] + \".outFloat\") ($mirrorJoint + \".translateX\");\n        $iTo = $iTo + 1;\n    }\n    if ($transY == 1)\n    {\n        $operatorTrans[$iTo] = `shadingNode -asUtility floatMath`;\n        setAttr ($operatorTrans[$iTo] + \".floatB\") -1;\n        setAttr ($operatorTrans[$iTo] + \".operation\") 2;\n        \n        connectAttr -f ($constPoint[0] + \".constraintTranslateY\") ($operatorTrans[$iTo] + \".floatA\");\n        connectAttr -f ($operatorTrans[$iTo] + \".outFloat\") ($mirrorJoint + \".translateY\");\n        $iTo = $iTo + 1; \n    }\n    if ($transZ == 1)\n    {\n        $operatorTrans[$iTo] = `shadingNode -asUtility floatMath`;\n        setAttr ($operatorTrans[$iTo] + \".floatB\") -1;\n        setAttr ($operatorTrans[$iTo] + \".operation\") 2;\n        \n        connectAttr -f ($constPoint[0] + \".constraintTranslateZ\") ($operatorTrans[$iTo] + \".floatA\");\n        connectAttr -f ($operatorTrans[$iTo] + \".outFloat\") ($mirrorJoint + \".translateZ\");\n        $iTo = $iTo + 1;  \n    }     \n}\n\n\n\nproc rotate_connect_operator(string $mirrorJoint, string $referenceJoint)\n{\n    global int $iRo;\n    global string $operatorRotate[];\n    \n    $rotateX = `checkBox -q -v XAxisRotCheckbox`;\n    $rotateY = `checkBox -q -v YAxisRotCheckbox`;\n    $rotateZ = `checkBox -q -v ZAxisRotCheckbox`;\n\n    if ($rotateX == 1)\n    {\n        $operatorRotate[$iRo] = `shadingNode -asUtility floatMath`;\n        setAttr ($operatorRotate[$iRo] + \".floatB\") -1;\n        setAttr ($operatorRotate[$iRo] + \".operation\") 2;\n        \n        \n        connectAttr -f ($referenceJoint + \".rotateX\") ($operatorRotate[$iRo] + \".floatA\");\n        connectAttr -f ($operatorRotate[$iRo] + \".outFloat\") ($mirrorJoint + \".rotateX\");\n        $iRo = $iRo + 1;        \n    }else connectAttr -f ($referenceJoint + \".rotateX\") ($mirrorJoint + \".rotateX\");\n\n    \n    if ($rotateY == 1)\n    {\n        $operatorRotate[$iRo] = `shadingNode -asUtility floatMath`;\n        setAttr ($operatorRotate[$iRo] + \".floatB\") -1;\n        setAttr ($operatorRotate[$iRo] + \".operation\") 2;\n        \n        connectAttr -f ($referenceJoint + \".rotateY\") ($operatorRotate[$iRo] + \".floatA\");\n        connectAttr -f ($operatorRotate[$iRo] + \".outFloat\") ($mirrorJoint + \".rotateY\");\n        $iRo = $iRo + 1;         \n    }else connectAttr -f ($referenceJoint + \".rotateY\") ($mirrorJoint + \".rotateY\");\n    \n    \n    if ($rotateZ == 1)\n    {\n        $operatorRotate[$iRo] = `shadingNode -asUtility floatMath`;\n        setAttr ($operatorRotate[$iRo] + \".floatB\") -1;\n        setAttr ($operatorRotate[$iRo] + \".operation\") 2;\n        \n        connectAttr -f ($referenceJoint + \".rotateZ\") ($operatorRotate[$iRo] + \".floatA\");\n        connectAttr -f ($operatorRotate[$iRo] + \".outFloat\") ($mirrorJoint + \".rotateZ\");\n        $iRo = $iRo + 1;          \n    }else connectAttr -f ($referenceJoint + \".rotateZ\") ($mirrorJoint + \".rotateZ\");\n\n}\n\nproc delete_all_created()\n{\n    global string $centerJoint[];\n    global string $operatorTrans[];\n    global string $operatorRotate[]; \n    if (catch (`delete $centerJoint $operatorTrans $operatorRotate`)) warning -n \"Some temporary objects have been removed from the scene\"; \n    //delete $centerJoint $operatorTrans $operatorRotate;\n    globals_variables();\n  \n}\n//----------------------------------------\nproc fast_bake(int $defineFrames)\n{\n    global string $mirrorObject[];\n    \n    select -r $mirrorObject;\n    \n    global string $gPlayBackSlider;\n    global float $startFrame; global float $finishFrame;\n    \n    if ($defineFrames == 1) define_frames_range();\n    \n    refresh -suspend 1; //do not refresh viewport\n    bakeResults -simulation 0 -t ($startFrame + \":\" + $finishFrame) -sampleBy 1 -disableImplicitControl true -preserveOutsideKeys true -sparseAnimCurveBake false -removeBakedAttributeFromLayer false -bakeOnOverrideLayer false -minimizeRotation true;\n    delete -sc; //delete static curves for baked object\n    filterCurve;\n    refresh -suspend 0;\n    delete_all_created();\n}\n\n//-----------------------------------------------------------\nproc define_frames_range()\n{\n    global string $gPlayBackSlider;  \n    global float $startFrame; global float $finishFrame;\n    global int $selectedTimeField;\n    float $selectedFrames[]=`timeControl -q -ra $gPlayBackSlider`;\n    \n    if(($selectedFrames[1]-$selectedFrames[0])<=1)\n        {    $startFrame = `playbackOptions  -q -min`;\n    \t         $finishFrame = `playbackOptions  -q -max`;\n    \t         $selectedTimeField = 0;\n        } else \n    \t    {\n    \t        $startFrame = $selectedFrames[0]; \n    \t        $finishFrame = $selectedFrames[1];\n    \t        $selectedTimeField = 1;\n    \t    }\n}\n//-----------------------------------------------------------\n\n\n\n" 
        -sourceType "mel" 
        -commandRepeatable 1
        -flat 1
    ;
}