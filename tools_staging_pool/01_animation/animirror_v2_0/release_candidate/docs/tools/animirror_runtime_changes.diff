+global proc int mtbAV2_read_flag(string $name)
+{
+    global int $mtbAV2_flags[];
+    if ($name == "TranslationsCheckbox") return $mtbAV2_flags[0];
+    if ($name == "RotationsCheckbox") return $mtbAV2_flags[1];
+    if ($name == "XAxisRotCheckbox") return $mtbAV2_flags[2];
+    if ($name == "YAxisRotCheckbox") return $mtbAV2_flags[3];
+    if ($name == "ZAxisRotCheckbox") return $mtbAV2_flags[4];
+    if ($name == "XAxisTransRadio") return $mtbAV2_flags[5];
+    if ($name == "YAxisTransRadio") return $mtbAV2_flags[6];
+    if ($name == "ZAxisTransRadio") return $mtbAV2_flags[7];
+    error "Unknown AniMirror option";
+    return 0;
+}
+
+global proc string[] mtbAV2_read_cache(string $name)
+{
+    global string $mtbAV2_centerJoint[];
+    global string $mtbAV2_operatorTrans[];
+    global string $mtbAV2_operatorRotate[];
+    if ($name == "centerJoint") return $mtbAV2_centerJoint;
+    if ($name == "operatorTrans") return $mtbAV2_operatorTrans;
+    if ($name == "operatorRotate") return $mtbAV2_operatorRotate;
+    error "Unknown AniMirror cache";
+    string $empty[];
+    return $empty;
+}
