global string $bb_Tools_Path;

//对应，图片，mel名，按钮名
global string $buttonArray[];
$buttonArray = {"Icon/Rename.png","bbstg_wp_RenameWindow;","bb_Tools_Rename",//重命名
                "Icon/List.png","bbstg_bb_listTool;","bb_Tools_List",//批量处理
                "Icon/Ctrl.png","bbstg_bb_ctrlTool;","bb_Tools_Ctrl",//控制器
                "Icon/Attr.png","bbstg_bb_attributeTool;","bb_Tools_Attr",//属性
                "Icon/CV.png","bbstg_bb_curveTool;","bb_Tools_CV",//CV工具
                "Icon/BS.png","bbstg_bb_blendShapeTool;","bb_Tools_BS",//BS
                "Icon/QC.png","bbstg_bb_QCTool;","bb_Tools_QC",//QC
                "Icon/ADV.png","bbstg_bb_advFixTool;","bb_Tools_ADV",//ADV
                "Icon/FBX.png","bbstg_bb_FBXExportTool;","bb_Tools_FBX",//FBX
                "Icon/Pose.png","bbstg_cgTkShapeBuilder;","bb_Tools_Pose",//Pose
                "Icon/Mirror.png","bbstg_abSymMesh;","bb_Tools_Mirror",//对称
                "Icon/Weight.png","bbstg_bb_skin2Deform;","bb_Tools_Weight",//权重转换
                "Icon/Follicles.png","bbstg_bb_createFolliceTool;","bb_Tools_Follicles",//毛囊
                "Icon/Dynamic.png","bbstg_cdkMakeDynamicChainUI;","bb_Tools_Dynamic",//动力学
                "Icon/SoftMod.png","bbstg_bb_softModTool;","bb_Tools_SoftMod",//软选择
                "Icon/Select.png","bbstg_bb_selectTool;","bb_Tools_Select",//选择类型
                "Icon/History.png","bbstg_bb_history;","bb_Tools_History",//历史
                "Icon/SkinList.png","bbstg_bb_skinList;","bb_Tools_SkinList",//蒙皮列表
                //"Icon/AutoSkirt.png","bbstg_bb_autoSkirt;","bb_Tools_AutoSkirt",//自动裙子
                "Icon/TexPath.png","bbstg_FileTextureManager;","bb_Tools_TexPath",//贴图路径
                "Icon/Duplicate.png","bbstg_LxxBSReplace;","bb_Tools_Duplicate",//批量复制
                "Icon/FixError.png","bbstg_bb_FixError;","bb_Tools_FixError"};//报错

global int $bb_Tools_rowColumn,$bb_Tools_MaxControl;
$bb_Tools_rowColumn = size($buttonArray)/3 + 1;
$bb_Tools_MaxControl = size($buttonArray)/3 + 1;

global proc bbstg_bb_Tools()
{
    global string $bb_Tools_Path;
    $bb_Tools_Path = `bbstg_bb_Tools_FilePath`;
    bbstg_bb_Tools_Win;
}
// Candidate: explicit native UI entry only.
//提取路径
global proc string bbstg_bb_Tools_FilePath()
{
    global string $bbstg_bundleRoot; return $bbstg_bundleRoot;
}

global proc bbstg_bb_Tools_initialization()
{
    global int  $bb_Tools_rowColumn;
    if(`optionVar -exists bb_Tools_rowColumn`)
        $bb_Tools_rowColumn = `optionVar -q bb_Tools_rowColumn`;
}

global proc bbstg_bb_Tools_Win()
{
    global int $bb_Tools_rowColumn;
    global int $bb_Tools_MaxControl;
    global string $bb_Tools_Path;
    bbstg_bb_Tools_initialization;
    if (`workspaceControl -q -exists bb_Tools_workspaceControl`) deleteUI bb_Tools_workspaceControl;
    if (`window -q -exists bb_Tools_Window`) deleteUI bb_Tools_Window;
        window -title "BB工具" -resizeToFitChildren 1 -toolbox 1 -sizeable 1 bb_Tools_Window;
            rowColumnLayout -numberOfColumns $bb_Tools_rowColumn -rowSpacing 1 1 bb_Tools_RCL;
                iconTextButton -image ($bb_Tools_Path + "Icon/BB.png") -c bbstg_bb_Tools_WindowChange -dcc "bbstg_bb_Tools_WindowRow" bb_Tools_Set;
                popupMenu -mm on -b 3 -p bb_Tools_Set;
                    //menuItem -rp "N" -l "窗口模式" -c "bbstg_bb_Tools";
                    menuItem -rp "E" -l "停靠右边" -c "bbstg_bb_Tools_workspace(\"right\")";
                    menuItem -rp "W" -l "停靠左边" -c "bbstg_bb_Tools_workspace(\"left\")";
         window -e -wh 35 35 -resizeToFitChildren 1 bb_Tools_Window;
         bbstg_bb_Tools_iconTextButton;
    showWindow bb_Tools_Window;
}


global proc bbstg_bb_Tools_workspace(string $dtm)
{
    if (`window -q -exists bb_Tools_Window`) deleteUI bb_Tools_Window;
    if (`workspaceControl -q -exists bb_Tools_workspaceControl`) deleteUI bb_Tools_workspaceControl;
    workspaceControl -retain false -floating true -uiScript "bbstg_bb_Tools_rowColumnLayout();" bb_Tools_workspaceControl;
    workspaceControl -e -l "bbstg_bb_Tools" -dtm $dtm 1 bb_Tools_workspaceControl;
}

global proc bbstg_bb_Tools_rowColumnLayout()
{
    global string $bb_Tools_Path;
    $bb_Tools_Path = `bbstg_bb_Tools_FilePath`;
    global int $bb_Tools_rowColumn;
    bbstg_bb_Tools_initialization;
        scrollLayout -w 40;
            rowColumnLayout -numberOfColumns 1 -rowSpacing 1 1 bb_Tools_RCL;
                iconTextButton -image ($bb_Tools_Path + "Icon/BB.png") bb_Tools_Set;
                popupMenu -mm on -b 3 -p bb_Tools_Set;
                    menuItem -rp "N" -l "窗口模式" -c "bbstg_bb_Tools_Win";
                    //menuItem -rp "E" -l "停靠右边" -c "bbstg_bb_Tools_workspace(\"right\")";
                    //menuItem -rp "W" -l "停靠左边" -c "bbstg_bb_Tools_workspace(\"left\")";
    bbstg_bb_Tools_iconTextButton;
}

global proc bbstg_bb_Tools_EditWorkspace()
{
    global int $bb_Tools_rowColumn;
    global int $bb_Tools_MaxControl;
    bbstg_bb_Tools_initialization;
    int $width = $bb_Tools_rowColumn*32;
    float $heightFloat = ($bb_Tools_MaxControl*0.1/$bb_Tools_rowColumn)*32;
    int $height = `ceil $heightFloat`;
    window -e -w $width -h $height -resizeToFitChildren 1 bb_Tools_Window;
}

global proc bbstg_bb_Tools_WindowChange()
{
    global int $bb_Tools_rowColumn;
    bbstg_bb_Tools_initialization;
    global int $bb_Tools_MaxControl;
    int $hight = `window -q -h bb_Tools_Window`;
    int $width = `window -q -w bb_Tools_Window`;
    if($hight > 40 || $width > 40){
        bbstg_bb_Tools_DeleteIconTextButton;
        window -e -wh 35 35 -resizeToFitChildren 1 bb_Tools_Window;
        iconTextButton -e -dcc "bbstg_bb_Tools_WindowChange" bb_Tools_Set;
    }
    else if($hight < 40 || $width < 40){
        int $width1 = $bb_Tools_rowColumn*32;
        float $heightFloat = ($bb_Tools_MaxControl*0.1/$bb_Tools_rowColumn)*32;
        int $height1 = `ceil $heightFloat`;
        window -e -wh $width1 $height1 -resizeToFitChildren 1 bb_Tools_Window;
        bbstg_bb_Tools_iconTextButton;
        iconTextButton -e -dcc "bbstg_bb_Tools_WindowRow" bb_Tools_Set;
    }
    if (`window -q -exists bb_ToolsRowWindow`) deleteUI bb_ToolsRowWindow;
}

global proc bbstg_bb_Tools_WindowRow()
{
    global int $bb_Tools_rowColumn;
    global int $bb_Tools_MaxControl;
    bbstg_bb_Tools_initialization;
    if (`window -q -exists bb_ToolsRowWindow`) deleteUI bb_ToolsRowWindow;
    window -title "工具行列调整" -resizeToFitChildren 1 -toolbox 1 -sizeable 1 bb_ToolsRowWindow;
        columnLayout ;
            intSliderGrp -h 35 -label "行数量：" -field true -columnWidth 1 50 -columnWidth 2 50 -columnWidth 3 200
                         -value $bb_Tools_rowColumn -minValue 1 -maxValue $bb_Tools_MaxControl -fieldMinValue 1
                         -fieldMaxValue $bb_Tools_MaxControl -step 1 -dragCommand bbstg_bb_Tools_rowColumnChange RowISG;
    showWindow bb_ToolsRowWindow;
}

global proc bbstg_bb_Tools_rowColumnChange()
{
    int $column = `intSliderGrp -q -value RowISG`;
    global int $bb_Tools_rowColumn;
    global string $bb_Tools_Path;
    $bb_Tools_Path = `bbstg_bb_Tools_FilePath`;
    optionVar -iv bb_Tools_rowColumn $column;
    deleteUI -layout bb_Tools_RCL;
    rowColumnLayout -p bb_Tools_Window -numberOfColumns $column -rowSpacing 1 1 bb_Tools_RCL;
        iconTextButton -image ($bb_Tools_Path + "Icon/BB.png") -c bbstg_bb_Tools_WindowChange -dcc bbstg_bb_Tools_WindowRow bb_Tools_Set;
    window -e -wh 35 35 -resizeToFitChildren 1 bb_Tools_Window;
    bbstg_bb_Tools_iconTextButton;
}

global proc bbstg_bb_Tools_iconTextButton()
{
    global string $bb_Tools_Path;
    $bb_Tools_Path = `bbstg_bb_Tools_FilePath`;
    global string $buttonArray[];
    for($i=0;$i<size($buttonArray);$i+=3){
        iconTextButton -p "bb_Tools_RCL"  -image ($bb_Tools_Path + $buttonArray[$i])
                       -c $buttonArray[$i+1] $buttonArray[$i+2];
    }
}

global proc bbstg_bb_Tools_DeleteIconTextButton()
{
    global string $buttonArray[];
    for($i=0;$i<size($buttonArray);$i+=3){
        deleteUI -control $buttonArray[$i+2];
    }
}
