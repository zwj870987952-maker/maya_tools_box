global proc mtkPTC_Native_LocalspaceLoc() {
python("from maya_toolkit.tools.physics_tools.runtime import require_scope; require_scope()");

    if( `objExists "ObjectLocal_00"` ) {
         print "You already clicked!";
     }
     else{

    string $naSelecao[]= `ls -sl`;
    if (size($naSelecao) > 0 && `objExists $naSelecao[0]`){
    select $naSelecao[0];
    selectMode -object;
    sets -n "ObjectLocal_00";
    spaceLocator -n "FirstLoc_00" -p 0 0 0;
    spaceLocator -n "SecondLoc_00" -p 0 0 0;
    parent SecondLoc_00 FirstLoc_00 ;
    select "ObjectLocal_00";
    select -add "FirstLoc_00";
    pointConstraint -offset 0 0 0 -weight 1;
    orientConstraint -offset 0 0 0 -weight 1;
    select -add "FirstLoc_00";
    setAttr -lock true "FirstLoc_00.tx";
    setAttr -lock true "FirstLoc_00.ty";
    setAttr -lock true "FirstLoc_00.tz";
    select -clear;
    select "FirstLoc_00";
    refresh -su true;
    string $startFrame = `playbackOptions -q -min`;
    string $endFrame = `playbackOptions -q -max`;
    bakeResults -t (($startFrame) + ":" + ($endFrame)) -sm true -sr false -sb 1.0 -pok true;
    refresh -su false;
    mtkPTC_Delete({"FirstLoc_00_orientConstraint1"}, 0);
    select "SecondLoc_00";
    select -add "ObjectLocal_00";
    orientConstraint -offset 0 0 0 -weight 1;
    select -clear;
    select "SecondLoc_00";
    color -rgb 1 1 0;
}

