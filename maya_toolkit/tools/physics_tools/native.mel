global proc mtkPTC_Native_Bakeinfo() {
python("from maya_toolkit.tools.physics_tools.runtime import require_scope; require_scope()");

    if( `objExists Physics_grp` ) {
         warning("You already have clicked!")
         ( `objExists Physics` )
         warning("You already have clicked!");
         }
     else {
        selectMode -object;
        sets -n "PhysicsSets";
        spaceLocator -n "InsertKeyframes";
        particle -n "MagicDust" -p -0 -0 -0 -c 1 ;
        escapeCurrentTool;
        select -r MagicDust ;
        setAttr "MagicDustShape.particleRenderType" 4;
        select -r MagicDustShape ;
        select -r InsertKeyframes ;
        connectAttr -f MagicDustShape.worldCentroid InsertKeyframes.translate;
        spaceLocator -n "PathLocator";
        select -r MagicDustShape ;
        select -add PathLocator ;
        goal -w 0.5 -utr 0   -g PathLocator  MagicDust;
        select -r MagicDust ;
        select -add PathLocator ;
        select -add InsertKeyframes ;
        group -n "Physics";
        select PhysicsSets;
        select -add Physics;
        parentConstraint -weight 1;
        parent -world Physics|MagicDust;
        parent -world Physics|InsertKeyframes;
        parent -world Physics|PathLocator;
        select -r MagicDust;
        select -add Physics;
        select -add InsertKeyframes;
        select -add PathLocator;
        group -n "Physics_grp";
        select Physics;
        mtkPTC_Delete({}, 0);
        select PhysicsSets;
        select -add PathLocator;
        parentConstraint -weight 1;
            select MagicDustShape;
    float $GoalsmoothPhysicsFive = `mtkPTC_Value("mtkPTC_Goalsmooth")`;
        setAttr "MagicDustShape.goalSmoothness" $GoalsmoothPhysicsFive;
    float $GoalWeightPhysicsFive = `mtkPTC_Value("mtkPTC_GoalWeight")`;
        setAttr "MagicDustShape.goalWeight[0]" $GoalWeightPhysicsFive;
    select InsertKeyframes;
    refresh -su true;
    string $startFrame = `playbackOptions -q -min`;
    string $endFrame = `playbackOptions -q -max`;
    bakeResults -t (($startFrame) + ":" + ($endFrame)) -sm true -sr false -sb 1.0 -pok true;
    refresh -su false;
    select -clear;
    select MagicDust;
    select -add PathLocator;
    mtkPTC_Delete({}, 0);
    select InsertKeyframes;
    select -add PhysicsSets;
    parentConstraint -mo -skipRotate x -skipRotate y -skipRotate z -weight 1;
        }

}
global proc mtkPTC_Native_BakeinfoController() {
python("from maya_toolkit.tools.physics_tools.runtime import require_scope; require_scope()");

    select PhysicsSets;
    refresh -su true;
    string $startFrame = `playbackOptions -q -min`;
    string $endFrame = `playbackOptions -q -max`;
    bakeResults -t (($startFrame) + ":" + ($endFrame)) -sm true -sr false -sb 1.0 -pok true -dl "bakedTRANS";
    refresh -su false;
    string $selected[]=`ls -sl`;
    for ($node in $selected )
    {
        string $layernamee = mtkPTC_HelperName("_Translations", $node);
        rename BakeResults $layernamee;
    }
    select -clear;
    select -add Physics_grp;
    mtkPTC_Delete({}, 0);
    if (`objExists PhysicsSets`) {
select PhysicsSets;
    sets -remove "PhysicsSets";
    select -r -ne PhysicsSets ;
    mtkPTC_Delete({}, 0);
}
    playbackOptions -playbackSpeed 1;
    print "The Magic is Done!";


}
global proc mtkPTC_Native_toLocator() {
python("from maya_toolkit.tools.physics_tools.runtime import require_scope; require_scope()");

    string $selected[]=`ls -sl`;
    for ($node in $selected ){
        string $imLocatorName = mtkPTC_HelperName("imLocator_", $node);
        if (`objExists $imLocatorName`){
            mtkPTC_Delete({$imLocatorName}, 0);
        }
        spaceLocator -name $imLocatorName;
        setAttr ($imLocatorName+".rotateOrder") `getAttr ($node+".rotateOrder")`;
        mtkPTC_Delete(`parentConstraint $node $imLocatorName`, 0);
        select -add $imLocatorName;
        select -deselect $node;
        }
         print "Done!";

}
global proc mtkPTC_Native_createlocs() {
python("from maya_toolkit.tools.physics_tools.runtime import require_scope; require_scope()");

    if( `objExists "PointAimVector1"` ) {
         print "You already clicked";
     }
     else{
    select "PhysicRotationAimSets";
    select -add "PointAimVector";
    parentConstraint -mo -weight 1;
    select -clear;
    select "PointAimVector";
    refresh -su true;
    string $startFrame = `playbackOptions -q -min`;
    string $endFrame = `playbackOptions -q -max`;
    bakeResults -t (($startFrame) + ":" + ($endFrame)) -sm true -sr false -sb 1.0 -pok true;
    refresh -su false;
    select "PointAimVector";
    mtkPTC_Delete({}, 1);
    select -cl;
    select "PhysicRotationAimSets";
    selectMode -object;
    sets -n "ControlerSetAim";
    spaceLocator -n "FirstLoc" -p 0 0 0;
    spaceLocator -n "SecondLoc" -p 0 0 0;
    parent SecondLoc FirstLoc ;
    select "ControlerSetAim";
    select -add "FirstLoc";
    pointConstraint -offset 0 0 0 -weight 1;
    orientConstraint -offset 0 0 0 -weight 1;
    select -add "FirstLoc";
    setAttr -lock true "FirstLoc.tx";
    setAttr -lock true "FirstLoc.ty";
    setAttr -lock true "FirstLoc.tz";
    select -clear;
    select "FirstLoc";
    refresh -su true;
    string $startFrame = `playbackOptions -q -min`;
    string $endFrame = `playbackOptions -q -max`;
    bakeResults -t (($startFrame) + ":" + ($endFrame)) -sm true -sr false -sb 1.0 -pok true;
    refresh -su false;
    mtkPTC_Delete({"FirstLoc_orientConstraint1"}, 0);
    select "PointAimVector";
    select -add "SecondLoc";
    aimConstraint -mo -weight 1 -aimVector 0 1 0 -upVector 0 1 0 -worldUpType "objectrotation" -worldUpVector 0 1 0 -worldUpObject FirstLoc;
    select "SecondLoc";
    select -add PhysicRotationAimSets;
    orientConstraint -offset 0 0 0 -weight 1;
    select -clear;
    select "PointAimVector";
    animLayer  PointAimVector;
    animLayer -e -addSelectedObjects PointAimVector1;
    select -clear;
    manipMoveContext -edit -mode 2 Move;
    print "Done!";
         }

}
