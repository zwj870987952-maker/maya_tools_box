    float $GoalsmoothPhysicsDampingTR = `mtkPTC_Value("mtkPTC_Goaldamping")`;
        setAttr "jiggle1.damping" $GoalsmoothPhysicsDampingTR;
        select jiggle1;
    float $GoalWeightPhysicsWeighttTR = `mtkPTC_Value("mtkPTC_GoalWeightt")`;
        setAttr "jiggle1.jiggleWeight" $GoalWeightPhysicsWeighttTR;
        select jiggle1;
    select "JiggleMe";
    refresh -su true;
    string $startFrame = `playbackOptions -q -min`;
    string $endFrame = `playbackOptions -q -max`;
    bakeResults -t (($startFrame) + ":" + ($endFrame)) -sm true -sr false -sb 1.0 -pok true;
    refresh -su false;
    select "JiggleMe";
    mtkPTC_Delete({}, 1);
    select "JiggleMe";
    createHair 1 1 10 0 0 0 0 5 0 1 1 1;
    rename "hairSystem1Follicles" "DontTouch";
    rename "JiggleMeFollicle5050" "JiggleMeFollicle";
    select "pfxHair*";
    select -add "curve1";
    select -add "hairSystem*";
    select -add "nucleus*";
    mtkPTC_Delete({}, 0);
    select "JiggleMeFollicle";
    select -add "JiggleSet";
    parentConstraint -mo -weight 1;
    select "JiggleMe";
    select -add "DontTouch";
    group -n "Nothing";
    //setAttr DontTouch.hiddenInOutliner true;AEdagNodeCommonRefreshOutliners();
    setAttr "JiggleMe.hideOnPlayback" 1;
    mtkPTC_ClearOwnCache();
    print "Magic!";
    select "JiggleSet";
    refresh -su true;
    string $startFrame = `playbackOptions -q -min`;
    string $endFrame = `playbackOptions -q -max`;
    bakeResults -t (($startFrame) + ":" + ($endFrame)) -sm true -sr false -sb 1.0 -pok true -dl "bake";
    refresh -su false;
    string $selected[]=`ls -sl`;
    for ($node in $selected )
    {
        string $layernamee = mtkPTC_HelperName("_Overlap", $node);
        rename BakeResults $layernamee;
    }
    select "Nothing";
    mtkPTC_Delete({}, 0);
    select -r -ne JiggleSet;
    mtkPTC_Delete({}, 0);
    playbackOptions -playbackSpeed 1;
    print "Magic!";
    }

     //selecao 20 -----------------------------------------
    if (size($naSelecao) > 19 && `objExists $naSelecao[19]`){
    select $naSelecao[19];
    selectMode -object;
    sets -n "JiggleSet";
    polyPlane -n "JiggleMe" -w 1 -h 1 -sx 1 -sy 1 -ax 0 1 0 -cuv 2 -ch 1;
    select  "JiggleMe";
    mtkPTC_CreateJiggle();
    select  "JiggleSet";
    select  -add "JiggleMe";
    parentConstraint -weight 1;
    setAttr "JiggleMe.visibility" 0;
        float $GoalsmoothPhysicsStiffnessTR = `mtkPTC_Value("mtkPTC_Goalstiffness")`;
        setAttr "jiggle1.stiffness" $GoalsmoothPhysicsStiffnessTR;
        select jiggle1;
    float $GoalsmoothPhysicsDampingTR = `mtkPTC_Value("mtkPTC_Goaldamping")`;
        setAttr "jiggle1.damping" $GoalsmoothPhysicsDampingTR;
        select jiggle1;
    float $GoalWeightPhysicsWeighttTR = `mtkPTC_Value("mtkPTC_GoalWeightt")`;
        setAttr "jiggle1.jiggleWeight" $GoalWeightPhysicsWeighttTR;
        select jiggle1;
    select "JiggleMe";
    refresh -su true;
    string $startFrame = `playbackOptions -q -min`;
    string $endFrame = `playbackOptions -q -max`;
    bakeResults -t (($startFrame) + ":" + ($endFrame)) -sm true -sr false -sb 1.0 -pok true;
    refresh -su false;
    select "JiggleMe";
    mtkPTC_Delete({}, 1);
    select "JiggleMe";
    createHair 1 1 10 0 0 0 0 5 0 1 1 1;
    rename "hairSystem1Follicles" "DontTouch";
    rename "JiggleMeFollicle5050" "JiggleMeFollicle";
    select "pfxHair*";
    select -add "curve1";
    select -add "hairSystem*";
    select -add "nucleus*";
    mtkPTC_Delete({}, 0);
    select "JiggleMeFollicle";
    select -add "JiggleSet";
    parentConstraint -mo -weight 1;
    select "JiggleMe";
    select -add "DontTouch";
    group -n "Nothing";
    //setAttr DontTouch.hiddenInOutliner true;AEdagNodeCommonRefreshOutliners();
    setAttr "JiggleMe.hideOnPlayback" 1;
    mtkPTC_ClearOwnCache();
    print "Magic!";
    select "JiggleSet";
    refresh -su true;
    string $startFrame = `playbackOptions -q -min`;
    string $endFrame = `playbackOptions -q -max`;
    bakeResults -t (($startFrame) + ":" + ($endFrame)) -sm true -sr false -sb 1.0 -pok true -dl "bake";
    refresh -su false;
    string $selected[]=`ls -sl`;
    for ($node in $selected )
    {
        string $layernamee = mtkPTC_HelperName("_Overlap", $node);
        rename BakeResults $layernamee;
    }
    select "Nothing";
    mtkPTC_Delete({}, 0);
    select -r -ne JiggleSet;
    mtkPTC_Delete({}, 0);
    playbackOptions -playbackSpeed 1;
    print "Magic!";
    }

}
global proc mtkPTC_Native_ruidoA() {
python("from maya_toolkit.tools.physics_tools.runtime import require_scope; require_scope()");

    mtkPTC_Embedded("\n\n\n\namplitude = 1\n\nimport maya.cmds as cmds\nimport maya.mel as mel\nimport random as rand\n\n\naTimeSlider = mel.eval('$tmpVar=$gPlayBackSlider')\ntimeRange = cmds.timeControl(aTimeSlider, q=True, rangeArray=True)\nobjects = cmds.ls ( orderedSelection = True, long = True)\n\n\nif objects:\n    timeRange[1] = timeRange[1]-1\n    \n    curvesToBake = cmds.channelBox(\"mainChannelBox\", q=1, sma=1)\n    \n    aLayer = mel.eval('treeView -query -selectItem (\"AnimLayerTabanimLayerEditor\")')\n    \n    if not aLayer or len(aLayer) <= 1:\n        \n        if curvesToBake:\n            \n            if not aLayer:\n                aLayer = []\n                aLayer.append(cmds.animLayer('noiseLayer'))\n            elif aLayer[0] == 'BaseAnimation':\n                aLayer[0] = cmds.animLayer('noiseLayer')\n            cmds.animLayer(aLayer[0], edit=True, addSelectedObjects=True)\n            \n            \n            if (timeRange[1]) - timeRange[0] == 0:\n                \n                startTime = cmds.playbackOptions( q=True, minTime=True )\n                endTime = cmds.playbackOptions( q=True, maxTime=True )\n                \n                for x in curvesToBake:\n                    \n                    \n                    cmds.bakeResults( objects, attribute=x, time=(startTime, endTime), simulation=False, preserveOutsideKeys = True, destinationLayer=aLayer[0])\n                    \n                    for o in objects:\n                        \n                        for t in range(int(startTime),int(endTime+1)):\n                            v = cmds.keyframe( o, attribute=x, query=True, eval=True, time=(t,t))\n                            randV = rand.uniform(-1*amplitude,amplitude)\n                            cmds.keyframe(o, attribute=x, valueChange=randV, time=(t,t))\n                        \n                        cmds.setKeyframe(o, identity=True, dirtyDG=True, time=(startTime,startTime))\n                        cmds.setKeyframe(o, identity=True, dirtyDG=True, time=(endTime,endTime))\n                   \n            \n            else:\n                \n                for x in curvesToBake:\n                    \n                    cmds.bakeResults( objects, attribute=x, time=(timeRange[0], timeRange[1]), simulation=False, preserveOutsideKeys = True, destinationLayer=aLayer[0])\n                    \n                    for o in objects:\n                        for t in range(int(timeRange[0]),int(timeRange[1])):\n                            if t == int(timeRange[0]):\n                                \n                                cmds.setKeyframe(o, attribute=x)\n                            else:\n                                \n                                v = cmds.keyframe( o, attribute=x, query=True, eval=True, time=(t,t))\n                                randV = rand.uniform(-1*amplitude,amplitude)\n                                cmds.keyframe(o, attribute=x, valueChange=randV, time=(t,t))\n                        \n                        cmds.setKeyframe(o, identity=True, dirtyDG=True, time=(timeRange[0],timeRange[0]))\n                        cmds.setKeyframe(o, identity=True, dirtyDG=True, time=(timeRange[1],timeRange[1]))\n\n\n        else: cmds.confirmDialog(title='Error', message='Select one or channels to apply noise')\n    else: cmds.confirmDialog(title='Error', message='Select one or less animation layers to apply noise')\nelse: cmds.confirmDialog(title='Error', message='Select one or more objects to convert to apply noise')");


}
