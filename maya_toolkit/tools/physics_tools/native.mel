global proc mtkPTC_Native_PhysicsToolsWin() {
python("from maya_toolkit.tools.physics_tools.runtime import require_scope; require_scope()");


if (`window -q -ex mtkPTC_PhysicsToolsWin`) {deleteUI mtkPTC_PhysicsToolsWin;}
string $window = `window -menuBar true  -title "Physics Tools v1.8 IuriMonteiro" -iconName "Physics Tools v1.8" -widthHeight 390 480 -bgc 0.1 0.1 0.1 mtkPTC_PhysicsToolsWin`;
       scrollLayout mtkPTC_Scroll;
checkBox -label "Allow reference edits" -value false mtkPTC_AllowReferences;
       button -label "Animation Mode Engaged" -bgc 0.0 0.5 0.5 -command ("mtkPTC_engagemode") -w 380;
       menu -label "Help";
       menuItem -label "imonteiro91@gmail.com" -c ("mtkPTC_ReportBug");
       menuItem -label "mtkPTC_Youtube" -c ("mtkPTC_Youtube");
       menuItem -label "mtkPTC_Vimeo" -c ("mtkPTC_Vimeo");
       menuItem -label "Gumroad" -c ("mtkPTC_gumroad");
       text -label "                              Characters should be imported as reference";
       frameLayout -label "Physics Translations" -bgc 0.5 0.4 0.0 -cl 1 -cll 1 -w 380;
       frameLayout -label "Physics Translations Basic" -bgc 0.8 0.5 0.0 -cl 1 -cll 1 -w 380;
       columnLayout -bgc 0.3 0.3 0.3 -adjustableColumn true -cal "center";
       separator;
       separator;
       button -label "1.-Setup/Preview" -bgc 0.5 0.5 0.5 -command ("mtkPTC_PhysicsMagicButton"); //mtkPTC_Bakeinfo
       separator;
       text -label "You can change the sliders while playing the animation";
       floatSliderGrp -label "Overlap" -field true -minValue -0.0 -maxValue 10.0 -ss 0.01 -dc ("mtkPTC_RefeshParticleSettings") -value 2.0 mtkPTC_Goalsmooth;
       separator -h 5;
       floatSliderGrp -label "Weight" -field true -minValue -0.0 -maxValue 1.0 -ss 0.01 -dc ("mtkPTC_RefeshParticleSettings") -value 0.5 mtkPTC_GoalWeight;
       separator;
       rowColumnLayout -bgc 0.2 0.2 0.2 -numberOfRows 1;
       button -label "                    mtkPTC_PlayEveryframe                " -bgc 0.4 0.2 0.0 -command ("mtkPTC_PlayEveryframe");
       button -label "                     PlayRealtime                " -bgc 0.0 0.2 0.4 -command ("mtkPTC_PlayNormalframe");
       setParent ..;
       button -label "ChannelBox Particle Options" -bgc 0.0 0.4 0.0 -command ("mtkPTC_ParticleOptionsTwo");
       button -label "Key Dynamics" -bgc 0.0 0.3 0.0 -command ("mtkPTC_keyframeDy");
       separator;
       button -label "Redo(Clean Outliner)" -bgc 0.3 0.0 0.0 -command ("mtkPTC_cleanMAHshit");
       separator;
       button -label "--------2.-MAGIC--------" -bgc 0.5 0.5 0.5 -command ("mtkPTC_BakeinfoController");
       setParent ..;
       setParent ..;
       frameLayout -label "Physics Translations Multiple Objects" -bgc 0.8 0.5 0.0 -cl 1 -cll 1 -w 380; //nao esquecer de mudar o nome do refreshparticles
       columnLayout -bgc 0.3 0.3 0.3 -adjustableColumn true -cal "center";
       text -label "You can't preview realtime so adjust the";
       text -label "sliders first and the click Supreme magic";
       floatSliderGrp -label "Overlap" -field true -minValue -0.0 -maxValue 10.0 -ss 0.01 -dc ("mtkPTC_RefeshParticleSettingsThree") -value 2.0 mtkPTC_Goalsmooththree;
       separator -h 5;
       floatSliderGrp -label "Weight" -field true -minValue -0.0 -maxValue 1.0 -ss 0.01 -dc ("mtkPTC_RefeshParticleSettingsThree") -value 0.5 mtkPTC_GoalWeightthree;
       separator;
       button -label "----Supreme Magic----" -bgc 0.5 0.5 0.5 -command ("mtkPTC_BakeVariosControladores");
       setParent ..;
       setParent ..;
       setParent ..;
//---------------Rotacoes---------------------------------------------------------------------------------------------
       frameLayout -label "Physics Rotations" -bgc 0.5 0.4 0.0 -cl 1 -cll 1 -w 380;
       frameLayout -label "Physics Rotations Basic" -bgc 0.8 0.5 0.0 -cl 1 -cll 1 -w 380;
       columnLayout -bgc 0.3 0.3 0.3 -adjustableColumn true;
       button -label "1.-Setup - Rotations" -bgc 0.5 0.5 0.5 -command ("mtkPTC_SetupRotationsPhysics");
       text -label "Needs to play one time first and on the 2";
       text -label "play you can see and change the physics";
       text -label "To see them click mtkPTC_PlayEveryframe";
       floatSliderGrp -label "Softness" -field true -minValue -0.0 -maxValue 1.0 -ss 0.01 -dc ("mtkPTC_RefeshParticleSettingsRotations") -value 0.1 mtkPTC_GoalstiffnessRotations;
       separator -h 5;
       floatSliderGrp -label "Stiffness" -field true -minValue -0.0 -maxValue 1.0 -ss 0.01 -dc ("mtkPTC_RefeshParticleSettingsRotations") -value 0.4 mtkPTC_GoaldampingRotations;
       separator -h 5;
       floatSliderGrp -label "Weight" -field true -minValue -0.0 -maxValue 0.9 -ss 0.01 -dc ("mtkPTC_RefeshParticleSettingsRotations") -value 0.7 mtkPTC_GoalWeightRotations;
       separator;
       text -label "Important- You can only select 1 controller";
       text -label "You can only do this 1 controller at a time";
       text -label "You can change the sliders while playing the animation";
       rowColumnLayout -bgc 0.2 0.2 0.2 -numberOfRows 1;
       button -label "                    mtkPTC_PlayEveryframe                " -bgc 0.4 0.2 0.0 -command ("mtkPTC_PlayEveryframe");
       button -label "                     PlayRealtime                " -bgc 0.0 0.2 0.4 -command ("mtkPTC_PlayNormalframe");
       setParent ..;
       button -label "ChannelBox Particle Options" -bgc 0.0 0.4 0.0 -command ("mtkPTC_ParticleOptions");
       button -label "Key Dynamics" -bgc 0.0 0.3 0.0 -command ("mtkPTC_keyframeDyy");
       button -label "2.-mtkPTC_Bake Controller" -bgc 0.5 0.5 0.5 -command ("mtkPTC_BakePhysics");
       button -label "Redo(Clean Outliner)" -bgc 0.5 0.0 0.0 -command ("mtkPTC_RedoMe");
       separator -h 10;
       button -label "----Supreme Magic----" -bgc 0.5 0.5 0.5 -command ("mtkPTC_SetupRotationsPhysicssmoothA");
       text -label "Up to 30 selectable objects";
       setParent ..;
       setParent ..;
       frameLayout -label "Physics Rotations Advance" -bgc 0.8 0.5 0.0 -cl 1 -cll 1 -w 380;
       columnLayout -bgc 0.3 0.3 0.3 -adjustableColumn true;
       text -label "Move the locator";
       button -label "1.-AimVector Locator" -bgc 0.5 0.5 0.5 -command "mtkPTC_CreateLocatorRotations";
       button -label "2.-UpVector Locator" -bgc 0.5 0.5 0.5 -command "mtkPTC_CreateLocatorUpVectorRotations";
       separator;
       text -label "Setup your aim vector this just needs 1 CLICK";
       text -label "Choose the aimVector side based on the world vector of the object";
       button -label "3.-Setup/Preview | Aimvector +X " -bgc 0.5 0.0 0.0 -command "mtkPTC_SetupRotationsXmais";
       button -label "3.-Setup/Preview | Aimvector -X " -bgc 0.5 0.0 0.0 -command "mtkPTC_SetupRotationsXmenos";
       button -label "3.-Setup/Preview | Aimvector +Y " -bgc 0.0 0.5 0.0 -command "mtkPTC_SetupRotationsYmais";
       button -label "3.-Setup/Preview | Aimvector -Y " -bgc 0.0 0.5 0.0 -command "mtkPTC_SetupRotationsYmenos";
       button -label "3.-Setup/Preview | Aimvector +Z " -bgc 0.0 0.0 0.5 -command "mtkPTC_SetupRotationsZmais";
       button -label "3.-Setup/Preview | Aimvector -Z " -bgc 0.0 0.0 0.5 -command "mtkPTC_SetupRotationsZmenos";
       separator;
       text -label "You can change the sliders while playing the animation";
       separator;
       floatSliderGrp -label "Overlap" -field true -minValue -0.0 -maxValue 10.0 -ss 0.01 -dc ("mtkPTC_RefeshParticleSettingsTwo") -value 2.0 mtkPTC_GoalsmoothTwo  ;
       separator;
       floatSliderGrp -label "Weight" -field true -minValue -0.0 -maxValue 1.0 -ss 0.01 -dc ("mtkPTC_RefeshParticleSettingsTwo") -value 0.5 mtkPTC_GoalWeightTwo  ;
       separator;
       rowColumnLayout -bgc 0.2 0.2 0.2 -numberOfRows 1;
       button -label "                    mtkPTC_PlayEveryframe                " -bgc 0.4 0.2 0.0 -command ("mtkPTC_PlayEveryframe");
       button -label "                     PlayRealtime                " -bgc 0.0 0.2 0.4 -command ("mtkPTC_PlayNormalframe");
       setParent ..;
       button -label "ChannelBox Particle Options" -bgc 0.0 0.4 0.0 -command ("mtkPTC_ParticleOptionsTwo");
       button -label "Key Dynamics" -bgc 0.0 0.3 0.0 -command ("mtkPTC_keyframeDy");
       separator;
       button -label "Redo(Clean Outliner)" -bgc 0.3 0.0 0.0 -command ("mtkPTC_cleanMAHshit");
       separator;
       button -label "---------4.-MAGIC---------" -bgc 0.5 0.5 0.5 -command ("mtkPTC_FinalRotationsBake");
       separator;
       button -label "Euler Filter"  -command ("mtkPTC_EulerFilterClean");
       text -label "If your curves in some frames are wierd click EulerFilter!";
       separator -h 10;
       separator -h 10;
       separator -h 10;
       setParent ..;
       setParent ..;
       setParent ..;
//---------------trans e rot-----------------------------------------------------------------------------------------------
       frameLayout -label "Physics Translations/Rotations" -bgc 0.5 0.4 0.0 -cl 1 -cll 1 -w 380;
       columnLayout -bgc 0.3 0.3 0.3 -adjustableColumn true -cal "center";
       button -label "1.-Setup - Translation and Rotations" -bgc 0.5 0.5 0.5 -command ("mtkPTC_SetupPhysics");
       text -label "Needs to play one time first and on the 2";
       text -label "play you can see and change the physics";
       text -label "To see them click mtkPTC_PlayEveryframe";
       floatSliderGrp -label "Softness" -field true -minValue -0.0 -maxValue 1.0 -ss 0.01 -dc ("mtkPTC_RefeshParticleSettings4") -value 0.1 mtkPTC_Goalstiffness;
       separator -h 5;
       floatSliderGrp -label "Stiffness" -field true -minValue -0.0 -maxValue 1.0 -ss 0.01 -dc ("mtkPTC_RefeshParticleSettings4") -value 0.4 mtkPTC_Goaldamping;
       separator -h 5;
       floatSliderGrp -label "Weight" -field true -minValue -0.0 -maxValue 0.9 -ss 0.01 -dc ("mtkPTC_RefeshParticleSettings4") -value 0.7 mtkPTC_GoalWeightt;
       separator;
       text -label "Important- You can only select 1 controller";
       text -label "You can only do this 1 controller at a time";
       text -label "You can change the sliders while playing the animation";
       rowColumnLayout -bgc 0.2 0.2 0.2 -numberOfRows 1;
       button -label "                    mtkPTC_PlayEveryframe                " -bgc 0.4 0.2 0.0 -command ("mtkPTC_PlayEveryframe");
       button -label "                     PlayRealtime                " -bgc 0.0 0.2 0.4 -command ("mtkPTC_PlayNormalframe");
       setParent ..;
       button -label "ChannelBox Particle Options" -bgc 0.0 0.4 0.0 -command ("mtkPTC_ParticleOptions");
       button -label "Key Dynamics" -bgc 0.0 0.3 0.0 -command ("mtkPTC_keyframeDyy");
       button -label "2.-mtkPTC_Bake Controller" -bgc 0.5 0.5 0.5 -command ("mtkPTC_BakePhysics");
       button -label "Redo(Clean Outliner)" -bgc 0.5 0.0 0.0 -command ("mtkPTC_RedoMe");
       separator -h 10;
       //AQUI------------------------------------------------------
       button -label "----Supreme Magic----" -bgc 0.5 0.5 0.5 -command ("mtkPTC_SetupRotationsPhysicssmoothB");
       text -label "Up to 20 selectable objects";
       text -label "Remember translations need to be visible in the channel box";
       setParent ..;
       setParent ..;
//---------------Scales-----------------------------------------------------------------------------------------------
       //frameLayout -label "Physics Scales Multiple Objects" -bgc 0.5 0.4 0.0 -cl 1 -cll 1 -w 380;
       //text -label "You cant preview realtime so adjust the sliders first";
       //floatSliderGrp -label "Overlap" -field true -minValue -0.0 -maxValue 10.0 -dc ("mtkPTC_RefeshParticleSettings5") -value 2.0 mtkPTC_Goalsmoothfive;
       //separator -h 5;
       //floatSliderGrp -label "Weight" -field true -minValue -0.0 -maxValue 1.0 -dc ("mtkPTC_RefeshParticleSettings5") -value 0.5 mtkPTC_GoalWeightfive;
       //separator;
       //button -label "----Supreme Magic----" -bgc 0.5 0.5 0.5 -command ("mtkPTC_BakeVariosControladores");
       //setParent ..;
//---------------Utilities-------------------------------------
       frameLayout -label "Time" -bgc 0.0 0.4 0.4 -cl 1 -cll 1 -w 380;
       columnLayout -bgc 0.0 0.5 0.5 -adjustableColumn true;
       button -label "mtkPTC_Bake to Layer" -command "mtkPTC_Bake";
//---------------Coluna-------------------------------------
       text -label "Offset Time" -bgc 0.0 0.2 0.2;
       rowColumnLayout -bgc 0.2 0.2 0.2 -nc 2;
       button -label "- Keyframe Offset All-" -w 200 -bgc 0.3 0.0 0.0 -al "left" -command "mtkPTC_OffsetKeysMenos";
       button -label "+ Keyframe Offset All+" -w 200 -bgc 0.0 0.3 0.0 -al "Right"-command "mtkPTC_OffsetKeysMais";
       button -label "Remove Frame" -bgc 0.5 0.5 0.5 -command ("mtkPTC_Rframe");
       button -label "Insert Frame" -bgc 0.5 0.5 0.5 -command ("mtkPTC_Iframe");
       setParent ..;
       setParent ..;
       setParent ..;
//---------------LocalSpace-----------------------------------------------------------------------------------------------
       frameLayout -label "Delay Rotations Workflow" -bgc 0.0 0.4 0.4 -cl 1 -cll 1 -w 380;
       columnLayout -bgc 0.0 0.5 0.5 -adjustableColumn true;
       text -label "Select the controller or object first" -bgc 0.0 0.2 0.2;
       button -label "1.- Create Proxy Locs" -command "mtkPTC_BakeAnimtoLocatorParentRotworkflow";
       button -label "2.- Select Locs" -command "mtkPTC_RotWorkflowSelect";
       text -label "3.- Offset Time" -bgc 0.0 0.2 0.2;
       rowColumnLayout -bgc 0.2 0.2 0.2 -nc 2;
       button -label "- Keyframe Offset All-" -w 200 -bgc 0.3 0.0 0.0 -al "left" -command "mtkPTC_OffsetKeysMenos";
       button -label "+ Keyframe Offset All+" -w 200 -bgc 0.0 0.3 0.0 -al "Right"-command "mtkPTC_OffsetKeysMais";
       setParent ..;
       text -label "Select the initial controllers " -bgc 0.0 0.2 0.2;
       button -label "4.- mtkPTC_Bake to Layer" -command "mtkPTC_BakeRotWork";
       button -label "Redo(Clean Outliner)" -bgc 0.5 0.0 0.0 -command "mtkPTC_RedoDRW";
       setParent ..;
       setParent ..;
       //---------------mtkPTC_Aim Constraint Workflow-----------------------------------------------------------------------------------------------
       frameLayout -label "mtkPTC_Aim Constraint Workflow" -bgc 0.0 0.4 0.4 -cl 1 -cll 1 -w 380;
       columnLayout -bgc 0.0 0.5 0.5 -adjustableColumn true;
       text -label "Select the controller or object first" -bgc 0.0 0.2 0.2;
       button -label "1.- Place mtkPTC_Aim Locator" -command "mtkPTC_CreateLocatorRotationsAim";
       button -label "2.- mtkPTC_Aim Y" -bgc 0.0 0.5 0.0 -command "mtkPTC_createlocs()";
       button -label "2.- mtkPTC_Aim X" -bgc 0.5 0.0 0.0 -command "mtkPTC_createlocsX()";
       button -label "2.- mtkPTC_Aim Z" -bgc 0.0 0.0 0.5 -command "mtkPTC_createlocsZ()";
       text -label "Now you can animate the locator" -bgc 0.0 0.2 0.2;
       text -label "note that a new anim layer was created" -bgc 0.0 0.2 0.2;
       button -label "Select AimController" -bgc 0.0 0.3 0.0 -command "mtkPTC_Aimcontrolerselect";
       button -label "3.- mtkPTC_Bake to Controller" -command "mtkPTC_BakeEverything";
       button -label "Redo(Clean Outliner)" -bgc 0.5 0.0 0.0 -command "mtkPTC_AimDelete";
       setParent ..;
       setParent ..;
       //---------------LocalSpace-----------------------------------------------------------------------------------------------
       frameLayout -label "Rotations Space Workflow" -bgc 0.0 0.4 0.4 -cl 1 -cll 1 -w 380;
       columnLayout -bgc 0.0 0.5 0.5 -adjustableColumn true;
       text -label "Select the controller or object first" -bgc 0.0 0.2 0.2;
       button -label "WorldSpace" -command "mtkPTC_LocalspaceLoc()";
       button -label "Select Ctrl Locs" -bgc 0.0 0.3 0.0 -command "mtkPTC_LocalspaceLoccontrolerselect()";
       button -label "mtkPTC_Bake to Controller" -command "mtkPTC_BakeLocalspaceLoc()";
       button -label "Redo(Clean Outliner)" -bgc 0.5 0.0 0.0 -command "mtkPTC_LocalspaceLocDelete()";
       setParent ..;
       setParent ..;
        //---------------Weapons Controllers-----------------------------------------------------------------------------------------------
       frameLayout -label "Weapons Controllers" -bgc 0.0 0.4 0.4 -cl 1 -cll 1 -w 380;
       rowColumnLayout -bgc 0.2 0.2 0.2 -nc 2;
       button -label "Left Hand" -w 200 -bgc 0.3 0.0 0.0 -al "Left"-command "mtkPTC_createlochandL";
       button -label "Right Hand" -w 200 -bgc 0.0 0.3 0.0 -al "Right" -command "mtkPTC_createlochandR";
       setParent ..;
       columnLayout -bgc 0.0 0.5 0.5 -adjustableColumn true;
       text -label "Select the controller or object first" -bgc 0.0 0.2 0.2;
       text -label "If already created use the same buttons to easily select the controller" -bgc 0.0 0.2 0.2;
       button -label "Redo(Clean Outliner)" -bgc 0.5 0.0 0.0 -command "mtkPTC_Redoweapons";
       setParent ..;
       setParent ..;
       //---------------SpaceLocker-----------------------------------------------------------------------------------------------
       frameLayout -label "SpaceLocker" -bgc 0.0 0.4 0.4 -cl 1 -cll 1 -w 380;
       columnLayout -bgc 0.0 0.5 0.5 -adjustableColumn true;
       button -label "Space Locker" -command "mtkPTC_footPlacer";
       rowColumnLayout -bgc 0.2 0.2 0.2 -numberOfRows 1;
       button -label "- Keyframe -" -w 200 -bgc 0.3 0.0 0.0 -al "left" -command "mtkPTC_OffsetKeysLessSL";
       button -label "+ Keyframe +" -w 200 -bgc 0.0 0.3 0.0 -al "Right"-command "mtkPTC_OffsetKeysMoreSL";
       setParent ..;
       button -label "Delete Space Locker" -command "mtkPTC_footPlacerDeleter";
       setParent ..;
       setParent ..;
       //---------------LocalSpace-----------------------------------------------------------------------------------------------
       frameLayout -label "Proxy Mesh" -bgc 0.0 0.4 0.4 -cl 1 -cll 1 -w 380;
       rowColumnLayout -bgc 0.2 0.2 0.2 -numberOfRows 3;
       button -label "Setup Cubes" -bgc 0.5 0.5 0.0 -command ("mtkPTC_CreateCube");

       button -label "Select Proxies Cubes" -bgc 0.5 0.5 0.5 -command ("mtkPTC_SProxiesCubes");

       button -label "Scale +" -bgc 0.0 0.5 0.0 -command ("mtkPTC_SProxiesMais");

       button -label "Setup Spheres" -bgc 0.5 0.5 0.0 -command ("mtkPTC_CreateSpheres");

       button -label "Select Proxies Spheres" -bgc 0.5 0.5 0.5 -command ("mtkPTC_SProxiesSpheres");

       button -label "Scale -" -bgc 0.5 0.0 0.0 -command ("mtkPTC_SProxiesMenos");

       button -label "Select Proxies" -bgc 0.5 0.5 0.5 -command ("mtkPTC_SProxies");

       button -label "Create Layer" -bgc 0.0 0.5 0.5 -command ("mtkPTC_CL");
       setParent ..;
       setParent ..;
       //---------------Locators-----------------------------------------------------------------------------------------------
       frameLayout -label "Locators" -bgc 0.0 0.4 0.4 -cl 1 -cll 1 -w 380;
       columnLayout -bgc 0.0 0.5 0.5 -adjustableColumn true;
       button -label "Create Locator at Selection" -command "mtkPTC_toLocator()";
       button -label "Select Objs mtkPTC_Bake Anim to Locators" -command "mtkPTC_BakeAnimtoLocator";
       button -label "Select Objs mtkPTC_Bake Anim to Locators and Parent" -command "mtkPTC_BakeAnimtoLocatorParent";
       button -label "Select Objs mtkPTC_Bake Anim to Locators and ParentRotation" -command "mtkPTC_BakeAnimtoLocatorParentRot";
       button -label "Redo(Clean Outliner)" -bgc 0.5 0.0 0.0 -command "mtkPTC_RedoDRW";
       setParent ..;
       setParent ..;
       frameLayout  -label "Constraints" -bgc 0.0 0.4 0.4 -cl 1 -cll 1 -w 380;
       columnLayout -bgc 0.0 0.5 0.5 -adjustableColumn true;
       button -label "mtkPTC_Tempivot" -command "mtkPTC_Tempivot";
       button -label "Align Objects" -command "mtkPTC_AlignCommand";
       button -label "mtkPTC_MatchTransforms" -command "mtkPTC_MatchTransforms";
       button -label "mtkPTC_MatchTranslations" -command "mtkPTC_MatchTranslations";
       button -label "mtkPTC_MatchRotations" -command "mtkPTC_MatchRotations";
       button -label "Parent Constraint Translations MaintainOffset" -command "mtkPTC_PCT";
       button -label "Parent Constraint Rotations MaintainOffset" -command "mtkPTC_PCR";
       button -label "Parent Constraint Translations" -command "mtkPTC_PCToff";
       button -label "Parent Constraint" -command "mtkPTC_ParentConstraintNormal";
       button -label "Point Constraint" -command "mtkPTC_PointC";
       button -label "Oriente Constraint" -command "mtkPTC_OrientC";
       button -label "mtkPTC_Aim Constraint" -command "mtkPTC_Aim";
       button -label "Delete Constraints" -command "mtkPTC_RemoveConstraints";
       text -label "Select the object with the constraints and then use Delete Constraints";
       separator -h 10;
       setParent ..;
       setParent ..;

       frameLayout  -label "Motion Debugger" -bgc 0.0 0.4 0.4 -cl 1 -cll 1 -w 380;
       columnLayout -bgc 0.0 0.5 0.5 -adjustableColumn true;
       button -label "Tracker_01" -command "mtkPTC_tracking_01";
       button -label "Tracker_02" -command "mtkPTC_tracking_02";
       button -label "Tracker_03" -command "mtkPTC_tracking_03";
       button -label "Tracker_04" -command "mtkPTC_tracking_04";
       button -label "Tracker_05" -command "mtkPTC_tracking_05";
       separator -h 10;
       button -label "GhostSelected" -command "mtkPTC_GhostSelectedtrack";
       button -label "UnghostSelected" -command "mtkPTC_UnghostSelectedtrack";
       button -label "UnghostAll" -command "mtkPTC_UnghostAlltrack";
       button -label "Options" -command "mtkPTC_GhostOptions";
       button -label "Delete" -bgc 0.5 0 0.0 -command "mtkPTC_Delete_tracking";
       separator -h 10;
       setParent ..;
       setParent ..;
       frameLayout  -label "Noise" -bgc 0.0 0.4 0.4 -cl 1 -cll 1 -w 380;
       columnLayout -bgc 0.0 0.5 0.5 -adjustableColumn true;
       button -label "Noise Low" -bgc 0.0 0.5 0.5 -command ("mtkPTC_ruidoA") -w 380;
       button -label "Noise Mid" -bgc 0.0 0.5 0.5 -command ("mtkPTC_ruidoB") -w 380;
       button -label "Noise High" -bgc 0.0 0.5 0.5 -command ("mtkPTC_ruidoC") -w 380;
       separator -h 10;
       setParent ..;
       setParent ..;
       separator -h 10;
       button -label "Loop Curves" -bgc 0.0 0.5 0.5 -command ("mtkPTC_curvesloop") -w 380;
       columnLayout -bgc 0.3 0.3 0.3 -adjustableColumn true -cal "center";
       text -label "Twitter @iurimonteiro91 - Show me what you have done!!";
       text -label "Thank you for your support!";
       separator -h 10;
       button -label "Close" -w 400 -command ("deleteUI -window " + $window);
setParent ..;
showWindow $window;

}
global proc mtkPTC_Native_Delete_tracking() {
python("from maya_toolkit.tools.physics_tools.runtime import require_scope; require_scope()");

  if( `objExists "pintracker_01*"` ) {
       mtkPTC_Delete({"pintracker_01"}, 0);
       mtkPTC_Delete({"Tracker_001"}, 0);
        }
  if( `objExists "pintracker_02*"` ) {
       mtkPTC_Delete({"pintracker_02"}, 0);
       mtkPTC_Delete({"Tracker_002"}, 0);
        }
  if( `objExists "pintracker_03*"` ) {
       mtkPTC_Delete({"pintracker_03"}, 0);
       mtkPTC_Delete({"Tracker_003"}, 0);
        }
  if( `objExists "pintracker_04*"` ) {
       mtkPTC_Delete({"pintracker_04"}, 0);
       mtkPTC_Delete({"Tracker_004"}, 0);
        }
  if( `objExists "pintracker_05*"` ) {
       mtkPTC_Delete({"pintracker_05"}, 0);
       mtkPTC_Delete({"Tracker_005"}, 0);
        }

}
global proc mtkPTC_Native_tracking_01() {
python("from maya_toolkit.tools.physics_tools.runtime import require_scope; require_scope()");

        Rivet;
        select "pinOutput";
        rename "pintracker_01";
        polySphere -name "Tracker_001";
        select "pintracker_01";
        select -add "Tracker_001";
        parentConstraint;
        select "Tracker_001";
        shadingNode -asShader lambert -n "redtracking";
        setAttr "redtracking.color" -type double3 1 1 0 ;
        select -r Tracker_001 ;
        hyperShade -assign redtracking;
        select -r "Tracker_001" ;
        GhostSelected;
        select "pintracker_01";
        setAttr "pintracker_01.visibility" 0;

}
