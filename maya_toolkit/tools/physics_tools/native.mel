global proc mtkPTC_Native_RotationsBake() {
python("from maya_toolkit.tools.physics_tools.runtime import require_scope; require_scope()");

    select MagicDustShape;
    float $GoalsmoothPhysicsFourtin = `mtkPTC_Value("mtkPTC_GoalsmoothTwo")`;
        setAttr "MagicDustShape.goalSmoothness" $GoalsmoothPhysicsFourtin;
    float $GoalWeightTwoPhysicsFourtin = `mtkPTC_Value("mtkPTC_GoalWeightTwo")`;
        setAttr "MagicDustShape.goalWeight[0]" $GoalWeightTwoPhysicsFourtin;
    select InsertKeyframes;
    refresh -su true;
    string $startFrame = `playbackOptions -q -min`;
    string $endFrame = `playbackOptions -q -max`;
    bakeResults -t (($startFrame) + ":" + ($endFrame)) -sm true -sr false -sb 1.0 -pok true;
    refresh -su false;
    select -clear;
    select MagicDust;
    select -add PathLocator;
    mtkPTC_Delete({}, 0);
    select InsertKeyframes;
    select -add PhysicsSets;
    parentConstraint -mo -skipRotate x -skipRotate y -skipRotate z -weight 1;
    select PhysicsSets;
    refresh -su true;
    //string $startFrame = `playbackOptions -q -min`;
    //string $endFrame = `playbackOptions -q -max`;
    bakeResults -t (($startFrame) + ":" + ($endFrame)) -sm true -sr false -sb 1.0 -pok true;
    refresh -su false;
    select -clear;
    select "RotationPointUpVector";
    mtkPTC_Delete({}, 0);
    select -add Physics_grp;
    mtkPTC_Delete({}, 0);
    if (`objExists PhysicsSets`) {
select PhysicsSets;
    sets -remove "PhysicsSets";
    select -r -ne PhysicsSets ;
    mtkPTC_Delete({}, 0);
}
    manipMoveContext -edit -mode 2 Move;

}
global proc mtkPTC_Native_FinalRotationsBake() {
python("from maya_toolkit.tools.physics_tools.runtime import require_scope; require_scope()");

    select PhysicsRotationSets;
    refresh -su true;
    string $startFrame = `playbackOptions -q -min`;
    string $endFrame = `playbackOptions -q -max`;
    bakeResults -t (($startFrame) + ":" + ($endFrame)) -sm true -sr false -sb 1.0 -pok true -dl "bakedROTATIONS";
    refresh -su false;
    string $selected[]=`ls -sl`;
    for ($node in $selected )
    {
        string $layernamee = mtkPTC_HelperName("_Rotations", $node);
        rename BakeResults $layernamee;
    }
    select PhysicsRotationSets;
    mtkPTC_Delete({}, 1);
    select PhysicsRotationSets;
    sets -remove "PhysicsRotationSets";
    select -r -ne PhysicsRotationSets;
    mtkPTC_Delete({}, 0);
    select RotationPointAimVector;
    mtkPTC_Delete({}, 0);
    select -add Physics_grp;
    mtkPTC_Delete({}, 0);
    playbackOptions -playbackSpeed 1;
    manipMoveContext -edit -mode 2 Move;
    print "The Magic is Done!";

}
global proc mtkPTC_Native_footPlacer() {
python("from maya_toolkit.tools.physics_tools.runtime import require_scope; require_scope()");

  if( `objExists "footPlacerSet*"` ) {
       warning("You already have clicked!");
        }
   else {
   selectMode -object;
   sets -n "footPlacerSet";
   setKeyframe;
   spaceLocator -name locFootPlacer;
   select locFootPlacer;
   select -add footPlacerSet;
   parentConstraint -weight 1 -mo;
   select locFootPlacer;
   print "Now press offset + or -";
   }

}
global proc mtkPTC_Native_footPlacerDeleter() {
python("from maya_toolkit.tools.physics_tools.runtime import require_scope; require_scope()");

    if( `objExists "*locFootPlacer*"` ) {
    mtkPTC_Delete({"*locFootPlacer*"}, 0);
    }
    else {
    warning("Clean");
    }
    if( `objExists "*footPlacerSet*"` ) {
    mtkPTC_Delete({"*footPlacerSet*"}, 0);
    }
    else {
    warning("Clean");
    }

}
global proc mtkPTC_Native_OffsetKeysLessSL() {
python("from maya_toolkit.tools.physics_tools.runtime import require_scope; require_scope()");

    select -r footPlacerSet;
    setKeyframe;
    nextOrPreviousFrame "previous";
    print "Keyframe back";

}
global proc mtkPTC_Native_OffsetKeysMoreSL() {
python("from maya_toolkit.tools.physics_tools.runtime import require_scope; require_scope()");

    select -r footPlacerSet;
    setKeyframe;
    nextOrPreviousFrame "next";
    print "Keyframe forward";

}
global proc mtkPTC_Native_AlignCommand() {
python("from maya_toolkit.tools.physics_tools.runtime import require_scope; require_scope()");

    string $parCns[] = `parentConstraint -n "MagicAlignment_"`;
    setKeyframe;
    mtkPTC_Delete({"*MagicAlignment_*"}, 0);
    print "All Aligned";

}
global proc mtkPTC_Native_cleanMAHshit() {
python("from maya_toolkit.tools.physics_tools.runtime import require_scope; require_scope()");

    if( `objExists "*Physics*"` ) {
    mtkPTC_Delete({"*Physics*"}, 0);
    }
    else {
    warning("Clean");
    }
    if( `objExists "*Physics_grp*"` ) {
    mtkPTC_Delete({"*Physics_grp*"}, 0);
    }
    else {
    warning("Clean");
    }
    if( `objExists "*PhysicsSets*"` ) {
    mtkPTC_Delete({"*PhysicsSets*"}, 0);
    }
    else {
    warning("Clean");
    }
    if( `objExists "*InsertKeyframes*"` ) {
    mtkPTC_Delete({"*InsertKeyframes*"}, 0);
    }
    if( `objExists "*particle*"` ) {
    mtkPTC_Delete({"*particle*"}, 0);
    }
    else {
    warning("Clean");
    }
    if( `objExists "*MagicDust*"` ) {
    mtkPTC_Delete({"*MagicDust*"}, 0);
    }
    else {
    warning("Clean");
    }
    if( `objExists "*PhysicsSets*"` ) {
    mtkPTC_Delete({"*PhysicsSets*"}, 0);
    }
    else {
    warning("Clean");
    }
     if( `objExists "*PhysicsRotationSets*"` ) {
    mtkPTC_Delete({"*PhysicsRotationSets*"}, 0);
    }
    else {
    warning("Clean");
    }
    if (`objExists "*imLocator_"`){
            mtkPTC_Delete({"*imLocator_"}, 0);
        }
    else {
        warning("Clean");
        }
    if (`objExists "*imLocator_*:*"`){
            mtkPTC_Delete({"*imLocator_*:*"}, 0);
        }
    else {
        warning("Clean");
        }
    if (`objExists "*imLocator_*:**:*"`){
            mtkPTC_Delete({"*imLocator_*:**:*"}, 0);
        }
    else {
        warning("Clean");
        }
    if( `objExists "*RotationPoint*"` ) {
    mtkPTC_Delete({"*RotationPoint*"}, 0);
    }
        else {
        warning("Clean");
        }
    if( `objExists "*nucleus*"` ) {
    mtkPTC_Delete({"*nucleus*"}, 0);
    }
        else {
        warning("Clean");
        }
        playbackOptions -playbackSpeed 1;

}
