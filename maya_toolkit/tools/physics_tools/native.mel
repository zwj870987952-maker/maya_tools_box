global proc mtkPTC_Native_PhysicsMagicButton() {
python("from maya_toolkit.tools.physics_tools.runtime import require_scope; require_scope()");

     if( `objExists "*Physics*"` ) {
         warning("You already have clicked!");
         }
     else {
        selectMode -object;
        sets -n "PhysicsSets";
        spaceLocator -n "InsertKeyframes";
        particle -n "MagicDust" -p -0 -0 -0 -c 1 ;
        escapeCurrentTool;
        select -r MagicDust ;
        setAttr "MagicDustShape.particleRenderType" 4;
        select -r MagicDustShape ;
        select -r InsertKeyframes ;
        connectAttr -f MagicDustShape.worldCentroid InsertKeyframes.translate;
        spaceLocator -n "PathLocator";
        select -r MagicDustShape ;
        select -add PathLocator ;
        goal -w 0.5 -utr 0   -g PathLocator  MagicDust;
        select -r MagicDust ;
        select -add PathLocator ;
        select -add InsertKeyframes ;
        group -n "Physics";
        select PhysicsSets;
        select -add Physics;
        parentConstraint -weight 1;
        parent -world Physics|MagicDust;
        parent -world Physics|InsertKeyframes;
        parent -world Physics|PathLocator;
        select -r MagicDust;
        select -add Physics;
        select -add InsertKeyframes;
        select -add PathLocator;
        group -n "Physics_grp";
        select Physics;
        mtkPTC_Delete({}, 0);
        select PhysicsSets;
        select -add PathLocator;
        parentConstraint -weight 1;
        select PathLocator;
        refresh -su true;
        string $startFrame = `playbackOptions -q -min`;
        string $endFrame = `playbackOptions -q -max`;
        bakeResults -t (($startFrame) + ":" + ($endFrame)) -sm true -sr false -sb 1.0 -pok true;
        refresh -su false;
        select PathLocator;
        mtkPTC_Delete({}, 1);
        select InsertKeyframes;
        select -add PhysicsSets;
        pointConstraint -mo;
        select MagicDustShape;
    float $GoalsmoothPhysics = `mtkPTC_Value("mtkPTC_Goalsmooth")`;
        setAttr "MagicDustShape.goalSmoothness" $GoalsmoothPhysics;
    float $GoalWeightPhysics = `mtkPTC_Value("mtkPTC_GoalWeight")`;
        setAttr "MagicDustShape.goalWeight[0]" $GoalWeightPhysics;
        print "Move the sliders to preview the results";
    }

}
global proc mtkPTC_Native_RefeshParticleSettings() {
python("from maya_toolkit.tools.physics_tools.runtime import require_scope; require_scope()");

    if( `objExists "MagicDustShape"` ) {
    select MagicDustShape;
    float $GoalsmoothPhysics = `mtkPTC_Value("mtkPTC_Goalsmooth")`;
        setAttr "MagicDustShape.goalSmoothness" $GoalsmoothPhysics;
        select MagicDustShape;
    float $GoalWeightPhysics = `mtkPTC_Value("mtkPTC_GoalWeight")`;
        setAttr "MagicDustShape.goalWeight[0]" $GoalWeightPhysics;
        select MagicDustShape;
    }
    else {
        print "Click 1.- Setup";
        }

}
