mds.setKeyframe(o, identity=True, dirtyDG=True, time=(endTime,endTime))\n                   \n            \n            else:\n                \n                for x in curvesToBake:\n                    \n                    cmds.bakeResults( objects, attribute=x, time=(timeRange[0], timeRange[1]), simulation=False, preserveOutsideKeys = True, destinationLayer=aLayer[0])\n                    \n                    for o in objects:\n                        for t in range(int(timeRange[0]),int(timeRange[1])):\n                            if t == int(timeRange[0]):\n                                \n                                cmds.setKeyframe(o, attribute=x)\n                            else:\n                                \n                                v = cmds.keyframe( o, attribute=x, query=True, eval=True, time=(t,t))\n                                randV = rand.uniform(-1*amplitude,amplitude)\n                                cmds.keyframe(o, attribute=x, valueChange=randV, time=(t,t))\n                        \n                        cmds.setKeyframe(o, identity=True, dirtyDG=True, time=(timeRange[0],timeRange[0]))\n                        cmds.setKeyframe(o, identity=True, dirtyDG=True, time=(timeRange[1],timeRange[1]))\n\n\n        else: cmds.confirmDialog(title='Error', message='Select one or channels to apply noise')\n    else: cmds.confirmDialog(title='Error', message='Select one or less animation layers to apply noise')\nelse: cmds.confirmDialog(title='Error', message='Select one or more objects to convert to apply noise')");


