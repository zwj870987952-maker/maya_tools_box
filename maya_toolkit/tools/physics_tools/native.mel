    refresh -su true;
    string $startFrame = `playbackOptions -q -min`;
    string $endFrame = `playbackOptions -q -max`;
    bakeResults -t (($startFrame) + ":" + ($endFrame)) -sm true -sr false -sb 1.0 -pok true;
    refresh -su false;
    mtkPTC_Delete({"FirstLoc_08_orientConstraint1"}, 0);
    select "SecondLoc_08";
    select -add "ObjectLocal_08";
    orientConstraint -offset 0 0 0 -weight 1;
    select -clear;
    select "SecondLoc_08";
    color -rgb 1 1 0;
}
if (size($naSelecao) > 9 && `objExists $naSelecao[9]`){
    select $naSelecao[9];
    selectMode -object;
    sets -n "ObjectLocal_09";
    spaceLocator -n "FirstLoc_09" -p 0 0 0;
    spaceLocator -n "SecondLoc_09" -p 0 0 0;
    parent SecondLoc_09 FirstLoc_09 ;
    select "ObjectLocal_09";
    select -add "FirstLoc_09";
    pointConstraint -offset 0 0 0 -weight 1;
    orientConstraint -offset 0 0 0 -weight 1;
    select -add "FirstLoc_09";
    setAttr -lock true "FirstLoc_09.tx";
    setAttr -lock true "FirstLoc_09.ty";
    setAttr -lock true "FirstLoc_09.tz";
    select -clear;
    select "FirstLoc_09";
    refresh -su true;
    string $startFrame = `playbackOptions -q -min`;
    string $endFrame = `playbackOptions -q -max`;
    bakeResults -t (($startFrame) + ":" + ($endFrame)) -sm true -sr false -sb 1.0 -pok true;
    refresh -su false;
    mtkPTC_Delete({"FirstLoc_09_orientConstraint1"}, 0);
    select "SecondLoc_09";
    select -add "ObjectLocal_09";
    orientConstraint -offset 0 0 0 -weight 1;
    select -clear;
    select "SecondLoc_09";
    color -rgb 1 1 0;
}
if (size($naSelecao) > 10 && `objExists $naSelecao[10]`){
    select $naSelecao[10];
    selectMode -object;
    sets -n "ObjectLocal_10";
    spaceLocator -n "FirstLoc_10" -p 0 0 0;
    spaceLocator -n "SecondLoc_10" -p 0 0 0;
    parent SecondLoc_10 FirstLoc_10 ;
    select "ObjectLocal_10";
    select -add "FirstLoc_10";
    pointConstraint -offset 0 0 0 -weight 1;
    orientConstraint -offset 0 0 0 -weight 1;
    select -add "FirstLoc_10";
    setAttr -lock true "FirstLoc_10.tx";
    setAttr -lock true "FirstLoc_10.ty";
    setAttr -lock true "FirstLoc_10.tz";
    select -clear;
    select "FirstLoc_10";
    refresh -su true;
    string $startFrame = `playbackOptions -q -min`;
    string $endFrame = `playbackOptions -q -max`;
    bakeResults -t (($startFrame) + ":" + ($endFrame)) -sm true -sr false -sb 1.0 -pok true;
    refresh -su false;
    mtkPTC_Delete({"FirstLoc_10_orientConstraint1"}, 0);
    select "SecondLoc_10";
    select -add "ObjectLocal_10";
    orientConstraint -offset 0 0 0 -weight 1;
    select -clear;
    select "SecondLoc_10";
    color -rgb 1 1 0;
}
}

