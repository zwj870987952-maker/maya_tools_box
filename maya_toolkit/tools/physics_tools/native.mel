global proc mtkPTC_Native_BakePhysics() {
python("from maya_toolkit.tools.physics_tools.runtime import require_scope; require_scope()");

    //select "JiggleMe";
    //doCreateGeometryCache 6 { "2", "1", "10", "OneFilePerFrame", "1", "","0","","0", "add", "0", "1", "1","0","1","mcx","0" } ;
    select "JiggleSet";
    refresh -su true;
    string $startFrame = `playbackOptions -q -min`;
    string $endFrame = `playbackOptions -q -max`;
    bakeResults -t (($startFrame) + ":" + ($endFrame)) -sm true -sr false -sb 1.0 -pok true -dl "bake";
    refresh -su false;
    string $selected[]=`ls -sl`;
    for ($node in $selected )
    {
        string $layernamee = mtkPTC_HelperName("_Overlap", $node);
        rename BakeResults $layernamee;
    }
    select "Nothing";
    mtkPTC_Delete({}, 0);
    select -r -ne JiggleSet;
    mtkPTC_Delete({}, 0);
    playbackOptions -playbackSpeed 1;
    print "Magic!";

}
global proc mtkPTC_Native_RedoMe() {
python("from maya_toolkit.tools.physics_tools.runtime import require_scope; require_scope()");

    if( `objExists "Nothing*"` ) {
         mtkPTC_Delete({"Nothing*"}, 0);
     }
     else{
         print "clean!";
         }
     if( `objExists "JiggleMe*"` ) {
         mtkPTC_Delete({"JiggleMe*"}, 0);
     }
     else{
         print "clean!";
         }
         if( `objExists "JiggleMeFollicle*"` ) {
         mtkPTC_Delete({"JiggleMeFollicle*"}, 0);
     }
     else{
         print "clean!";
         }
         if( `objExists "DontTouch*"` ) {
         mtkPTC_Delete({"DontTouch*"}, 0);
     }
     else{
         print "clean!";
         }
         if( `objExists "JiggleSet*"` ) {
         mtkPTC_Delete({"JiggleSet*"}, 0);
     }
     else{
         print "clean!";
         }
         playbackOptions -playbackSpeed 1;
    print "Scene Clean!";

}
