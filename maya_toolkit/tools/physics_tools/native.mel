global proc mtkPTC_Native_SetupRotationsXmais() {
python("from maya_toolkit.tools.physics_tools.runtime import require_scope; require_scope()");

    select PhysicsRotationSets;
    select -add RotationPointAimVector;
    parentConstraint -mo -weight 1;
    select RotationPointAimVector;
    refresh -su true;
    string $startFrame = `playbackOptions -q -min`;
    string $endFrame = `playbackOptions -q -max`;
    bakeResults -t (($startFrame) + ":" + ($endFrame)) -sm true -sr false -sb 1.0 -pok true;
    refresh -su false;
    select RotationPointAimVector;
    mtkPTC_Delete({}, 1);
    select RotationPointAimVector;
    select -add PhysicsRotationSets;
    aimConstraint -mo -weight 1 -aimVector 1 0 0 -upVector 0 1 0 -worldUpType "object" -worldUpObject |RotationPointUpVector;
    select RotationPointAimVector;
        selectMode -object;
        sets -n "PhysicsSets";
        spaceLocator -n "InsertKeyframes";
        particle -n "MagicDust" -p -0 -0 -0 -c 1 ;
        escapeCurrentTool;
        select -r MagicDust ;
        setAttr "MagicDustShape.particleRenderType" 4;
        select -r MagicDustShape ;
        select -r InsertKeyframes ;
        connectAttr -f MagicDustShape.worldCentroid InsertKeyframes.translate;
        spaceLocator -n "PathLocator";
        select -r MagicDustShape ;
        select -add PathLocator ;
        goal -w 0.5 -utr 0   -g PathLocator  MagicDust;
        select -r MagicDust ;
        select -add PathLocator ;
        select -add InsertKeyframes ;
        group -n "Physics";
        select PhysicsSets;
        select -add Physics;
        parentConstraint -weight 1;
        parent -world Physics|MagicDust;
        parent -world Physics|InsertKeyframes;
        parent -world Physics|PathLocator;
        select -r MagicDust;
        select -add Physics;
        select -add InsertKeyframes;
        select -add PathLocator;
        group -n "Physics_grp";
        select Physics;
        mtkPTC_Delete({}, 0);
        select PhysicsSets;
        select -add PathLocator;
        parentConstraint -weight 1;
        select PathLocator;
        refresh -su true;
        //string $startFrame = `playbackOptions -q -min`;
        //string $endFrame = `playbackOptions -q -max`;
        bakeResults -t (($startFrame) + ":" + ($endFrame)) -sm true -sr false -sb 1.0 -pok true;
        refresh -su false;
        select PathLocator;
        mtkPTC_Delete({}, 1);
        select InsertKeyframes;
        select -add PhysicsSets;
        pointConstraint -mo;
        select MagicDustShape;
    float $GoalsmoothPhysicsAdvance = `mtkPTC_Value("mtkPTC_GoalsmoothTwo")`;
        setAttr "MagicDustShape.goalSmoothness" $GoalsmoothPhysicsAdvance;
    float $GoalWeightTwoPhysicsAdvance = `mtkPTC_Value("mtkPTC_GoalWeightTwo")`;
        setAttr "MagicDustShape.goalWeight[0]" $GoalWeightTwoPhysicsAdvance;
        select PathLocator;
        parent "RotationPointUpVector";
        print "Press Play, move the sliders to preview the results";

}
