global proc MIRR_0d9dbbe39a5758068cdf30cf9c7cb924(string $side_from,string $side_to, string $rig_type)
{
		string $connection_output[]= MIRR_1b5534c2455631fcdd51693bf0e0f9d5();
		if(size($connection_output)==0)
			return;
		string $rig_mirr_names[];
		int $num_ch;
		string   $names_variations[] ;
		string $fin_name;
		$rig_mirr_names=$connection_output;
        for($i=0;$i<size($connection_output); $i++)
        {
            $rig_mirr_names[$i]=`match "^.*_" $rig_mirr_names[$i]`;
            $num_ch=sizeBytes($rig_mirr_names[$i])-1;
            $rig_mirr_names[$i]=`substring $rig_mirr_names[$i] 1 $num_ch`;
            $names_variations=MIRR_b3acc831f9f61a01a45fe7165ec12c62( $rig_mirr_names[$i], $side_from, $side_to);
			$names_variations=stringArrayRemove({$rig_mirr_names[$i]}, $names_variations);
            $fin_name="";
            for($name in $names_variations)
                if(`objExists $name`)
                    $fin_name=$name;
            $rig_mirr_names[$i]= $fin_name;
        }
        print "\nExpected names for mirror controls:\n\n";
        print $rig_mirr_names;
		print "\n";
		catch (`setKeyframe $rig_mirr_names`);
		MIRR_194c7b09c27128a45486ac17560c7a25($rig_mirr_names);
		sets -n "mirrored_objects";
		for($i=0;$i<size($connection_output); $i++)
		{
			if(`objExists $rig_mirr_names[$i]`)
			{
				select $connection_output[$i] $rig_mirr_names[$i];
				MIRR_ebdde21f7478f2e87c8125a749c52f7a();
				if($rig_type=="AdvSkel")
				{
					catchQuiet (MIRR_18a1bcd5e135a60ba68f5eb3c465884e("parent",0));
					if( `gmatch $rig_mirr_names[$i] "FK*"`)
						rotate -os -180 0 0;
					else
						rotate -os 0 0 0;
				}
				if($rig_type=="Symmetric")
				{
					catchQuiet (MIRR_18a1bcd5e135a60ba68f5eb3c465884e("parent",0));
				}
				if($rig_type=="SymmetricRotate")
				{
					catchQuiet (MIRR_18a1bcd5e135a60ba68f5eb3c465884e("orient",0));
				}
			}
			else
				print ("\nno match presumed  name found \n\n" + $connection_output[$i] + " >>> ???\ncheck the correct spelling of the prefixes\n" ) ;
		}
}
global proc MIRR_af16024bff0824c73ab6c4082569d9ed(string $side_from,string $side_to)
{
    string $selected_obj[]=`ls-sl`;
    if(size($selected_obj)==0)
        return;
    string $m_object;
    string $fin_name="";
    string $fin_names[];
    string $name;
    string $finobjs[],$names_variation[];
    for($m_object in $selected_obj)
    {
        $m_object=`match "^.*_" $m_object`;
        $num_ch=sizeBytes($m_object)-1;
        $m_object=`substring $m_object 1 $num_ch`;
        $names_variations=MIRR_b3acc831f9f61a01a45fe7165ec12c62( $m_object, $side_from, $side_to);
		$names_variations=stringArrayRemove({$m_object}, $names_variations);
        for($name in $names_variations)
            if(`objExists $name`)
            {
                appendStringArray ($fin_names,{$name}, 1);
                break;
            }
            else
            {
                print ("\nno match presumed  name found \n\n" + $selected_obj[0] + " >>> ???\ncheck the correct spelling of the prefixes\n" ) ;
                return;
            }
    }
    catch (`setKeyframe $fin_names`);
    for($i=0;$i<size($selected_obj);$i++)
        appendStringArray ($finobjs,{$selected_obj[$i],$fin_names[$i]}, 2);
    MIRR_194c7b09c27128a45486ac17560c7a25($finobjs);
}
global proc MIRR_18a1bcd5e135a60ba68f5eb3c465884e(string $type,int $offset)
{
    string $selection[]=`ls-sl`;
    float $rad=1;
    string $all_locks[];
    for($i=0;$i<size($selection);$i+=2)
    {
        select $selection[$i] $selection[$i+1];
        MIRR_b3a0af3dcb5c339fc02c21363528b660($type,0);
        appendStringArray ($all_locks,`ls-sl`, 1);
    }
    select $all_locks;
    MIRR_6de8028af587b467034457b4d6349f89 ($rad);
	MIRR_10b1c67feba7e9570357d44ba9306692 ("", $selection,"l");
}
