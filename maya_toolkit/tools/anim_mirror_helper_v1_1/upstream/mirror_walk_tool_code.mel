global proc string MIRR_e8f0c3b3e6300189aca31ae83320ec92(string $node_name_mask)
{
	$connected_nodes=`listConnections -t node`;
	string $nodename;
	int $has_connect_to_recalculate=0;
	string $obj;
	for($obj in $connected_nodes)
		{
		   if(`gmatch $obj $node_name_mask`)
		   {
		   $nodename=$obj;
		   $has_connect_to_recalculate=1;
		   }
		}
		return  $nodename;
}
global proc string[] MIRR_6c03bcf1c4cd077aea727f60dfb001f6(int $mode, string $nodename_mask)
{
    string $prevouos[];
    string $next[];
    string  $connected_items[];
    int $current_item_index;
    int $connected_items_size;
    $select_items=`ls-sl`;
    $j=0;
    string $all_connected_items[];
	string $top_connected_items[];
    for($obj in $select_items)
    {
        select $obj;
        $nodename=MIRR_e8f0c3b3e6300189aca31ae83320ec92($nodename_mask);
        if($nodename!="")
        {
            $connected_items=`listConnections  -d 1 $nodename`;
            $connected_items_size =size($connected_items)-1;
            for ($i=0; $i<=$connected_items_size;$i++)
            {
              if($connected_items[$i]==$obj)
                    $current_item_index=$i;
            }
        }
        if($current_item_index!=0)
            $prevouos[$j]=$connected_items[$current_item_index -1];
        else
            $prevouos[$j]=$connected_items[$connected_items_size];
        if($current_item_index!=$connected_items_size)
            $next[$j]=$connected_items[$current_item_index+1];
        else
            $next[$j]=$connected_items[0];
        $j++;
        appendStringArray( $all_connected_items, $connected_items, `size $connected_items`);
		appendStringArray( $top_connected_items, $connected_items, 1);
    }
	$all_connected_items=stringArrayRemoveDuplicates($all_connected_items);
	$top_connected_items=stringArrayRemoveDuplicates($top_connected_items);
	select $select_items;
	if($mode==2)
		return $top_connected_items;
    if($mode==-1)
        return $prevouos;
    if($mode==1)
        return $next;
        else
        return $all_connected_items;
}
global proc string MIRR_b3a0af3dcb5c339fc02c21363528b660(string $type_of_connection, int $offset)
{
    string $selection[]=`ls-sl`;
    string $constr;
    string $lock=MIRR_1ae288c6b64a87de88c296f40fb5ed72($selection[0]) ;
    select $lock $selection[1];
   if( $type_of_connection=="parent")
   {
		delete `orientConstraint $selection[1] $lock`;
        $constr=MIRR_3463baee6dea488d87f160cd40a14353({$lock,$selection[1]}, $offset);
		catchQuiet (`setAttr ($constr + ".interpType") 2`);
        catchQuiet (`setAttr ($constr + ".target[0].targetOffsetTranslateX") 0`);
        catchQuiet (`setAttr ($constr + ".target[0].targetOffsetTranslateY") 0`);
        catchQuiet (`setAttr ($constr + ".target[0].targetOffsetTranslateZ") 0`);
   }
    if( $type_of_connection=="orient")
	{
		delete `orientConstraint $selection[1] $lock`;
        $constr=MIRR_008e7eaba89cfdd4ba3b1eca102e0dba({$lock,$selection[1]}, $offset);
		setAttr ($constr + ".interpType") 2;
	}
     if( $type_of_connection=="point")
        $constr=MIRR_e0b44e5f427a869b704a743cf1d3614c();
   select  $lock;
   return  $constr;
}
global proc string MIRR_1ae288c6b64a87de88c296f40fb5ed72(string $object)
{
	$selection=`ls-sl`;
	select $object;
	$lock_name=MIRR_7c2ba8388365b4e58c01dc0fb2c2d23c();
	select $selection;
	return $lock_name[0];
}
global proc MIRR_338d6d9c2032e82a688aa841f622a6cf()
{
	$name_mirror_sys_node=MIRR_e8f0c3b3e6300189aca31ae83320ec92("*mirror_barnev_system*");
	if($name_mirror_sys_node=="")
	{
		warning "selected object not connected to Mirror System";
		return;
	}
	if (`getAttr($name_mirror_sys_node + ".calculate")`==0)
	{
		string $obj;
		$j=0;
		string  $connection_input[];
		string  $connection_output[];
		string $list_mirr_obj_attribs[];
		if($name_mirror_sys_node!="")
		{
		  for($obj in `attributeInfo -all   $name_mirror_sys_node`)
		  {
			   if(`gmatch $obj "mirr_obj*"`)
			   {
				   $tmp_input=`listConnections  -d 0 -s 1  ($name_mirror_sys_node + "." + $obj)`;
				   $tmp_output=`listConnections  -d 1 -s 0  ($name_mirror_sys_node + "." + $obj)`;
				  if(( $tmp_input[0]!="")&&($tmp_output[0]!=""))
				  {
					  $list_mirr_obj_attribs[$j]=$obj;
					  $connection_input[$j]=$tmp_input[0];
					  $connection_output[$j]=$tmp_output[0];
					  $j++;
				  }
			   }
		  }
		}
		if(size($list_mirr_obj_attribs)==0)
		{
			error "mirror system not have connections";
		}
		$time=`currentTime -q`;
		autoKeyframe -state off;
		cutKey -cl -t ":" -f ":"   $connection_output;
		for($i=`playbackOptions -q -min`;$i<=`playbackOptions -q -max`;$i++)
		{
			currentTime $i;
			MIRR_8f1bbed6c413bd9cd1ae5d3c63afb5cc($connection_input, $connection_output);
			MIRR_9ef8981ccf72c74373e900ef581dfaea($connection_input, $connection_output);
			MIRR_2fa2b06e9166235ba786cb6586606b52($connection_input, $connection_output);
			MIRR_4aba01922b93bf80f149ac6b55439e7d($connection_input, $connection_output);
			setKeyframe $connection_output;
		}
		autoKeyframe -state on;
		currentTime $time;
		keyframe -e -iub true -r -o over -tc (`getAttr($name_mirror_sys_node + ".offset")`) $connection_output;
		if (`getAttr($name_mirror_sys_node + ".cycled")`==1)
			setInfinity -pri cycle -poi cycle $connection_output;
		else
			setInfinity -pri constant -poi constant $connection_output;
	}
}
global proc execute_single_MT_calculation(string $manip_name)
{
$selected=`ls-sl`;
select `listConnections  -d 0 -s 1 $manip_name`;
MIRR_692e2fda85cadfdf0f28e93323f58c08;
MIRR_338d6d9c2032e82a688aa841f622a6cf();
MIRR_f4b1a2b52ab1771321003f86cde63160;
select $selected;
}
global proc rotate_to_position(string $target_position[], string $object_to_move[])
{
	for($i=0;$i<size($target_position);$i++)
	{
		$Rot = `xform -q -ro -ws $target_position[$i]`; 
		//3 раза - потому что иначе не проставляется в слое
		rotate -ws $Rot[0] $Rot[1] $Rot[2] $object_to_move[$i];
		rotate -ws $Rot[0] $Rot[1] $Rot[2] $object_to_move[$i];
		rotate -ws $Rot[0] $Rot[1] $Rot[2] $object_to_move[$i];
	}	
}
global proc string[] MIRR_19d76f37038db0f20211caf8b74f382f(float $radius, float $rnd_persent)
{
	$selection = `ls -fl -sl `;
	string $curve_sphere[];
	if(size($selection)>0)
	{
		for($i=0;$i<size($selection);$i++)
			$curve_sphere[$i]= MIRR_ccabd0c1dfc9e3be77b0702d110cbb7c( $radius*(`rand  (-1*$rnd_persent) $rnd_persent` + 1));
		MIRR_847308ac6f1debf8edcc8d63e128d64c( $selection, $curve_sphere);
		rotate_to_position( $selection,$curve_sphere);
	}
	else
	{
		$curve_sphere[0]=MIRR_ccabd0c1dfc9e3be77b0702d110cbb7c($radius);
	}
   select $curve_sphere ;
   return $curve_sphere;
}
global proc string[] MIRR_1b5534c2455631fcdd51693bf0e0f9d5()
{
	$name_mirror_sys_node=MIRR_e8f0c3b3e6300189aca31ae83320ec92("*mirror_barnev_system*");
		if ( $name_mirror_sys_node=="")
		{
			warning "select Mirror System Lockator";
			return {};
		}
			string  $connection_input[];
			string  $connection_output[];
			string $list_mirr_obj_attribs[];
			string $obj;
			$j=0;
			if($name_mirror_sys_node!="")
			{
			  for($obj in `attributeInfo -all   $name_mirror_sys_node`)
			  {
				   if(`gmatch $obj "mirr_obj*"`)
				   {
					   $tmp_input=`listConnections  -d 0 -s 1  ($name_mirror_sys_node + "." + $obj)`;
					   $tmp_output=`listConnections  -d 1 -s 0  ($name_mirror_sys_node + "." + $obj)`;
					  if(( $tmp_input[0]!="")&&($tmp_output[0]!=""))
					  {
						  $list_mirr_obj_attribs[$j]=$obj;
						  $connection_input[$j]=$tmp_input[0];
						  $connection_output[$j]=$tmp_output[0];
						  $j++;
					  }
				   }
			  }
			}
			$connection_output=`pickWalk -d down $connection_output`;
			return $connection_output;
}
global proc string MIRR_e0b44e5f427a869b704a743cf1d3614c()
{
	$obj=`ls-sl`;
	string $name_of_constrain[];
	$tx_lock=`getAttr -lock ($obj[1] + ".tx")`;
	$ty_lock=`getAttr -lock ($obj[1] + ".ty")`;
	$tz_lock=`getAttr -lock ($obj[1] + ".tz")`;
	$h=$tx_lock+$ty_lock+$tz_lock;
	if ($h<3)
	{
		$skipX= "";
		$skipY= "";
		$skipZ= "";
		if($tx_lock)
			$skipX= " -skip x";
		if($ty_lock)
			$skipY= " -skip y";
		if($tz_lock)
			$skipZ= " -skip z";
		$skipped = $skipX + $skipY + $skipZ;
		string $objects = "";
		for($i=0;$i<size($obj);$i++)
		{
			$objects = $objects + $obj[$i] + " ";
		}
			$name_of_constrain=`eval ("pointConstraint  " + $skipped + " " + $objects)`;
	}
	return  $name_of_constrain[0];
}
global proc string MIRR_008e7eaba89cfdd4ba3b1eca102e0dba(string $obj[],int $offset)
{
	string $tmp_constr[];
	$rx_lock=`getAttr -lock ($obj[(size($obj)-1)] + ".rx")`;
	$ry_lock=`getAttr -lock ($obj[(size($obj)-1)] + ".ry")`;
	$rz_lock=`getAttr -lock ($obj[(size($obj)-1)] + ".rz")`;
	string $off= "";
	if($offset)
	    $off= " -mo ";
	$h=$rx_lock+$ry_lock+$rz_lock;
	if ($h<3)
	{
		$skipX= "";
		$skipY= "";
		$skipZ= "";
		if($rx_lock)
			$skipX= " -skipRotate x";
		if($ry_lock)
			$skipY= " -skipRotate y";
		if($rz_lock)
			$skipZ= " -skipRotate z";
		string $objects = "";
		$skipped = $skipX + $skipY + $skipZ;
		for($i=0;$i<size($obj);$i++)
		{
			$objects = $objects + $obj[$i] + " ";
		}
		$tmp_constr=`eval ("parentConstraint  " + $off + "-skipTranslate x -skipTranslate y -skipTranslate z " + $skipped + " " + $objects)`;
	}
	return $tmp_constr[0];
}
global proc string MIRR_3463baee6dea488d87f160cd40a14353(string $obj[], int $offset)
{
	int $num_obj=size($obj);
	string $ret_name;
	string $name_of_constrain[];
	$weight_all=MIRR_9de233870ac6b9c5087a491c3b4ca38a($obj);
	string $off=" ";
	if($offset)
	    $off=" -mo ";
	$rx_lock=`getAttr -lock ($obj[$num_obj-1] + ".rx")`;
	$ry_lock=`getAttr -lock ($obj[$num_obj-1] + ".ry")`;
	$rz_lock=`getAttr -lock ($obj[$num_obj-1] + ".rz")`;
	$tx_lock=`getAttr -lock ($obj[$num_obj-1] + ".tx")`;
	$ty_lock=`getAttr -lock ($obj[$num_obj-1] + ".ty")`;
	$tz_lock=`getAttr -lock ($obj[$num_obj-1] + ".tz")`;
	$h=$rx_lock+$ry_lock+$rz_lock+$tx_lock+$ty_lock+$tz_lock;
	if ($h<6)
	{
		$skipTX= "";
		$skipTY= "";
		$skipTZ= "";
		$skipRX= "";
		$skipRY= "";
		$skipRZ= "";
		if($tx_lock)
			$skipTX= " -st x";
		if($ty_lock)
			$skipTY= " -st y";
		if($tz_lock)
			$skipTZ= " -st z";
		if($rx_lock)
			$skipRX= " -sr x";
		if($ry_lock)
			$skipRY= " -sr y";
		if($rz_lock)
			$skipRZ= " -sr z";
		$skipped = $skipTX + $skipTY + $skipTZ + $skipRX + $skipRY + $skipRZ;
		string $objects = "";
		for($i=0;$i<$num_obj;$i++)
		{
			$objects = $objects + $obj[$i] + " ";
		}
		$name_of_constrain=`eval ("parentConstraint " + $off + $skipped + " " + $objects)`;
		for($i=0;$i<($num_obj-1);$i++)
		{
			$attr_name=`listAttr -string ("*W" + $i) $name_of_constrain[0]`;
			catch (`setAttr ($name_of_constrain[0] + "." +  $attr_name[0]) $weight_all[$i]`);
		}
	}
		$ret_name=$name_of_constrain[0];
		return $ret_name;
}
global proc MIRR_847308ac6f1debf8edcc8d63e128d64c(string $target_position[], string $object_to_move[])
{
    float $Trans[];
	for($i=0;$i<size($target_position);$i++)
	{
        $Trans=MIRR_8598296823aa3af15686cb0d78f1615d($target_position[$i]);
		move -rpr $Trans[0] $Trans[1] $Trans[2] $object_to_move[$i];
		move -rpr $Trans[0] $Trans[1] $Trans[2] $object_to_move[$i];
		move -rpr $Trans[0] $Trans[1] $Trans[2] $object_to_move[$i];
	}
}
global proc MIRR_4aba01922b93bf80f149ac6b55439e7d(string $target[], string $object[])
{
    float $targ_attr_val;
	string $attrib[], $attr;
    for($i=0;$i<size($target);$i++)
    {
		$attrib=`listAttr -k -v -ud $target[$i]`;
		for($attr in $attrib)
		{
			catchQuiet($targ_attr_val=`getAttr ($target[$i] + "." + $attr)`);
			catchQuiet(`setAttr ($object[$i] + "." + $attr) $targ_attr_val`);
		}
    }
}
global proc string MIRR_ccabd0c1dfc9e3be77b0702d110cbb7c(float $radius)
{
	string $curves[];
	clear $curves;
	$crv=`circle -c 0 0 0 -nr 0 0 1 -sw 360 -r  $radius -d 3 -ut 0 -tol 0.01 -s 8 -ch 0`;
	catchQuiet (`setAttr -lock true ($crv[0] + ".rcurve")`);
	catchQuiet (`setAttr -lock true ($crv[0] + ".cwdth")`);
	catchQuiet (`setAttr -lock true ($crv[0] + ".srate")`);
	catchQuiet (`setAttr -lock true ($crv[0] + ".ai_curve_shaderr")`);
	catchQuiet (`setAttr -lock true ($crv[0] + ".ai_curve_shaderg")`);
	catchQuiet (`setAttr -lock true ($crv[0] + ".ai_curve_shaderb")`);
	appendStringArray( $curves, $crv, 1);
	$crv=`duplicate -rr -rc`;
	rotate -a -ws -fo 0 90 0 ;
	appendStringArray( $curves, $crv, 1);
	$crv=`duplicate -rr -rc`;
	rotate -r -ws -fo 0 0 90 ;
	appendStringArray( $curves, $crv, 1);
	select $curves;
	makeIdentity -apply true -t 1 -r 1 -s 1 -n 0 -pn 1;
	for($i=1;$i<size($curves);$i++)
	{
		$shapes=`listRelatives -shapes  $curves[$i]`;
		parent -add  -s  $shapes $curves[0];
	}
	select $curves;
	select -d $curves[0];
	delete;
	select $curves[0];
	makeIdentity -apply true -t 1 -r 1 -s 1 -n 0 -pn 1;
	return $curves[0];
}
global proc string[] MIRR_7c2ba8388365b4e58c01dc0fb2c2d23c()
{
	string $object[]=`ls-sl`;
	select -cl;
	select $object;
	string $lock[]=MIRR_e0a5f9682afe5d450c5614dd6a49ac78();
	MIRR_32a3829df17c3736d9757e423eeaf0e3($object,$lock);
	return $lock;
}
global proc string[] MIRR_e0a5f9682afe5d450c5614dd6a49ac78()
{
    string $selection[]=`ls-fl-os`;
    string $lock[]=MIRR_54d92f8424c4459e6d996d9fd93902f0();
    for($i=0;$i<size($selection);$i++)
        if(!((`objectType -isType "mesh" $selection[$i]`)+(`objectType -isType "nurbsSurface" $selection[$i]`)+(`objectType -isType "nurbsCurve" $selection[$i]`)+(`objectType -isType "lattice" $selection[$i]`)))
            delete `orientConstraint $selection[$i] $lock[$i]`;
    return $lock;
}
global proc float[] MIRR_9de233870ac6b9c5087a491c3b4ca38a(string $objects[])
{
	float $distanse_all[];
	float $distanse_all_normalized[];
	float $weight_all[];
	float $getPvPos[];
    $getPvPos=MIRR_174b5e03acbe9a8ba7bf83b031094a2e( $objects[size($objects)-1]);
	vector $end_point = <<$getPvPos[0], $getPvPos[1], $getPvPos[2]>>;
	for($i=0;$i<(size($objects)-1);$i++)
	{
        $getPvPos=MIRR_174b5e03acbe9a8ba7bf83b031094a2e($objects[$i]);
		vector $start_point = <<$getPvPos[0], $getPvPos[1], $getPvPos[2]>>;
		$distanse_all[$i]=mag($start_point - $end_point);
	}
	$sort_dist=`sort $distanse_all`;
	float $max_dist = $sort_dist[size($sort_dist)-1];
	float $min_dist = $sort_dist[0];
	if($min_dist>0)
	{
		for($i=0;$i<size($distanse_all);$i++)
		{
		$distanse_all_normalized[$i]=$distanse_all[$i]/$max_dist;
		$weight_all[$i]=1/$distanse_all_normalized[$i] ;
		}
	}
	else
	{
		for($i=0;$i<size($distanse_all);$i++)
		{
			if($distanse_all[$i])
			{
			$weight_all[$i]=0;
			}
			else
			{
			$weight_all[$i]=1;
			}
		}
	}
	float $summ=0;
	for($obj in $weight_all)
	    $summ+=$obj;
	float $weight_all_normi[];
	for($i=0;$i<size($weight_all);$i++)
	{
	    $weight_all_normi[$i]=$weight_all[$i]/$summ;
	}
	return $weight_all_normi;
}
global proc float[] MIRR_174b5e03acbe9a8ba7bf83b031094a2e(string $object)
{
    float $getPvPos[];
    float $getPvRot[];
    string $obj_selected_shape[];
    string $obj_selected[];
		if ((`objectType -isType "mesh" $object`)+(`objectType -isType "nurbsSurface" $object`)+(`objectType -isType "nurbsCurve" $object`))
			{
				$getPvPos=`pointPosition -world $object`;
                $obj_selected_shape = `listRelatives -f -p  $object`;
                $obj_selected = `listRelatives -f -p $obj_selected_shape`;
                $getPvRot = `xform -q -ro -ws $obj_selected[0]`;
			}
			else
			{
				$getPvPos = `xform -q -ws -piv $object`;
                $getPvRot = `xform -q -ro -ws $object`;
			}
	$getPvPos[3]=$getPvRot[0];
	$getPvPos[4]=$getPvRot[1];
	$getPvPos[5]=$getPvRot[2];
	return $getPvPos;
}