	{
		setAttr -lock true ($objs + ".scaleX");
		setAttr -lock true ($objs + ".scaleY");
		setAttr -lock true ($objs + ".scaleZ");
	}
}
global proc MIRR_37979d5db724aeac3ec6046edc570bbd()
{
string $objs;
	if(!size(`ls-sl`))
		return;
	for($objs in `ls-sl`)
	{
		setAttr -lock false ($objs + ".scale");
		setAttr -lock false ($objs + ".scaleX");
		setAttr -lock false ($objs + ".scaleY");
		setAttr -lock false ($objs + ".scaleZ");
	}
}
global proc MIRR_c89bf830cdb2b9cc874e6c8604e8b257()
{
	string $objs[] = `ls-sl`;
	if(!size($objs))
		return;
	for($i=0;$i<size($objs);$i++)
	{
		setAttr -keyable false -channelBox false ($objs[$i] + ".sx");
