global proc MIRR_32a3829df17c3736d9757e423eeaf0e3 (string $target[], string $object[])
{
    select $object;
    $createSetResult_object = `sets -name "object"`;
    for($i=0;$i<size($target);$i++)
    {
        $childs=`listConnections -t node $createSetResult_object`;
        catchQuiet (`parent $childs[$i] $target[$i]`);
    }
    $childs=`listConnections -t node $createSetResult_object`;
    select  $childs;
    delete $createSetResult_object;
}
global proc string[] MIRR_e706e982298fe9e8f94ae04b06b5d6b2(string $prefix)
{
	string $objs[] = `ls -selection`;
	$j=0;
		for($i=0;$i<size($objs);$i++)
		{
			while (`objExists ($prefix + $j)`)
			{
				$j++;
			}
		rename $objs[$i]($prefix + $j);
		$objs = `ls -selection`;
		}
	return $objs;
}
global proc string[] MIRR_10b1c67feba7e9570357d44ba9306692 (string $prefix, string $name_massive[],string $postfix)
{
	$objs = `ls-sl`;
    string $new_names[];
	for($i=0;$i<size($objs);$i++)
		$new_names[$i]=`rename $objs[$i] ($prefix + $name_massive[$i] + $postfix + "#")`;
	return $new_names;
}
global proc MIRR_ade4e354383a28fcefcaf5ce40e6639d()
