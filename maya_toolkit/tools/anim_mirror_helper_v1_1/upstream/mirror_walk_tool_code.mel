global proc MIRR_c8f9519489b62d03fdd39080a1626293(string $axis)
{
	$axis=`capitalizeString $axis`;
	$selection=`ls-sl`;
	if(size($selection)!=2)
	{
		warning "select 2 object!";
		return;
	}
	select -cl;
	select $selection[0];
	$joint=MIRR_f2d5a2798ed7cfee36eb77ee8a281ed8();
	$grpp=`group` ;
	xform -os -piv 0 0 0;
	select $joint;
	if ($axis=="X")
	{
		$mirrored=`mirrorJoint -mirrorBehavior -mirrorYZ`;
		rotate -r -os -fo 180 0 0;
	}
	if ($axis=="Y")
	{
		$mirrored=`mirrorJoint -mirrorBehavior -mirrorXZ`;
		rotate -r -os -fo -180 0 0 ;
		rotate -r -os -fo 0 0 -180;
	}
	if ($axis=="Z")
	{
		$mirrored=`mirrorJoint -mirrorBehavior -mirrorXY`;
		rotate -r -os -fo 0 0 180;
		rotate -r -os -fo 0 180 0 ;
	}
	select -add $selection[1];
	MIRR_9a8d2e62249cad27916aacc736478655;
	MIRR_95d47209f5832c068ce7614b82201089;
	delete $grpp;
	select $selection;
}
global proc MIRR_9d6d9b3fa6689f784a8751133c4da807(string $axis)
{
    $axis=`capitalizeString $axis`;
		$selection=`ls-sl`;
		if(size($selection)!=2)
		{
			warning "select 2 object!";
			return;
		}
		select -cl;
		$grpp=MIRR_0a10c57fddb9b8e3dc07486c3a9a5eed();
		select $selection[0];
		$lock=MIRR_54d92f8424c4459e6d996d9fd93902f0();
		select $lock $grpp ;
		parent;
		select $grpp;
		setAttr ($grpp[0] + ".scale" + $axis) -1;
		select $lock $selection[1];
		MIRR_9713c7abe7f317a1eaefb22b30d9ce1c;
		delete $grpp;
		select $selection;
}
