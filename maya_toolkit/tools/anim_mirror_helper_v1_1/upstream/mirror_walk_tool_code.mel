// This tool helps you make gait and running animations. It makes a mirror copy of the movement with a time shift by a specified amount of time.
// Mirror_tool_menue()
global proc Mirror_tool_menue()
{
	if(`window -q -ex "mirror_toool"`)deleteUI("mirror_toool");
	window
		-mb true
		-mnb 0
		-bgc 1 0.9 0.8
		-t "Anim Mirror Helper v1.0 Studio license - best tool for create walk animations"
		-tlb 1 "mirror_toool";
	columnLayout -adj 1 "columnLayout5";
	frameLayout
		-p "columnLayout5"
		-bgc 0.2 0.555 0.580
		-ebg true
		-bv false
		-cl 0
		-cll true
		-l "create Mirror system"
		-la "top"
		-lw 0
		-mw 0
		-cc "catchQuiet(`window -e -h 80 mirror_toool`)" add_it_fr_lay_base;
	rowLayout -p add_it_fr_lay_base -adj 7 -nc 11;
	global string $mirror_tool_mirr_axis="x";
	radioCollection ;
    	radioButton -sl
			-label "x"
			-annotation "select mirror axis"
			-cc "$mirror_tool_mirr_axis=\"x\"";
    	radioButton
			-label "y"
			-annotation "select mirror axis"
			-cc "$mirror_tool_mirr_axis=\"y\"";
    	radioButton
			-label "z"
			-annotation "select mirror axis"
			-cc "$mirror_tool_mirr_axis=\"z\"";
	text  -annotation "select mirror axis"  -l "-axis     ";
	button
		-l   "create Mirror node" -w 110
		-bgc 0.995  1.0 0.79
		-annotation "creating Mirror System node. select objects and press Button"
		-c "MIRR_b7cfd62c53832d19b9248a27c80a6f44($mirror_tool_mirr_axis, 0, 1)";
	iconTextButton -image "addCreateGeneric.png" -style "iconAndTextHorizontal"
		-annotation "select objects and MirrorSystem Locator and press button"
		-c "MIRR_9147e5087e953411782b272b89b1ddb6()" -l "add item";
	text "";
	button
		-l   "calculate Mirror" -w 110
		-bgc 1  0.8 0.79
		-annotation "recalculare selected Mirror System Locator"
		-c "MT_calcul_single()";
frameLayout
		-p "columnLayout5"
		-bgc 0.2 0.555 0.580
		-ebg true
		-bv false
		-cl 0
		-cll true
		-l "auto connect"
		-la "top"
		-lw 0
		-mw 0
		-cc "catchQuiet(`window -e -h 80 mirror_toool`)" connectAuto_fr_lay_creator;
rowLayout -p connectAuto_fr_lay_creator
		-nc 8
		-adj 5
		connectAuto_row_creator;
	text -l" from ";
	textField
		-tx "_L"
		-tcc "textField -e -tx `textField -q -tx Mirr_from` Mirr_z_from"
		-ann "from this side prefix attached to ..."
		-w 40
		-bgc 1  1.0 0.79
		"Mirr_from";
	text -l" to>> ";
	textField
		-tx "_R"
		-tcc "textField -e -tx `textField -q -tx Mirr_to` Mirr_z_to"
		-w 40
		-ann "...attached to this side prefix "
		-bgc 1  1.0 0.79
		"Mirr_to";
	text -l"  ";
	button -p connectAuto_row_creator -w 150
							-l "Symmetric Translate Rotate"
							-bgc 0.82 1.0 0.8
							-ann "auto connect MirrorSystem by Symmetric pose Translates And Rotates"
							-c "MIRR_0d9dbbe39a5758068cdf30cf9c7cb924(`textField -q -tx Mirr_from`,`textField -q -tx Mirr_to`, \"Symmetric\")";
	text -l"  ";
	button -p connectAuto_row_creator -w 150
							-l "Symmetric Rotate Only"
							-bgc 0.82 1.0 0.8
							-ann "auto connect MirrorSystem by Symmetric pose Rotates only"
							-c "MIRR_0d9dbbe39a5758068cdf30cf9c7cb924(`textField -q -tx Mirr_from`,`textField -q -tx Mirr_to`, \"SymmetricRotate\")";
frameLayout
		-p "columnLayout5"
		-bgc 0.2 0.555 0.580
		-ebg true
		-bv false
		-cl 1
		-cll true
		-l "manual connect"
		-la "top"
		-lw 0
		-mw 0
		-cc "catchQuiet(`window -e -h 80 mirror_toool`)" connectAcross_fr_lay_creator;
	rowLayout -p connectAcross_fr_lay_creator -nc 5 -adj 2 connectAcross_row_creator;
		columnLayout -adj 0 -p connectAcross_row_creator connectAcross_creator;
					button -p connectAcross_creator -w 150
						-l "Parent attach across"
						-bgc 0.82 1.0 0.8
						-ann "Create locator inside first selected object. Move second to position and parent constrain"
						-c "MIRR_18a1bcd5e135a60ba68f5eb3c465884e(\"parent\",0);";
					button -p connectAcross_creator -w 150
						-l "Orient attach across"
						-bgc 0.82 1.0 0.8
						-ann "Create locator inside first selected object. And orient constrain second"
						-c "MIRR_18a1bcd5e135a60ba68f5eb3c465884e(\"orient\",0);";
					button -p connectAcross_creator -w 150
						-l "Point attach across"
						-bgc 0.82 1.0 0.8
						-ann "Create locator inside first selected object. And point constrain second"
						-c "MIRR_18a1bcd5e135a60ba68f5eb3c465884e(\"point\",0);";
		text -p connectAcross_row_creator -l "";
		columnLayout -adj 0 -p connectAcross_row_creator zero_and_rotate_creator;
					rowLayout -p zero_and_rotate_creator -nc 3   zero_and_rotate_creator_row_creator;
						button -p zero_and_rotate_creator_row_creator -w 58
							-l "copy"
							-bgc 0.82 1.0 0.6
							-ann "copy rotation from selection object"
							-c "MIRR_66c56c7553b8c48c1c480f58c19084ce()";
						button -p zero_and_rotate_creator_row_creator -w 58
							-l "paste"
							-bgc 0.82 1.0 0.6
							-ann "paste rotation to selection objects"
							-c "MIRR_f0a28d7c6e1c7cd0114c5b790b5810db()";
					button -p zero_and_rotate_creator -w 120
						-l "mirr rotate"
						-bgc 0.82 1.0 0.8
						-ann "rotate selected obj 180 0 0"
						-c "rotate -os 180 0 0";
					button -p zero_and_rotate_creator -w 120
						-l "zero rotate"
						-bgc 0.82 1.0 0.8
						-ann "zero rotate selected objects"
						-c "rotate -os 0 0 0";
		text -p connectAcross_row_creator -l "";
		columnLayout -adj 1 -p connectAcross_row_creator connect_attrib_creator;
					rowLayout -p connect_attrib_creator
								-bgc 0.8 0.62 0.8
								-nc 5
								-adj 3
								connect_manu_row_creator;
							text
								-ann "set prefixes in autoconnect tab"
								-p connect_manu_row_creator -l"     ";
							textField
								-p connect_manu_row_creator
								-ed 0
								-tx (`textField -q -tx Mirr_from`)
								-fn "obliqueLabelFont"
								-ann "from this side prefix attached to ..."
								-w 40
								-bgc 0.80.62 0.8
								"Mirr_z_from";
							text
								-ann "set prefixes in autoconnect tab"
								-fn "obliqueLabelFont"
								-p connect_manu_row_creator -l">>";
							textField
								-tx (`textField -q -tx Mirr_to`)
								-p connect_manu_row_creator
								-ed 0
								-fn "obliqueLabelFont"
								-w 40
								-ann "...attached to this side prefix "
								-bgc 0.8 0.62 0.8
								"Mirr_z_to";
							text
								-ann "set prefixes in autoconnect tab"
								-p connect_manu_row_creator -l"      ";
				button -p connect_attrib_creator -w 150
							-l "selected most suitable"
							-bgc 0.8 0.62 0.8
							-ann "select mirr object. The most suitable object will be selected"
							-c "MIRR_af16024bff0824c73ab6c4082569d9ed(`textField -q -tx Mirr_from`,`textField -q -tx Mirr_to`)";
					button -p connect_attrib_creator -w 150
							-l "Connect same_attrib"
							-bgc 0.82 1.0 0.8
							-ann "select mirr object and control.  Attrib with same names will be connected"
							-c "MIRR_ebdde21f7478f2e87c8125a749c52f7a()";
frameLayout
		-p "columnLayout5"
		-bgc 0.2 0.555 0.580
		-ebg true
		-bv false
		-cl 1
		-cll true
		-l "bake&delete"
		-la "top"
		-lw 0
		-mw 0
		-cc "catchQuiet(`window -e -h 80 mirror_toool`)" add_it_fr_lay_creator;
columnLayout -adj 1 -p add_it_fr_lay_creator  add_it_creator;
    	rowLayout -p add_it_creator -nc 3 -adj 2 connectAcross_row_creator1;
			button -p "connectAcross_row_creator1" -w 200 -h 40
			-bgc 0.995  1.0 0.79
				-ann "Bake selected"
				-c "MIRR_692e2fda85cadfdf0f28e93323f58c08; MIRR_de88efca2929f0080ae1d45ff5db42d4; MIRR_09f1edc0a69a4931b08e1bcc40e94a55; MIRR_f4b1a2b52ab1771321003f86cde63160;" -l "Bake selected";
			text -p "connectAcross_row_creator1" "";
			button -p "connectAcross_row_creator1" -w 200 -h 40
					-bgc 1  0.8 0.79
					-ann "delete selected MirrorSystem Locator system"
					-c "MIRR_4e55dd5ee0a5a72502e97cf0ed202fa7" -l "delete selected Mirror tool";
frameLayout
		-p "columnLayout5"
		-bgc 0.7 0.4 0.2
		-ebg true
		-bv false
		-cl 1
		-cll true
		-l "help"
		-la "top"
		-lw 0
		-mw 0
		-cc "catchQuiet(`window -e -h 80 mirror_toool`)" hlp_fr_lay_creator;
text -fn boldLabelFont -al "left" -p hlp_fr_lay_creator -ww 1
	-l "   This script creates a system that mirrors the animation of selected objects with a shift by a certain number of frames. \n  - ideal for animating legs and arms in walk/run animations.\n ";
columnLayout -bgc 0.995  1.0 0.79 -adj 1 textt_yello;
text -p textt_yello -fn smallBoldLabelFont -al "left" -ww 1
	-l "USAGE:";
text -p textt_yello -fn obliqueLabelFont -al "left" -ww 1
	-l " - select objects whose animation we want to mirror according to the same law (if it is a leg, select knee, foot, sock)\n - select miroor axis \n - press CREATE MIRROR NODE";
text -p textt_yello-fn obliqueLabelFont -al "left" -ww 1
	-l " - the MIRROR SYSTEM locator will appear in the scene \n - it will have the OFFSET attribute (0 by default) - you should set it to the desired value (usually half-period animation)\n - and also there will be mapped objects selected earlier.";
text -p textt_yello -fn obliqueLabelFont -al "left" -ww 1
	-l " - to them you need to attach the corresponding objects on the other side with AUTO CONNECT. \n SYMMETRIC POSE - the best method";
text -p textt_yello -fn obliqueLabelFont -al "left" -ww 1
	-l " - or you can attach with MANUAL CONNECT. \n\n";
text -fn obliqueLabelFont -al "left" -p hlp_fr_lay_creator
	-ww 1
	-l " moving and constrain BASE GROUP FOR MIRROR and BASE GROUP NOT MIRROR to different objects, \n you can achieve the corresponding effects  and rotations of the displayed animation \n (animation is calculated from the position relative to these groups, not the world coordinates)";
	window -e -h 80 mirror_toool;
	showWindow "mirror_toool";
}
global proc MIRR_692e2fda85cadfdf0f28e93323f58c08()
{
	global float $startTime;
	global string $my_eval_mode[];
	float $mayaVersion;
	$startTime = `timerX`;
	refresh -su 1;
	setTimeSliderVisible 0;
	$mayaVersion = `getApplicationVersionAsFloat` ;
	if ($mayaVersion>=2016)
	{
		$my_eval_mode=`evaluationManager -q -mode`;
		evaluationManager -mode "off";
	}
}
global proc MIRR_f4b1a2b52ab1771321003f86cde63160()
{
	global float $startTime;
	global string $my_eval_mode[];
	float $mayaVersion;
	$totalTime = `timerX -startTime $startTime`;
	print ("Total Time: "+$totalTime+"\n");
	refresh -su 0;
	setTimeSliderVisible 1;
	$mayaVersion = `getApplicationVersionAsFloat` ;
	if ($mayaVersion>=2016)
	{
		evaluationManager -mode $my_eval_mode[0];
	}
}
global proc MIRR_de88efca2929f0080ae1d45ff5db42d4()
{
	$selection=`ls-sl`;
    $mayaVersion = `getApplicationVersionAsFloat` ;
    string $eval_mode[];
    if ($mayaVersion>=2016)
    {
        $eval_mode=`evaluationManager -q -mode`;
		if($eval_mode[0]!="off")
			evaluationManager -mode "off";
    }
    $min=`playbackOptions -q -ast`;
    $max=`playbackOptions -q -aet`;
    $its_baked=catchQuiet (`bakeResults -sm 1 -s false -t ($min+":"+$max) $selection`);
	if ($mayaVersion>=2016)
    {
		if($eval_mode[0]!="off")
			evaluationManager -mode $eval_mode[0];
    }
    if($its_baked)
    {
        warning "select something!";
    }
}
global proc MIRR_09f1edc0a69a4931b08e1bcc40e94a55()
{
	$selected= `ls -sl`;
	if(size($selected)==0)
	{
		warning "select something!!!!";
		return;
	}
	string $crvs[] = `keyframe -q -n`;
	float $statTime[] = `keyframe -index 0 -q -tc $crvs`;
	$statTime=`sort $statTime`;
	$null_frame = $statTime[0] - 10;
	catchQuiet(`setKeyframe -v 0 -t $null_frame -at rotateX -at rotateY -at rotateZ`) ;
	catchQuiet(`filterCurve $selected.rotateX $selected.rotateY $selected.rotateZ`);
	selectKey -clear;
	catchQuiet(`cutKey -t $null_frame  -at rotateX -at rotateY -at rotateZ `);
	selectKey -clear;
}
global proc MIRR_48485870564b576698e443b951ff184a()
{
	$selected=`ls-sl`;
	float $targ_attr[];
	catchQuiet($targ_attr=`getAttr ($selected[0] + ".rotate")`);
	catchQuiet(`rotate $targ_attr[0] $targ_attr[1] $targ_attr[2]  $selected[1]`);
	catchQuiet(`rotate $targ_attr[0] $targ_attr[1] $targ_attr[2]  $selected[1]`);
	catchQuiet(`rotate $targ_attr[0] $targ_attr[1] $targ_attr[2]  $selected[1]`);
}
global proc MIRR_ef5038f332443510e158b37092b13e2e()
{
	$selected=`ls-sl`;
	float $targ_attr[];
	catchQuiet($targ_attr=`getAttr ($selected[0] + ".translate")`);
	catchQuiet(`move -cs $targ_attr[0] $targ_attr[1] $targ_attr[2]  $selected[1]`);
	catchQuiet(`move -cs $targ_attr[0] $targ_attr[1] $targ_attr[2]  $selected[1]`);
	catchQuiet(`move -cs $targ_attr[0] $targ_attr[1] $targ_attr[2]  $selected[1]`);
}
global proc MIRR_b7cfd62c53832d19b9248a27c80a6f44(string $mirror_axis, float $offset, int $cycled)
{
	$mirror_axis=`capitalizeString $mirror_axis`;
	$selected_object_for_mirror=`ls-sl`;
	select -cl;
	select $selected_object_for_mirror;
	string $base_grpp[]=MIRR_e6d1cc62e700198ddfd8906d663761ba();
	string $base_locks[]=`ls-sl`;
	string $attr_on_obj[];
	$base_locks=MIRR_10b1c67feba7e9570357d44ba9306692 ("", $selected_object_for_mirror,"_bl");
	MIRR_29941243f77aa0343e79460d48136072 (1);
	MIRR_17431451b1be026fdeee93b86579c6b6($selected_object_for_mirror, $base_locks);
	MIRR_bfe56aae7d5797fb0a4d2b81c633d99e($selected_object_for_mirror,$base_locks);
	select $base_grpp;
	rotate -os 0 0 0 $base_grpp;
	move -os 0 0 0  $base_grpp;
	$base_not_mirror_group=`group -name (MIRR_c954f3ebe8232ef721ae19221935b64e("base_group_not_mirror"))`;
	xform -os -piv 0 0 0;
	select $selected_object_for_mirror $base_not_mirror_group;
	float $dist=MIRR_a358a7c27f7a7b80712d695138ed032e(`ls-sl`, 1);
	select $selected_object_for_mirror;
	$mirror_grpp_to_calc= MIRR_0a10c57fddb9b8e3dc07486c3a9a5eed();
	float $rad=($dist/8)/MIRR_f71c299bf7b53f7243b078a9990e581c(1);
	string $mirror_jnts[]=MIRR_19d76f37038db0f20211caf8b74f382f($rad, 0.3);
	MIRR_32a3829df17c3736d9757e423eeaf0e3($mirror_grpp_to_calc,$mirror_jnts);
	MIRR_5145561f67290e54dacf2e0b5d4f02b7($base_locks, $mirror_grpp_to_calc);
	$mirror_grpp=MIRR_0a10c57fddb9b8e3dc07486c3a9a5eed();
	string  $new_attr_mg,$new_attr_j,$new_attr_nmg;
    for($i=0;$i<size($selected_object_for_mirror);$i++)
    {
        $attr_on_obj=`listAttr -k -v -ud  $selected_object_for_mirror[$i]`;
        for($att in  $attr_on_obj)
        {
            $new_attr_nmg=MIRR_81710030388b6f6922e422fe523dd15a( $att,$base_locks[$i]);
            connectAttr -f ($selected_object_for_mirror[$i] + "." + $att) $new_attr_nmg ;
            $new_attr_mg=MIRR_81710030388b6f6922e422fe523dd15a( $att,$mirror_grpp_to_calc[$i]);
			setAttr $new_attr_mg (`getAttr $new_attr_nmg`);
            catchQuiet($new_attr_j=MIRR_81710030388b6f6922e422fe523dd15a( $att,$mirror_jnts[$i]));
            catchQuiet(`connectAttr -f $new_attr_mg $new_attr_j `);
        }
    }
	select $mirror_grpp;
	rotate -os 0 0 0 $mirror_grpp $mirror_jnts;
	move -os 0 0 0  $mirror_grpp;
	MIRR_32a3829df17c3736d9757e423eeaf0e3($mirror_grpp,$mirror_grpp_to_calc);
	MIRR_5e8af8371c687e5c50d7ded5040ffe13($base_locks, $mirror_jnts);
	scale -os 1 1 1 $mirror_jnts;
	select $mirror_grpp;
	$base_mirror_group=`group -name(MIRR_c954f3ebe8232ef721ae19221935b64e("base_group_for_mirror")) `;
	xform -os -piv 0 0 0;
	setAttr ($base_mirror_group + ".scale" + $mirror_axis) -1;
	createNode blindDataTemplate;
	$nodenames=MIRR_e706e982298fe9e8f94ae04b06b5d6b2("mirror_barnev_system");
	string $attribname;
    for($i=0;$i<size($selected_object_for_mirror); $i++)
    {
		$attribname=MIRR_65107bc37ea4a0d842be293fd78287a9("mirr_obj" + $i, $nodenames[0]);
		connectAttr -f ($base_locks[$i] + ".visibility")   $attribname;
		connectAttr -f $attribname ($mirror_grpp_to_calc[$i] + ".visibility");
		$attribname=MIRR_65107bc37ea4a0d842be293fd78287a9("mirr_group" + $i, $nodenames[0]);
		connectAttr -f ($base_grpp[$i] + ".visibility")   $attribname;
		connectAttr -f $attribname ($mirror_grpp[$i] + ".visibility");
    }
	select $mirror_jnts $mirror_grpp_to_calc;
	MIRR_aa074854107180f09880ea0e8edd43f8;
	select $mirror_jnts;
	move -os 0 0 0  $mirror_jnts;
	$attribname=MIRR_65107bc37ea4a0d842be293fd78287a9("base_groupps", $nodenames[0]);
	connectAttr -f ($base_not_mirror_group + ".visibility")   $attribname;
	$attribname_ggg=MIRR_65107bc37ea4a0d842be293fd78287a9("not_delete_this_attr", $base_mirror_group);
	connectAttr -f   $attribname $attribname_ggg;
	select $base_mirror_group $base_not_mirror_group;
	$general_mirror_system_group=`group -name (MIRR_c954f3ebe8232ef721ae19221935b64e("mirror_system_gr"))`;
	xform -os -piv 0 0 0;
	$attribname=MIRR_65107bc37ea4a0d842be293fd78287a9("general_mirror_system_group", $nodenames[0]);
	connectAttr -f ($general_mirror_system_group + ".visibility")   $attribname;
	MIRR_aa074854107180f09880ea0e8edd43f8;
	select -cl;
	string $diamond[]=MIRR_8a435c1e94becce7728e63b61ba412bd($dist/2);
	string $tmp_new_nm=MIRR_c954f3ebe8232ef721ae19221935b64e("mirror_system");
	$diamond[0]=`rename $diamond[0]  $tmp_new_nm`;
	$general_mirror_system_locator=$diamond;
	setAttr ($general_mirror_system_locator[0] + ".hideOnPlayback") 0;
	$attribname=MIRR_41a30a2e9e6a02aac72ab138d3f62f90("Offset", $general_mirror_system_locator[0]);
	setAttr $attribname $offset;
	$attribname_node=MIRR_41a30a2e9e6a02aac72ab138d3f62f90("offset", $nodenames[0]);
	connectAttr -f $attribname $attribname_node;
	$attribname=MIRR_65107bc37ea4a0d842be293fd78287a9("Cycled", $general_mirror_system_locator[0]);
	setAttr $attribname $cycled;
	$attribname_node=MIRR_65107bc37ea4a0d842be293fd78287a9("cycled", $nodenames[0]);
	connectAttr -f $attribname $attribname_node;
	addAttr -ln "calculate"  -at "enum" -en "Yes:No:" $general_mirror_system_locator[0];
	setAttr -e-channelBox true ($general_mirror_system_locator[0] + ".calculate");
	setAttr  ($general_mirror_system_locator[0] + ".calculate") 0;
	$attribname_node=MIRR_65107bc37ea4a0d842be293fd78287a9("calculate", $nodenames[0]);
	connectAttr -f ($general_mirror_system_locator[0] + ".calculate") $attribname_node;
	global string $mirror_tool_icon_path;
	string $name_annotation = `annotate -tx ( "mirror           ") -p 0 0 0  $general_mirror_system_locator[0]`;
	string $ann_base[]=`pickWalk -d up $name_annotation`;
	setAttr ($name_annotation + ".displayArrow") 0;
	toggle -template;
	select -add  $general_mirror_system_locator[0];
	parent -r;
	select $base_not_mirror_group;
	MIRR_4c2952dd9f486573856c8eb6a0dc46ac(0);
	select $general_mirror_system_locator[0];
	MIRR_cc20e95399a3b6da44eb78e45451d764(22);
	MIRR_c89bf830cdb2b9cc874e6c8604e8b257;
	MIRR_ef6700cd4efa166b5d6bde47732f420a;
	move -r 0 0 0 ;
	select $mirror_jnts;
	MIRR_d709ffba9755e96e5977d4e5832da1cd($mirror_jnts);
	MIRR_10b1c67feba7e9570357d44ba9306692 ("", $selected_object_for_mirror,"_m");
	select $mirror_grpp_to_calc;
	MIRR_10b1c67feba7e9570357d44ba9306692 ("", $selected_object_for_mirror,"_mg");
	select  $mirror_grpp;
	MIRR_10b1c67feba7e9570357d44ba9306692 ("", $selected_object_for_mirror,"_Mpiv");
	select $base_grpp;
	MIRR_10b1c67feba7e9570357d44ba9306692 ("", $selected_object_for_mirror,"_Bpiv");
	string $name_button=  MIRR_27fa0883c172ae08e08f5b2f5e58ad38($mirror_tool_icon_path,  "",  $general_mirror_system_locator[0]);
	$command="execute_single_MT_calculation(\"" + $name_button + "\")";
	setAttr -type "string" ($name_button + ".script") $command;
	MIRR_e9a3d5ffe283044f2485219b12ac5f73({$ann_base[0],$name_button}, 1);
	select $general_mirror_system_locator[0];
	manipMoveContext -edit -mode 0 Move;
    setToolTo moveSuperContext;
}
global proc MIRR_9147e5087e953411782b272b89b1ddb6()
{
	$selected=`ls-sl`;
	select -cl;
	select $selected;
	$mirror_sys_lock=`ls-sl -tail 1`;
	select -d $mirror_sys_lock;
	$select_obj_to_add=`ls-sl`;
	select $mirror_sys_lock;
	$name_mirror_sys_node=MIRR_e8f0c3b3e6300189aca31ae83320ec92("*mirror_barnev_system*");
	if ( $name_mirror_sys_node=="")
	{
		error "select Mirror System Lockator last";
		return;
	}
	$node_attrib= `attributeInfo -all   $name_mirror_sys_node`;
	$tmp_input=`listConnections  -d 0 -s 1  ($name_mirror_sys_node + ".base_groupps")`;
	$base_group_not_mirror =$tmp_input[0];
	$tmp_output=`listConnections  -d 1 -s 0  ($name_mirror_sys_node + ".base_groupps")`;
	$base_group_mirror =$tmp_output[0];
	string $obj;
	$number_connected_obj=0;
	for($obj in $node_attrib)
		if(`gmatch $obj "mirr_obj*"`)
			$number_connected_obj++;
	select $select_obj_to_add;
	$base_grpp_add=MIRR_e6d1cc62e700198ddfd8906d663761ba();
	$base_locks_add=`ls-sl`;
	MIRR_17431451b1be026fdeee93b86579c6b6($select_obj_to_add, $base_locks_add);
	MIRR_bfe56aae7d5797fb0a4d2b81c633d99e($select_obj_to_add,$base_locks_add);
	select $base_grpp_add $base_group_not_mirror;
	float $dist=MIRR_a358a7c27f7a7b80712d695138ed032e(`ls-sl`, 1);
	parent ;
	select $base_grpp_add;
	rotate -os 0 0 0 $base_grpp_add;
	move -os 0 0 0 $base_grpp_add;
	select $select_obj_to_add;
		$mirror_grpp_to_calc= MIRR_0a10c57fddb9b8e3dc07486c3a9a5eed();
	float $rad=($dist/8)/MIRR_f71c299bf7b53f7243b078a9990e581c(1);
	string $mirror_jnt_to_calc[]=MIRR_19d76f37038db0f20211caf8b74f382f($rad, 0.3);
	MIRR_32a3829df17c3736d9757e423eeaf0e3($mirror_grpp_to_calc,$mirror_jnt_to_calc);
	rotate -os 180 0 0 $mirror_jnt_to_calc;
	$mirror_grpp=MIRR_0a10c57fddb9b8e3dc07486c3a9a5eed();
	MIRR_32a3829df17c3736d9757e423eeaf0e3($mirror_grpp,$mirror_grpp_to_calc);
	select  $mirror_grpp;
	MIRR_ade4e354383a28fcefcaf5ce40e6639d;
	parent $mirror_grpp $base_group_mirror;
	select 	$mirror_grpp;
	rotate -os 0 0 0 $mirror_grpp;
	move -os 0 0 0 $mirror_grpp;
	MIRR_37979d5db724aeac3ec6046edc570bbd;
	MIRR_8f1bbed6c413bd9cd1ae5d3c63afb5cc($base_locks_add,$mirror_grpp_to_calc);
	MIRR_9ef8981ccf72c74373e900ef581dfaea($base_locks_add,$mirror_grpp_to_calc);
	MIRR_2fa2b06e9166235ba786cb6586606b52($base_locks_add,$mirror_grpp_to_calc);
	string $attribname;
	for($i=0;$i<size($select_obj_to_add); $i++)
	{
		$attribname=MIRR_65107bc37ea4a0d842be293fd78287a9("mirr_obj" + ($number_connected_obj + $i), $name_mirror_sys_node);
		connectAttr -f ($base_locks_add[$i] + ".visibility")   $attribname;
		connectAttr -f $attribname ($mirror_grpp_to_calc[$i] + ".visibility");
		$attribname=MIRR_65107bc37ea4a0d842be293fd78287a9("mirr_group" + ($number_connected_obj + $i), $name_mirror_sys_node);
		connectAttr -f ($base_grpp_add[$i] + ".visibility")   $attribname;
		connectAttr -f $attribname ($mirror_grpp[$i] + ".visibility");
	}
	string $attr_on_obj[];
	string  $new_attr_mg,$new_attr_j,$new_attr_nmg;
    for($i=0;$i<size($select_obj_to_add);$i++)
    {
        $attr_on_obj=`listAttr -k -v -ud  $select_obj_to_add[$i]`;
        for($att in  $attr_on_obj)
        {
            $new_attr_nmg=MIRR_81710030388b6f6922e422fe523dd15a( $att,$base_locks_add[$i]);
            connectAttr -f ($select_obj_to_add[$i] + "." + $att) $new_attr_nmg ;
            $new_attr_mg=MIRR_81710030388b6f6922e422fe523dd15a( $att,$mirror_grpp_to_calc[$i]);
			setAttr $new_attr_mg (`getAttr $new_attr_nmg`);
             catchQuiet($new_attr_j=MIRR_81710030388b6f6922e422fe523dd15a( $att,$mirror_jnt_to_calc[$i]));
             catchQuiet(`connectAttr -f $new_attr_mg $new_attr_j`);
        }
    }
	select $base_grpp_add;
	MIRR_10b1c67feba7e9570357d44ba9306692 ("", $select_obj_to_add,"_Bpiv");
	select $mirror_grpp_to_calc;
	MIRR_aa074854107180f09880ea0e8edd43f8;
	MIRR_10b1c67feba7e9570357d44ba9306692 ("", $select_obj_to_add,"_mg");
	select  $mirror_grpp;
	MIRR_10b1c67feba7e9570357d44ba9306692 ("", $select_obj_to_add,"_Mpiv");
	select $mirror_jnt_to_calc;
	MIRR_d709ffba9755e96e5977d4e5832da1cd($mirror_jnt_to_calc);
	MIRR_10b1c67feba7e9570357d44ba9306692 ("", $select_obj_to_add,"_m");
}
