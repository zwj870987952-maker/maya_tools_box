global proc int[] MIRR_d709ffba9755e96e5977d4e5832da1cd(string $objects[])
{
    if(!size($objects))
        return {};
    string $obj;
    int $colors[]={13,22,6,14,9,18,12,31,19,28,30,31,1,4,5};
    int $col_num[];
    $i=0;
    int $num;
    for($obj in $objects)
    {
        catchQuiet(`setAttr ($obj + ".overrideEnabled") 1`);
		catchQuiet(`setAttr -lock false ($obj + ".overrideColor") $colors[$i]`);
		$col_num[$i]= $colors[$i];
		$i++;
		if($i>=size( $colors))
		    $i=0;
    }
    return $col_num;
}
global proc MIRR_92de112c5c170c44ad9daf4d48b1acdd(float $rad)
