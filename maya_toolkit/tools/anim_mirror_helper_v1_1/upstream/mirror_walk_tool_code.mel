global proc MIRR_6de8028af587b467034457b4d6349f89(float $subScale)
{
    int $camera_ortograf=0;
	float $dist=50;
	$subScale=MIRR_f71c299bf7b53f7243b078a9990e581c($subScale)/MIRR_f71c299bf7b53f7243b078a9990e581c(1)/MIRR_f71c299bf7b53f7243b078a9990e581c(1);
	$sel=`ls-head 1 -sl`;
	string $camera_name="";
	float $camera_scale=1;
	catchQuiet( $camera_name= MIRR_20a28b95c1b8b4dd29397ab332dbc667());
	if( $camera_name =="no model panel viewport")
	    $camera_name="persp";
	catchQuiet( $camera_scale=`getAttr ($camera_name + ".cameraScale")`);
	catchQuiet( $dist=MIRR_c7822f1f10b007a6803735c105e40799($sel[0], $camera_name));
	catchQuiet( $camera_ortograf=`getAttr ($camera_name + ".orthographic")`);
	catchQuiet( $camera_orthographicWidth=`getAttr ($camera_name + ".orthographicWidth")`);
	if(!$camera_ortograf)
	    catchQuiet(MIRR_29941243f77aa0343e79460d48136072 (($dist/25)*$subScale*$camera_scale));
	else
	   catchQuiet(MIRR_29941243f77aa0343e79460d48136072 (($camera_orthographicWidth/25)*$subScale*$camera_scale));
}
global proc string [] MIRR_ac2021d0d7ff3ecfad4dbca9f9f88248(string $target_massiv[], string $object_massiv[])
{
	string $name_of_constrain[];
	string $tmp[];
	for($i=0;$i<size($target_massiv);$i++)
		{
		$rx_lock=`getAttr -lock ($object_massiv[$i] + ".rx")`;
		$ry_lock=`getAttr -lock ($object_massiv[$i] + ".ry")`;
		$rz_lock=`getAttr -lock ($object_massiv[$i] + ".rz")`;
		$h=$rx_lock+$ry_lock+$rz_lock;
		if ($h<3)
		{
			$skipX= "";
			$skipY= "";
			$skipZ= "";
			if($rx_lock)
				$skipX= " -skip x";
			if($ry_lock)
				$skipY= " -skip y";
			if($rz_lock)
				$skipZ= " -skip z";
			$skipped = $skipX + $skipY + $skipZ;
			$tmp=`eval ("orientConstraint  " + $skipped + " " + $target_massiv[$i] + " " + $object_massiv[$i])`;
			$name_of_constrain[$i]=$tmp[0];
		}
	}
	return $name_of_constrain;
}
global proc string [] MIRR_bfe56aae7d5797fb0a4d2b81c633d99e(string $target_massiv[], string $object_massiv[])
{
	string $name_of_constrain[];
	string $tmp[];
	int $h;
	int $rx_lock;
	int $ry_lock;
	int $rz_lock;
	string $skipX;
	string $skipY;
	string $skipZ;
	string $skipped;
	for($i=0;$i<size($target_massiv);$i++)
		{
		$rx_lock=`getAttr -lock ($object_massiv[$i] + ".sx")`;
		$ry_lock=`getAttr -lock ($object_massiv[$i] + ".sy")`;
		$rz_lock=`getAttr -lock ($object_massiv[$i] + ".sz")`;
		$h=$rx_lock+$ry_lock+$rz_lock;
		if ($h<3)
		{
			$skipX= "";
			$skipY= "";
			$skipZ= "";
			if($rx_lock)
				$skipX= " -skip x";
			if($ry_lock)
				$skipY= " -skip y";
			if($rz_lock)
				$skipZ= " -skip z";
			$skipped = $skipX + $skipY + $skipZ;
			$tmp=`eval ("scaleConstraint " + $skipped + " " + $target_massiv[$i] + " " + $object_massiv[$i])`;
			$name_of_constrain[$i]=$tmp[0];
		}
	}
	return $name_of_constrain;
}
global proc float[] MIRR_8598296823aa3af15686cb0d78f1615d(string $selection)
{
    float $objPosition[];
    float $getPvPos[];
    float $Rot[];
    string $buffer[];
    string $e_f_result[];
    vector $coords[];
    vector $coo;
    float $pos[];
    int $num;
    if ((`objectType -isType "mesh" $selection`)+(`objectType -isType "nurbsSurface" $selection`)+(`objectType -isType "nurbsCurve" $selection`)+(`objectType -isType "lattice" $selection`))
	{
        if (`objectType -isType "mesh" $selection`)
        {
            tokenize  $selection "." $buffer;
            $objname=$buffer[0];
            tokenize  $buffer[1] "[]" $buffer;
            $component_name=$buffer[0];
            if($component_name=="vtx")
            {
                $getPvPos=`pointPosition -world $selection`;
                $objPosition={$getPvPos[0],$getPvPos[1],$getPvPos[2],0,0,0};
            }
            if($component_name=="e")
            {
                $e_f_result=`polyInfo -ev $selection`;
                $num=`tokenize  $e_f_result[0] " " $buffer`;
                $j=0;
                for($i=2;$i<$num-1;$i++)
                {
                    $getPvPos=`pointPosition -world ($objname + ".vtx[" + $buffer[$i] + "]")`;
                    print ($objname + ".vtx[" + $buffer[$i] + "]");
                    $coords[$j]=<<$getPvPos[0],$getPvPos[1],$getPvPos[2]>>;
                    $j++;
                }
                $coo=MIRR_e3bea614176fbceebe7c7aae67e953b0($coords);
                $objPosition={$coo.x,$coo.y,$coo.z,0,0,0};
            }
            if($component_name=="f")
            {
                $e_f_result=`polyInfo -fv $selection`;
                tokenize  $e_f_result[0] " " $buffer;
                $j=0;
                for($i=2;$i<size($buffer)-1;$i++)
                {
                    $getPvPos=`pointPosition -world ($objname + ".vtx[" + $buffer[$i] + "]")`;
                    $coords[$j]=<<$getPvPos[0],$getPvPos[1],$getPvPos[2]>>;
                    $j++;
                }
                $coo=MIRR_e3bea614176fbceebe7c7aae67e953b0($coords);
                $objPosition={$coo.x,$coo.y,$coo.z,0,0,0};
            }
        }
        else
        {
    		$getPvPos=`pointPosition -world $selection`;
    		$objPosition={$getPvPos[0],$getPvPos[1],$getPvPos[2],0,0,0};
		}
	}
	else
	{
		$getPvPos = `xform -q -ws -piv $selection `;
		$Rot= `xform -q -ro -ws $selection`;
		$objPosition={$getPvPos[0],$getPvPos[1],$getPvPos[2],$Rot[0],$Rot[1],$Rot[2]};
	}
	return $objPosition;
}
global proc string[] MIRR_17431451b1be026fdeee93b86579c6b6(string $target_massiv[], string $object_massiv[])
{
	string $name_constrain[];
	string $tmp_constrain[];
	string $skipTX;
	string $skipTY;
	string $skipTZ;
	string $skipRX;
	string $skipRY;
	string $skipRZ;
	string $delChannelTX;
	string $delChannelTY;
	string $delChannelTZ;
	string $delChannelRX;
	string $delChannelRY;
	string $delChannelRZ;
	int $rx_lock;
	int $ry_lock;
	int $rz_lock;
	int $tx_lock;
	int $ty_lock;
	int $tz_lock;
	for($i=0;$i<size($target_massiv);$i++)
	{
		$rx_lock=`getAttr -lock ($object_massiv[$i] + ".rx")`;
		$ry_lock=`getAttr -lock ($object_massiv[$i] + ".ry")`;
		$rz_lock=`getAttr -lock ($object_massiv[$i] + ".rz")`;
		$tx_lock=`getAttr -lock ($object_massiv[$i] + ".tx")`;
		$ty_lock=`getAttr -lock ($object_massiv[$i] + ".ty")`;
		$tz_lock=`getAttr -lock ($object_massiv[$i] + ".tz")`;
		$h=$rx_lock+$ry_lock+$rz_lock+$tx_lock+$ty_lock+$tz_lock;
		if ($h<6)
		{
			$skipTX= "";
			$skipTY= "";
			$skipTZ= "";
			$skipRX= "";
			$skipRY= "";
			$skipRZ= "";
			$delChannelTX = "";
			$delChannelTY = "";
			$delChannelTZ = "";
			$delChannelRX = "";
			$delChannelRY = "";
			$delChannelRZ = "";
			if($tx_lock)
				$skipTX= " -st x";
			else
				$delChannelTX =" -at \"tx\"";
			if($ty_lock)
				$skipTY= " -st y";
			else
				$delChannelTY =" -at \"ty\"";
			if($tz_lock)
				$skipTZ= " -st z";
			else
				$delChannelTZ =" -at \"tz\"";
			if($rx_lock)
				$skipRX= " -sr x";
			else
				$delChannelRX =" -at \"rx\"";
			if($ry_lock)
				$skipRY= " -sr y";
			else
				$delChannelRY =" -at \"ry\"";
			if($rz_lock)
				$skipRZ= " -sr z";
			else
				$delChannelRZ =" -at \"rz\"";
			$skipped = $skipTX + $skipTY + $skipTZ + $skipRX + $skipRY + $skipRZ;
			if($target_massiv[$i]!="")
			{
			$tmp_constrain=`eval ("parentConstraint -mo " + $skipped + " " + $target_massiv[$i] + " " + $object_massiv[$i])`;
			}
			$name_constrain[$i]=$tmp_constrain[0];
		}
	}
	return $name_constrain;
}
global proc MIRR_5e8af8371c687e5c50d7ded5040ffe13(string $target_position[], string $object_to_move[])
{
	float $Trans[];
	float $Rot[];
	for($i=0;$i<size($target_position);$i++)
	{
        $Trans=MIRR_8598296823aa3af15686cb0d78f1615d($target_position[$i]);
        $Rot={$Trans[3],$Trans[4],$Trans[5]};
		rotate -ws $Rot[0] $Rot[1] $Rot[2] $object_to_move[$i];
		move -rpr $Trans[0] $Trans[1] $Trans[2] $object_to_move[$i];
		rotate -ws $Rot[0] $Rot[1] $Rot[2] $object_to_move[$i];
		move -rpr $Trans[0] $Trans[1] $Trans[2] $object_to_move[$i];
		rotate -ws $Rot[0] $Rot[1] $Rot[2] $object_to_move[$i];
		move -rpr $Trans[0] $Trans[1] $Trans[2] $object_to_move[$i];
	}
}
global proc MIRR_5145561f67290e54dacf2e0b5d4f02b7(string $target_position[], string $object_to_move[])
{
	for($i=0;$i<size($target_position);$i++)
	{
		$Rot = `xform -q -ro -ws $target_position[$i]`;
		$Trans = `xform -q -ws -piv $target_position[$i]`;
		$Scale =`xform -q -s -ws $target_position[$i]`;
		rotate -ws $Rot[0] $Rot[1] $Rot[2] $object_to_move[$i];
		move -rpr $Trans[0] $Trans[1] $Trans[2] $object_to_move[$i];
		rotate -ws $Rot[0] $Rot[1] $Rot[2] $object_to_move[$i];
		move -rpr $Trans[0] $Trans[1] $Trans[2] $object_to_move[$i];
		rotate -ws $Rot[0] $Rot[1] $Rot[2] $object_to_move[$i];
		move -rpr $Trans[0] $Trans[1] $Trans[2] $object_to_move[$i];
		scale -a $Scale[0] $Scale[1] $Scale[2]  $object_to_move[$i];
		scale -a $Scale[0] $Scale[1] $Scale[2]  $object_to_move[$i];
		scale -a $Scale[0] $Scale[1] $Scale[2]  $object_to_move[$i];
	}
}
global proc MIRR_9a8d2e62249cad27916aacc736478655()
{
	$obj=`ls-sl`;
	if (size($obj) == 2)
	{
		$Rot = `xform -q -ro -ws $obj[0]`;
		rotate -ws $Rot[0] $Rot[1] $Rot[2] $obj[1];
		rotate -ws $Rot[0] $Rot[1] $Rot[2] $obj[1];
		rotate -ws $Rot[0] $Rot[1] $Rot[2] $obj[1];
	}
	else
	{
		warning "Select 2 object!";
	}
}
global proc float[] MIRR_9713c7abe7f317a1eaefb22b30d9ce1c()
{
	$obj=`ls-sl`;
	float $distance[];
	float $pos1[];
	float $pos2[];
	if(size($obj)<2)
	{
		warning "Select 2 object!";
		return $pos1;
	}
	else
	{
		$pos1=`xform -q  -ws -piv $obj[0]`;
		$pos2=`xform -q  -ws -piv $obj[1]`;
		for($i=0;$i<3;$i++)
		{
			$distance[$i]=$pos1[$i]-$pos2[$i];
		}
	}
	if (size($obj) == 2)
	{
		move -rpr $pos1[0] $pos1[1] $pos1[2] $obj[1];
		move -rpr $pos1[0] $pos1[1] $pos1[2] $obj[1];
		move -rpr $pos1[0] $pos1[1] $pos1[2] $obj[1];
		return $pos1;
	}
	if (size($obj) > 2)
	{
		$range=size($obj)-1;
		$x=$distance[0]/$range;
		$y=$distance[1]/$range;
		$z=$distance[2]/$range;
		for($i=2;$i<size($obj);$i++)
		{
		   move -rpr ($pos1[0] - $x*($i-1)) ($pos1[1] - $y*($i-1)) ($pos1[2] - $z*($i-1)) $obj[$i];
		   move -rpr ($pos1[0] - $x*($i-1)) ($pos1[1] - $y*($i-1)) ($pos1[2] - $z*($i-1)) $obj[$i];
		   move -rpr ($pos1[0] - $x*($i-1)) ($pos1[1] - $y*($i-1)) ($pos1[2] - $z*($i-1)) $obj[$i];
		}
		return $pos1;
	}
}
global proc MIRR_3a25eaad774c71ebdcb06ee4d2b25ce3()
{
	$objs = `ls-sl`;
	for($obj in $objs)
	{
	    if(`objectType -i "joint" $obj`)
	    {
    		if(!`getAttr -lock ($obj + ".jointOrientX")`)
    			setAttr ($obj + ".jointOrientX") 0;
    		if(!`getAttr  -lock ($obj + ".jointOrientY") `)
    			setAttr ($obj + ".jointOrientY") 0;
    		if(!`getAttr  -lock ($obj + ".jointOrientZ")`)
    			setAttr ($obj + ".jointOrientZ") 0;
    	}
	}
}
