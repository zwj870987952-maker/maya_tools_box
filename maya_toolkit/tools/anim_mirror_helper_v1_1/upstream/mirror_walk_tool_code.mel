global proc string[] MIRR_54d92f8424c4459e6d996d9fd93902f0()
{
	string $selection[];
	$selection_true = `ls -fl -sl `;
	$selection = `ls -fl -os`;
	string $locators[];
	string $b[];
	if (size ($selection)>0)
	{
		$j=0;
		for($obj in $selection)
		{
			$getPvPos=MIRR_8598296823aa3af15686cb0d78f1615d($obj);
			$b=`spaceLocator -p 0 0 0`;
			$locators[$j]=$b[0];
			xform -ws -t $getPvPos[0] $getPvPos[1] $getPvPos[2] $b[0];
			rotate -ws $getPvPos[3] $getPvPos[4] $getPvPos[5]  $b[0];
			$j++;
		}
		select -cl;
		for($obj in $locators)
		{
			select -add $obj;
		}
	}
	else
	{
		$locators = `spaceLocator -p 0 0 0`;
	}
	return $locators;
}
global proc string[] MIRR_f2d5a2798ed7cfee36eb77ee8a281ed8()
{
	string $selection[];
	$selection_true = `ls -fl -sl `;
	$selection = `ls -fl -os`;
	string $locators[];
	string $b[];
	select -cl;
	float $getPvPos[];
	if (size ($selection)>0)
	{
	    $j=0;
	    for($obj in $selection)
	    {
            $getPvPos=MIRR_8598296823aa3af15686cb0d78f1615d($obj);
            $b[0]=`joint`;
            $locators[$j]=$b[0];
            xform -ws -t $getPvPos[0] $getPvPos[1] $getPvPos[2] $b[0];
            rotate -ws $getPvPos[3] $getPvPos[4] $getPvPos[5]  $b[0];
            $j++;
		}
		for($obj in $locators)
		{
		    select -add $obj;
		}
	}
	else
	{
		$locators[0] =`joint -p 0 0 0`;
	}
	select -cl;
	select $locators;
	return $locators;
}
