global proc string[] MIRR_194c7b09c27128a45486ac17560c7a25(string $objs[])
{
	string $new_selected[];
	$j=0;
	for($i=0;$i<size($objs);$i++)
	{
		if( `objExists $objs[$i]` )
		{
			$new_selected[$j] = $objs[$i];
			$j++;
		}
	}
	select -r $new_selected;
	return $new_selected;
}
global proc float MIRR_c7822f1f10b007a6803735c105e40799(string $obj1, string $obj2)
{
	float $temp[]=MIRR_8598296823aa3af15686cb0d78f1615d($obj1);
	vector $point1 = <<$temp[0], $temp[1], $temp[2]>>;
	$temp=MIRR_8598296823aa3af15686cb0d78f1615d($obj2);
	vector $point2 = <<$temp[0], $temp[1], $temp[2]>>;
	float $lenght=`mag($point1-$point2)`;
	return  $lenght;
}
global proc string[] MIRR_b3acc831f9f61a01a45fe7165ec12c62(string $full_name,string $side_from,string $side_to)
{
	string $buffer[], $short_names_buff[],$short_names_variations[],$namespaces[],$short_names_plus_buff[],$short_names_plus_buff_vari[];
	int $num_buf,$snb;
	string $temp_namespaces="";
	tokenize  $full_name ":" $buffer;
	$num_buf=size($buffer)-1;
	$namespaces=$buffer;
	stringArrayRemoveAtIndex($num_buf, $namespaces);
	if(size($namespaces)>0)
	    $temp_namespaces=stringArrayToString($namespaces, ":") + ":";
	string $short_name=$buffer[$num_buf];
	$short_names_buff=MIRR_465f2c70f8e4bf417e93834f61ee4f6e($short_name, $side_from);
	$snb=size($short_names_buff);
	for($i=0;$i<$snb; $i++)
	{
		$short_names_plus_buff[$i*2]=$short_names_buff[$i];
		$short_names_plus_buff[$i*2+1]="";
	}
	for($i=0;$i<$snb; $i++)
	{
		$short_names_plus_buff_vari= $short_names_plus_buff;
    		for($j=0;$j<$snb-1; $j++)
    		{
    			$short_names_plus_buff_vari[$j*2+1]=$side_from;
    			$short_names_plus_buff_vari[$i*2+1]=$side_to;
    		}
		$short_names_variations[$i]=$temp_namespaces + stringArrayToString($short_names_plus_buff_vari,"") ;
	}
	return $short_names_variations;
}
global proc string MIRR_c954f3ebe8232ef721ae19221935b64e(string $take_name)
{
    $i=0;
    while (`objExists $take_name`)
    {
        $take_name=( $take_name + $i);
	}
   return $take_name;
}
global proc MIRR_95d47209f5832c068ce7614b82201089()
{
	$selection=`ls-sl`;
	$lock_name =` spaceLocator `;
	setKeyframe -at rx -at ry -at rz $lock_name[0];
	$currTime=(`currentTime -q`) -1;
    setKeyframe  -at rx -at ry -at rz -t $currTime;
	string $obj;
	for($obj in $selection)
	{
		$rx=getAttr($obj + ".rx");
		$ry=getAttr($obj + ".ry");
		$rz=getAttr($obj + ".rz");
		rotate -a $rx $ry $rz $lock_name[0];
		setKeyframe -at rx -at ry -at rz $lock_name[0];
		filterCurve $lock_name.rotateX $lock_name.rotateY $lock_name.rotateZ;
	    $rx=getAttr($lock_name[0] + ".rx");
		$ry=getAttr($lock_name[0] + ".ry");
		$rz=getAttr($lock_name[0] + ".rz");
		rotate -a $rx $ry $rz $obj;
	}
	delete $lock_name;
	select $selection;
}
global proc MIRR_9ef8981ccf72c74373e900ef581dfaea(string $target[], string $object[])
{
    float $targ_attr[];
    for($i=0;$i<size($target);$i++)
    {
        catchQuiet($targ_attr=`getAttr ($target[$i] + ".translate")`);
        catchQuiet(`setAttr ($object[$i] + ".translateX") $targ_attr[0]`);
		catchQuiet(`setAttr ($object[$i] + ".translateY") $targ_attr[1]`);
		catchQuiet(`setAttr ($object[$i] + ".translateZ") $targ_attr[2]`);
    }
}
global proc MIRR_8f1bbed6c413bd9cd1ae5d3c63afb5cc(string $target[], string $object[])
{
    float $targ_attr[];
    for($i=0;$i<size($target);$i++)
    {
        catchQuiet($targ_attr=`getAttr ($target[$i] + ".rotate")`);
		catchQuiet(`setAttr ($object[$i] + ".rotateX") $targ_attr[0]`);
		catchQuiet(`setAttr ($object[$i] + ".rotateY") $targ_attr[1]`);
		catchQuiet(`setAttr ($object[$i] + ".rotateZ") $targ_attr[2]`);
    }
}
global proc MIRR_2fa2b06e9166235ba786cb6586606b52(string $target[], string $object[])
{
    float $targ_attr[];
    for($i=0;$i<size($target);$i++)
    {
        catchQuiet($targ_attr=`getAttr ($target[$i] + ".scale")`);
        catchQuiet(`setAttr ($object[$i] + ".scale") $targ_attr[0] $targ_attr[1] $targ_attr[2]`);
    }
}
global proc MIRR_c8fcd9a605f50c9c5156cafe60648ba3(string $target[], string $object[])
{
	string $attrib[], $attr;
    for($i=0;$i<size($target);$i++)
    {
		$attrib=`listAttr -k -v -ud $target[$i]`;
		for($attr in $attrib)
			catchQuiet(`connectAttr -f ($target[$i] + "." + $attr) ($object[$i] + "." + $attr) `);
    }
}
global proc string MIRR_27fa0883c172ae08e08f5b2f5e58ad38(string $icon, string $command, string $to_object)
{
    $exist_manip=`ls -o "Manipulator*"`;
    buttonManip -icon $icon $command $to_object;
    $all_with_new_manip = `ls -o "Manipulator*"`;
    string $new_manip_object[] = stringArrayRemove($exist_manip,$all_with_new_manip);
    string $returned=$new_manip_object[0];
    return $returned;
}
global proc string MIRR_20a28b95c1b8b4dd29397ab332dbc667()
{
    $currentPanel = `getPanel -withFocus`;
    $error=catch($cam_name=`modelEditor -q -camera  $currentPanel`);
    if($error)
    {
        $cam_name="no model panel viewport";
    }
    return $cam_name;
}
global proc string[] MIRR_8a435c1e94becce7728e63b61ba412bd(float $radius)
{
	$selection = `ls -fl -sl `;
	string $curve_sphere[];
	if(size($selection)>0)
	{
		for($i=0;$i<size($selection);$i++)
		{
			$curve_sphere[$i]=MIRR_1a0417e38be183894da98c3ef5716f0d($radius);
		}
		MIRR_847308ac6f1debf8edcc8d63e128d64c( $selection, $curve_sphere);
		rotate_to_position( $selection,$curve_sphere);
	}
	else
	{
		$curve_sphere[0]=MIRR_1a0417e38be183894da98c3ef5716f0d($radius);
	}
   select $curve_sphere ;
   return $curve_sphere;
}
global proc string MIRR_1a0417e38be183894da98c3ef5716f0d(float $radius)
{
	string $curves[];
	$crv=`curve -d 1
        -p 0  0.5  0
        -p 0  -0.5  0
        -p 0  0  0
        -p 0.5  0  0
        -p -0.5  0  0
        -p 0  0  0
        -p 0  0  0.5
        -p 0  0  -0.5 ` ;
        scale -a (1*$radius) (1*$radius) (1*$radius)  $crv;
        makeIdentity -apply true -t 1 -r 1 -s 1 -n 0 -pn 1;
        select $crv;
        return $crv;
};
global proc string[] MIRR_465f2c70f8e4bf417e93834f61ee4f6e(string $stroka, string $poisk)
{
	string $buffer[]={};
	string $fin_str=$stroka;
	int $siz_stroka=sizeBytes($stroka);
	int $siz_poisk=sizeBytes($poisk);
	for($i=0;$i<($siz_stroka/ $siz_poisk)+1;$i++)
	    $fin_str=`substitute $poisk $fin_str "###^@@@"`;
	tokenize $fin_str "^" $buffer;
	for($i=0;$i<size($buffer);$i++)
	{
	    $buffer[$i]=`substitute "###" $buffer[$i] ""`;
	    $buffer[$i]=`substitute "@@@" $buffer[$i] ""`;
	}
	return $buffer;
}
global proc float MIRR_a358a7c27f7a7b80712d695138ed032e(string $objects[], int $average)
{
    float $distance;
    for($i=0;$i<size($objects)-1;$i++)
        $distance=$distance + MIRR_c7822f1f10b007a6803735c105e40799($objects[$i] , $objects[$i+1]);
    if($average)
         $distance=$distance/(size($objects)-1);
    return $distance;
}
global proc vector MIRR_e3bea614176fbceebe7c7aae67e953b0(vector $coords[])
{
	int $num = `size $coords`;
	vector $ff;
	for ($each in $coords)
	    $ff+=$each;
	$ff=($ff/$num);
	return $ff;
}
global proc float MIRR_f71c299bf7b53f7243b078a9990e581c(float $input)
{
   string $un=`currentUnit -query -linear`;
   float $output;
   float $coeff;
   if($un=="mm")
       $coeff=0.1;
   if($un=="cm")
       $coeff=1;
   if($un=="m")
       $coeff=100;
   if($un=="km")
       $coeff=100000;
   if($un=="in")
       $coeff=2.54;
   if($un=="ft")
       $coeff=30.48;
   if($un=="yd")
       $coeff=91.44;
   if($un=="mi")
       $coeff=160934.4;
    $output =  $input/$coeff;
    return $output;
}
global proc string MIRR_41a30a2e9e6a02aac72ab138d3f62f90(string $attribname, string $object)
{
    addAttr -ln $attribname -nn $attribname -at double -dv 0 $object;
    setAttr -e-channelBox true ($object + "." + $attribname);
    return   ($object + "." + $attribname);
}
global proc string MIRR_81710030388b6f6922e422fe523dd15a(string $attribname, string $object)
{
    addAttr -ln $attribname -nn $attribname -at double -dv 0 $object;
    setAttr -e -channelBox true   ($object + "." + $attribname);
    setAttr -keyable true ($object + "." + $attribname);
    return   ($object + "." + $attribname);
}
global proc string MIRR_65107bc37ea4a0d842be293fd78287a9(string $attribname, string $object)
{
    addAttr -ln $attribname -nn $attribname -at long  -dv 0 $object;
    setAttr -e-channelBox true ($object + "." + $attribname);
